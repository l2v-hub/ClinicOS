DATABASE_URL="postgresql://user:password@host:5432/clinicos?schema=public"
PORT=3001
NODE_ENV=production
# Production must use Entra. Demo requires explicit AUTH_MODE=demo together with
# NODE_ENV=development/test; missing or invalid values always fail closed.
AUTH_MODE=entra
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=

# URL principale del frontend Vercel (production)
FRONTEND_URL=https://clinicos-eosin.vercel.app

# Lista separata da virgole: production + tutte le preview URL Vercel
FRONTEND_URLS=https://clinicos-eosin.vercel.app,https://clinicos-el91lyszt-lucalavia-2482s-projects.vercel.app

# Nota: in Railway impostare queste variabili nel pannello Variables del servizio backend.
# In produzione sono accettate soltanto le origini elencate esplicitamente qui sopra.

# ── AI / Importa lettera di dimissioni (REQ-013) ────────────────────────────
# Tutte server-side. NESSUNA di queste va nel frontend o in variabili VITE_*.
AI_PROVIDER=google
AI_MODEL=gemma-4-31b-it
# Modello separato per output strutturato, se il modello principale non supporta schema (opzionale).
# AI_STRUCTURED_MODEL=gemini-2.0-flash
# SEGRETO: impostare SOLO nel secret manager Railway, mai nel repository.
GEMINI_API_KEY=
# Path agli asset versionati (default: backend/ai-assets/*). Override solo se necessario.
# AI_EXTRACTION_SCHEMA_PATH=
# AI_EXTRACTION_PROMPT_PATH=
# AI_EXTRACTION_OUTPUT_SCHEMA_PATH=   # JSON Schema per validare l'output (REQ-015)
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_MAX_FILES=10
AI_MAX_TOTAL_MB=25
# Import job temp storage + retention (REQ-014). Default: <tmp>/clinicos-imports.
# AI_UPLOAD_DIR=
AI_JOB_RETENTION_MIN=60
# Merge multi-documento (REQ-016): true = ordina i candidati in conflitto dal più
# recente (NON risolve mai automaticamente i conflitti).
AI_MERGE_PREFER_RECENT=true
# Sicurezza import (REQ-019): rate limit generale e cost guard sull'estrazione.
AI_RATE_LIMIT_PER_MIN=60
AI_MAX_EXTRACTIONS_PER_5MIN=10
# ExtractionAgent (REQ-021): agent-native estrazione con tool (find/aggiorna paziente).
AI_USE_AGENT=true
AI_AGENT_MODEL=gemini-2.0-flash
# Async import worker (REQ-022). Worker runs in-process by default; set
# AI_WORKER_INLINE=false when running a separate worker service.
AI_REQUEST_TIMEOUT_MS=300000
AI_JOB_MAX_DURATION_MS=900000
AI_JOB_POLL_INTERVAL_MS=2000
AI_WORKER_INLINE=true

# Runtime AI service-to-service. Entrambi i segreti sono server-only e devono essere diversi.
AI_RUNTIME_URL=
AI_RUNTIME_SERVICE_TOKEN=
# Minimo 32 byte. Firma la busta utente/ruolo/scope inviata a /internal/ai; non esporre al runtime
# del modello, al browser o a variabili VITE_*. L'endpoint fallisce chiuso se non configurata.
AI_GATEWAY_CONTEXT_SECRET=
# Accesso cross-patient e query di struttura sono disabilitati per default.
AI_CROSS_PATIENT_SEARCH_ENABLED=false
AI_FACILITY_QUERIES_ENABLED=false
