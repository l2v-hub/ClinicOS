{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://clinicos/extraction/sections.schema.json",
  "title": "ClinicOS faithful clinical sections (REQ-026)",
  "description": "Model-agnostic contract: each canonical clinical section keeps one faithful rawText block plus semantic annotations (offsets only, never HTML). Missing data stays empty; nothing is summarised, rewritten or invented.",
  "type": "object",
  "required": ["sections"],
  "additionalProperties": false,
  "properties": {
    "sections": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["sectionKey", "rawText"],
        "additionalProperties": false,
        "properties": {
          "sectionKey": {
            "type": "string",
            "enum": [
              "PATIENT_DEMOGRAPHICS",
              "ALLERGIES",
              "DISCHARGE_DIAGNOSIS",
              "ANAMNESIS",
              "HOSPITAL_COURSE",
              "CONSULTATIONS",
              "IMAGING_DIAGNOSTICS",
              "PROCEDURES_AND_INTERVENTIONS",
              "HOSPITAL_THERAPY",
              "DISCHARGE_HOME_THERAPY",
              "ADVICE_AND_FOLLOW_UP",
              "UNMAPPED_CONTENT"
            ]
          },
          "detectedHeading": { "type": "string", "maxLength": 255 },
          "rawText": { "type": "string", "maxLength": 100000 },
          "sourceRanges": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fileId": { "type": "string", "maxLength": 128 },
                "pageNumber": { "type": "integer", "minimum": 1, "maximum": 100000 },
                "startOffset": { "type": "integer", "minimum": 0, "maximum": 100000 },
                "endOffset": { "type": "integer", "minimum": 0, "maximum": 100000 }
              }
            }
          },
          "annotations": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "required": ["tag", "text", "startOffset", "endOffset"],
              "additionalProperties": false,
              "properties": {
                "tag": {
                  "type": "string",
                  "enum": [
                    "SECTION_TITLE",
                    "SUBSECTION_TITLE",
                    "DATE",
                    "TIME",
                    "TEMPORAL_MARKER",
                    "MEDICATION_NAME",
                    "DOSE",
                    "SCHEDULE",
                    "FREQUENCY",
                    "ALLERGY_CRITICAL",
                    "WARNING_TEXT"
                  ]
                },
                "text": { "type": "string", "maxLength": 2000 },
                "startOffset": { "type": "integer", "minimum": 0, "maximum": 100000 },
                "endOffset": { "type": "integer", "minimum": 0, "maximum": 100000 }
              }
            }
          },
          "medications": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "required": ["exactText"],
              "additionalProperties": false,
              "properties": {
                "medicationName": { "type": "string", "maxLength": 1000 },
                "dose": { "type": "string", "maxLength": 1000 },
                "schedule": { "type": "string", "maxLength": 1000 },
                "frequency": { "type": "string", "maxLength": 1000 },
                "route": { "type": "string", "maxLength": 1000 },
                "duration": { "type": "string", "maxLength": 1000 },
                "exactText": { "type": "string", "maxLength": 5000 },
                "warnings": {
                  "type": "array",
                  "maxItems": 128,
                  "items": { "type": "string", "maxLength": 255 }
                }
              }
            }
          },
          "warnings": {
            "type": "array",
            "maxItems": 128,
            "items": { "type": "string", "maxLength": 255 }
          }
        }
      }
    },
    "allergies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["present", "explicitly_absent", "conflicting", "not_documented", "unclear"]
        },
        "rawText": { "type": "string", "maxLength": 100000 },
        "sourceFileId": { "type": "string", "maxLength": 128 },
        "sourcePage": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "warnings": {
          "type": "array",
          "maxItems": 128,
          "items": { "type": "string", "maxLength": 255 }
        }
      }
    },
    "demographics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "firstName": { "type": "string", "maxLength": 255 },
        "lastName": { "type": "string", "maxLength": 255 },
        "dateOfBirth": { "type": "string", "maxLength": 255 },
        "placeOfBirth": { "type": "string", "maxLength": 255 },
        "sex": { "type": "string", "enum": ["", "M", "F"] },
        "codiceFiscale": { "type": "string", "maxLength": 255 },
        "address": { "type": "string", "maxLength": 1000 },
        "phone": { "type": "string", "maxLength": 255 },
        "email": { "type": "string", "maxLength": 255 },
        "medicalRecordNumber": { "type": "string", "maxLength": 255 }
      }
    }
  }
}
