{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://clinicos/extraction/discharge-narrative.schema.json",
  "title": "ClinicOS discharge narrative draft (REQ-028)",
  "description": "Flat, model-agnostic narrative contract for discharge-letter import. Each clinical section is ONE faithful text block (string) — never an array of structured entities. Missing sections are empty strings; semantic emphasis is carried by offset boldTags (no HTML/Markdown).",
  "type": "object",
  "required": [
    "schemaVersion",
    "allergyStatus",
    "allergiesText",
    "diagnosisText",
    "anamnesisText",
    "hospitalCourseText",
    "consultationsText",
    "imagingDiagnosticsText",
    "proceduresAndInterventionsText",
    "therapyText",
    "adviceAndFollowUpText",
    "unmappedText",
    "boldTags",
    "sourceReferences",
    "missingSections",
    "warnings"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "clinicos-discharge-narrative-v1" },

    "firstName": { "type": "string", "maxLength": 255 },
    "lastName": { "type": "string", "maxLength": 255 },
    "dateOfBirth": { "type": "string", "maxLength": 255 },
    "placeOfBirth": { "type": "string", "maxLength": 255 },
    "sex": { "type": "string", "maxLength": 16 },
    "fiscalCode": { "type": "string", "maxLength": 255 },
    "address": { "type": "string", "maxLength": 1000 },
    "phone": { "type": "string", "maxLength": 255 },
    "email": { "type": "string", "maxLength": 255 },

    "allergyStatus": {
      "type": "string",
      "enum": ["present", "explicitly_absent", "not_documented", "unclear", "conflicting"]
    },
    "allergiesText": { "type": "string", "maxLength": 100000 },

    "diagnosisText": { "type": "string", "maxLength": 100000 },
    "anamnesisText": { "type": "string", "maxLength": 100000 },
    "hospitalCourseText": { "type": "string", "maxLength": 100000 },
    "consultationsText": { "type": "string", "maxLength": 100000 },
    "imagingDiagnosticsText": { "type": "string", "maxLength": 100000 },
    "proceduresAndInterventionsText": { "type": "string", "maxLength": 100000 },
    "therapyText": { "type": "string", "maxLength": 100000 },
    "adviceAndFollowUpText": { "type": "string", "maxLength": 100000 },
    "unmappedText": { "type": "string", "maxLength": 100000 },

    "boldTags": {
      "type": "array",
      "maxItems": 1280,
      "items": {
        "type": "object",
        "required": ["sectionKey", "tagType", "text", "startOffset", "endOffset"],
        "additionalProperties": false,
        "properties": {
          "sectionKey": { "type": "string", "maxLength": 64 },
          "tagType": {
            "type": "string",
            "enum": [
              "SECTION_TITLE",
              "SUBSECTION_TITLE",
              "DATE",
              "TIME",
              "TEMPORAL_MARKER",
              "ALLERGY_CRITICAL",
              "MEDICATION_NAME",
              "DOSE",
              "FREQUENCY",
              "SCHEDULE",
              "WARNING_TEXT"
            ]
          },
          "text": { "type": "string", "maxLength": 2000 },
          "startOffset": { "type": "integer", "minimum": 0 },
          "endOffset": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "sourceReferences": {
      "type": "array",
      "maxItems": 320,
      "items": {
        "type": "object",
        "required": ["sectionKey"],
        "additionalProperties": false,
        "properties": {
          "sectionKey": { "type": "string", "maxLength": 64 },
          "fileId": { "type": "string", "maxLength": 128 },
          "fileName": { "type": "string", "maxLength": 255 },
          "pageFrom": { "type": "integer", "minimum": 1, "maximum": 100000 },
          "pageTo": { "type": "integer", "minimum": 1, "maximum": 100000 }
        }
      }
    },
    "missingSections": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "maxLength": 64 }
    },
    "warnings": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "maxLength": 255 }
    }
  }
}
