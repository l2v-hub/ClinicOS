import {browser,setup,openImport,finish,expect,out,report,newJob,memoryKey} from './fixture.mjs';
const results=[];
async function run(name,options,test){const ctx=await setup(options);try{await openImport(ctx);await test(ctx);await ctx.page.screenshot({path:`${out}/screenshots/${name}.png`});await finish(ctx,name);results.push({name,status:'PASS'});}catch(error){await ctx.page.screenshot({path:`${out}/screenshots/${name}-failed.png`}).catch(()=>{});await finish(ctx,`${name}-failed`).catch(()=>{});results.push({name,status:'FAIL',error:error.message});throw error;}}
const footer=p=>p.locator('.import-session-footer');
async function noPromise(p){await expect(footer(p)).not.toContainText(/Chiudendo|pagine già salvate|conserv/);await expect(p.locator('.import-modal__head .icon-btn')).toHaveAttribute('aria-label','Chiudi importazione');}
const savedJob=()=>{const j=newJob();j.documents=[{id:'synthetic-document',filename:'pagina-sintetica.png',mimeType:'image/png',sizeBytes:67,pageCount:1,contentUrl:'/synthetic-unused'}];j.manifest.pages=[{id:'synthetic-page',documentId:'synthetic-document',sourcePageNumber:1,groupId:'synthetic-letter',sortOrder:0,status:'pending',canRetry:false,errorCode:null,error:null}];j.manifest.groups[0].pageCount=1;return j;};
try{
 for(const [status,text] of [['expired','La sessione è scaduta.'],['cancelled','La sessione è stata eliminata.'],['confirmed','Questa importazione è già conclusa.']])await run(status,{session:newJob(status)},async({page,state})=>{await expect(page.getByRole('alert')).toContainText(text);await noPromise(page);await expect(page.getByRole('button',{name:'Nuova importazione',exact:true})).toBeVisible();expect(state.created).toBe(0);});
 await run('missing-masked',{sessionStatus:404},async({page,state})=>{await expect(page.getByRole('alert')).toContainText('La sessione non è disponibile.');await expect(page.getByRole('alert')).not.toContainText(/eliminata|scaduta|conclusa/);await noPromise(page);expect(state.created).toBe(0);});
 await run('temporary-retry-same-id',{sessionStatus:503},async({page,state})=>{await expect(page.getByRole('alert')).toContainText('Disponibilità della sessione non verificata.');await noPromise(page);await expect(page.getByRole('button',{name:'Nuova importazione',exact:true})).toHaveCount(0);state.sessionStatus=200;state.session=newJob();await page.getByRole('button',{name:'Riprova apertura sessione'}).click();await expect(page.getByTestId('import-documents-workspace')).toContainText('0 / 30 pagine');expect(state.created).toBe(0);expect(state.requests.filter(r=>r.path.startsWith('/ai/extraction/jobs/')).every(r=>r.path==='/ai/extraction/jobs/synthetic-session-420')).toBe(true);expect(await page.evaluate(k=>localStorage.getItem(k),memoryKey)).toBe('synthetic-session-420');});
 await run('network-retry-same-id',{sessionStatus:503},async({page,state})=>{await expect(page.getByRole('alert')).toContainText('Disponibilità');state.networkFailure=true;await page.getByRole('button',{name:'Riprova apertura sessione'}).click();await expect(page.getByRole('alert')).toContainText('Disponibilità');await noPromise(page);state.sessionStatus=200;state.session=newJob();await page.getByRole('button',{name:'Riprova apertura sessione'}).click();await expect(page.getByTestId('import-documents-workspace')).toBeVisible();expect(state.created).toBe(0);});
 await run('replacement-feedback-return-reload',{},async({page,state})=>{await expect(page.getByRole('alert')).toContainText('scaduta');state.delayCreate=800;const create=page.getByRole('button',{name:'Nuova importazione',exact:true});await create.focus();await page.keyboard.press('Enter');await expect(page.getByRole('status').filter({hasText:'Creazione nuova sessione…'})).toBeVisible();await noPromise(page);await expect(page.getByRole('status').filter({hasText:'Nuova sessione creata.'})).toBeVisible();await expect(page.getByTestId('import-documents-workspace')).toContainText('0 / 30 pagine');expect(state.created).toBe(1);expect(state.creationKeys[0]).toBeTruthy();await footer(page).getByRole('button',{name:'Chiudi importazione',exact:true}).focus();await page.keyboard.press('Enter');await expect(page.getByRole('dialog')).toHaveCount(0);await page.reload();await openImport({page});await expect(page.getByTestId('import-documents-workspace')).toContainText('0 / 30 pagine');expect(state.created).toBe(1);expect(await page.evaluate(k=>localStorage.getItem(k),memoryKey)).toBe('synthetic-new-session-420');});
 await run('active-saved-page-recovery',{session:savedJob()},async({page,state})=>{await expect(page.locator('[data-page-id="synthetic-page"]')).toContainText('pagina-sintetica.png');await expect(page.locator('.import-page__thumbnail img')).toBeVisible();await expect(footer(page)).toContainText('Chiudendo puoi riprendere le pagine già salvate finché la sessione resta disponibile.');await footer(page).getByRole('button',{name:'Chiudi importazione',exact:true}).click();await page.reload();await openImport({page});await expect(page.locator('[data-page-id="synthetic-page"]')).toContainText('pagina-sintetica.png');expect(state.created).toBe(0);expect(await page.evaluate(k=>localStorage.getItem(k),memoryKey)).toBe('synthetic-session-420');});
 await run('resource404-not-job-deletion',{session:newJob('review_ready')},async({page,state})=>{await expect(page.getByRole('alert')).toContainText('Synthetic missing result');await noPromise(page);await expect(page.getByRole('button',{name:'Nuova importazione',exact:true})).toHaveCount(0);await expect(page.getByRole('button',{name:'Riprova apertura sessione'})).toBeVisible();expect(state.created).toBe(0);expect(await page.evaluate(k=>localStorage.getItem(k),memoryKey)).toBe('synthetic-session-420');});
 await run('terminal-poll-removes-stale',{session:newJob('processing')},async({page,state})=>{await expect(page.getByTestId('import-documents-workspace')).toBeVisible();state.session=newJob('expired');await page.clock.runFor(2100);await expect(page.getByRole('alert')).toContainText('La sessione è scaduta.');await noPromise(page);await expect(page.getByTestId('import-documents-workspace')).toHaveCount(0);await expect(page.getByRole('button',{name:'Nuova importazione',exact:true})).toBeVisible();expect(state.created).toBe(0);});
 await run('terminal-mutation-removes-stale',{session:newJob()},async({page,state})=>{await expect(page.getByTestId('import-documents-workspace')).toBeVisible();await page.getByRole('button',{name:'+ Nuova lettera',exact:true}).click();await expect(page.getByRole('alert')).toContainText('non è più modificabile');await noPromise(page);await expect(page.getByTestId('import-documents-workspace')).toHaveCount(0);expect(state.created).toBe(0);});
 await run('past-expiry-not-fabricated',{session:{...newJob(),expiresAt:'2026-10-08T18:00:00Z'}},async({page})=>{await expect(page.getByTestId('import-documents-workspace')).toBeVisible();await noPromise(page);await expect(footer(page)).toContainText('Disponibilità della sessione non verificata');await expect(page.getByRole('button',{name:'Nuova importazione',exact:true})).toHaveCount(0);});
 await run('mobile-terminal-return',{mobile:true},async({page})=>{await expect(page.getByRole('alert')).toContainText('La sessione è scaduta.');await noPromise(page);expect(await page.locator('.import-session').evaluate(e=>e.scrollWidth<=e.clientWidth+1)).toBe(true);await footer(page).getByRole('button',{name:'Chiudi importazione',exact:true}).click();await expect(page.getByRole('dialog')).toHaveCount(0);});
 report(results);
}finally{report(results);await browser.close();}
