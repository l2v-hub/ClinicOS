import {browser,setup,openImport,finish,expect,out,report} from './fixture.mjs';
try{const ctx=await setup();try{await openImport(ctx);await expect(ctx.page.getByRole('alert')).toContainText('La sessione è scaduta, eliminata o già conclusa.');await expect(ctx.page.locator('.import-session-footer')).toContainText('Chiudendo conservi le pagine già salvate nella tua sessione.');await ctx.page.screenshot({path:`${out}/screenshots/before-contradiction.png`});await ctx.page.getByRole('button',{name:'Nuova importazione',exact:true}).click();await expect(ctx.page.getByTestId('import-documents-workspace')).toContainText('0 / 30 pagine');expect(ctx.state.created).toBe(1);await ctx.page.screenshot({path:`${out}/screenshots/before-new-session-works.png`});await finish(ctx,'before');report([{name:'contradictory promise reproduced; explicit new already works',status:'PASS'}]);}catch(e){try{await finish(ctx,'before-failed');}catch{}throw e;}}finally{await browser.close();}
