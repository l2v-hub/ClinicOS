{"type":"frame-snapshot","snapshot":{"callId":"call@17346","snapshotName":"after@call@17346","pageId":"page@b4b888adf092d3c4be5054dfcaa2fb18","frameId":"frame@b869674d7fef28756a81491d790bb706","frameUrl":"http://127.0.0.1:7483/#/dettaglio-paziente/QA-418-INDEPENDENT/parametri","doctype":"html","html":["HTML",{"lang":"it"},["HEAD",{},[[32,0]],[[32,1]],[[32,2]],[[32,3]],[[32,4]],[[32,5]],[[32,6]],[[32,7]],[[32,8]],[[32,9]],[[32,10]],[[32,11]],[[32,12]],[[32,13]],[[32,15]],[[32,16]],[[32,18]],[[32,20]],[[32,22]],[[32,24]],[[32,26]],[[32,28]],[[29,1]],[[29,3]],[[29,5]],[[29,7]],[[29,9]],[[29,11]],[[29,13]],[[29,15]],[[29,17]],[[29,19]],[[29,21]],[[29,23]],[[29,25]],[[29,27]],[[29,29]],[[28,1]],[[28,3]],[[28,5]],[[28,7]],[[28,9]],[[28,11]],[[28,13]],[[28,15]],[[28,17]],[[28,19]],[[28,21]],[[28,23]],[[28,25]],[[28,27]],[[25,1]],[[25,3]],[[20,1]],[[20,3]],[[20,5]],[[20,7]],[[15,1]],[[15,3]],[[15,5]],[[15,7]],[[11,1]],[[11,3]],[[11,5]],[[11,7]],["STYLE",{},"/* Agenda operatore — HMI 1 (artifacts/hmi-parity/proto/agenda.png). Solo `.agt-view--hmi`:\r\n   le classes agt- sono condivise con l'agenda multi-operatore dell'admin. */\r\n.agt-view--hmi .agt-day-card {\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 16px;\r\n  padding: 24px;\r\n  min-width: 0;\r\n}\r\n.agt-view--hmi .agt-day-card__head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  flex-wrap: wrap;\r\n  padding-bottom: 16px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n.agt-view--hmi .agt-day-card__title {\r\n  margin: 0;\r\n  font: 600 20px/28px var(--font-ui);\r\n  color: var(--text);\r\n}\r\n.agt-view--hmi .agt-day-card__title::first-letter {\r\n  text-transform: uppercase;\r\n}\r\n\r\n.agt-view--hmi .agt-day-wrap {\r\n  overflow: visible;\r\n}\r\n.agt-view--hmi .agt-slot,\r\n.agt-view--hmi .agt-slot--hour,\r\n.agt-view--hmi .agt-slot--half {\r\n  min-height: 56px;\r\n  align-items: center;\r\n  gap: 16px;\r\n  border-bottom: 1px solid var(--border);\r\n  padding: 8px 0;\r\n}\r\n.agt-view--hmi .agt-slot__time {\r\n  width: 72px;\r\n  font: 600 16px/24px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--text);\r\n  align-self: center;\r\n  padding: 0;\r\n}\r\n/* Fascia libera: vuota come nel prototipo, \"+ Disponibile\" al passaggio o al fuoco. */\r\n.agt-view--hmi .agt-free-slot {\r\n  opacity: 0;\r\n  transition: opacity 0.15s;\r\n}\r\n.agt-view--hmi .agt-slot--free:hover .agt-free-slot,\r\n.agt-view--hmi .agt-slot--free:focus-visible .agt-free-slot {\r\n  opacity: 1;\r\n}\r\n.agt-view--hmi .agt-slot--free:focus-visible {\r\n  outline: 3px solid #245bb5;\r\n  outline-offset: -3px;\r\n  border-radius: 8px;\r\n}\r\n.agt-view--hmi .agt-apt-card {\r\n  flex: 1;\r\n  min-width: 0;\r\n  border: 0;\r\n  border-radius: 8px;\r\n  padding: 8px 16px;\r\n  background: #eaf1fe;\r\n}\r\n.agt-view--hmi .agt-apt-card--in_corso,\r\n.agt-view--hmi .agt-apt-card--urgent {\r\n  background: #fdf3e2;\r\n}\r\n.agt-view--hmi .agt-apt-card--completato {\r\n  background: #e6f6ef;\r\n}\r\n.agt-view--hmi .agt-apt-card--annullato {\r\n  background: #eef1f6;\r\n}\r\n.agt-view--hmi .agt-apt-card__row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.agt-view--hmi .agt-apt-card__title {\r\n  font: 600 16px/24px var(--font-ui);\r\n  color: #1d4fc4;\r\n  white-space: nowrap;\r\n}\r\n.agt-view--hmi .agt-apt-card--annullato .agt-apt-card__title {\r\n  color: var(--text-muted);\r\n  text-decoration: line-through;\r\n}\r\n.agt-view--hmi .agt-apt-card__detail {\r\n  flex: 1;\r\n  min-width: 0;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: #1d4fc4;\r\n  overflow: hidden;\r\n  white-space: nowrap;\r\n}\r\n.agt-view--hmi .agt-apt-card__detail .agt-apt-card__patient {\r\n  font: inherit;\r\n  color: inherit;\r\n  padding: 0;\r\n  min-height: 0;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n.agt-view--hmi .agt-apt-card__badges {\r\n  margin-left: auto;\r\n  flex: none;\r\n}\r\n@media (max-width: 600px) {\r\n  .agt-view--hmi .agt-day-card {\r\n    padding: 16px;\r\n  }\r\n  .agt-view--hmi .agt-slot__time {\r\n    width: 52px;\r\n  }\r\n  .agt-view--hmi .agt-apt-card__row {\r\n    flex-wrap: wrap;\r\n    gap: 4px 12px;\r\n  }\r\n  .agt-view--hmi .agt-apt-card__detail {\r\n    order: 3;\r\n    flex-basis: 100%;\r\n  }\r\n}\r\n/* Allineamento al prototipo sopra gli stili storici dell'agenda (app-additions.css). */\r\n.agt-view--hmi .agt-filter-row {\r\n  background: transparent;\r\n  border: 0;\r\n  padding: 0 0 16px;\r\n}\r\n.agt-view--hmi .agt-slot--free,\r\n.agt-view--hmi .agt-slot--half.agt-slot--free {\r\n  background: transparent;\r\n}\r\n.agt-view--hmi .agt-slot--free:hover,\r\n.agt-view--hmi .agt-slot--free:focus-visible {\r\n  background: #f5f7fb;\r\n}\r\n.agt-view--hmi .agt-slot__time,\r\n.agt-view--hmi .agt-slot--half .agt-slot__time {\r\n  padding: 0;\r\n}\r\n.agt-view--hmi .agt-apt-card {\r\n  min-height: 0;\r\n  align-self: center;\r\n  box-shadow: none;\r\n  border-left: 0;\r\n  gap: 8px;\r\n}\r\n.agt-view--hmi .agt-apt-card__detail {\r\n  flex: 0 1 auto;\r\n}\r\n.agt-view--hmi .agt-apt-card__detail .agt-meta-sep {\r\n  color: inherit;\r\n}\r\n.agt-view--hmi .agt-day-wrap,\r\n.agt-view--hmi .agt-slot {\r\n  background: transparent;\r\n  border-left: 0;\r\n}\r\n/* Sottotitolo nell'intestazione: va a capo (settimana/data sempre leggibili, niente «…»). */\r\n.topbar-title .agt-page-subtitle {\r\n  flex-wrap: wrap;\r\n  row-gap: 0;\r\n  column-gap: 6px;\r\n  white-space: normal;\r\n}\r\n.topbar-title .agt-page-subtitle > * {\r\n  flex: 0 1 auto;\r\n  min-width: 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n.agt-view--hmi .agt-day-card__heading {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n}\r\n.agt-view--hmi .agt-day-card__op {\r\n  display: none;\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n@media (max-width: 600px) {\r\n  /* Sul telefono l'intestazione mostra solo la data (a capo se non entra); l'operatore\r\n     passa nella card del giorno. */\r\n  .topbar-title .agt-page-subtitle .agt-op-chip,\r\n  .topbar-title .agt-page-subtitle .agt-page-subtitle__separator,\r\n  .topbar-title .agt-page-subtitle .agt-header__date ~ span {\r\n    display: none;\r\n  }\r\n  .topbar-title .agt-page-subtitle .agt-header__date {\r\n    flex: 0 1 auto;\r\n    min-width: 0;\r\n  }\r\n  .agt-view--hmi .agt-day-card__op {\r\n    display: block;\r\n  }\r\n}\r\n"]],[[32,30]],["BODY",{},[[32,31]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},[[21,2]],["DIV",{"class":"main-area-clean"},[[14,1]],["MAIN",{"class":"page-content content-panel"},["DIV",{"class":"patient-record-view"},[[13,3]],[[17,53]],["DIV",{"class":"cr-detail-layout cr-detail-layout--no-sidebar"},["DIV",{"id":"patient-tab-panel","role":"tabpanel","aria-labelledby":"patient-section-parametri","tabindex":"0","class":"cr-detail-content tab-panel-transition"},["DIV",{"class":"chart-part","data-chart-part":"parametri"},["DIV",{"class":"patient-vital-signs parameter-workspace","id":"vital-panel"},["SECTION",{"class":"parameter-single-entry","aria-label":"Registra parametri del paziente"},[[14,19]],["FORM",{"class":"parameter-reading-form","aria-label":"Nuova rilevazione"},["DIV",{"class":"parameter-reading-form__layout"},["FIELDSET",{"class":"parameter-reading-form__fields"},[[14,21]],[[3,1]],["LABEL",{"for":"_r_g_-spo2","class":"parameter-reading-form__field"},[[14,35]],[[14,36]],["SMALL",{"__playwright_target__":"","id":"_r_g_-spo2-previous","class":"parameter-reading-form__previous"},[[12,3]]]],[[12,8]],[[12,11]],[[12,14]],[[12,17]],[[12,20]],[[12,23]],[[12,26]],[[14,121]],[[14,126]]],[[14,169]]]]],[[12,36]]]],[[17,75]]]]]]]]],[[32,65]],[[32,66]]]],"viewport":{"width":1150,"height":1004},"timestamp":80348.66,"wallTime":1792890302422,"collectionTime":1,"resourceOverrides":[],"