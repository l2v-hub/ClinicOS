{"type":"frame-snapshot","snapshot":{"callId":"call@16156","snapshotName":"after@call@16156","pageId":"page@7bae6b9dd7e5947c0c75684c6a58f975","frameId":"frame@1a2dddf9cdbd20ea36ab8c51f62852d2","frameUrl":"http://127.0.0.1:7483/#/dettaglio-paziente/QA-418-INDEPENDENT","doctype":"html","html":["HTML",{"lang":"it"},["HEAD",{},[[13,0]],[[13,1]],[[13,2]],[[13,3]],[[13,4]],[[13,5]],[[13,6]],[[13,7]],[[13,8]],[[13,9]],[[13,10]],[[13,11]],[[13,12]],[[13,13]],[[13,15]],[[13,16]],[[13,18]],[[13,20]],[[13,22]],[[13,24]],[[13,26]],[[13,28]],[[10,1]],[[10,3]],[[10,5]],[[10,7]],[[10,9]],[[10,11]],[[10,13]],[[10,15]],[[10,17]],[[10,19]],[[10,21]],[[10,23]],[[10,25]],[[10,27]],[[10,29]],[[9,1]],[[9,3]],[[9,5]],[[9,7]],[[9,9]],[[9,11]],[[9,13]],[[9,15]],[[9,17]],[[9,19]],[[9,21]],[[9,23]],[[9,25]],[[9,27]],[[6,1]],[[6,3]],[[1,1]],[[1,3]],[[1,5]],[[1,7]],[[1,9]],[[1,11]],[[1,13]],[[1,15]],[[1,17]],[[1,19]],[[1,21]],[[1,23]],[[1,25]],[[1,27]],[[1,29]],[[1,31]],[[1,33]],[[1,35]],[[1,37]],["STYLE",{},"/* Amministrazione → Ruoli e permessi. Solo layout e colori degli effetti: i controlli (chip,\r\n   pulsanti, campi) restano quelli canonici di design-system.css. Rosso solo per gli errori. */\r\n\r\n.rp-page {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n  /* .page-content already provides the page gutter. */\r\n  padding: 0;\r\n}\r\n\r\n.rp-body {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n  padding-bottom: 24px;\r\n}\r\n\r\n.rp-stack {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n\r\n.rp-muted {\r\n  color: var(--text-muted);\r\n  font-size: 13px;\r\n}\r\n\r\n.rp-mono {\r\n  font-family: var(--font-mono);\r\n  font-size: 12.5px;\r\n}\r\n\r\n/* ── Banner ─────────────────────────────────────────────────────────────────────────────── */\r\n.rp-banner {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  margin: 0;\r\n  padding: 12px 16px;\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--radius);\r\n  background: var(--surface);\r\n  color: var(--text);\r\n  font-size: 14px;\r\n}\r\n.rp-banner__actions {\r\n  display: inline-flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n.rp-banner--success {\r\n  background: var(--emerald-bg);\r\n  border-color: color-mix(in srgb, var(--emerald) 35%, transparent);\r\n}\r\n.rp-banner--warning {\r\n  background: var(--amber-bg);\r\n  border-color: color-mix(in srgb, var(--amber) 35%, transparent);\r\n  color: color-mix(in srgb, var(--amber) 55%, black);\r\n}\r\n.rp-banner--error {\r\n  background: var(--red-bg);\r\n  border-color: var(--red-border);\r\n  color: color-mix(in srgb, var(--red) 80%, black);\r\n}\r\n.rp-warnings {\r\n  display: block;\r\n  margin-bottom: 12px;\r\n  padding-left: 32px;\r\n}\r\n.rp-warnings li + li {\r\n  margin-top: 4px;\r\n}\r\n\r\n/* ── Filtri ─────────────────────────────────────────────────────────────────────────────── */\r\n.rp-filters {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: flex-end;\r\n  gap: 12px;\r\n  padding: 12px 16px;\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--radius);\r\n}\r\n.rp-filters__field {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  min-width: 160px;\r\n}\r\n.rp-filters__field--grow {\r\n  flex: 1 1 240px;\r\n}\r\n.rp-filters__label {\r\n  color: var(--field-label);\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n}\r\n.rp-filters__chips {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n.rp-filters__count {\r\n  margin-left: auto;\r\n  align-self: center;\r\n  color: var(--text-muted);\r\n  font-size: 13px;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.rp-capability-picker {\r\n  max-width: 640px;\r\n}\r\n\r\n/* ── Etichette ──────────────────────────────────────────────────────────────────────────── */\r\n.rp-tags,\r\n.rp-name-list {\r\n  display: inline-flex;\r\n  flex-wrap: wrap;\r\n  gap: 4px;\r\n}\r\n.rp-tag {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  padding: 1px 7px;\r\n  border-radius: 6px;\r\n  background: var(--c-neutral-bg);\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  line-height: 18px;\r\n  white-space: nowrap;\r\n}\r\n.rp-tag--write,\r\n.rp-tag--action {\r\n  background: var(--c-primary-bg);\r\n  color: var(--c-primary-active);\r\n}\r\n.rp-tag--sens-high,\r\n.rp-tag--sens-critical {\r\n  background: var(--amber-bg);\r\n  color: color-mix(in srgb, var(--amber) 65%, black);\r\n}\r\n.rp-tag--sens-critical {\r\n  font-weight: 800;\r\n}\r\n.rp-tag--tool,\r\n.rp-tag--sim {\r\n  background: color-mix(in srgb, var(--purple) 12%, white);\r\n  color: var(--purple);\r\n}\r\n.rp-tag--active,\r\n.rp-tag--gain {\r\n  background: var(--emerald-bg);\r\n  color: color-mix(in srgb, var(--emerald) 60%, black);\r\n}\r\n.rp-tag--loss {\r\n  background: var(--c-neutral-bg);\r\n  color: var(--text);\r\n  text-decoration: line-through;\r\n}\r\n.rp-legacy-tag {\r\n  display: inline-block;\r\n  margin-left: 6px;\r\n  padding: 0 6px;\r\n  border: 1px dashed var(--text-xmuted);\r\n  border-radius: 6px;\r\n  color: var(--text-xmuted);\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.04em;\r\n  line-height: 16px;\r\n  text-transform: lowercase;\r\n}\r\n.rp-count {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  min-width: 24px;\r\n  justify-content: center;\r\n  padding: 0 8px;\r\n  border-radius: 8px;\r\n  background: var(--c-neutral-bg);\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  line-height: 22px;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.rp-count--doubt {\r\n  background: var(--amber-bg);\r\n  color: color-mix(in srgb, var(--amber) 65%, black);\r\n}\r\n.rp-count--changed {\r\n  background: var(--c-primary-bg);\r\n  color: var(--c-primary-active);\r\n}\r\n\r\n/* ── Effetti ────────────────────────────────────────────────────────────────────────────── */\r\n.rp-effect,\r\n.rp-effect-badge {\r\n  --rp-bg: var(--c-neutral-bg);\r\n  --rp-fg: var(--text-muted);\r\n  --rp-bd: #d3dbe6;\r\n  background-color: var(--rp-bg);\r\n  color: var(--rp-fg);\r\n  border: 1px solid var(--rp-bd);\r\n}\r\n.rp-effect--ALLOWED,\r\n.rp-effect-badge--ALLOWED {\r\n  --rp-bg: var(--emerald-bg);\r\n  --rp-fg: color-mix(in srgb, var(--emerald) 60%, black);\r\n  --rp-bd: color-mix(in srgb, var(--emerald) 40%, white);\r\n}\r\n.rp-effect--ALLOWED_WITH_CONFIRMATION,\r\n.rp-effect-badge--ALLOWED_WITH_CONFIRMATION {\r\n  --rp-bg: var(--amber-bg);\r\n  --rp-fg: color-mix(in srgb, var(--amber) 65%, black);\r\n  --rp-bd: color-mix(in srgb, var(--amber) 40%, white);\r\n}\r\n.rp-effect--READ_ONLY,\r\n.rp-effect-badge--READ_ONLY {\r\n  --rp-bg: var(--ds-blue-tint, #eaf1fe);\r\n  --rp-fg: var(--c-primary-active);\r\n  --rp-bd: color-mix(in srgb, var(--blue) 30%, white);\r\n}\r\n\r\n.rp-effect {\r\n  box-sizing: border-box;\r\n  width: 100%;\r\n  min-width: 132px;\r\n  height: 40px;\r\n  padding: 0 28px 0 10px;\r\n  border-radius: var(--radius-sm);\r\n  font: 600 13px/1 var(--font-ui);\r\n  cursor: pointer;\r\n  appearance: none;\r\n  background-image:\r\n    linear-gradient(45deg, transparent 50%, currentColor 50%),\r\n    linear-gradient(135deg, currentColor 50%, transparent 50%);\r\n  background-position:\r\n    calc(100% - 14px) 50%,\r\n    calc(100% - 9px) 50%;\r\n  background-size: 5px 5px;\r\n  background-repeat: no-repeat;\r\n}\r\n.rp-effect:focus-visible {\r\n  outline: var(--ds-focus, 3px solid #245bb5);\r\n  outline-offset: 1px;\r\n}\r\n.rp-effect option {\r\n  background: var(--surface);\r\n  color: var(--text);\r\n}\r\n.rp-effect--changed {\r\n  box-shadow: inset 0 0 0 2px var(--blue);\r\n  border-color: var(--blue);\r\n}\r\n.rp-effect--inert {\r\n  border-style: dashed;\r\n  text-decoration: line-through;\r\n}\r\n\r\n.rp-effect-badge {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  padding: 1px 8px;\r\n  border-radius: 6px;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  line-height: 20px;\r\n  white-space: nowrap;\r\n}\r\n.rp-effect-badge--none {\r\n  border-style: dashed;\r\n}\r\n\r\n.rp-doubt {\r\n  display: inline-flex;\r\n  flex: none;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 22px;\r\n  height: 22px;\r\n  border-radius: 50%;\r\n  background: var(--amber-bg);\r\n  border: 1px solid color-mix(in srgb, var(--amber) 50%, white);\r\n  color: color-mix(in srgb, var(--amber) 65%, black);\r\n  font-size: 12px;\r\n  font-weight: 800;\r\n  cursor: help;\r\n}\r\n.rp-doubt:focus-visible {\r\n  outline: var(--ds-focus, 3px solid #245bb5);\r\n  outline-offset: 1px;\r\n}\r\n.rp-note {\r\n  display: inline-flex;\r\n  align-items: flex-start;\r\n  gap: 6px;\r\n  color: var(--text);\r\n  font-size: 13px;\r\n  white-space: normal;\r\n}\r\n\r\n.rp-outcome {\r\n  font-weight: 700;\r\n}\r\n.rp-outcome--yes {\r\n  color: color-mix(in srgb, var(--emerald) 60%, black);\r\n}\r\n.rp-outcome--no {\r\n  color: var(--text-muted);\r\n}\r\n\r\n/* ── Matrice ────────────────────────────────────────────────────────────────────────────── */\r\n.rp-matrix {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  min-width: 0;\r\n}\r\n.rp-matrix__tools {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n.rp-matrix__wrap {\r\n  max-height: calc(100vh - 300px);\r\n  min-height: 320px;\r\n  overflow: auto;\r\n  overscroll-behavior: contain;\r\n  margin-bottom: 0;\r\n  background: var(--surface);\r\n}\r\n.rp-matrix__table {\r\n  border-collapse: separate;\r\n  border-spacing: 0;\r\n}\r\n.rp-matrix__table thead th {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 3;\r\n  vertical-align: bottom;\r\n  white-space: normal;\r\n}\r\n.rp-matrix__cap-col {\r\n  left: 0;\r\n  z-index: 4 !important;\r\n  min-width: 260px;\r\n}\r\n.rp-matrix__role-col {\r\n  min-width: 144px;\r\n  text-transform: none !important;\r\n  letter-spacing: 0 !important;\r\n}\r\n.rp-matrix__role-label {\r\n  color: var(--text);\r\n  font-size: 13px;\r\n}\r\n.rp-col--legacy {\r\n  background-image: repeating-linear-gradient(\r\n    135deg,\r\n    transparent 0 8px,\r\n    rgba(90, 107, 128, 0.05) 8px 16px\r\n  );\r\n}\r\n.rp-matrix__table tbody td.rp-matrix__cell {\r\n  height: auto;\r\n  min-height: 0;\r\n  padding: 6px 8px;\r\n}\r\n.rp-cell {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n}\r\n\r\n:is(.rp-matrix__table, .rp-list-table) tbody th.rp-matrix__cap {\r\n  padding: 8px 14px;\r\n  border-bottom: 1px solid #f0f4f8;\r\n  background: var(--surface);\r\n  text-align: left;\r\n  font-weight: 400;\r\n  vertical-align: middle;\r\n}\r\n.rp-matrix__table tbody th.rp-matrix__cap {\r\n  position: sticky;\r\n  left: 0;\r\n  z-index: 2;\r\n  max-width: 340px;\r\n  box-shadow: 1px 0 0 var(--border);\r\n}\r\n.rp-cap-name {\r\n  display: block;\r\n  color: var(--text);\r\n  font-size: 13.5px;\r\n  font-weight: 600;\r\n}\r\n.rp-cap-id {\r\n  display: block;\r\n  margin: 1px 0 4px;\r\n  color: var(--text-xmuted);\r\n  font-family: var(--font-mono);\r\n  font-size: 11px;\r\n  word-break: break-all;\r\n}\r\n\r\n.rp-group-row th {\r\n  position: sticky;\r\n  left: 0;\r\n  padding: 0;\r\n  background: var(--surface-raised);\r\n  border-bottom: 1px solid var(--border);\r\n  text-align: left;\r\n}\r\n.rp-group-toggle {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 10px;\r\n  width: 100%;\r\n  min-height: 48px;\r\n  padding: 8px 14px;\r\n  border: 0;\r\n  background: transparent;\r\n  color: var(--text);\r\n  font: 700 14px/1.3 var(--font-ui);\r\n  text-align: left;\r\n  cursor: pointer;\r\n}\r\n.rp-group-toggle:hover {\r\n  background: var(--hover);\r\n}\r\n.rp-group-toggle:focus-visible {\r\n  outline: var(--ds-focus, 3px solid #245bb5);\r\n  outline-offset: -3px;\r\n}\r\n.rp-chevron {\r\n  width: 8px;\r\n  height: 8px;\r\n  border-right: 2px solid currentColor;\r\n  border-bottom: 2px solid currentColor;\r\n  transform: rotate(-45deg);\r\n  transition: transform 0.15s ease-out;\r\n}\r\n.rp-chevron--open {\r\n  transform: rotate(45deg);\r\n}\r\n\r\n/* ── Per ruolo / per capability ─────────────────────────────────────────────────────────── */\r\n.rp-list-table tbody td {\r\n  height: auto;\r\n  min-height: 0;\r\n  padding: 8px 14px;\r\n}\r\n.rp-list-table .rp-effect {\r\n  max-width: 220px;\r\n}\r\n.rp-row--legacy td,\r\n.rp-row--legacy th {\r\n  background-image: repeating-linear-gradient(\r\n    135deg,\r\n    transparent 0 8px,\r\n    rgba(90, 107, 128, 0.05) 8px 16px\r\n  );\r\n}\r\n.rp-role-summary {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n}\r\n.rp-role-summary__desc {\r\n  margin: 0;\r\n  color: var(--text);\r\n  font-size: 14px;\r\n}\r\n.rp-facts {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));\r\n  gap: 10px 16px;\r\n  margin: 0;\r\n}\r\n.rp-facts dt {\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n}\r\n.rp-facts dd {\r\n  margin: 2px 0 0;\r\n  color: var(--text);\r\n  font-size: 14px;\r\n}\r\n.rp-subtitle {\r\n  margin: 0 0 6px;\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  color: var(--text);\r\n}\r\n.rp-identity-list,\r\n.rp-derived-list {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  margin: 0;\r\n  padding: 0;\r\n  list-style: none;\r\n}\r\n.rp-identity-list li,\r\n.rp-derived-list li {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px;\r\n  font-size: 13.5px;\r\n}\r\n.rp-derived-list .rp-cap-name,\r\n.rp-derived-list .rp-cap-id {\r\n  display: inline;\r\n  margin: 0;\r\n}\r\n\r\n/* ── Identità ───────────────────────────────────────────────────────────────────────────── */\r\n.rp-assign {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n.rp-assign__select {\r\n  min-width: 220px;\r\n}\r\nselect.rp-assign__select--changed:not(#ds) {\r\n  border-color: var(--blue);\r\n  box-shadow: inset 0 0 0 1px var(--blue);\r\n}\r\n\r\n/* ── Storico ────────────────────────────────────────────────────────────────────────────── */\r\n.rp-history {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  margin: 0;\r\n  padding: 0;\r\n  list-style: none;\r\n}\r\n.rp-history__item {\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--radius);\r\n  background: var(--surface);\r\n  overflow: hidden;\r\n}\r\n.rp-history__item.is-open {\r\n  border-color: color-mix(in srgb, var(--blue) 35%, var(--border));\r\n}\r\n.rp-history__head {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding-right: 12px;\r\n}\r\n.rp-history__toggle {\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n}\r\n.rp-history__version {\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.rp-history__meta,\r\n.rp-history__counts {\r\n  color: var(--text-muted);\r\n  font-size: 13px;\r\n  font-weight: 500;\r\n}\r\n.rp-history__counts {\r\n  margin-left: auto;\r\n}\r\n.rp-history__note,\r\n.rp-history__item > .rp-muted {\r\n  margin: 0;\r\n  padding: 0 14px 10px 36px;\r\n  font-size: 13.5px;\r\n}\r\n.rp-history__body {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  padding: 12px 14px 14px;\r\n  border-top: 1px solid var(--divider);\r\n}\r\n.rp-history__roles {\r\n  margin: 0;\r\n  font-size: 13.5px;\r\n}\r\n\r\n/* ── Impatto e conferma ─────────────────────────────────────────────────────────────────── */\r\n.rp-impact__table td {\r\n  vertical-align: top;\r\n  min-width: 140px;\r\n}\r\n.rp-confirm-summary {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n}\r\n.rp-confirm-summary__line {\r\n  display: block;\r\n}\r\n.rp-confirm-summary__warning {\r\n  padding: 6px 10px;\r\n  border-radius: var(--radius-sm);\r\n  background: var(--amber-bg);\r\n  color: color-mix(in srgb, var(--amber) 65%, black);\r\n}\r\n\r\n/* ── Barra modifiche ────────────────────────────────────────────────────────────────────── */\r\n.rp-changebar {\r\n  position: sticky;\r\n  bottom: 0;\r\n  z-index: 20;\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 12px;\r\n  margin: 0 calc(var(--gutter, 20px) * -1);\r\n  padding: 12px var(--gutter, 20px);\r\n  border-top: 2px solid var(--blue);\r\n  background: var(--surface);\r\n  box-shadow: 0 -6px 18px rgba(16, 32, 54, 0.1);\r\n}\r\n.rp-changebar__count {\r\n  display: flex;\r\n  flex-direction: column;\r\n  font-size: 14px;\r\n  color: var(--text);\r\n}\r\n.rp-changebar__count strong {\r\n  font-size: 18px;\r\n  color: var(--c-primary-active);\r\n}\r\n.rp-changebar__note {\r\n  flex: 1 1 240px;\r\n  min-width: 200px;\r\n}\r\n.rp-changebar__note .form-input {\r\n  width: 100%;\r\n}\r\n.rp-changebar__actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n\r\n@media (max-width: 1023px) {\r\n  .rp-page {\r\n    padding: 0;\r\n  }\r\n  .rp-changebar {\r\n    margin: 0 -14px;\r\n    padding: 10px 14px;\r\n  }\r\n  .rp-matrix__cap-col {\r\n    min-width: 200px;\r\n  }\r\n  .rp-matrix__table tbody th.rp-matrix__cap {\r\n    max-width: 220px;\r\n  }\r\n  .rp-filters__count {\r\n    margin-left: 0;\r\n  }\r\n  .rp-history__counts {\r\n    margin-left: 0;\r\n  }\r\n}\r\n\r\n/* Views (L3) and the reload action share one row: no empty action row above the tabs. */\r\n.rp-tabs-row {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  flex-wrap: wrap;\r\n}\r\n"]],[[13,30]],["BODY",{},[[13,31]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},[[2,2]],["DIV",{"class":"main-area-clean"},["DIV",{"class":"compact-topbar"},[[8,53]],["BUTTON",{"type":"button","class":"topbar-back","aria-label":"Indietro: Pazienti","title":"Torna a Pazienti (Alt+←)"},[[3,5]]],["DIV",{"class":"topbar-title"}],[[8,63]],[[8,79]]],["MAIN",{"class":"page-content content-panel"},["DIV",{"class":"page-loading","role":"status","aria-live":"polite"},["SPAN",{"class":"page-loading__spinner","aria-hidden":"true"}],"Caricamento modulo…"]]]]],[[13,65]],[[13,66]]]],"viewport":{"width":1150,"height":1004},"timestamp":76018.536,"wallTime":1792890303032,"collectionTime":2,"resourceOverrides":[],"isMainFrame":true}}
