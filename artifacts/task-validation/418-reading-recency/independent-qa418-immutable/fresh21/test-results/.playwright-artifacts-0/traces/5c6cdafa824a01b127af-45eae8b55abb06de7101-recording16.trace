{"type":"frame-snapshot","snapshot":{"callId":"call@16156","snapshotName":"input@call@16156","pageId":"page@7bae6b9dd7e5947c0c75684c6a58f975","frameId":"frame@1a2dddf9cdbd20ea36ab8c51f62852d2","frameUrl":"http://127.0.0.1:7483/#/pazienti","doctype":"html","html":["HTML",{"lang":"it"},["HEAD",{},[[12,0]],[[12,1]],[[12,2]],[[12,3]],[[12,4]],[[12,5]],[[12,6]],[[12,7]],[[12,8]],[[12,9]],[[12,10]],[[12,11]],[[12,12]],[[12,13]],[[12,15]],[[12,16]],[[12,18]],[[12,20]],[[12,22]],[[12,24]],[[12,26]],[[12,28]],[[9,1]],[[9,3]],[[9,5]],[[9,7]],[[9,9]],[[9,11]],[[9,13]],[[9,15]],[[9,17]],[[9,19]],[[9,21]],[[9,23]],[[9,25]],[[9,27]],[[9,29]],[[8,1]],[[8,3]],[[8,5]],[[8,7]],[[8,9]],[[8,11]],[[8,13]],[[8,15]],[[8,17]],[[8,19]],[[8,21]],[[8,23]],[[8,25]],[[8,27]],[[5,1]],[[5,3]],["STYLE",{},".patient-combobox {\r\n  position: relative;\r\n  min-width: 0;\r\n}\r\n\r\n.patient-combobox__control {\r\n  position: relative;\r\n}\r\n\r\n.patient-combobox__search-icon {\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 12px;\r\n  z-index: 1;\r\n  width: 18px;\r\n  height: 18px;\r\n  color: var(--text-muted);\r\n  pointer-events: none;\r\n  transform: translateY(-50%);\r\n}\r\n\r\n.patient-combobox__search-icon svg,\r\n.patient-combobox__clear svg {\r\n  width: 18px;\r\n  height: 18px;\r\n}\r\n\r\n.patient-combobox .patient-combobox__input {\r\n  min-width: 0;\r\n  width: 100%;\r\n  padding-right: 46px;\r\n  padding-left: 40px;\r\n}\r\n\r\n.patient-combobox__clear {\r\n  position: absolute;\r\n  top: 50%;\r\n  right: 4px;\r\n  display: grid;\r\n  width: 44px;\r\n  height: 44px;\r\n  padding: 0;\r\n  border: 0;\r\n  border-radius: 7px;\r\n  color: var(--text-muted);\r\n  background: transparent;\r\n  cursor: pointer;\r\n  place-items: center;\r\n  transform: translateY(-50%);\r\n}\r\n\r\n.patient-combobox__clear:hover,\r\n.patient-combobox__clear:focus-visible {\r\n  color: var(--blue);\r\n  background: var(--blue-dim);\r\n}\r\n\r\n.patient-combobox__help {\r\n  margin: 5px 0 0;\r\n  color: var(--text-muted);\r\n  font-size: 11.5px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.patient-combobox__selection {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 9px;\r\n  min-width: 0;\r\n  margin-top: 8px;\r\n  padding: 9px 11px;\r\n  border: 1px solid color-mix(in srgb, var(--emerald) 28%, var(--border));\r\n  border-radius: 8px;\r\n  color: var(--text);\r\n  background: var(--emerald-bg);\r\n}\r\n\r\n.patient-combobox__selection-icon {\r\n  display: grid;\r\n  width: 26px;\r\n  height: 26px;\r\n  flex: 0 0 26px;\r\n  border-radius: 50%;\r\n  color: var(--emerald);\r\n  background: var(--surface);\r\n  place-items: center;\r\n}\r\n\r\n.patient-combobox__selection-icon svg {\r\n  width: 15px;\r\n  height: 15px;\r\n}\r\n\r\n.patient-combobox__popup {\r\n  position: absolute;\r\n  top: calc(100% + 6px);\r\n  left: 0;\r\n  right: 0;\r\n  z-index: 250;\r\n  overflow: hidden;\r\n  border: 1px solid var(--border-strong, var(--border));\r\n  border-radius: 9px;\r\n  background: var(--surface);\r\n  box-shadow: 0 12px 30px rgba(20, 39, 72, 0.16);\r\n}\r\n\r\n.patient-combobox__list {\r\n  max-height: min(320px, 40vh);\r\n  margin: 0;\r\n  padding: 4px;\r\n  overflow-y: auto;\r\n  list-style: none;\r\n}\r\n\r\n.patient-combobox__option {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr);\r\n  gap: 12px;\r\n  align-items: center;\r\n  min-height: 52px;\r\n  padding: 8px 10px;\r\n  border-radius: 7px;\r\n  cursor: pointer;\r\n}\r\n\r\n.patient-combobox__option.is-active,\r\n.patient-combobox__option:hover {\r\n  background: var(--blue-dim);\r\n  box-shadow: inset 3px 0 0 var(--blue);\r\n}\r\n\r\n.patient-combobox__option-name {\r\n  overflow: hidden;\r\n  color: var(--text);\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.patient-combobox__option-identity {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-end;\r\n  color: var(--text-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 10.5px;\r\n  line-height: 1.35;\r\n}\r\n\r\n.patient-combobox__option-identity strong {\r\n  color: var(--text);\r\n  font-size: 11px;\r\n}\r\n\r\n.patient-combobox__status {\r\n  margin: 0;\r\n  padding: 13px 14px;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n}\r\n\r\n.patient-combobox__status--error {\r\n  color: var(--red);\r\n}\r\n\r\n@media (max-width: 520px) {\r\n  .patient-combobox__option {\r\n    grid-template-columns: 1fr;\r\n    gap: 3px;\r\n  }\r\n\r\n  .patient-combobox__option-identity {\r\n    align-items: flex-start;\r\n  }\r\n}\r\n"],["STYLE",{},".tdose-list {\r\n  list-style: none;\r\n  margin: 6px 0 0;\r\n  padding: 0;\r\n  display: grid;\r\n  gap: 4px;\r\n  text-align: left;\r\n}\r\n.tdose {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1px;\r\n  padding: 3px 6px;\r\n  border-left: 3px solid var(--blue);\r\n  border-radius: 4px;\r\n  background: var(--surface, #fff);\r\n  font-size: 11.5px;\r\n  line-height: 1.35;\r\n  overflow-wrap: anywhere;\r\n}\r\n.tdose__who {\r\n  font-weight: 650;\r\n  color: var(--text);\r\n}\r\n.tdose__what {\r\n  color: var(--text);\r\n}\r\n.tdose__status {\r\n  font-weight: 600;\r\n  color: #1d4fc4;\r\n}\r\n.tdose--late,\r\n.tdose--missed {\r\n  border-left-color: var(--red);\r\n}\r\n.tdose--late .tdose__status,\r\n.tdose--missed .tdose__status {\r\n  color: #a5202f;\r\n}\r\n.tdose--done {\r\n  border-left-color: #16a37b;\r\n}\r\n.tdose--done .tdose__status {\r\n  color: #0e7a55;\r\n}\r\n.tdose-list__partial {\r\n  margin: 4px 0 0;\r\n  font-size: 11.5px;\r\n  color: var(--text-muted);\r\n}\r\n"],["STYLE",{},".therapy-modal .therapy-modal__body {\r\n  min-height: 0;\r\n  padding-top: 0;\r\n  scroll-padding-block: 160px 16px;\r\n}\r\n.therapy-modal .therapy-patient-group {\r\n  min-width: 0;\r\n  margin-bottom: 18px;\r\n  border: 1px solid var(--border, #dce3ec);\r\n  border-radius: 8px;\r\n  background: var(--surface, #fff);\r\n}\r\n.therapy-modal .therapy-patient-header {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 2;\r\n  margin: 0;\r\n  padding: 12px 16px;\r\n  border-top: 0;\r\n  border-bottom: 2px solid var(--border, #dce3ec);\r\n  border-radius: 7px 7px 0 0;\r\n  background: var(--surface, #fff);\r\n  box-shadow: 0 3px 5px rgb(26 51 87 / 8%);\r\n}\r\n.therapy-modal .patient-identity__name {\r\n  font-size: 18px;\r\n  font-weight: 750;\r\n}\r\n.therapy-modal .therapy-drug-row {\r\n  padding-block: 12px;\r\n  flex-wrap: wrap;\r\n}\r\n.therapy-modal .therapy-drug-row__info {\r\n  min-width: 0;\r\n  flex-basis: 180px;\r\n  overflow-wrap: anywhere;\r\n}\r\n.therapy-modal .therapy-drug-row__actions {\r\n  flex-wrap: wrap;\r\n  min-width: 0;\r\n  max-width: 100%;\r\n}\r\n.therapy-modal button,\r\n.therapy-modal input {\r\n  min-height: 44px;\r\n}\r\n.therapy-modal button {\r\n  white-space: normal;\r\n  overflow-wrap: anywhere;\r\n}\r\n.therapy-modal button:focus-visible,\r\n.therapy-modal input:focus-visible {\r\n  outline: 2px solid var(--blue, #2463eb);\r\n  outline-offset: 3px;\r\n}\r\n.therapy-modal .therapy-modal__footer,\r\n.therapy-modal .therapy-modal__footer > div {\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n@media (max-width: 520px) {\r\n  .therapy-modal .therapy-modal__body {\r\n    padding: 0 8px 8px;\r\n  }\r\n  .therapy-modal .therapy-patient-header,\r\n  .therapy-modal .therapy-drug-row {\r\n    padding-inline: 12px;\r\n  }\r\n  .therapy-modal .therapy-drug-row__actions {\r\n    width: 100%;\r\n  }\r\n  .therapy-modal .therapy-motivi-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Agenda — informazione senza tocchi (UX direct-access, 2026-10-03). Condiviso da agenda\r\n   operatore e multi-operatore: nota sempre visibile, stato in parole (non solo colore), nome\r\n   dell'operatore accanto al pallino, mese senza «+N» (la cella cresce). Testo che va a capo. */\r\n.agt-note-inline {\r\n  white-space: pre-wrap;\r\n  overflow-wrap: anywhere;\r\n  font-size: 13px;\r\n  line-height: 18px;\r\n}\r\n.agt-inline-apt {\r\n  flex-wrap: wrap;\r\n  align-items: flex-start;\r\n  row-gap: 2px;\r\n  height: auto;\r\n}\r\n.agt-inline-apt .agt-week-apt__name,\r\n.agt-inline-apt .agt-month-apt__name {\r\n  white-space: normal;\r\n  overflow: visible;\r\n  text-overflow: clip;\r\n  overflow-wrap: anywhere;\r\n}\r\n.agt-inline-meta {\r\n  flex-basis: 100%;\r\n  min-width: 0;\r\n  font-size: 11px;\r\n  line-height: 15px;\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n}\r\n.agt-inline-meta strong {\r\n  font-weight: 700;\r\n  color: var(--text);\r\n}\r\n/* Mese: la cella mostra tutti gli appuntamenti e cresce in altezza. */\r\n.agt-month-day {\r\n  height: auto;\r\n}\r\n.agt-month-day__apts {\r\n  overflow: visible;\r\n}\r\n"],["STYLE",{},".consegne-page .handover-editor {\r\n  max-width: 1040px;\r\n  margin: 0 auto 20px;\r\n  padding: 0;\r\n  overflow: visible;\r\n  border-radius: 9px;\r\n  box-shadow: 0 1px 4px rgba(20, 39, 72, 0.08);\r\n}\r\n\r\n.handover-editor__header {\r\n  min-height: 68px;\r\n  margin: 0;\r\n  padding: 13px 16px;\r\n  align-items: flex-start;\r\n  border-bottom: 1px solid var(--border);\r\n  border-radius: 9px 9px 0 0;\r\n  background: var(--surface-raised);\r\n}\r\n\r\n.handover-editor__eyebrow,\r\n.handover-editor__section > legend {\r\n  color: var(--text-xmuted);\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  letter-spacing: 0.65px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.handover-editor__eyebrow {\r\n  display: block;\r\n  margin-bottom: 2px;\r\n}\r\n\r\n.handover-editor__intro {\r\n  margin: 3px 0 0;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.handover-editor__body {\r\n  padding: 0 16px;\r\n}\r\n\r\n.handover-editor__section {\r\n  min-width: 0;\r\n  margin: 0;\r\n  padding: 14px 0 16px;\r\n  border: 0;\r\n  border-bottom: 1px solid var(--divider);\r\n}\r\n\r\n.handover-editor__section--last {\r\n  border-bottom: 0;\r\n}\r\n\r\n.handover-editor__section > legend {\r\n  width: 100%;\r\n  padding: 0 0 9px;\r\n}\r\n\r\n.handover-editor__grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(12, minmax(0, 1fr));\r\n  gap: 12px;\r\n}\r\n\r\n.handover-editor__field--patient {\r\n  grid-column: span 7;\r\n  min-width: 0;\r\n}\r\n\r\n.handover-editor__field--assignee {\r\n  grid-column: span 5;\r\n}\r\n\r\n.handover-editor__field--third {\r\n  grid-column: span 3;\r\n}\r\n\r\n.handover-editor .form-field,\r\n.handover-editor .form-input,\r\n.handover-editor .form-select {\r\n  min-width: 0;\r\n}\r\n\r\n.handover-editor .form-input,\r\n.handover-editor .form-select {\r\n  width: 100%;\r\n}\r\n\r\n.handover-editor__optional-label {\r\n  color: var(--text-muted);\r\n  font-size: 10px;\r\n  font-weight: 500;\r\n  text-transform: none;\r\n}\r\n\r\n.handover-editor__notes {\r\n  min-height: 86px;\r\n  resize: vertical;\r\n}\r\n\r\n.handover-editor__counter {\r\n  display: block;\r\n  margin-top: 4px;\r\n  color: var(--text-xmuted);\r\n  font-size: 10.5px;\r\n  text-align: right;\r\n}\r\n\r\n.handover-editor__actions {\r\n  min-height: 62px;\r\n  align-items: center;\r\n  margin: 0;\r\n  padding: 9px 16px;\r\n  border-top: 1px solid var(--border);\r\n  border-radius: 0 0 9px 9px;\r\n  background: var(--surface-raised);\r\n}\r\n\r\n.handover-editor__required-note,\r\n.handover-editor__error {\r\n  margin: 0 auto 0 0;\r\n  font-size: 11px;\r\n}\r\n\r\n.handover-editor__required-note {\r\n  color: var(--text-muted);\r\n}\r\n\r\n.handover-editor__required-note > span {\r\n  color: var(--red);\r\n  font-weight: 700;\r\n}\r\n\r\n.handover-editor__error {\r\n  color: var(--red);\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .handover-editor__grid {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n\r\n  .handover-editor__field--patient {\r\n    grid-column: 1 / -1;\r\n  }\r\n\r\n  .handover-editor__field--assignee,\r\n  .handover-editor__field--third {\r\n    grid-column: span 1;\r\n  }\r\n}\r\n\r\n@media (max-width: 639px) {\r\n  .handover-editor__header,\r\n  .handover-editor__body,\r\n  .handover-editor__actions {\r\n    padding-right: 12px;\r\n    padding-left: 12px;\r\n  }\r\n\r\n  .handover-editor__intro {\r\n    max-width: 34ch;\r\n  }\r\n\r\n  .handover-editor__grid {\r\n    grid-template-columns: minmax(0, 1fr);\r\n    gap: 10px;\r\n  }\r\n\r\n  .handover-editor__field--patient,\r\n  .handover-editor__field--assignee,\r\n  .handover-editor__field--third {\r\n    grid-column: 1;\r\n  }\r\n\r\n  .handover-editor__actions {\r\n    flex-wrap: wrap;\r\n  }\r\n\r\n  .handover-editor__required-note,\r\n  .handover-editor__error {\r\n    width: 100%;\r\n  }\r\n\r\n  .handover-editor__actions .btn-secondary,\r\n  .handover-editor__actions .btn-success {\r\n    min-height: 44px;\r\n    flex: 1;\r\n    justify-content: center;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Diario terapia: pannello \"Valida terapia\" dentro il modulo di nuova voce del diario.\r\n   Solo layout e superfici del pannello: l'aspetto dei controlli (ds-btn, ds-badge, ds-link) lo\r\n   decide design-system.css. */\r\n\r\n.diary-therapy {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n  padding: 16px;\r\n  border: 2px solid var(--border, #e6ebf2);\r\n  border-radius: 16px;\r\n  background: var(--surface, #fff);\r\n}\r\n\r\n.diary-therapy__head h3 {\r\n  margin: 0 0 4px;\r\n  font-size: 1rem;\r\n  font-weight: 600;\r\n  color: var(--text-primary, #16202e);\r\n}\r\n.diary-therapy__head p {\r\n  margin: 0;\r\n}\r\n\r\n.diary-therapy__source {\r\n  margin: 0;\r\n  min-width: 0;\r\n}\r\n.diary-therapy__source blockquote {\r\n  margin: 4px 0 0;\r\n  padding: 12px 16px;\r\n  border-left: 4px solid var(--blue, #2f6bed);\r\n  border-radius: 8px;\r\n  background: var(--bg, #eef1f6);\r\n  color: var(--text-primary, #16202e);\r\n  white-space: pre-wrap;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.diary-therapy__notices {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  margin: 0;\r\n  padding: 0;\r\n  list-style: none;\r\n}\r\n.diary-therapy__notices li {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px;\r\n  min-width: 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.diary-therapy__intent {\r\n  padding: 12px 16px;\r\n  border-radius: 12px;\r\n  background: var(--amber-bg, #fdf3e2);\r\n  color: var(--text-primary, #16202e);\r\n}\r\n.diary-therapy__intent p {\r\n  margin: 0;\r\n}\r\n.diary-therapy__intent p + p {\r\n  margin-top: 4px;\r\n}\r\n\r\n.diary-therapy__alert {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px 12px;\r\n  padding: 8px 12px;\r\n  border-radius: 8px;\r\n  background: var(--red-bg, #fdecee);\r\n  color: var(--red, #d93a4a);\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.diary-therapy__actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  justify-content: flex-end;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n.diary-therapy__blockers {\r\n  flex: 1 1 100%;\r\n  margin: 0;\r\n  padding-left: 20px;\r\n  color: var(--text-secondary, #5a6b80);\r\n  font-size: 0.875rem;\r\n}\r\n\r\n/* Riga \"Terapia aggiunta: FARMACO — apri\" nella card della voce */\r\n.diario-card__therapy {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 4px 8px;\r\n  margin-top: 8px;\r\n  min-width: 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n/* Il modulo della voce ha tre azioni: su schermi stretti vanno a capo invece di uscire */\r\n.cr-inline-form__actions.diario-form__actions {\r\n  flex-wrap: wrap;\r\n}\r\n\r\n@media (max-width: 600px) {\r\n  .diary-therapy {\r\n    padding: 12px;\r\n  }\r\n  .diary-therapy__actions > button {\r\n    flex: 1 1 auto;\r\n  }\r\n}\r\n\r\n/* Campi che l'interprete non ha letto dal testo: da compilare a mano. */\r\n.diary-therapy__unread {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px;\r\n  font-size: 14px;\r\n}\r\n"],["STYLE",{},"/* UX2 W8 — urgenze del diario: evidenza della voce che CHI legge può prendere in carico\r\n   («Ho capito», components/shared/UrgencyNotice). Rosso solo per l'allerta clinica attiva. */\r\n.diario-card--to-see {\r\n  box-shadow:\r\n    0 0 0 2px rgba(217, 58, 74, 0.18),\r\n    var(--shadow-card);\r\n}\r\n.diario-to-see {\r\n  margin: 0 0 12px;\r\n  font: 600 14px/20px var(--font-ui);\r\n  color: var(--red);\r\n}\r\n.diario-ack-error { margin: 0 0 12px; padding: 12px 16px; border: 1px solid #efc3cb; border-radius: 12px; background: #fdecee; color: #b42335; font-size: 14px; line-height: 1.5; }\r\n"],["STYLE",{},".diary-thread {\r\n  margin: 14px 0 0 12px;\r\n  padding: 0 0 0 16px;\r\n  border-left: 2px solid #cdd8e8;\r\n  display: grid;\r\n  gap: 10px;\r\n  min-width: 0;\r\n}\r\n.diary-thread__reply {\r\n  position: relative;\r\n  padding: 12px 14px;\r\n  border: 1px solid #d8e3f1;\r\n  border-radius: 0 12px 12px 12px;\r\n  background: #f4f8fd;\r\n  color: #263e5e;\r\n  font-size: 13px;\r\n  line-height: 1.5;\r\n  overflow-wrap: anywhere;\r\n}\r\n.diary-thread__reply::before {\r\n  content: '';\r\n  position: absolute;\r\n  left: -18px;\r\n  top: 18px;\r\n  width: 16px;\r\n  border-top: 2px solid #cdd8e8;\r\n}\r\n.diary-thread__head {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: baseline;\r\n  gap: 4px 12px;\r\n}\r\n.diary-thread__head time {\r\n  color: #536782;\r\n  font-size: 12px;\r\n}\r\n.diary-thread__message {\r\n  margin: 5px 0;\r\n}\r\n.diary-thread__reply small {\r\n  display: block;\r\n  color: #536782;\r\n  font-size: 12px;\r\n}\r\n.diary-thread--active > .diary-thread__reply {\r\n  border-color: #efc3cb;\r\n  background: #fff7f8;\r\n}\r\n.diary-thread--active > .diary-thread__reply > strong {\r\n  color: #b42335;\r\n}\r\n.diary-thread .urgency-notice {\r\n  margin-top: 6px;\r\n  padding-top: 0;\r\n  border-top: 0;\r\n}\r\n.diary-thread__reply--personal {\r\n  background: #f8fafc;\r\n}\r\n.patient-record-view .diario-card__author {\r\n  margin: 8px 0 4px;\r\n}\r\n.diary-thread.diary-thread--reading {\r\n  margin: 14px 0 0;\r\n  padding: 0;\r\n  border: 0;\r\n}\r\n.diary-thread--reading > .diary-thread__reply {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  flex-wrap: wrap;\r\n  gap: 8px 16px;\r\n  padding: 10px 0 0;\r\n  border: 0;\r\n  border-top: 1px solid var(--border, #d8e3f1);\r\n  border-radius: 0;\r\n  background: transparent;\r\n}\r\n.diary-thread--reading > .diary-thread__reply::before {\r\n  display: none;\r\n}\r\n.diary-thread__status {\r\n  flex: 1 1 220px;\r\n  min-width: 0;\r\n}\r\n.diary-thread--reading .diary-thread__message {\r\n  margin: 2px 0 0;\r\n  color: #536782;\r\n}\r\n.diary-thread--reading .btn-sm {\r\n  min-height: 40px;\r\n  padding: 6px 14px;\r\n  flex: 0 0 auto;\r\n}\r\n@media (max-width: 600px) {\r\n  .diary-thread {\r\n    margin-left: 0;\r\n    padding-left: 12px;\r\n  }\r\n  .diary-thread__reply {\r\n    padding: 10px;\r\n  }\r\n  .diary-thread__reply::before {\r\n    left: -14px;\r\n    width: 12px;\r\n  }\r\n}\r\n"],["STYLE",{},".therapy-calendar-grid {\r\n  overflow: auto;\r\n  max-height: 580px;\r\n  border: 1px solid var(--border-color, #dbe3f0);\r\n  border-radius: 12px;\r\n  scrollbar-gutter: stable;\r\n}\r\n.therapy-calendar-grid table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n  table-layout: fixed;\r\n}\r\n.therapy-calendar-grid th,\r\n.therapy-calendar-grid td {\r\n  border-bottom: 1px solid var(--border-color, #dbe3f0);\r\n  padding: 6px;\r\n  vertical-align: top;\r\n  text-align: left;\r\n}\r\n.therapy-calendar-grid th:first-child {\r\n  width: 64px;\r\n  font-size: 12px;\r\n  color: var(--text-secondary, #55708b);\r\n}\r\n.therapy-calendar-grid thead th {\r\n  position: sticky;\r\n  top: 0;\r\n  background: var(--surface, #fff);\r\n  z-index: 1;\r\n  font-size: 12px;\r\n}\r\n.therapy-calendar-grid.is-week table {\r\n  min-width: 760px;\r\n}\r\n.therapy-calendar-grid__empty {\r\n  display: block;\r\n  min-height: 24px;\r\n  color: var(--text-secondary, #55708b);\r\n}\r\n.therapy-calendar-grid__add {\r\n  width: 32px;\r\n  min-width: 32px;\r\n  height: 32px;\r\n  min-height: 32px;\r\n  color: #3269ed;\r\n  background: transparent;\r\n  border: 1px dashed #b9cafa;\r\n  border-radius: 8px;\r\n}\r\n.therapy-calendar-grid__add:focus-visible {\r\n  outline: 3px solid #3269ed;\r\n  outline-offset: 2px;\r\n}\r\n.therapy-calendar-cell {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  width: 100%;\r\n  min-height: 60px;\r\n  padding: 8px;\r\n  border: 1px solid #b9cafa;\r\n  border-left: 4px solid #3269ed;\r\n  border-radius: 8px;\r\n  background: #eef3ff;\r\n  color: #173355;\r\n  text-align: left;\r\n  font: inherit;\r\n  cursor: pointer;\r\n}\r\n.therapy-calendar-cell > svg {\r\n  width: 16px;\r\n  min-width: 16px;\r\n  height: 16px;\r\n}\r\n.therapy-calendar-cell > svg:last-child {\r\n  margin-left: auto;\r\n}\r\n.therapy-calendar-cell__text {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 3px;\r\n  min-width: 0;\r\n  overflow-wrap: anywhere;\r\n  font-size: 12px;\r\n}\r\n.therapy-calendar-cell__text strong {\r\n  font-size: 13px;\r\n}\r\n.therapy-calendar-cell.is-late,\r\n.therapy-calendar-cell.is-missed {\r\n  border-left-color: #cf2c47;\r\n  background: #fff0f3;\r\n}\r\n.therapy-calendar-cell.is-done,\r\n.therapy-calendar-cell.is-administered {\r\n  border-left-color: #008a80;\r\n  background: #e8f6f3;\r\n}\r\n.therapy-calendar-cell.is-focus {\r\n  outline: 2px solid #3269ed;\r\n  outline-offset: 2px;\r\n}\r\n.therapy-calendar-cell:focus-visible {\r\n  outline: 3px solid #3269ed;\r\n  outline-offset: 2px;\r\n}\r\n.therapy-calendar-dialog {\r\n  width: min(850px, calc(100vw - 32px));\r\n  max-width: 850px;\r\n  max-height: 85vh;\r\n  overflow: auto;\r\n  padding: 16px;\r\n}\r\n.therapy-calendar-dialog__head {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  align-items: center;\r\n  margin-bottom: 12px;\r\n}\r\n.therapy-calendar-dialog__head h3 {\r\n  margin: 0;\r\n  font-size: 18px;\r\n}\r\n.therapy-calendar-dialog__patient {\r\n  border-top: 1px solid #dbe3f0;\r\n  padding: 12px 0;\r\n}\r\n.therapy-calendar-dialog__patient-head {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  align-items: center;\r\n}\r\n.therapy-calendar-dialog__patient dl {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));\r\n  gap: 8px;\r\n}\r\n.therapy-calendar-dialog__patient dt {\r\n  font-size: 12px;\r\n  color: #55708b;\r\n}\r\n.therapy-calendar-dialog__patient dd {\r\n  margin: 2px 0 0;\r\n}\r\n@media (max-width: 600px) {\r\n  .therapy-calendar-dialog {\r\n    width: calc(100vw - 24px);\r\n    padding: 12px;\r\n  }\r\n  .therapy-calendar-cell__text strong {\r\n    font-size: 12px;\r\n  }\r\n}\r\n.therapy-calendar-count {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-width: 36px;\r\n  min-height: 36px;\r\n  width: max-content;\r\n  max-width: 100%;\r\n  padding: 4px 8px;\r\n  border: 1px solid #b9cafa;\r\n  border-radius: 8px;\r\n  background: #eef3ff;\r\n  color: #2054b2;\r\n  font: 650 14px/20px var(--ds-font);\r\n  cursor: pointer;\r\n}\r\n.therapy-calendar-count.is-late {\r\n  border-color: #f1b3be;\r\n  background: #fff0f3;\r\n  color: #b71938;\r\n}\r\n.therapy-calendar-count.is-done {\r\n  border-color: #a8d9d0;\r\n  background: #e8f6f3;\r\n  color: #006d62;\r\n}\r\n.therapy-calendar-count.is-missed {\r\n  border-color: #e5cd97;\r\n  background: #fff6e5;\r\n  color: #855600;\r\n}\r\n.therapy-calendar-count.is-unknown {\r\n  border-style: dashed;\r\n  background: #f4f6fa;\r\n  color: #55708b;\r\n}\r\n.therapy-calendar-count:focus-visible {\r\n  outline: 3px solid #3269ed;\r\n  outline-offset: 2px;\r\n}\r\n.therapy-calendar-legend {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px 16px;\r\n  font-size: 12px;\r\n  color: var(--text-secondary, #55708b);\r\n}\r\n.therapy-calendar-legend > span {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 5px;\r\n}\r\n.therapy-calendar-legend > span:before {\r\n  content: '';\r\n  width: 8px;\r\n  height: 8px;\r\n  border-radius: 50%;\r\n  background: #3269ed;\r\n}\r\n.therapy-calendar-legend > .therapy-calendar-legend__count:before {\r\n  display: none;\r\n}\r\n.therapy-calendar-legend > .is-late:before {\r\n  background: #cf2c47;\r\n}\r\n.therapy-calendar-legend > .is-done:before {\r\n  background: #008a80;\r\n}\r\n.therapy-calendar-legend > .is-missed:before {\r\n  background: #b87800;\r\n}\r\n.therapy-calendar-dialog__search {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  font-size: 12px;\r\n  margin-bottom: 12px;\r\n}\r\n.therapy-calendar-dialog__search input {\r\n  width: 100%;\r\n  max-width: 320px;\r\n}\r\n@media (pointer: coarse) {\r\n  .therapy-calendar-count {\r\n    min-width: 40px;\r\n    min-height: 40px;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Ward details: the title and search stay visible while only the doses scroll. */\r\n.modal-overlay:has(> .therapy-calendar-dialog--ward) {\r\n  z-index: 1300;\r\n  align-items: center;\r\n  padding: 12px;\r\n}\r\n.therapy-calendar-dialog.therapy-calendar-dialog--ward {\r\n  display: flex;\r\n  flex-direction: column;\r\n  width: min(820px, calc(100vw - 32px));\r\n  max-height: min(85vh, 820px);\r\n  padding: 0;\r\n  overflow: hidden;\r\n  background: var(--surface, #fff);\r\n}\r\n.therapy-calendar-dialog--ward .therapy-calendar-dialog__head {\r\n  flex-shrink: 0;\r\n  gap: 12px;\r\n  margin: 0;\r\n  padding: 12px 16px;\r\n  border-bottom: 1px solid var(--border, #dbe3f0);\r\n}\r\n.therapy-calendar-dialog--ward .therapy-calendar-dialog__date {\r\n  margin: 2px 0 0;\r\n  font-size: 12px;\r\n  color: var(--text-muted, #55708b);\r\n}\r\n.therapy-calendar-dialog__controls {\r\n  flex-shrink: 0;\r\n  padding: 8px 16px;\r\n  background: var(--surface-secondary, #f5f7fb);\r\n  border-bottom: 1px solid var(--border, #dbe3f0);\r\n}\r\n.therapy-calendar-dialog__controls > p {\r\n  margin: 0 0 6px;\r\n  font-size: 12px;\r\n}\r\n.therapy-calendar-dialog__controls > p:last-child {\r\n  margin: 0;\r\n}\r\n.therapy-calendar-dialog__controls > [role='alert'] {\r\n  color: #b71938;\r\n}\r\n.therapy-calendar-dialog__controls > [role='status'] > button {\r\n  margin: 4px 0 0 8px;\r\n}\r\n.therapy-calendar-dialog--ward .therapy-calendar-dialog__search {\r\n  margin: 0 0 6px;\r\n}\r\n.therapy-calendar-dialog--ward .therapy-calendar-dialog__search input {\r\n  max-width: none;\r\n}\r\n.therapy-calendar-dialog__count {\r\n  color: var(--text-muted, #55708b);\r\n}\r\n.therapy-calendar-dialog__body {\r\n  min-height: 0;\r\n  overflow-y: auto;\r\n  overscroll-behavior: contain;\r\n  scrollbar-gutter: stable;\r\n  padding: 12px 16px;\r\n}\r\n.therapy-calendar-dialog__body:focus-visible {\r\n  outline: 2px solid #3269ed;\r\n  outline-offset: -2px;\r\n}\r\n.therapy-calendar-dialog--ward .therapy-calendar-dialog__patient {\r\n  padding: 0;\r\n  margin: 0 0 10px;\r\n  border: 1px solid var(--border, #dbe3f0);\r\n  border-radius: 8px;\r\n  overflow: hidden;\r\n}\r\n.therapy-calendar-dialog--ward .therapy-calendar-dialog__patient:last-child {\r\n  margin-bottom: 0;\r\n}\r\n.therapy-calendar-dialog--ward .therapy-calendar-dialog__patient-head {\r\n  padding: 6px 10px;\r\n  background: var(--surface-secondary, #f5f7fb);\r\n  border-bottom: 1px solid var(--border, #dbe3f0);\r\n  font-size: 13px;\r\n}\r\n.therapy-calendar-dialog--ward .therapy-calendar-dialog__patient-head > strong {\r\n  min-width: 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n.therapy-calendar-dialog--ward .therapy-calendar-dialog__patient-head > button {\r\n  flex-shrink: 0;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n}\r\n.therapy-calendar-dialog__patient-head > button svg {\r\n  width: 16px;\r\n  height: 16px;\r\n}\r\n.therapy-calendar-dialog__dose {\r\n  padding: 8px 10px;\r\n  border-left: 3px solid #3269ed;\r\n}\r\n.therapy-calendar-dialog__dose + .therapy-calendar-dialog__dose {\r\n  border-top: 1px solid var(--border, #dbe3f0);\r\n}\r\n.therapy-calendar-dialog__dose.is-late {\r\n  border-left-color: #c42b46;\r\n}\r\n.therapy-calendar-dialog__dose.is-done {\r\n  border-left-color: #008a80;\r\n}\r\n.therapy-calendar-dialog__dose.is-missed {\r\n  border-left-color: #b87800;\r\n}\r\n.therapy-calendar-dialog--ward .therapy-calendar-dialog__patient dl {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1.5fr) minmax(70px, 0.55fr) minmax(0, 1fr);\r\n  align-items: start;\r\n  gap: 8px 16px;\r\n  margin: 0;\r\n  font-size: 13px;\r\n  line-height: 18px;\r\n  overflow-wrap: anywhere;\r\n}\r\n.therapy-calendar-dialog--ward .therapy-calendar-dialog__drug dt {\r\n  font-size: 13px;\r\n  font-weight: 650;\r\n  color: var(--text-primary, #173355);\r\n}\r\n.therapy-calendar-dialog--ward .therapy-calendar-dialog__drug dd {\r\n  color: var(--text-muted, #55708b);\r\n}\r\n.therapy-calendar-dialog__status {\r\n  display: inline-block;\r\n  padding: 2px 6px;\r\n  border-radius: 5px;\r\n  font-size: 12px;\r\n  line-height: 16px;\r\n  background: #eef3ff;\r\n  color: #2054b2;\r\n}\r\n.therapy-calendar-dialog__status.is-late {\r\n  background: #fff0f3;\r\n  color: #b71938;\r\n}\r\n.therapy-calendar-dialog__status.is-done {\r\n  background: #e8f6f3;\r\n  color: #006d62;\r\n}\r\n.therapy-calendar-dialog__status.is-missed {\r\n  background: #fff6e5;\r\n  color: #855600;\r\n}\r\n@media (max-width: 600px) {\r\n  .therapy-calendar-dialog.therapy-calendar-dialog--ward {\r\n    width: calc(100vw - 24px);\r\n    max-height: 90dvh;\r\n  }\r\n  .therapy-calendar-dialog--ward .therapy-calendar-dialog__head,\r\n  .therapy-calendar-dialog__controls,\r\n  .therapy-calendar-dialog__body {\r\n    padding: 10px 12px;\r\n  }\r\n  .therapy-calendar-dialog--ward .therapy-calendar-dialog__patient dl {\r\n    grid-template-columns: minmax(0, 0.65fr) minmax(0, 1fr);\r\n    gap: 6px 12px;\r\n  }\r\n  .therapy-calendar-dialog__drug {\r\n    grid-column: 1 / -1;\r\n  }\r\n  .therapy-calendar-dialog--ward .therapy-calendar-dialog__patient-head > button > span {\r\n    display: none;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Calendario del giro terapia (settimana × fasce). Controlli e colori dai token del design system. */\r\n.tcal {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.tcal__note {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px 16px;\r\n  margin: 0;\r\n  padding: 12px 16px;\r\n  border-radius: 12px;\r\n  background: var(--ds-surface-2);\r\n  color: var(--ds-text);\r\n  font: 400 14px/20px var(--ds-font);\r\n}\r\n.tcal__scroll {\r\n  overflow-x: auto;\r\n  border: 1px solid var(--ds-border);\r\n  border-radius: var(--ds-card-radius);\r\n  background: var(--ds-surface);\r\n}\r\n.tcal__table {\r\n  width: 100%;\r\n  min-width: 640px;\r\n  border-collapse: collapse;\r\n  table-layout: fixed;\r\n}\r\n.tcal__table th,\r\n.tcal__table td {\r\n  padding: 8px;\r\n  border-bottom: 1px solid var(--ds-border);\r\n  text-align: center;\r\n}\r\n.tcal__corner,\r\n.tcal__fascia {\r\n  width: 72px;\r\n}\r\n.tcal__fascia {\r\n  font: 600 16px/24px var(--ds-font);\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--ds-text);\r\n  text-align: left;\r\n}\r\n.tcal__day {\r\n  font: 400 14px/20px var(--ds-font);\r\n  color: var(--ds-text-muted);\r\n}\r\n.tcal__weekday {\r\n  display: block;\r\n  text-transform: capitalize;\r\n}\r\n.tcal__date {\r\n  display: block;\r\n  font-weight: 600;\r\n  color: var(--ds-text);\r\n}\r\n.tcal__day--today {\r\n  background: var(--ds-blue-tint);\r\n  color: var(--ds-blue-active);\r\n}\r\n.tcal__day--today .tcal__date {\r\n  color: var(--ds-blue-active);\r\n}\r\n.tcal__cell {\r\n  height: 72px;\r\n}\r\n.tcal__none,\r\n.tcal__cell--wait {\r\n  color: var(--ds-text-muted);\r\n}\r\n/* La cella è un pulsante di griglia (componente dichiarato), non una chip. */\r\n.tcal__btn {\r\n  box-sizing: border-box;\r\n  width: 100%;\r\n  min-height: 56px;\r\n  padding: 4px;\r\n  border: var(--ds-border-w) solid var(--ds-border);\r\n  border-radius: var(--ds-radius);\r\n  background: var(--ds-surface);\r\n  color: var(--ds-text);\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 2px;\r\n  cursor: pointer;\r\n}\r\n.tcal__btn:hover {\r\n  border-color: var(--ds-blue);\r\n}\r\n.tcal__btn:focus-visible {\r\n  outline: var(--ds-focus);\r\n  outline-offset: 2px;\r\n}\r\n.tcal__count {\r\n  font: 600 16px/24px var(--ds-font);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.tcal__hint {\r\n  font: 400 12px/16px var(--ds-font);\r\n}\r\n.tcal__btn--completa {\r\n  background: var(--emerald-bg);\r\n  border-color: var(--emerald);\r\n  color: color-mix(in srgb, var(--emerald) 65%, black);\r\n}\r\n.tcal__btn--da-fare {\r\n  background: var(--ds-blue-tint);\r\n  border-color: var(--ds-blue);\r\n  color: var(--ds-blue-active);\r\n}\r\n.tcal__btn--mancanti {\r\n  background: var(--amber-bg);\r\n  border-color: var(--amber);\r\n  color: color-mix(in srgb, var(--amber) 70%, black);\r\n}\r\n/* Totali non esatti (pageInfo.summaryExact falso): nessun colore di stato, solo il dato parziale. */\r\n.tcal__btn--parziale {\r\n  background: var(--ds-surface-2);\r\n  border-style: dashed;\r\n  color: var(--ds-text);\r\n}\r\n/* La colonna delle ore resta ferma mentre i giorni scorrono (telefono). */\r\n.tcal__corner,\r\n.tcal__fascia {\r\n  position: sticky;\r\n  left: 0;\r\n  z-index: 1;\r\n  background: var(--ds-surface);\r\n}\r\n/* UX 2026-10-03: la cella elenca le dosi (paziente · farmaco · dose · stato) e cresce in altezza. */\r\n.tcal__cell {\r\n  vertical-align: top;\r\n  height: auto;\r\n}\r\n/* Su tablet verticale e telefono: un blocco per giorno invece della griglia a 7 colonne. */\r\n.tcal__stack {\r\n  display: none;\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  gap: 12px;\r\n}\r\n@media (max-width: 1099px) {\r\n  .tcal__scroll {\r\n    display: none;\r\n  }\r\n  .tcal__stack {\r\n    display: grid;\r\n  }\r\n}\r\n.tcal__stack-day {\r\n  padding: 12px;\r\n  border: 1px solid var(--ds-border);\r\n  border-radius: var(--ds-card-radius);\r\n  background: var(--ds-surface);\r\n}\r\n.tcal__stack-day.is-today {\r\n  border-color: var(--ds-blue);\r\n}\r\n.tcal__stack-head {\r\n  margin: 0 0 8px;\r\n  font: 600 15px/22px var(--ds-font);\r\n  text-transform: capitalize;\r\n}\r\n.tcal__stack-fascia + .tcal__stack-fascia {\r\n  margin-top: 10px;\r\n}\r\n.tcal__stack-open {\r\n  min-height: 44px;\r\n  padding: 4px 10px;\r\n  border: var(--ds-border-w) solid var(--ds-border);\r\n  border-radius: var(--ds-radius);\r\n  background: var(--ds-surface-2);\r\n  color: var(--ds-text);\r\n  font: 500 14px/20px var(--ds-font);\r\n  cursor: pointer;\r\n}\r\n.tcal__stack-open:focus-visible {\r\n  outline: var(--ds-focus);\r\n  outline-offset: 2px;\r\n}\r\n.tcal__none-text {\r\n  margin: 0;\r\n  color: var(--ds-text-muted);\r\n}\r\n"],["STYLE",{},"/* Giro terapia — HMI 1 (artifacts/hmi-parity/proto/terapia.png). */\r\n.giro-allergies {\r\n  margin: 0 16px 12px;\r\n  padding: 12px 16px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 12px;\r\n  background: var(--surface);\r\n  color: var(--text);\r\n  overflow-wrap: anywhere;\r\n  font: 400 14px/20px var(--font-ui);\r\n}\r\n.giro-allergies__status { margin: 0; display: flex; flex-wrap: wrap; gap: 4px 12px; }\r\n.giro-allergies__source { color: var(--text-muted); }\r\n.giro-allergies__list { margin: 8px 0; padding-left: 20px; }\r\n.giro-allergies__details summary {\r\n  cursor: pointer;\r\n  min-height: 44px;\r\n  padding: 12px 0;\r\n  color: var(--text);\r\n  font-weight: 600;\r\n}\r\n.giro-allergies__details summary:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }\r\n.giro-allergies__details p { margin: 4px 0; }\r\n.giro-allergies__documentation { padding: 8px 0; border-top: 1px solid var(--border); }\r\n\r\n.giro-view {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.giro-sr {\r\n  position: absolute;\r\n  width: 1px;\r\n  height: 1px;\r\n  overflow: hidden;\r\n  clip: rect(0 0 0 0);\r\n  white-space: nowrap;\r\n}\r\n\r\n.giro-bar {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 16px;\r\n}\r\n.giro-slots,\r\n.giro-filters,\r\n.giro-reasons {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n\r\n.giro-progress {\r\n  flex: 1 1 200px;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.giro-progress__track {\r\n  flex: 1;\r\n  height: 8px;\r\n  border-radius: 4px;\r\n  background: #e8edf4;\r\n  overflow: hidden;\r\n}\r\n.giro-progress__track i {\r\n  display: block;\r\n  height: 100%;\r\n  background: #16a37b;\r\n}\r\n.giro-progress__count {\r\n  font: 600 16px/24px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.giro-tools {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px 16px;\r\n}\r\n.giro-tools .roster-order {\r\n  margin: 0;\r\n}\r\n.giro-note-box {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px 16px;\r\n  padding: 12px 16px;\r\n  border-radius: 12px;\r\n  background: var(--amber-bg);\r\n  color: #7a4a00;\r\n}\r\n\r\n.giro-rows {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n.giro-row {\r\n  display: grid;\r\n  grid-template-columns: 48px minmax(0, 1fr) minmax(0, 1fr) auto;\r\n  gap: 16px;\r\n  align-items: center;\r\n  padding: 16px;\r\n  border-radius: 16px;\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n}\r\n.giro-row > * {\r\n  min-width: 0;\r\n}\r\n.giro-row--done {\r\n  background: #f5f7fb;\r\n}\r\n.giro-row__bed {\r\n  width: 48px;\r\n  height: 48px;\r\n  border-radius: 12px;\r\n  background: #f5f7fb;\r\n  border: 1px solid var(--border);\r\n  display: grid;\r\n  place-items: center;\r\n  font: 600 18px/24px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--text);\r\n}\r\n.giro-row--done .giro-row__bed {\r\n  background: var(--surface);\r\n}\r\n.giro-row__who,\r\n.giro-row__drug {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n}\r\n.giro-row__name {\r\n  font: 600 16px/24px var(--font-ui);\r\n  color: var(--text);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.giro-row__cap {\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.giro-row__act {\r\n  display: flex;\r\n  gap: 8px;\r\n  justify-content: flex-end;\r\n}\r\n\r\n.giro-badge {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  min-height: 32px;\r\n  padding: 4px 10px;\r\n  border-radius: 8px;\r\n  font: 600 14px/20px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.giro-badge svg {\r\n  width: 16px;\r\n  height: 16px;\r\n}\r\n.giro-badge--ok {\r\n  background: #e6f6ef;\r\n  color: #0e7a55;\r\n}\r\n.giro-badge--warn {\r\n  background: var(--amber-bg);\r\n  color: #8a5300;\r\n}\r\n.giro-badge--due {\r\n  background: #eaf1fe;\r\n  color: #1d4fc4;\r\n}\r\n.giro-row__reasons {\r\n  grid-column: 2 / -1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n}\r\n.giro-note {\r\n  height: 48px;\r\n  max-width: 480px;\r\n}\r\n.giro-reasons__actions {\r\n  display: flex;\r\n  gap: 8px;\r\n}\r\n.giro-empty {\r\n  margin: 0;\r\n  padding: 24px;\r\n  border-radius: 16px;\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  color: var(--text-muted);\r\n}\r\n\r\n/* Telefono: camera + paziente in alto, farmaco sotto, azioni a tutta larghezza. */\r\n@media (max-width: 720px) {\r\n  .giro-row {\r\n    grid-template-columns: 48px minmax(0, 1fr);\r\n    gap: 8px 12px;\r\n  }\r\n  .giro-row__drug,\r\n  .giro-row__act,\r\n  .giro-row__reasons {\r\n    grid-column: 1 / -1;\r\n  }\r\n\r\n  .giro-row__act {\r\n    justify-content: stretch;\r\n  }\r\n  .giro-row__act > .giro-badge {\r\n    margin-right: auto;\r\n  }\r\n}\r\n\r\n.giro-tools__right {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px;\r\n  margin-left: auto;\r\n}\r\n\r\n.giro-row:focus-visible {\r\n  outline: 3px solid #245bb5;\r\n  outline-offset: 2px;\r\n}\r\n\r\n/* Contatori delle fasce allineati: cifre tabellari (solo tipografia numerica, non l'aspetto). */\r\n.giro-slot {\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n@media (max-width: 720px) {\r\n  .giro-row__act > .ds-btn {\r\n    flex: 1;\r\n  }\r\n}\r\n\r\n/* ── Giro per paziente: testata del paziente, sotto i suoi farmaci dell'ora ─────────────────\r\n   Il nome del paziente conserva il carattere di prima (giro-row__name); i farmaci usano un\r\n   carattere diverso e più piccolo, come richiesto. */\r\n.giro-patients {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n}\r\n.giro-patient {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  padding: 16px;\r\n  border-radius: 16px;\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  min-width: 0;\r\n}\r\n.giro-patient--done {\r\n  background: #f5f7fb;\r\n}\r\n.giro-patient--done .giro-row__bed {\r\n  background: var(--surface);\r\n}\r\n.giro-patient__head {\r\n  display: grid;\r\n  grid-template-columns: 48px minmax(0, 1fr);\r\n  gap: 16px;\r\n  align-items: center;\r\n}\r\n.giro-drugs {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0 0 0 64px;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n.giro-drug {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) auto;\r\n  gap: 8px 16px;\r\n  align-items: center;\r\n  padding: 8px 0;\r\n  border-top: 1px solid var(--border);\r\n  min-width: 0;\r\n}\r\n.giro-drug__info {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n}\r\n.giro-drug__name {\r\n  font: 500 14px/20px var(--font-ui);\r\n  color: var(--text);\r\n  overflow-wrap: anywhere;\r\n}\r\n.giro-drug__cap {\r\n  font: 400 13px/18px var(--font-ui);\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n}\r\n.giro-drug--done .giro-drug__name {\r\n  color: var(--text-muted);\r\n}\r\n.giro-drug > .giro-row__reasons {\r\n  grid-column: 1 / -1;\r\n}\r\n.giro-drug:focus-visible {\r\n  outline: 3px solid #245bb5;\r\n  outline-offset: 2px;\r\n}\r\n@media (max-width: 720px) {\r\n  .giro-drugs {\r\n    padding-left: 0;\r\n  }\r\n  .giro-drug {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }\r\n  .giro-drug > .giro-row__act {\r\n    justify-content: stretch;\r\n  }\r\n  .giro-drug > .giro-row__act > .giro-badge {\r\n    margin-right: auto;\r\n  }\r\n  .giro-drug > .giro-row__act > .ds-btn {\r\n    flex: 1;\r\n  }\r\n}\r\n/* In ritardo (UX 2026-10-03): rosso solo per il ritardo, sempre con il testo «In ritardo di N min». */\r\n.giro-badge--late {\r\n  background: #fdecee;\r\n  color: #a5202f;\r\n  font-weight: 600;\r\n}\r\n.giro-feedback {\r\n  margin: 0 0 8px;\r\n  font: 500 13px/18px var(--font-ui);\r\n}\r\n.giro-feedback.is-ok {\r\n  color: var(--green, #1f7a4d);\r\n}\r\n.giro-feedback.is-error {\r\n  color: var(--red);\r\n}\r\n/* Accesso diretto: paziente richiesto evidenziato nel giro. */\r\n.giro-patient.therapy-list-row--focus {\r\n  outline: 3px solid var(--blue);\r\n  outline-offset: 2px;\r\n  border-radius: 12px;\r\n}\r\n"],["STYLE",{},"/* Agenda operatore — HMI 1 (artifacts/hmi-parity/proto/agenda.png). Solo `.agt-view--hmi`:\r\n   le classes agt- sono condivise con l'agenda multi-operatore dell'admin. */\r\n.agt-view--hmi .agt-day-card {\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 16px;\r\n  padding: 24px;\r\n  min-width: 0;\r\n}\r\n.agt-view--hmi .agt-day-card__head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  flex-wrap: wrap;\r\n  padding-bottom: 16px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n.agt-view--hmi .agt-day-card__title {\r\n  margin: 0;\r\n  font: 600 20px/28px var(--font-ui);\r\n  color: var(--text);\r\n}\r\n.agt-view--hmi .agt-day-card__title::first-letter {\r\n  text-transform: uppercase;\r\n}\r\n\r\n.agt-view--hmi .agt-day-wrap {\r\n  overflow: visible;\r\n}\r\n.agt-view--hmi .agt-slot,\r\n.agt-view--hmi .agt-slot--hour,\r\n.agt-view--hmi .agt-slot--half {\r\n  min-height: 56px;\r\n  align-items: center;\r\n  gap: 16px;\r\n  border-bottom: 1px solid var(--border);\r\n  padding: 8px 0;\r\n}\r\n.agt-view--hmi .agt-slot__time {\r\n  width: 72px;\r\n  font: 600 16px/24px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--text);\r\n  align-self: center;\r\n  padding: 0;\r\n}\r\n/* Fascia libera: vuota come nel prototipo, \"+ Disponibile\" al passaggio o al fuoco. */\r\n.agt-view--hmi .agt-free-slot {\r\n  opacity: 0;\r\n  transition: opacity 0.15s;\r\n}\r\n.agt-view--hmi .agt-slot--free:hover .agt-free-slot,\r\n.agt-view--hmi .agt-slot--free:focus-visible .agt-free-slot {\r\n  opacity: 1;\r\n}\r\n.agt-view--hmi .agt-slot--free:focus-visible {\r\n  outline: 3px solid #245bb5;\r\n  outline-offset: -3px;\r\n  border-radius: 8px;\r\n}\r\n.agt-view--hmi .agt-apt-card {\r\n  flex: 1;\r\n  min-width: 0;\r\n  border: 0;\r\n  border-radius: 8px;\r\n  padding: 8px 16px;\r\n  background: #eaf1fe;\r\n}\r\n.agt-view--hmi .agt-apt-card--in_corso,\r\n.agt-view--hmi .agt-apt-card--urgent {\r\n  background: #fdf3e2;\r\n}\r\n.agt-view--hmi .agt-apt-card--completato {\r\n  background: #e6f6ef;\r\n}\r\n.agt-view--hmi .agt-apt-card--annullato {\r\n  background: #eef1f6;\r\n}\r\n.agt-view--hmi .agt-apt-card__row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.agt-view--hmi .agt-apt-card__title {\r\n  font: 600 16px/24px var(--font-ui);\r\n  color: #1d4fc4;\r\n  white-space: nowrap;\r\n}\r\n.agt-view--hmi .agt-apt-card--annullato .agt-apt-card__title {\r\n  color: var(--text-muted);\r\n  text-decoration: line-through;\r\n}\r\n.agt-view--hmi .agt-apt-card__detail {\r\n  flex: 1;\r\n  min-width: 0;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: #1d4fc4;\r\n  overflow: hidden;\r\n  white-space: nowrap;\r\n}\r\n.agt-view--hmi .agt-apt-card__detail .agt-apt-card__patient {\r\n  font: inherit;\r\n  color: inherit;\r\n  padding: 0;\r\n  min-height: 0;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n.agt-view--hmi .agt-apt-card__badges {\r\n  margin-left: auto;\r\n  flex: none;\r\n}\r\n@media (max-width: 600px) {\r\n  .agt-view--hmi .agt-day-card {\r\n    padding: 16px;\r\n  }\r\n  .agt-view--hmi .agt-slot__time {\r\n    width: 52px;\r\n  }\r\n  .agt-view--hmi .agt-apt-card__row {\r\n    flex-wrap: wrap;\r\n    gap: 4px 12px;\r\n  }\r\n  .agt-view--hmi .agt-apt-card__detail {\r\n    order: 3;\r\n    flex-basis: 100%;\r\n  }\r\n}\r\n/* Allineamento al prototipo sopra gli stili storici dell'agenda (app-additions.css). */\r\n.agt-view--hmi .agt-filter-row {\r\n  background: transparent;\r\n  border: 0;\r\n  padding: 0 0 16px;\r\n}\r\n.agt-view--hmi .agt-slot--free,\r\n.agt-view--hmi .agt-slot--half.agt-slot--free {\r\n  background: transparent;\r\n}\r\n.agt-view--hmi .agt-slot--free:hover,\r\n.agt-view--hmi .agt-slot--free:focus-visible {\r\n  background: #f5f7fb;\r\n}\r\n.agt-view--hmi .agt-slot__time,\r\n.agt-view--hmi .agt-slot--half .agt-slot__time {\r\n  padding: 0;\r\n}\r\n.agt-view--hmi .agt-apt-card {\r\n  min-height: 0;\r\n  align-self: center;\r\n  box-shadow: none;\r\n  border-left: 0;\r\n  gap: 8px;\r\n}\r\n.agt-view--hmi .agt-apt-card__detail {\r\n  flex: 0 1 auto;\r\n}\r\n.agt-view--hmi .agt-apt-card__detail .agt-meta-sep {\r\n  color: inherit;\r\n}\r\n.agt-view--hmi .agt-day-wrap,\r\n.agt-view--hmi .agt-slot {\r\n  background: transparent;\r\n  border-left: 0;\r\n}\r\n/* Sottotitolo nell'intestazione: va a capo (settimana/data sempre leggibili, niente «…»). */\r\n.topbar-title .agt-page-subtitle {\r\n  flex-wrap: wrap;\r\n  row-gap: 0;\r\n  column-gap: 6px;\r\n  white-space: normal;\r\n}\r\n.topbar-title .agt-page-subtitle > * {\r\n  flex: 0 1 auto;\r\n  min-width: 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n.agt-view--hmi .agt-day-card__heading {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n}\r\n.agt-view--hmi .agt-day-card__op {\r\n  display: none;\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n@media (max-width: 600px) {\r\n  /* Sul telefono l'intestazione mostra solo la data (a capo se non entra); l'operatore\r\n     passa nella card del giorno. */\r\n  .topbar-title .agt-page-subtitle .agt-op-chip,\r\n  .topbar-title .agt-page-subtitle .agt-page-subtitle__separator,\r\n  .topbar-title .agt-page-subtitle .agt-header__date ~ span {\r\n    display: none;\r\n  }\r\n  .topbar-title .agt-page-subtitle .agt-header__date {\r\n    flex: 0 1 auto;\r\n    min-width: 0;\r\n  }\r\n  .agt-view--hmi .agt-day-card__op {\r\n    display: block;\r\n  }\r\n}\r\n"],["STYLE",{},".notes-page .note-editor {\r\n  max-width: 1040px;\r\n  margin: 0 auto 20px;\r\n  padding: 0;\r\n  overflow: visible;\r\n  border-radius: 9px;\r\n  box-shadow: 0 1px 4px rgba(20, 39, 72, 0.08);\r\n}\r\n\r\n.note-editor__header {\r\n  min-height: 68px;\r\n  margin: 0;\r\n  padding: 13px 16px;\r\n  align-items: flex-start;\r\n  border-bottom: 1px solid var(--border);\r\n  border-radius: 9px 9px 0 0;\r\n  background: var(--surface-raised);\r\n}\r\n\r\n.note-editor__eyebrow,\r\n.note-editor__section > legend {\r\n  color: var(--text-xmuted);\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  letter-spacing: 0.65px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.note-editor__eyebrow {\r\n  display: block;\r\n  margin-bottom: 2px;\r\n}\r\n\r\n.note-editor__intro {\r\n  max-width: 70ch;\r\n  margin: 3px 0 0;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.note-editor__body {\r\n  padding: 0 16px;\r\n}\r\n\r\n.note-editor__section {\r\n  min-width: 0;\r\n  margin: 0;\r\n  padding: 14px 0 16px;\r\n  border: 0;\r\n  border-bottom: 1px solid var(--divider);\r\n}\r\n\r\n.note-editor__section--last {\r\n  border-bottom: 0;\r\n}\r\n\r\n.note-editor__section > legend {\r\n  width: 100%;\r\n  padding: 0 0 9px;\r\n}\r\n\r\n.note-editor__grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(12, minmax(0, 1fr));\r\n  gap: 12px;\r\n  align-items: start;\r\n}\r\n\r\n.note-editor__field--recipient {\r\n  grid-column: span 5;\r\n}\r\n\r\n.note-editor__field--patient {\r\n  grid-column: span 7;\r\n  min-width: 0;\r\n}\r\n\r\n.note-editor__field--priority {\r\n  grid-column: span 3;\r\n}\r\n\r\n.note-editor__field--message {\r\n  grid-column: span 9;\r\n}\r\n\r\n.note-editor .form-field,\r\n.note-editor .form-input,\r\n.note-editor .form-select {\r\n  min-width: 0;\r\n}\r\n\r\n.note-editor .form-input,\r\n.note-editor .form-select {\r\n  width: 100%;\r\n}\r\n\r\n.note-editor__helper {\r\n  display: block;\r\n  margin-top: 5px;\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  line-height: 1.35;\r\n}\r\n\r\n.note-editor__message {\r\n  min-height: 86px;\r\n  resize: vertical;\r\n}\r\n\r\n.note-editor__counter {\r\n  display: block;\r\n  margin-top: 4px;\r\n  color: var(--text-xmuted);\r\n  font-size: 10.5px;\r\n  text-align: right;\r\n}\r\n\r\n.note-editor__actions {\r\n  min-height: 62px;\r\n  align-items: center;\r\n  margin: 0;\r\n  padding: 9px 16px;\r\n  border-top: 1px solid var(--border);\r\n  border-radius: 0 0 9px 9px;\r\n  background: var(--surface-raised);\r\n}\r\n\r\n.note-editor__required-note,\r\n.note-editor__error {\r\n  margin: 0 auto 0 0;\r\n  font-size: 11px;\r\n}\r\n\r\n.note-editor__required-note {\r\n  color: var(--text-muted);\r\n}\r\n\r\n.note-editor__required-note > span {\r\n  color: var(--red);\r\n  font-weight: 700;\r\n}\r\n\r\n.note-editor__error {\r\n  color: var(--red);\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .note-editor__grid {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n\r\n  .note-editor__field--recipient,\r\n  .note-editor__field--priority {\r\n    grid-column: span 1;\r\n  }\r\n\r\n  .note-editor__field--patient,\r\n  .note-editor__field--message {\r\n    grid-column: 1 / -1;\r\n  }\r\n}\r\n\r\n@media (max-width: 639px) {\r\n  .note-editor__header,\r\n  .note-editor__body,\r\n  .note-editor__actions {\r\n    padding-right: 12px;\r\n    padding-left: 12px;\r\n  }\r\n\r\n  .note-editor__intro {\r\n    max-width: 34ch;\r\n  }\r\n\r\n  .note-editor__grid {\r\n    grid-template-columns: minmax(0, 1fr);\r\n    gap: 10px;\r\n  }\r\n\r\n  .note-editor__field--recipient,\r\n  .note-editor__field--patient,\r\n  .note-editor__field--priority,\r\n  .note-editor__field--message {\r\n    grid-column: 1;\r\n  }\r\n\r\n  .note-editor__actions {\r\n    flex-wrap: wrap;\r\n  }\r\n\r\n  .note-editor__required-note,\r\n  .note-editor__error {\r\n    width: 100%;\r\n  }\r\n\r\n  .note-editor__actions .btn-secondary,\r\n  .note-editor__actions .btn-success {\r\n    min-height: 44px;\r\n    flex: 1;\r\n    justify-content: center;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Note e messaggi — HMI 1 (artifacts/hmi-parity/proto/note.png). */\r\n.notes-page--hmi .nm-card {\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 16px;\r\n  padding: 24px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.nm-card__head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  flex-wrap: wrap;\r\n}\r\n.nm-card__title {\r\n  margin: 0;\r\n  font: 600 20px/28px var(--font-ui);\r\n  color: var(--text);\r\n}\r\n\r\n.nm-tools {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px 16px;\r\n}\r\n.nm-search {\r\n  flex: 1 1 280px;\r\n  min-width: 0;\r\n}\r\n.nm-search .search-input {\r\n  height: 48px;\r\n}\r\n\r\n.nm-list {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  border-top: 1px solid var(--border);\r\n}\r\n.nm-row {\r\n  display: grid;\r\n  grid-template-columns: 48px minmax(0, 1fr) auto;\r\n  gap: 16px;\r\n  align-items: start;\r\n  padding: 16px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n.nm-row--done {\r\n  background: #f5f7fb;\r\n}\r\n.nm-avatar {\r\n  width: 48px;\r\n  height: 48px;\r\n  border-radius: 50%;\r\n  background: #eaf1fe;\r\n  color: #1d4fc4;\r\n  display: grid;\r\n  place-items: center;\r\n  font: 600 16px/24px var(--font-ui);\r\n}\r\n.nm-row__body {\r\n  min-width: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n}\r\n.nm-row__meta {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 4px 8px;\r\n  min-width: 0;\r\n}\r\n.nm-dot {\r\n  width: 8px;\r\n  height: 8px;\r\n  border-radius: 50%;\r\n  background: var(--blue);\r\n  flex: none;\r\n}\r\n.nm-author {\r\n  font: 600 16px/24px var(--font-ui);\r\n  color: var(--text);\r\n  overflow-wrap: anywhere;\r\n}\r\n.nm-dest {\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n}\r\n.nm-prio {\r\n  font: 600 13px/18px var(--font-ui);\r\n  padding: 2px 8px;\r\n  border-radius: 6px;\r\n}\r\n/* Urgenza: il rosso resta riservato agli allarmi clinici e ai conteggi. */\r\n.nm-prio--urgente {\r\n  background: #fdecee;\r\n  color: #b3261e;\r\n}\r\n.nm-prio--alta {\r\n  background: var(--amber-bg);\r\n  color: #8a5300;\r\n}\r\n.nm-state {\r\n  font: 600 13px/18px var(--font-ui);\r\n  padding: 2px 8px;\r\n  border-radius: 6px;\r\n  background: #e6f6ef;\r\n  color: #0e7a55;\r\n}\r\n.nm-sr {\r\n  position: absolute;\r\n  width: 1px;\r\n  height: 1px;\r\n  overflow: hidden;\r\n  clip: rect(0 0 0 0);\r\n  white-space: nowrap;\r\n}\r\n.nm-message {\r\n  font: 400 16px/24px var(--font-ui);\r\n  color: var(--text);\r\n  min-width: 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n.nm-row__side {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-end;\r\n  gap: 8px;\r\n}\r\n.nm-time {\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n  white-space: nowrap;\r\n}\r\n.nm-actions {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n}\r\n\r\n.nm-empty {\r\n  padding: 32px 16px;\r\n  text-align: center;\r\n  color: var(--text-muted);\r\n}\r\n.nm-more {\r\n  display: flex;\r\n  justify-content: center;\r\n}\r\n@media (max-width: 600px) {\r\n  .notes-page--hmi .nm-card {\r\n    padding: 16px;\r\n  }\r\n  .nm-row {\r\n    grid-template-columns: 40px minmax(0, 1fr);\r\n    padding: 12px 0;\r\n  }\r\n  .nm-avatar {\r\n    width: 40px;\r\n    height: 40px;\r\n  }\r\n  .nm-row__side {\r\n    grid-column: 2;\r\n    flex-direction: row;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Parametri vitali — HMI 1 (artifacts/hmi-parity/proto/parametri.png). */\r\n.par-view {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.par-grid {\r\n  display: grid;\r\n  grid-template-columns: 240px minmax(0, 1fr);\r\n  grid-template-areas: 'list form';\r\n  gap: 24px;\r\n  align-items: start;\r\n}\r\n.par-patients {\r\n  grid-area: list;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  min-width: 0;\r\n}\r\n.par-form {\r\n  grid-area: form;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.par-side {\r\n  grid-area: side;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.par-eyebrow {\r\n  font: 600 14px/20px var(--font-ui);\r\n  letter-spacing: 0.06em;\r\n  text-transform: uppercase;\r\n  color: var(--text-muted);\r\n}\r\n.par-cap {\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n  min-width: 0;\r\n}\r\n\r\n.par-pad__key:focus-visible,\r\n.par-pick__main:focus-visible {\r\n  outline: 3px solid #245bb5;\r\n  outline-offset: 2px;\r\n}\r\n\r\n/* Colonna pazienti */\r\n.par-search {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n.par-search__ico {\r\n  position: absolute;\r\n  left: 14px;\r\n  display: grid;\r\n  color: var(--text-muted);\r\n}\r\n.par-search__ico svg {\r\n  width: 18px;\r\n  height: 18px;\r\n}\r\n.par-search__input {\r\n  width: 100%;\r\n  height: 48px;\r\n  padding: 0 44px;\r\n  border-radius: 12px;\r\n  border: 2px solid var(--border);\r\n  background: var(--surface);\r\n  font: 400 16px/24px var(--font-ui);\r\n  color: var(--text);\r\n}\r\n.par-search__clear {\r\n  position: absolute;\r\n  right: 4px;\r\n  width: 40px;\r\n  height: 40px;\r\n  border: 0;\r\n  background: none;\r\n  display: grid;\r\n  place-items: center;\r\n  color: var(--text-muted);\r\n  cursor: pointer;\r\n}\r\n.par-patients__tools {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n}\r\n.par-plist {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n.par-pick {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding-right: 8px;\r\n  border-radius: 12px;\r\n  background: var(--surface);\r\n  border: 2px solid transparent;\r\n}\r\n.par-pick--selected {\r\n  border-color: var(--blue);\r\n  background: #eaf1fe;\r\n}\r\n.par-pick__main {\r\n  flex: 1;\r\n  min-width: 0;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n  padding: 8px;\r\n  border: 0;\r\n  background: none;\r\n  text-align: left;\r\n  cursor: pointer;\r\n  border-radius: 10px;\r\n}\r\n.par-pick__bed {\r\n  width: 48px;\r\n  height: 48px;\r\n  flex: none;\r\n  border-radius: 12px;\r\n  background: #f5f7fb;\r\n  border: 1px solid var(--border);\r\n  display: grid;\r\n  place-items: center;\r\n  font: 600 18px/24px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--text);\r\n}\r\n.par-pick__text {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n}\r\n.par-pick__name {\r\n  font: 600 16px/24px var(--font-ui);\r\n  color: var(--text);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.par-pick .par-cap {\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n.par-pick__draft {\r\n  color: #8a5300;\r\n  font-weight: 600;\r\n}\r\n.par-pick .turno-pcard__news2 {\r\n  flex: none;\r\n}\r\n.par-more {\r\n  align-self: flex-start;\r\n  min-height: 48px;\r\n}\r\n\r\n/* Paziente scelto */\r\n.par-form__head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n}\r\n.par-form__who {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n}\r\n.par-form__name {\r\n  margin: 0;\r\n  font: 600 20px/28px var(--font-ui);\r\n  color: var(--text);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.par-cards {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  gap: 16px;\r\n}\r\n.par-card {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  padding: 16px;\r\n  border-radius: 16px;\r\n  background: var(--surface);\r\n  border: 2px solid var(--border);\r\n  cursor: text;\r\n  min-width: 0;\r\n  margin: 0;\r\n}\r\n.par-card--active {\r\n  border-color: var(--blue);\r\n}\r\n.par-card__label {\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n.par-card__value {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: 8px;\r\n  min-width: 0;\r\n}\r\n/* Il campo è la card: niente riquadro del campo globale (form-controls.css). */\r\n.par-view .par-card input.par-card__input {\r\n  --control-bg: transparent;\r\n  --control-border: transparent;\r\n  box-shadow: none;\r\n  /* Il campo cresce col valore: l'unità resta accanto, come nel prototipo. */\r\n  field-sizing: content;\r\n  width: auto;\r\n  min-width: 2ch;\r\n  max-width: 100%;\r\n  flex: 0 1 auto;\r\n  height: 40px;\r\n  border: 0;\r\n  padding: 0;\r\n  background: none;\r\n  font: 600 28px/36px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--text);\r\n}\r\n.par-view .par-card input.par-card__input:focus {\r\n  outline: none;\r\n}\r\n.par-card__input::placeholder {\r\n  color: var(--text);\r\n}\r\n.par-card__unit {\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n  white-space: nowrap;\r\n}\r\n.par-choice,\r\n.par-field {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  margin: 0;\r\n}\r\n.par-choice__label {\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n\r\n.par-extra {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  gap: 16px;\r\n}\r\n.par-text {\r\n  min-height: 48px;\r\n  width: 100%;\r\n}\r\n\r\n/* Tastierino e salvataggio */\r\n.par-pad {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, 1fr);\r\n  gap: 8px;\r\n}\r\n.par-pad__key {\r\n  height: 48px;\r\n  border-radius: 12px;\r\n  border: 2px solid var(--border);\r\n  background: var(--surface);\r\n  color: var(--text);\r\n  font: 600 20px/28px var(--font-ui);\r\n  cursor: pointer;\r\n}\r\n.par-pad__key:active:not(:disabled) {\r\n  background: #eaf1fe;\r\n}\r\n\r\n.par-pad__key:disabled {\r\n  opacity: 0.45;\r\n  cursor: not-allowed;\r\n}\r\n.par-news2 {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  padding: 16px;\r\n  border-radius: 16px;\r\n  background: #eaf1fe;\r\n  color: #1d4fc4;\r\n}\r\n.par-news2__title {\r\n  font: 600 14px/20px var(--font-ui);\r\n}\r\n.par-news2__score {\r\n  font: 700 28px/36px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.par-news2__text {\r\n  font: 400 16px/24px var(--font-ui);\r\n}\r\n.par-news2--ok {\r\n  background: #e6f6ef;\r\n  color: #0e7a55;\r\n}\r\n.par-news2--low {\r\n  background: #eaf1fe;\r\n  color: #1d4fc4;\r\n}\r\n.par-news2--single,\r\n.par-news2--medium {\r\n  background: var(--amber-bg);\r\n  color: #8a5300;\r\n}\r\n.par-news2--high {\r\n  background: #fdecee;\r\n  color: #b3261e;\r\n}\r\n.par-result {\r\n  margin: 0;\r\n  color: #0e7a55;\r\n  font: 600 14px/20px var(--font-ui);\r\n}\r\n.par-error {\r\n  color: #b3261e;\r\n  font: 400 14px/20px var(--font-ui);\r\n}\r\n\r\n/* Tablet: pazienti a sinistra, tastierino sotto il modulo. */\r\n@media (max-width: 1099px) {\r\n  .par-grid {\r\n    grid-template-columns: 240px minmax(0, 1fr);\r\n    grid-template-areas: 'list form';\r\n  }\r\n}\r\n/* Telefono: una colonna; l'elenco pazienti scorre in un riquadro. */\r\n@media (max-width: 699px) {\r\n  .par-grid {\r\n    grid-template-columns: minmax(0, 1fr);\r\n    grid-template-areas: 'list' 'form';\r\n  }\r\n  .par-plist {\r\n    max-height: 40vh;\r\n    overflow-y: auto;\r\n  }\r\n  .par-cards,\r\n  .par-extra {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }\r\n  .par-cards {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n  /* Sul telefono c'è già la tastiera numerica di sistema (inputMode). */\r\n  .par-pad {\r\n    display: none;\r\n  }\r\n}\r\n/* Schermi larghi: tastierino, NEWS2 e Salva restano a vista mentre si scorre il modulo. */\r\n@media (min-width: 1100px) {\r\n  .par-side {\r\n    position: sticky;\r\n    top: 16px;\r\n  }\r\n}\r\n\r\n/* QA: il nome non si tronca (omonimi, stessa camera). Va a capo su più righe se serve. */\r\n.par-pick__name,\r\n.par-pick .par-cap {\r\n  white-space: normal;\r\n  overflow: visible;\r\n  text-overflow: clip;\r\n  overflow-wrap: anywhere;\r\n}\r\n.par-pick__main {\r\n  align-items: flex-start;\r\n}\r\n.par-pick { display:grid; grid-template-columns:minmax(0,1fr); padding:8px; gap:4px; }\r\n.par-pick__main { width:100%; padding:0; gap:10px; }\r\n.par-pick__text { flex:1; min-width:0; }\r\n.par-pick__bed { width:32px; height:32px; border-radius:8px; font-size:14px; }\r\n.par-pick__name { font-size:14px; line-height:20px; overflow-wrap:normal; word-break:normal; }\r\n.par-pick .par-cap { font-size:12px; line-height:18px; overflow-wrap:normal; }\r\n.par-pick .turno-pcard__news2 { justify-self:start; max-width:100%; margin-left:42px; font-size:12px; line-height:18px; }\r\n@media (max-width: 1099px) {\r\n  .par-grid {\r\n    grid-template-columns: 240px minmax(0, 1fr);\r\n  }\r\n}\r\n@media (max-width: 699px) {\r\n  .par-grid {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }\r\n}\r\n.par-outside {\r\n  margin: 0;\r\n  padding: 8px 12px;\r\n  border-radius: 12px;\r\n  background: var(--amber-bg);\r\n  color: #8a5300;\r\n  font: 600 14px/20px var(--font-ui);\r\n}\r\n\r\n/* Un solo pulsante per cancellare la ricerca (quello della pagina). */\r\n.par-search__input::-webkit-search-cancel-button {\r\n  display: none;\r\n}\r\n\r\n/* Azioni della colonna laterale a tutta larghezza (solo layout). */\r\n.par-wide {\r\n  width: 100%;\r\n}\r\n"],["STYLE",{},"/* Ricerca in anagrafica AIFA. Token del design system; nessun rosso come colore di marca. */\r\n\r\n.ricerca-farmaco {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  padding: 16px 20px 20px;\r\n  min-height: 0;\r\n}\r\n\r\n.ricerca-farmaco__campo {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding: 8px 12px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: #fff;\r\n}\r\n\r\n/* Stesso vincolo del campo nella maschera terapia: senza, il flex stira l'icona a tutto campo. */\r\n.ricerca-farmaco__campo > svg {\r\n  flex: none;\r\n  width: 18px;\r\n  height: 18px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.ricerca-farmaco__campo:focus-within {\r\n  border-color: var(--blue);\r\n  box-shadow: 0 0 0 3px rgb(47 107 237 / 12%);\r\n}\r\n\r\n.ricerca-farmaco__campo input {\r\n  flex: 1;\r\n  min-width: 0;\r\n  border: 0;\r\n  outline: none;\r\n  font-size: 14px;\r\n  color: var(--text);\r\n  background: transparent;\r\n}\r\n\r\n.ricerca-farmaco__criterio {\r\n  width: fit-content;\r\n  max-width: 100%;\r\n}\r\n\r\n.ricerca-farmaco__esiti {\r\n  flex: 1;\r\n  min-height: 0;\r\n  overflow: auto;\r\n}\r\n\r\n.ricerca-farmaco__nota {\r\n  margin: 0;\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.ricerca-farmaco__nota--errore {\r\n  color: var(--red);\r\n}\r\n\r\n.ricerca-farmaco__lista {\r\n  margin: 0;\r\n  padding: 0;\r\n  list-style: none;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n\r\n.ricerca-farmaco__riga {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  padding: 10px 12px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: #fff;\r\n}\r\n\r\n.ricerca-farmaco__nome {\r\n  margin: 0;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  color: var(--text);\r\n}\r\n\r\n/* Il rosso qui e' corretto: e' un avviso, non un accento di marca. */\r\n.ricerca-farmaco__revocato {\r\n  margin-left: 8px;\r\n  padding: 1px 7px;\r\n  border-radius: 999px;\r\n  background: var(--red);\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n  text-transform: uppercase;\r\n  color: #fff;\r\n}\r\n\r\n.ricerca-farmaco__dettagli,\r\n.ricerca-farmaco__pa {\r\n  margin: 2px 0 0;\r\n  font-size: 11px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n/* ── Modale ─────────────────────────────────────────────────────────────────────────────── */\r\n\r\n.ricerca-farmaco-modale {\r\n  display: flex;\r\n  flex-direction: column;\r\n  width: min(720px, 96vw);\r\n  max-height: 88vh;\r\n  max-width: none;\r\n  padding: 0;\r\n  overflow: hidden;\r\n}\r\n\r\n.ricerca-farmaco-modale__testa {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  padding: 18px 20px 12px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.ricerca-farmaco-modale__testa h2 {\r\n  margin: 0 0 4px;\r\n  font-size: 16px;\r\n  font-weight: 700;\r\n  color: var(--text);\r\n}\r\n\r\n/* ── Pagina dedicata ────────────────────────────────────────────────────────────────────── */\r\n\r\n.page-anagrafica-farmaci {\r\n  max-width: 1400px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.page-anagrafica-farmaci__corpo {\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--card-radius, 14px);\r\n  background: var(--surface);\r\n}\r\n\r\n/* ── Indicatore sulla riga di terapia ───────────────────────────────────────────────────── */\r\n\r\n.farmaco-trovato {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  margin: 3px 0 0 6px;\r\n  padding: 2px 6px;\r\n  border-radius: 999px;\r\n  background: var(--emerald-bg);\r\n  color: var(--text);\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  line-height: 1.4;\r\n  white-space: nowrap;\r\n  vertical-align: middle;\r\n}\r\n\r\n.farmaco-trovato svg {\r\n  display: block;\r\n  width: 12px;\r\n  height: 12px;\r\n  color: var(--teal);\r\n}\r\n\r\n/* \"non in anagrafica\" / \"senza documento\": ds-badge--warning canonico (ambra, mai rosso: non è\r\n   un allarme clinico ma un dato mancante su cui l'operatore può agire). */\r\n.ricerca-farmaco__icona {\r\n  flex: none;\r\n  display: grid;\r\n  place-items: center;\r\n  width: 24px;\r\n  height: 24px;\r\n  color: var(--text);\r\n}\r\n.ricerca-farmaco__icona svg {\r\n  width: 20px;\r\n  height: 20px;\r\n}\r\n.ricerca-farmaco__testo {\r\n  /* Base esplicita: su schermi stretti è il pulsante ad andare a capo, non le parole a spezzarsi. */\r\n  flex: 1 1 200px;\r\n  min-width: 0;\r\n  overflow-wrap: break-word;\r\n}\r\n@media (max-width: 600px) {\r\n  .ricerca-farmaco__riga {\r\n    flex-wrap: wrap;\r\n  }\r\n  .ricerca-farmaco__riga > :last-child {\r\n    margin-left: 36px;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Farmaci — HMI 1 (artifacts/hmi-parity/proto/farmaci.png). Solo la pagina: la modale della\r\n   terapia usa lo stesso corpo di ricerca con i suoi stili. */\r\n.page-anagrafica-farmaci {\r\n  max-width: none;\r\n}\r\n.page-anagrafica-farmaci__corpo {\r\n  border-radius: 16px;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco {\r\n  padding: 24px;\r\n  gap: 16px;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__campo {\r\n  height: 48px;\r\n  padding: 0 16px;\r\n  border: 2px solid var(--border);\r\n  border-radius: 12px;\r\n  background: #f5f7fb;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__campo input {\r\n  font-size: 16px;\r\n}\r\n\r\n.page-anagrafica-farmaci .ricerca-farmaco__nota {\r\n  font-size: 14px;\r\n  line-height: 20px;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__vuoto {\r\n  padding: 16px 0;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__esiti {\r\n  overflow: visible;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__lista {\r\n  gap: 0;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__riga {\r\n  gap: 16px;\r\n  padding: 12px 0;\r\n  border: 0;\r\n  border-bottom: 1px solid var(--border);\r\n  border-radius: 0;\r\n  background: transparent;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__nome {\r\n  font: 600 16px/24px var(--font-ui);\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__dettagli,\r\n.page-anagrafica-farmaci .ricerca-farmaco__pa {\r\n  font: 400 14px/20px var(--font-ui);\r\n}\r\n\r\n@media (max-width: 600px) {\r\n  .page-anagrafica-farmaci .ricerca-farmaco {\r\n    padding: 16px;\r\n  }\r\n  .page-anagrafica-farmaci .ricerca-farmaco__riga {\r\n    flex-wrap: wrap;\r\n  }\r\n  .page-anagrafica-farmaci .ricerca-farmaco__riga > :last-child {\r\n    margin-left: 40px;\r\n  }\r\n}\r\n"],["STYLE",{},".agnos-panel { height: 100dvh; max-width: 100%; }\r\n.agnos-panel > header, .agnos-panel > .agnos-intro,\r\n.agnos-workflow-status, .agnos-composer { flex-shrink: 0; }\r\n.agnos-panel .ai-drawer__body { min-height: 0; overscroll-behavior: contain; padding: 16px 24px; }\r\n/* HMI 1: testata alta come la barra in alto, titolo \"✧ Assistente\" viola, poi la dichiarazione. */\r\n.agnos-panel .ai-drawer__header { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 8px; min-height: 72px; padding: 12px 16px 12px 24px; box-sizing: border-box; }\r\n.agnos-panel .agnos-title { display: flex; align-items: center; gap: 8px; min-width: 0; margin: 0; font: 600 20px/28px var(--ds-font); color: var(--purple, #6c4bd1); }\r\n.agnos-panel .agnos-title svg { width: 20px; height: 20px; flex: none; }\r\n.agnos-intro { padding: 16px 24px 0; }\r\n.agnos-intro p { margin: 0; }\r\n.agnos-intro__text { font: 400 14px/20px var(--ds-font); color: var(--text-muted); }\r\n.agnos-intro .agnos-intro__scope { margin-top: 8px; font: 600 14px/20px var(--ds-font); color: var(--ds-blue-active); }\r\n.agnos-panel .agnos-compose { display: flex; flex-direction: column; align-items: stretch; gap: 8px; padding: 16px 24px; }\r\n.agnos-compose-row { display: flex; align-items: flex-end; gap: 8px; }\r\n.agnos-compose-label { font-size: 13px; font-weight: 650; color: var(--text); }\r\n/* il campo parte da una riga (48px) e cresce col testo o con la dettatura */\r\n.agnos-panel textarea.agnos-input { width: 100%; min-width: 0; min-height: 48px; height: auto; max-height: 150px; flex: auto; field-sizing: content; line-height: 24px; padding-block: 10px; resize: none; }\r\n.agnos-compose-actions { display: flex; align-items: center; justify-content: flex-end; gap: 8px; }\r\n.agnos-compose-help { margin: 0; padding: 0 12px 8px; font-size: 12px; color: var(--text-muted); line-height: 1.4; }\r\n.agnos-compose .agnos-compose-help { padding: 0; }\r\n.agnos-panel .agnos-voice-consent { padding: 0 14px max(8px, env(safe-area-inset-bottom)); }\r\n.agnos-voice-consent .link-btn { font-size: 12px; min-height: 28px; }\r\n.agnos-consent-prompt { padding: 16px; border-top: 1px solid var(--border); background: #f3f7fd; font-size: 13px; line-height: 1.5; }\r\n.agnos-consent-prompt > strong { display: block; font-size: 15px; color: var(--text); }\r\n.agnos-consent-prompt p { margin: 8px 0 12px; }\r\n.agnos-composer { max-height: 65%; overflow-y: auto; overscroll-behavior: contain; }\r\n.agnos-consent-prompt .agnos-compose-actions { flex-wrap: wrap; }\r\n.agnos-workflow-status { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; padding: 10px 14px; background: #eef4ff; border-bottom: 1px solid var(--border); color: #244676; font-size: 13px; line-height: 1.4; }\r\n.agnos-workflow-status > span:not(.agnos-workflow-spinner) { flex: 1 1 220px; }\r\n.agnos-workflow-status[data-phase='error'] { background: #fff7e8; color: #76501c; }\r\n.agnos-workflow-status .link-btn { font-size: 12px; min-height: 32px; }\r\n.agnos-workflow-spinner { width: 14px; height: 14px; flex: 0 0 14px; border: 2px solid #cbdaf2; border-top-color: #316dda; border-radius: 50%; animation: agnos-spin 900ms linear infinite; }\r\n.agnos-transcript-label { align-self: flex-end; font-size: 11px; color: var(--text-muted); }\r\n.agnos-proposed-text { padding: 12px; border: 1px solid var(--border); border-radius: 8px; background: white; }\r\n.agnos-proposed-text p, .agnos-preview .voice-preview__row dd { white-space: pre-wrap; overflow-wrap: anywhere; }\r\n.agnos-proposed-text p { margin: 8px 0 12px; line-height: 1.5; }\r\n.agnos-proposed-text summary { cursor: pointer; color: var(--blue); margin-bottom: 12px; }\r\n.agnos-approval-hint { font-size: 13px; line-height: 1.45; margin: 12px 0 8px; }\r\n.agnos-panel .voice-actions { flex-wrap: wrap; }\r\n.agnos-workflow-dock { position: fixed; bottom: max(52px, env(safe-area-inset-bottom)); right: 12px; z-index: 202; max-width: min(440px, calc(100vw - 24px)); padding: 12px; display: flex; align-items: center; flex-wrap: wrap; gap: 10px; background: white; border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 4px 20px #10284726; font-size: 13px; }\r\n.agnos-workflow-dock span { flex: 1 1 190px; }\r\n@keyframes agnos-spin { to { transform: rotate(360deg); } }\r\n@media (min-width: 1100px) {\r\n  .app-shell:has(.agnos-panel--workspace[aria-hidden='false']) .main-area-clean { margin-right: 420px; }\r\n}\r\n@media (max-width: 1099px) {\r\n  .agnos-panel--workspace { top: auto; bottom: 0; height: 76dvh; border-radius: 16px 16px 0 0; }\r\n}\r\n@media (max-width: 480px) {\r\n  .agnos-panel--workspace { top: 0; height: 100dvh; border-radius: 0; }\r\n  .agnos-panel .agnos-compose { padding: 12px 16px; }\r\n  .agnos-panel .ai-drawer__header { padding-left: 16px; }\r\n  .agnos-intro { padding: 12px 16px 0; }\r\n  .agnos-panel .ai-drawer__body { padding: 12px 16px; }\r\n}\r\n@media (prefers-reduced-motion: reduce) { .agnos-workflow-spinner { animation: none; } }\r\n@media print { .agnos-workflow-dock { display: none !important; } }\r\n"]],[[12,30]],["BODY",{},[[12,31]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},[[1,2]],["DIV",{"class":"main-area-clean"},["DIV",{"class":"compact-topbar"},[[7,53]],[[2,6]],["DIV",{"class":"topbar-title"},["DIV",{"class":"page-header__titles"},["H1",{"class":"page-header__title"},"Pazienti"],["P",{"class":"page-header__subtitle"},"1 caricati su 1"]]],[[7,63]],[[7,79]]],["MAIN",{"class":"page-content content-panel"},["DIV",{"class":"patient-list-view"},["SECTION",{"class":"plist-card plist-list","aria-label":"Elenco pazienti"},["DIV",{"class":"plist-toolbar"},["DIV",{"class":"search-wrap plist-search"},["SPAN",{"class":"search-wrap__ico"},["svg",{"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.75","stroke-linecap":"round","stroke-linejoin":"round"},["circle",{"cx":"11","cy":"11","r":"8"}],["line",{"x1":"21","y1":"21","x2":"16.65","y2":"16.65"}]]],["INPUT",{"__playwright_value_":"","class":"search-input","placeholder":"Cerca per nome o codice fiscale…","aria-label":"Cerca paziente per nome o codice fiscale","maxlength":"80","type":"search","value":""}]],["DIV",{"class":"plist-views","role":"group","aria-label":"Vista dei pazienti caricati"},["BUTTON",{"type":"button","class":"ds-chip","aria-pressed":"true"},"Non dimessi",["SPAN",{"class":"ds-chip__count"},"1"]],["BUTTON",{"type":"button",