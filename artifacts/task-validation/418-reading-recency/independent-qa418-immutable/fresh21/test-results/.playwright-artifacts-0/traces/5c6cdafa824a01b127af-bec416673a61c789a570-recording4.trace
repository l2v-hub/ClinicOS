e-width: 4;\r\n}\r\n.parameter-trend-dot {\r\n  cursor: pointer;\r\n}\r\n.parameter-trend-axis-label {\r\n  margin: 2px 0 8px;\r\n  text-align: center;\r\n  font-size: 11px;\r\n  color: var(--text-muted);\r\n}\r\n.parameter-trend-lane__empty {\r\n  margin: 12px 0 18px;\r\n  font-size: 13px;\r\n  color: var(--text-muted);\r\n}\r\n.parameter-trend-detail {\r\n  margin: 0 0 14px;\r\n  padding: 12px 14px;\r\n  border: 1px solid var(--border);\r\n  border-left: 3px solid var(--trend-color);\r\n  border-radius: 8px;\r\n  background: var(--bg);\r\n  font-size: 13px;\r\n}\r\n.parameter-trend-detail__title {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n}\r\n.parameter-trend-detail ul {\r\n  list-style: none;\r\n  margin: 8px 0 0;\r\n  padding: 0;\r\n  max-height: 230px;\r\n  overflow-y: auto;\r\n}\r\n.parameter-trend-detail li {\r\n  display: flex;\r\n  align-items: baseline;\r\n  flex-wrap: wrap;\r\n  gap: 5px 20px;\r\n  padding: 5px 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n.parameter-trend-detail li > strong {\r\n  font-size: 18px;\r\n}\r\n.parameter-trend-detail li > span,\r\n.parameter-trend-detail small {\r\n  color: var(--text-muted);\r\n  font-weight: 400;\r\n  font-size: 12px;\r\n}\r\n.parameter-trends-source {\r\n  margin-top: 20px;\r\n  padding-top: 12px;\r\n  border-top: 1px solid var(--border);\r\n}\r\n.parameter-trends-error {\r\n  color: var(--red);\r\n  font-size: 13px;\r\n}\r\n@media (max-width: 600px) {\r\n  .parameter-trends-heading {\r\n    flex-wrap: wrap;\r\n  }\r\n  .parameter-trends .filter-chip,\r\n  .parameter-trends button,\r\n  .parameter-trends .form-input {\r\n    min-height: 44px;\r\n  }\r\n  .parameter-trends-selection__name {\r\n    display: none;\r\n  }\r\n  .parameter-trends-range label {\r\n    flex: 1 1 110px;\r\n  }\r\n  .parameter-trends-range .form-input {\r\n    width: 100%;\r\n  }\r\n  .parameter-trend-chart {\r\n    padding: 12px 6px 4px;\r\n  }\r\n  .parameter-trend-detail {\r