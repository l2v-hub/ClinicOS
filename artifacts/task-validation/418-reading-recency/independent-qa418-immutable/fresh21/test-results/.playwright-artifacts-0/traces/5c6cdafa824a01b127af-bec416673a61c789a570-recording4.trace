led":"","aria-label":"9"},"9"],["BUTTON",{"type":"button","class":"ds-btn ds-btn--secondary","disabled":"","aria-label":"4"},"4"],["BUTTON",{"type":"button","class":"ds-btn ds-btn--secondary","disabled":"","aria-label":"5"},"5"],["BUTTON",{"type":"button","class":"ds-btn ds-btn--secondary","disabled":"","aria-label":"6"},"6"],["BUTTON",{"type":"button","class":"ds-btn ds-btn--secondary","disabled":"","aria-label":"1"},"1"],["BUTTON",{"type":"button","class":"ds-btn ds-btn--secondary","disabled":"","aria-label":"2"},"2"],["BUTTON",{"type":"button","class":"ds-btn ds-btn--secondary","disabled":"","aria-label":"3"},"3"],["BUTTON",{"type":"button","class":"ds-btn ds-btn--secondary","disabled":"","aria-label":"Virgola"},","],["BUTTON",{"type":"button","class":"ds-btn ds-btn--secondary","disabled":"","aria-label":"0"},"0"],["BUTTON",{"type":"button","class":"ds-btn ds-btn--secondary","disabled":"","aria-label":"Cancella"},"⌫"]],["SMALL",{},"Seleziona un campo numerico. Il tastierino aggiunge o cancella in fondo al valore."],["BUTTON",{"type":"button","class":"ds-btn ds-btn--secondary"},"Campo successivo"],["DIV",{"class":"parameter-reading-form__news2","role":"status","aria-live":"polite"},["STRONG",{},"NEWS2 in tempo reale · ","—"],["P",{},"Mancano: FR, SpO₂, O₂, PA, FC, Coscienza, TC"]],["P",{"id":"_r_j_-news2-help","class":"parameter-reading-form__help"},"NEWS2 usa i sette parametri della stessa rilevazione e la scala SpO₂ 1. O₂ indica l’ossigeno supplementare; coscienza usa ACVPU. Un punteggio incompleto non è un NEWS2 valido."],["SMALL",{},"Data e ora vengono registrate quando premi Salva."],["BUTTON",{"type":"submit","class":"ds-btn ds-btn--primary","aria-busy":"false"},"Salva rilevazione"]]]]],["SECTION",{"class":"parameter-workspace-records","aria-label":"Consultazione parametri vitali"},["DIV",{"class":"parameter-workspace-records__heading"},["H3",{},"Valori e andamento"],["BUTTON",{"type":"button","class":"btn-secondary btn-sm"},"Aggiorna"]],["DIV",{"class":"par