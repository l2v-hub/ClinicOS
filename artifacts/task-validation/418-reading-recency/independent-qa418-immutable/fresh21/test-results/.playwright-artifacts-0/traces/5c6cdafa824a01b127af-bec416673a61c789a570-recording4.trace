{"type":"frame-snapshot","snapshot":{"callId":"call@5080","snapshotName":"input@call@5080","pageId":"page@2d545344a487ce7a76acd0ba43ae82dc","frameId":"frame@52bec97eab84e58bcc9aa52c1fa7fdda","frameUrl":"http://127.0.0.1:7483/#/dettaglio-paziente/QA-418-INDEPENDENT","doctype":"html","html":["HTML",{"lang":"it"},["HEAD",{},[[20,0]],[[20,1]],[[20,2]],[[20,3]],[[20,4]],[[20,5]],[[20,6]],[[20,7]],[[20,8]],[[20,9]],[[20,10]],[[20,11]],[[20,12]],[[20,13]],[[20,15]],[[20,16]],[[20,18]],[[20,20]],[[20,22]],[[20,24]],[[20,26]],[[20,28]],[[16,1]],[[16,3]],[[16,5]],[[16,7]],[[16,9]],[[16,11]],[[16,13]],[[16,15]],[[16,17]],[[16,19]],[[16,21]],[[16,23]],[[16,25]],[[16,27]],[[16,29]],[[15,1]],[[15,3]],[[15,5]],[[15,7]],[[15,9]],[[15,11]],[[15,13]],[[15,15]],[[15,17]],[[15,19]],[[15,21]],[[15,23]],[[15,25]],[[15,27]],[[14,1]],[[14,3]],[[8,1]],[[8,3]],[[8,5]],[[8,7]],[[5,1]],[[5,3]],[[5,5]],[[5,7]],[[5,9]],[[5,11]],[[5,13]],[[5,15]],[[5,17]],[[5,19]],[[5,21]],[[5,23]],[[4,1]],[[4,3]],["STYLE",{},".agnos-panel { height: 100dvh; max-width: 100%; }\r\n.agnos-panel > header, .agnos-panel > .agnos-intro,\r\n.agnos-workflow-status, .agnos-composer { flex-shrink: 0; }\r\n.agnos-panel .ai-drawer__body { min-height: 0; overscroll-behavior: contain; padding: 16px 24px; }\r\n/* HMI 1: testata alta come la barra in alto, titolo \"✧ Assistente\" viola, poi la dichiarazione. */\r\n.agnos-panel .ai-drawer__header { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 8px; min-height: 72px; padding: 12px 16px 12px 24px; box-sizing: border-box; }\r\n.agnos-panel .agnos-title { display: flex; align-items: center; gap: 8px; min-width: 0; margin: 0; font: 600 20px/28px var(--ds-font); color: var(--purple, #6c4bd1); }\r\n.agnos-panel .agnos-title svg { width: 20px; height: 20px; flex: none; }\r\n.agnos-intro { padding: 16px 24px 0; }\r\n.agnos-intro p { margin: 0; }\r\n.agnos-intro__text { font: 400 14px/20px var(--ds-font); color: var(--text-muted); }\r\n.agnos-intro .agnos-intro__scope { margin-top: 8px; font: 600 14px/20px var(--ds-font); color: var(--ds-blue-active); }\r\n.agnos-panel .agnos-compose { display: flex; flex-direction: column; align-items: stretch; gap: 8px; padding: 16px 24px; }\r\n.agnos-compose-row { display: flex; align-items: flex-end; gap: 8px; }\r\n.agnos-compose-label { font-size: 13px; font-weight: 650; color: var(--text); }\r\n/* il campo parte da una riga (48px) e cresce col testo o con la dettatura */\r\n.agnos-panel textarea.agnos-input { width: 100%; min-width: 0; min-height: 48px; height: auto; max-height: 150px; flex: auto; field-sizing: content; line-height: 24px; padding-block: 10px; resize: none; }\r\n.agnos-compose-actions { display: flex; align-items: center; justify-content: flex-end; gap: 8px; }\r\n.agnos-compose-help { margin: 0; padding: 0 12px 8px; font-size: 12px; color: var(--text-muted); line-height: 1.4; }\r\n.agnos-compose .agnos-compose-help { padding: 0; }\r\n.agnos-panel .agnos-voice-consent { padding: 0 14px max(8px, env(safe-area-inset-bottom)); }\r\n.agnos-voice-consent .link-btn { font-size: 12px; min-height: 28px; }\r\n.agnos-consent-prompt { padding: 16px; border-top: 1px solid var(--border); background: #f3f7fd; font-size: 13px; line-height: 1.5; }\r\n.agnos-consent-prompt > strong { display: block; font-size: 15px; color: var(--text); }\r\n.agnos-consent-prompt p { margin: 8px 0 12px; }\r\n.agnos-composer { max-height: 65%; overflow-y: auto; overscroll-behavior: contain; }\r\n.agnos-consent-prompt .agnos-compose-actions { flex-wrap: wrap; }\r\n.agnos-workflow-status { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; padding: 10px 14px; background: #eef4ff; border-bottom: 1px solid var(--border); color: #244676; font-size: 13px; line-height: 1.4; }\r\n.agnos-workflow-status > span:not(.agnos-workflow-spinner) { flex: 1 1 220px; }\r\n.agnos-workflow-status[data-phase='error'] { background: #fff7e8; color: #76501c; }\r\n.agnos-workflow-status .link-btn { font-size: 12px; min-height: 32px; }\r\n.agnos-workflow-spinner { width: 14px; height: 14px; flex: 0 0 14px; border: 2px solid #cbdaf2; border-top-color: #316dda; border-radius: 50%; animation: agnos-spin 900ms linear infinite; }\r\n.agnos-transcript-label { align-self: flex-end; font-size: 11px; color: var(--text-muted); }\r\n.agnos-proposed-text { padding: 12px; border: 1px solid var(--border); border-radius: 8px; background: white; }\r\n.agnos-proposed-text p, .agnos-preview .voice-preview__row dd { white-space: pre-wrap; overflow-wrap: anywhere; }\r\n.agnos-proposed-text p { margin: 8px 0 12px; line-height: 1.5; }\r\n.agnos-proposed-text summary { cursor: pointer; color: var(--blue); margin-bottom: 12px; }\r\n.agnos-approval-hint { font-size: 13px; line-height: 1.45; margin: 12px 0 8px; }\r\n.agnos-panel .voice-actions { flex-wrap: wrap; }\r\n.agnos-workflow-dock { position: fixed; bottom: max(52px, env(safe-area-inset-bottom)); right: 12px; z-index: 202; max-width: min(440px, calc(100vw - 24px)); padding: 12px; display: flex; align-items: center; flex-wrap: wrap; gap: 10px; background: white; border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 4px 20px #10284726; font-size: 13px; }\r\n.agnos-workflow-dock span { flex: 1 1 190px; }\r\n@keyframes agnos-spin { to { transform: rotate(360deg); } }\r\n@media (min-width: 1100px) {\r\n  .app-shell:has(.agnos-panel--workspace[aria-hidden='false']) .main-area-clean { margin-right: 420px; }\r\n}\r\n@media (max-width: 1099px) {\r\n  .agnos-panel--workspace { top: auto; bottom: 0; height: 76dvh; border-radius: 16px 16px 0 0; }\r\n}\r\n@media (max-width: 480px) {\r\n  .agnos-panel--workspace { top: 0; height: 100dvh; border-radius: 0; }\r\n  .agnos-panel .agnos-compose { padding: 12px 16px; }\r\n  .agnos-panel .ai-drawer__header { padding-left: 16px; }\r\n  .agnos-intro { padding: 12px 16px 0; }\r\n  .agnos-panel .ai-drawer__body { padding: 12px 16px; }\r\n}\r\n@media (prefers-reduced-motion: reduce) { .agnos-workflow-spinner { animation: none; } }\r\n@media print { .agnos-workflow-dock { display: none !important; } }\r\n"]],[[20,30]],["BODY",{},[[20,31]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},[[6,2]],["DIV",{"class":"main-area-clean"},[[2,7]],["MAIN",{"class":"page-content content-panel"},["DIV",{"class":"patient-record-view"},["DIV",{"class":"chart-sections no-print"},["NAV",{"class":"top-nav top-nav--level2 top-nav--chips","role":"tablist","aria-label":"Sezioni della cartella"},[[2,9]],["DIV",{"class":"top-nav__items"},[[1,0]],[[2,13]],[[2,15]],[[2,17]],["BUTTON",{"__playwright_target__":"","type":"button","role":"tab","id":"patient-section-parametri","aria-selected":"false","aria-controls":"patient-tab-panel","tabindex":"-1","class":"top-nav__item"},[[2,18]]],[[2,21]],[[2,23]],[[2,25]]]],[[2,40]]],[[2,53]],["DIV",{"class":"cr-detail-layout cr-detail-layout--no-sidebar"},["DIV",{"id":"patient-tab-panel","role":"tabpanel","aria-labelledby":"patient-section-panoramica","tabindex":"0","class":"cr-detail-content tab-panel-transition"},["SECTION",{"class":"vitals-summary","aria-label":"Ultimi parametri e NEWS2"},["DIV",{"class":"vitals-summary__head"},["BUTTON",{"type":"button","class":"ds-icon-btn","aria-expanded":"true","aria-controls":"widget-_r_9_","aria-label":"Comprimi ultimi parametri"},"▾"],["H2",{},"Ultimi parametri"],["DIV",{"class":"vitals-summary__actions"},["BUTTON",{"type":"button","class":"ds-link","aria-label":"Rileva ora i parametri di questo paziente"},"Rileva ora"],["BUTTON",{"type":"button","class":"icon-btn","aria-label":"Espandi ultimi parametri e NEWS2","title":"Espandi parametri","aria-haspopup":"dialog"},["svg",{"viewBox":"0 0 24 24","width":"20","height":"20","fill":"none","stroke":"currentColor","stroke-width":"2","aria-hidden":"true"},["path",{"d":"M8 3H3v5M16 3h5v5M3 16v5h5M21 16v5h-5M3 3l6 6M21 3l-6 6M3 21l6-6M21 21l-6-6"}]]]]],["DIV",{"id":"widget-_r_9_"},["DIV",{"class":"vitals"},["DIV",{"class":"vt vt--none"},["SPAN",{"class":"vt__label"