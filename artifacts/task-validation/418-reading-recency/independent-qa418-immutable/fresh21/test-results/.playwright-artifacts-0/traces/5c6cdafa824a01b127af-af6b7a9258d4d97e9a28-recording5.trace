{"type":"frame-snapshot","snapshot":{"callId":"call@6244","snapshotName":"before@call@6244","pageId":"page@58f85d5a243f2ecef99d17e3aca8e328","frameId":"frame@114859759f6b54060681bc7b37222cec","frameUrl":"http://127.0.0.1:7483/#/parametri-multipaziente","doctype":"html","html":["HTML",{"lang":"it"},["HEAD",{},[[42,0]],[[42,1]],[[42,2]],[[42,3]],[[42,4]],[[42,5]],[[42,6]],[[42,7]],[[42,8]],[[42,9]],[[42,10]],[[42,11]],[[42,12]],[[42,13]],[[42,15]],[[42,16]],[[42,18]],[[42,20]],[[42,22]],[[42,24]],[[42,26]],[[42,28]],[[37,1]],[[37,3]],[[37,5]],[[37,7]],[[37,9]],[[37,11]],[[37,13]],[[37,15]],[[37,17]],[[37,19]],[[37,21]],[[37,23]],[[37,25]],[[37,27]],[[37,29]],[[37,31]],[[37,33]],[[37,35]],[[37,37]],[[37,39]],[[37,41]],[[37,43]],[[37,45]],[[37,47]],[[37,49]],[[37,51]],[[37,53]],[[37,55]],[[37,57]],[[33,1]],[[33,3]],[[30,1]],[[30,3]],[[30,5]],[[30,7]],[[27,1]],[[27,3]],[[27,5]],[[27,7]],[[27,9]],[[27,11]],[[27,13]],[[27,15]],[[27,17]],[[27,19]],[[27,21]],[[27,23]],[[20,1]],[[20,3]],["STYLE",{},".agnos-panel { height: 100dvh; max-width: 100%; }\r\n.agnos-panel > header, .agnos-panel > .agnos-intro,\r\n.agnos-workflow-status, .agnos-composer { flex-shrink: 0; }\r\n.agnos-panel .ai-drawer__body { min-height: 0; overscroll-behavior: contain; padding: 16px 24px; }\r\n/* HMI 1: testata alta come la barra in alto, titolo \"✧ Assistente\" viola, poi la dichiarazione. */\r\n.agnos-panel .ai-drawer__header { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 8px; min-height: 72px; padding: 12px 16px 12px 24px; box-sizing: border-box; }\r\n.agnos-panel .agnos-title { display: flex; align-items: center; gap: 8px; min-width: 0; margin: 0; font: 600 20px/28px var(--ds-font); color: var(--purple, #6c4bd1); }\r\n.agnos-panel .agnos-title svg { width: 20px; height: 20px; flex: none; }\r\n.agnos-intro { padding: 16px 24px 0; }\r\n.agnos-intro p { margin: 0; }\r\n.agnos-intro__text { font: 400 14px/20px var(--ds-font); color: var(--text-muted); }\r\n.agnos-intro .agnos-intro__scope { margin-top: 8px; font: 600 14px/20px var(--ds-font); color: var(--ds-blue-active); }\r\n.agnos-panel .agnos-compose { display: flex; flex-direction: column; align-items: stretch; gap: 8px; padding: 16px 24px; }\r\n.agnos-compose-row { display: flex; align-items: flex-end; gap: 8px; }\r\n.agnos-compose-label { font-size: 13px; font-weight: 650; color: var(--text); }\r\n/* il campo parte da una riga (48px) e cresce col testo o con la dettatura */\r\n.agnos-panel textarea.agnos-input { width: 100%; min-width: 0; min-height: 48px; height: auto; max-height: 150px; flex: auto; field-sizing: content; line-height: 24px; padding-block: 10px; resize: none; }\r\n.agnos-compose-actions { display: flex; align-items: center; justify-content: flex-end; gap: 8px; }\r\n.agnos-compose-help { margin: 0; padding: 0 12px 8px; font-size: 12px; color: var(--text-muted); line-height: 1.4; }\r\n.agnos-compose .agnos-compose-help { padding: 0; }\r\n.agnos-panel .agnos-voice-consent { padding: 0 14px max(8px, env(safe-area-inset-bottom)); }\r\n.agnos-voice-consent .link-btn { font-size: 12px; min-height: 28px; }\r\n.agnos-consent-prompt { padding: 16px; border-top: 1px solid var(--border); background: #f3f7fd; font-size: 13px; line-height: 1.5; }\r\n.agnos-consent-prompt > strong { display: block; font-size: 15px; color: var(--text); }\r\n.agnos-consent-prompt p { margin: 8px 0 12px; }\r\n.agnos-composer { max-height: 65%; overflow-y: auto; overscroll-behavior: contain; }\r\n.agnos-consent-prompt .agnos-compose-actions { flex-wrap: wrap; }\r\n.agnos-workflow-status { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; padding: 10px 14px; background: #eef4ff; border-bottom: 1px solid var(--border); color: #244676; font-size: 13px; line-height: 1.4; }\r\n.agnos-workflow-status > span:not(.agnos-workflow-spinner) { flex: 1 1 220px; }\r\n.agnos-workflow-status[data-phase='error'] { background: #fff7e8; color: #76501c; }\r\n.agnos-workflow-status .link-btn { font-size: 12px; min-height: 32px; }\r\n.agnos-workflow-spinner { width: 14px; height: 14px; flex: 0 0 14px; border: 2px solid #cbdaf2; border-top-color: #316dda; border-radius: 50%; animation: agnos-spin 900ms linear infinite; }\r\n.agnos-transcript-label { align-self: flex-end; font-size: 11px; color: var(--text-muted); }\r\n.agnos-proposed-text { padding: 12px; border: 1px solid var(--border); border-radius: 8px; background: white; }\r\n.agnos-proposed-text p, .agnos-preview .voice-preview__row dd { white-space: pre-wrap; overflow-wrap: anywhere; }\r\n.agnos-proposed-text p { margin: 8px 0 12px; line-height: 1.5; }\r\n.agnos-proposed-text summary { cursor: pointer; color: var(--blue); margin-bottom: 12px; }\r\n.agnos-approval-hint { font-size: 13px; line-height: 1.45; margin: 12px 0 8px; }\r\n.agnos-panel .voice-actions { flex-wrap: wrap; }\r\n.agnos-workflow-dock { position: fixed; bottom: max(52px, env(safe-area-inset-bottom)); right: 12px; z-index: 202; max-width: min(440px, calc(100vw - 24px)); padding: 12px; display: flex; align-items: center; flex-wrap: wrap; gap: 10px; background: white; border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 4px 20px #10284726; font-size: 13px; }\r\n.agnos-workflow-dock span { flex: 1 1 190px; }\r\n@keyframes agnos-spin { to { transform: rotate(360deg); } }\r\n@media (min-width: 1100px) {\r\n  .app-shell:has(.agnos-panel--workspace[aria-hidden='false']) .main-area-clean { margin-right: 420px; }\r\n}\r\n@media (max-width: 1099px) {\r\n  .agnos-panel--workspace { top: auto; bottom: 0; height: 76dvh; border-radius: 16px 16px 0 0; }\r\n}\r\n@media (max-width: 480px) {\r\n  .agnos-panel--workspace { top: 0; height: 100dvh; border-radius: 0; }\r\n  .agnos-panel .agnos-compose { padding: 12px 16px; }\r\n  .agnos-panel .ai-drawer__header { padding-left: 16px; }\r\n  .agnos-intro { padding: 12px 16px 0; }\r\n  .agnos-panel .ai-drawer__body { padding: 12px 16px; }\r\n}\r\n@media (prefers-reduced-motion: reduce) { .agnos-workflow-spinner { animation: none; } }\r\n@media print { .agnos-workflow-dock { display: none !important; } }\r\n"]],[[42,30]],[[2,11]]],"viewport":{"width":853,"height":1138},"timestamp":27792.77,"wallTime":1792890302799,"collectionTime":1,"resourceOverrides":[],"isMainFrame":true}}
