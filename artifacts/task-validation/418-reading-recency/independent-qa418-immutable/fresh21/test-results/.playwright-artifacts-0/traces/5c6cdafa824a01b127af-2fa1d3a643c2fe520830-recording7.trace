{"type":"before","callId":"call@8506","startTime":38365.195,"class":"Route","method":"fulfill","params":{"status":200,"headers":[{"name":"content-type","value":"application/json"},{"name":"content-length","value":"853"}],"body":"{\"readings\":[{\"id\":\"QA-minutes\",\"patientId\":\"QA-418-INDEPENDENT\",\"requestId\":\"QA-minutes\",\"measuredAt\":\"2026-10-25T00:59:00Z\",\"values\":{\"fr\":\"19\"},\"createdAt\":\"2026-10-25T00:59:00Z\",\"authorOperatorId\":\"QA-418-NURSE\",\"authorName\":\"Infermiere QA418\"},{\"id\":\"QA-days\",\"patientId\":\"QA-418-INDEPENDENT\",\"requestId\":\"QA-days\",\"measuredAt\":\"2026-10-21T01:05:00Z\",\"values\":{\"spo2\":\"95\",\"o2\":\"no\"},\"createdAt\":\"2026-10-21T01:05:00Z\",\"authorOperatorId\":\"QA-418-NURSE\",\"authorName\":\"Infermiere QA418\"},{\"id\":\"QA-weeks\",\"patientId\":\"QA-418-INDEPENDENT\",\"requestId\":\"QA-weeks\",\"measuredAt\":\"2026-10-04T01:05:00Z\",\"values\":{\"fr\":\"15\",\"spo2\":\"98\",\"o2\":\"no\",\"pa\":\"124/76\",\"fc\":\"74\",\"temperatura\":\"36,6\",\"coscienza\":\"A\",\"dtx\":\"104\"},\"createdAt\":\"2026-10-04T01:05:00Z\",\"authorOperatorId\":\"QA-418-NURSE\",\"authorName\":\"Infermiere QA418\"}],\"hasMore\":false,\"nextCursor\":null}","isBase64":false},"stepId":"pw:api@473","pageId":"page@06145f9785f33f8cad61789f68499a86"}
