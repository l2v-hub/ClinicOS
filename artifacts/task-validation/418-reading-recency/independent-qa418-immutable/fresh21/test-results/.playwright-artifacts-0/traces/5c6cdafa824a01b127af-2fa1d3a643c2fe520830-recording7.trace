flex-wrap: wrap;\r\n  gap: 8px 16px;\r\n  margin-top: 12px;\r\n  padding: 10px 12px;\r\n  font-size: 13px;\r\n  color: #216345;\r\n  background: #edf8f2;\r\n  border-radius: 8px;\r\n}\r\n.parameter-workspace-records {\r\n  min-width: 0;\r\n}\r\n.parameter-workspace-records__heading {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  margin-bottom: 12px;\r\n}\r\n.parameter-workspace-period .filter-chips {\r\n  margin: 0;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n.parameter-workspace-period .filter-chip {\r\n  min-height: 36px;\r\n}\r\n.parameter-workspace-period .parameter-trends-range {\r\n  margin-top: 12px;\r\n}\r\n.parameter-workspace-summary {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  padding: 14px 0;\r\n  margin-bottom: 4px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n.parameter-workspace-summary > div {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px 16px;\r\n  align-items: center;\r\n  font-size: 13px;\r\n}\r\n.parameter-workspace-summary span {\r\n  color: var(--text-muted);\r\n}\r\n.parameter-workspace .parameter-workspace-graph-active {\r\n  color: var(--blue);\r\n  background: #eaf1ff;\r\n  border-color: #c6d8fc;\r\n}\r\n.parameter-workspace-list-title {\r\n  font-size: 14px;\r\n  margin: 16px 0 10px;\r\n}\r\n.parameter-workspace .parameter-history-day {\r\n  margin: 14px 0 8px;\r\n}\r\n.parameter-workspace .parameter-history-reading {\r\n  padding: 12px 14px;\r\n}\r\n.parameter-workspace .parameter-trends--inline {\r\n  padding: 14px 0 8px;\r\n}\r\n.parameter-workspace .parameter-trends--inline > .parameter-trend-note {\r\n  margin-top: 10px;\r\n}\r\n.parameter-workspace .parameter-trend-chart {\r\n  margin: 12px 0;\r\n}\r\n.parameter-workspace button:focus-visible,\r\n.parameter-workspace summary:focus-visible {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 3px;\r\n}\r\n@media (max-width: 900px) {\r\n  .parameter-single-entry__fields {\r\n    grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  }\r\n}\r\n@media (max-width: 600px) {\r\n  .parameter-single-entry {\r\n    padding: 14px;\r\n  }\r\n  .parameter-single-entry__heading {\r\n    align-items: start;\r\n  }\r\n  .parameter-single-entry .parameter-entry-clock {\r\n    flex-direction: column;\r\n    align-items: flex-end;\r\n    gap: 4px;\r\n  }\r\n  .parameter-single-entry .parameter-entry-clock > span:last-child {\r\n    text-align: right;\r\n    max-width: 150px;\r\n    font-size: 11px;\r\n  }\r\n  .parameter-single-entry__fields {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n    gap: 12px;\r\n  }\r\n  .parameter-single-entry__actions {\r\n    flex-wrap: wrap;\r\n  }\r\n  .parameter-single-entry__actions button {\r\n    width: 100%;\r\n  }\r\n  .parameter-workspace button,\r\n  .parameter-workspace .form-input,\r\n  .parameter-workspace .filter-chip {\r\n    min-height: 44px;\r\n  }\r\n  .parameter-workspace-summary > div {\r\n    display: grid;\r\n  }\r\n  .parameter-workspace-summary {\r\n    align-items: start;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Unified screen contract for structured data inside the patient record.\r\n   Print forms intentionally keep their dedicated A4 rules from print-forms.css. */\r\n@media screen {\r\n  .patient-record-view {\r\n    --patient-data-radius: 12px;\r\n    --patient-data-header-height: 46px;\r\n    --patient-data-row-height: 46px;\r\n    --patient-data-cell-x: 14px;\r\n    --patient-data-header-bg: var(--surface-raised, #f3f6fb);\r\n    --patient-data-label-bg: var(--surface-raised, #f3f6fb);\r\n    --patient-data-border: var(--border, #e6ebf2);\r\n  }\r\n\r\n  .patient-diary-filters {\r\n    align-self: flex-start;\r\n    max-width: calc(100% - 48px);\r\n    margin: 8px 24px 12px;\r\n    box-sizing: border-box;\r\n  }\r\n\r\n  /* One surface and one header treatment for every clinical section. */\r\n  .patient-record-view :is(.clinical-card, .cts, .cr-profilo-group, .narrative-section) {\r\n    background: var(--surface, #fff);\r\n    border: 1px solid var(--patient-data-border);\r\n    border-radius: var(--patient-data-radius);\r\n    box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04);\r\n    overflow: hidden;\r\n  }\r\n\r\n  .patient-record-view .clinical-card + .clinical-card {\r\n    margin-top: 12px;\r\n  }\r\n\r\n  .patient-record-view :is(.clinical-card__header, .cts__header) {\r\n    width: 100%;\r\n    min-height: var(--patient-data-header-height);\r\n    height: auto;\r\n    padding: 7px var(--patient-data-cell-x);\r\n    background: var(--patient-data-header-bg);\r\n    border: 0;\r\n    border-bottom: 1px solid var(--patient-data-border);\r\n    color: var(--text, #16202e);\r\n  }\r\n\r\n  .patient-record-view .clinical-card__title,\r\n  .patient-record-view .cts__title {\r\n    margin: 0;\r\n    color: var(--text, #16202e);\r\n    font-size: 13px;\r\n    font-weight: 700;\r\n    letter-spacing: 0.01em;\r\n    text-transform: none;\r\n  }\r\n\r\n  .patient-record-view :is(.clinical-card__actions, .cts__header-right) {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 6px;\r\n  }\r\n\r\n  .patient-record-view .clinical-card__edit,\r\n  .patient-record-view .cts__header-right .btn-sm {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    min-height: 32px;\r\n    padding: 5px 10px;\r\n    border: 1px solid #cfd9ea;\r\n    border-radius: 8px;\r\n    background: var(--surface, #fff);\r\n    color: var(--blue, #2f6bed);\r\n    font-size: 12px;\r\n    font-weight: 700;\r\n    line-height: 1;\r\n  }\r\n\r\n  .patient-record-view .clinical-card__edit:hover,\r\n  .patient-record-view .cts__header-right .btn-sm:hover {\r\n    border-color: #9cb8f4;\r\n    background: var(--indigo-bg, #eef3fe);\r\n  }\r\n\r\n  .patient-record-view .clinical-card__content-inner:has(> :is(.cr-form-section, .pic-edit-form)) {\r\n    padding: 0;\r\n  }\r\n\r\n  .patient-record-view .clinical-card .cr-form-section {\r\n    gap: 0;\r\n    padding: 0;\r\n    border: 0;\r\n    border-radius: 0;\r\n    box-shadow: none;\r\n  }\r\n\r\n  .patient-record-view .pic-edit-form {\r\n    gap: 12px;\r\n    padding: 16px;\r\n    background: var(--surface-raised, #f3f6fb);\r\n  }\r\n\r\n  /* Canonical key/value data row used by intake, profile and legacy summaries. */\r\n  .patient-record-view .pic-row {\r\n    display: grid;\r\n    grid-template-columns: minmax(180px, 34%) minmax(0, 1fr);\r\n    align-items: stretch;\r\n    gap: 0;\r\n    min-height: var(--patient-data-row-height);\r\n    padding: 0;\r\n    border-bottom: 1px solid var(--divider, #f0f3f8);\r\n    font-size: 13.5px;\r\n  }\r\n\r\n  .patient-record-view .pic-row:last-child {\r\n    border-bottom: 0;\r\n  }\r\n\r\n  .patient-record-view .pic-row__lbl,\r\n  .patient-record-view .pic-row__val {\r\n    display: flex;\r\n    min-width: 0;\r\n    padding: 10px var(--patient-data-cell-x);\r\n    align-items: center;\r\n  }\r\n\r\n  .patient-record-view .pic-row__lbl {\r\n    background: var(--patient-data-label-bg);\r\n    color: var(--text-muted, #5a6b80);\r\n    font-size: 12.5px;\r\n    font-weight: 600;\r\n  }\r\n\r\n  .patient-record-view .pic-row__val {\r\n    justify-content: flex-end;\r\n    margin: 0;\r\n    color: var(--text, #16202e);\r\n    font-size: 13.5px;\r\n    font-weight: 600;\r\n    text-align: right;\r\n    overflow-wrap: anywhere;\r\n  }\r\n\r\n  .patient-record-view\r\n    .inline-edit-row:is(:hover, :focus-visible)\r\n    > :is(.pic-row__lbl, .pic-row__val) {\r\n    background: var(--indigo-bg, #eef3fe);\r\n  }\r\n\r\n  .patient-record-view .pic-row--danger > :is(.pic-row__lbl, .pic-row__val) {\r\n    background: #fef2f2;\r\n    color: #b42318;\r\n  }\r\n\r\n  .patient-record-view\r\n    .pic-row--danger:is(:hover, :focus-visible)\r\n    > :is(.pic-row__lbl, .pic-row__val) {\r\n    background: #fee4e2;\r\n  }\r\n\r\n  .patient-record-view .pic-row .inline-edit__value {\r\n    align-self: center;\r\n    justify-self: end;\r\n    min-height: 34px;\r\n    margin: 5px 8px;\r\n    padding: 5px 8px;\r\n  }\r\n\r\n  .patient-record-view .pic-row--editing {\r\n    align-items: stretch;\r\n    padding: 0;\r\n    background: var(--surface-raised, #f3f6fb);\r\n  }\r\n\r\n  .patient-record-view .pic-row--editing .inline-edit__control {\r\n    padding: 6px 8px;\r\n  }\r\n\r\n  /* Profile data follows the same label/value hierarchy without nested-card shadows. */\r\n  .patient-record-view .cr-profilo-grid {\r\n    gap: 12px;\r\n  }\r\n\r\n  .patient-record-view .cr-profilo-group {\r\n    padding: 0;\r\n    gap: 0;\r\n  }\r\n\r\n  .patient-record-view .cr-profilo-group__title {\r\n    min-height: 42px;\r\n    margin: 0;\r\n    padding: 12px var(--patient-data-cell-x);\r\n    background: var(--patient-data-header-bg);\r\n    border-bottom: 1px solid var(--patient-data-border);\r\n    color: var(--text, #16202e);\r\n    font-size: 12px;\r\n    font-weight: 700;\r\n    letter-spacing: 0.04em;\r\n  }\r\n\r\n  .patient-record-view .cr-profilo-row {\r\n    display: grid;\r\n    grid-template-columns: minmax(120px, 42%) minmax(0, 1fr);\r\n    align-items: stretch;\r\n    gap: 0;\r\n    min-height: 42px;\r\n    border-bottom: 1px solid var(--divider, #f0f3f8);\r\n    font-size: 13px;\r\n  }\r\n\r\n  .patient-record-view .cr-profilo-row:last-child {\r\n    border-bottom: 0;\r\n  }\r\n\r\n  .patient-record-view .cr-profilo-row > :is(span:first-child, strong) {\r\n    display: flex;\r\n    align-items: center;\r\n    min-width: 0;\r\n    padding: 9px var(--patient-data-cell-x);\r\n  }\r\n\r\n  .patient-record-view .cr-profilo-row > span:first-child {\r\n    background: var(--patient-data-label-bg);\r\n    color: var(--text-muted, #5a6b80);\r\n    font-weight: 600;\r\n  }\r\n\r\n  .patient-record-view .cr-profilo-row > strong {\r\n    justify-content: flex-end;\r\n    color: var(--text, #16202e);\r\n    font-weight: 600;\r\n    text-align: right;\r\n  }\r\n\r\n  /* Narrative and list-like records share the same restrained chrome. */\r\n  .patient-record-view :is(.cr-item-row, .diario-card) {\r\n    border: 1px solid var(--patient-data-border);\r\n    border-radius: var(--patient-data-radius);\r\n    background: var(--surface, #fff);\r\n    box-shadow: none;\r\n  }\r\n\r\n  .patient-record-view .cr-legacy-anamnesi-row {\r\n    display: grid;\r\n    grid-template-columns: minmax(180px, 34%) minmax(0, 1fr);\r\n    gap: 0;\r\n    padding: 0;\r\n    border-bottom: 1px solid var(--divider, #f0f3f8);\r\n  }\r\n\r\n  .patient-record-view .cr-legacy-anamnesi-row__label,\r\n  .patient-record-view .cr-legacy-anamnesi-row__value {\r\n    margin: 0;\r\n    padding: 10px var(--patient-data-cell-x);\r\n  }\r\n\r\n  .patient-record-view .cr-legacy-anamnesi-row__label {\r\n    background: var(--patient-data-label-bg);\r\n    font-size: 12.5px;\r\n    letter-spacing: 0.01em;\r\n    text-transform: none;\r\n  }\r\n\r\n  /* Every semantic and module table receives the same screen-only table contract. */\r\n  .patient-record-view\r\n    :is(\r\n      .clinicos-table,\r\n      .parametri-modulo-table,\r\n      .braden-modulo-table,\r\n      .med-modulo-table,\r\n      .med-followup-table\r\n    ) {\r\n    width: 100%;\r\n    border-collapse: separate;\r\n    border-spacing: 0;\r\n    border: 1px solid var(--patient-data-border);\r\n    border-radius: var(--patient-data-radius);\r\n    background: var(--surface, #fff);\r\n    color: var(--text, #16202e);\r\n    font-family: var(--font-ui);\r\n    font-size: 13px;\r\n    overflow: hidden;\r\n  }\r\n\r\n  .patient-record-view\r\n    :is(\r\n      .clinicos-table,\r\n      .parametri-modulo-table,\r\n      .braden-modulo-table,\r\n      .med-modulo-table,\r\n      .med-followup-table\r\n    )\r\n    thead\r\n    th {\r\n    min-height: 42px;\r\n    padding: 10px var(--patient-data-cell-x);\r\n    background: var(--patient-data-header-bg);\r\n    border: 0;\r\n    border-bottom: 1px solid var(--patient-data-border);\r\n    color: var(--text-muted, #5a6b80);\r\n    font-family: var(--font-ui);\r\n    font-size: 11.5px;\r\n    font-weight: 700;\r\n    letter-spacing: 0.04em;\r\n    line-height: 1.25;\r\n    text-align: left;\r\n    text-transform: uppercase;\r\n  }\r\n\r\n  .patient-record-view\r\n    :is(\r\n      .clinicos-table,\r\n      .parametri-modulo-table,\r\n      .braden-modulo-table,\r\n      .med-modulo-table,\r\n      .med-followup-table\r\n    )\r\n    tbody\r\n    td {\r\n    min-height: var(--patient-data-row-height);\r\n    height: auto;\r\n    padding: 10px var(--patient-data-cell-x);\r\n    border: 0;\r\n    border-bottom: 1px solid var(--divider, #f0f3f8);\r\n    background: var(--surface, #fff);\r\n    color: var(--text, #16202e);\r\n    font-family: var(--font-ui);\r\n    font-size: 13px;\r\n    vertical-align: middle;\r\n  }\r\n\r\n  .patient-record-view\r\n    :is(\r\n      .clinicos-table,\r\n      .parametri-modulo-table,\r\n      .braden-modulo-table,\r\n      .med-modulo-table,\r\n      .med-followup-table\r\n    )\r\n    tbody\r\n    tr:nth-child(even):not(.totale-row)\r\n    > td {\r\n    background: var(--surface-raised, #f3f6fb);\r\n  }\r\n\r\n  .patient-record-view\r\n    :is(\r\n      .clinicos-table,\r\n      .parametri-modulo-table,\r\n      .braden-modulo-table,\r\n      .med-modulo-table,\r\n      .med-followup-table\r\n    )\r\n    tbody\r\n    tr:not(.totale-row):hover\r\n    > td {\r\n    background: var(--indigo-bg, #eef3fe);\r\n  }\r\n\r\n  .patient-record-view\r\n    :is(\r\n      .clinicos-table,\r\n      .parametri-modulo-table,\r\n      .braden-modulo-table,\r\n      .med-modulo-table,\r\n      .med-followup-table\r\n    )\r\n    tbody\r\n    tr:last-child\r\n    > td {\r\n    border-bottom: 0;\r\n  }\r\n\r\n  .patient-record-view .clinicos-table-wrap {\r\n    margin-bottom: 12px;\r\n    border: 0;\r\n    border-radius: var(--patient-data-radius);\r\n    box-shadow: none;\r\n    overflow-x: auto;\r\n    scrollbar-gutter: stable;\r\n  }\r\n\r\n  .patient-record-view :is(.fm, .modulo-content, .clinical-card__content-inner) {\r\n    max-width: 100%;\r\n  }\r\n\r\n  .patient-record-view :is(.fm, .modulo-content) {\r\n    overflow-x: auto;\r\n    scrollbar-gutter: stable;\r\n  }\r\n\r\n  /* Horizontal rails stay available to touch, trackpads and keyboard-focused controls,\r\n     but do not add a second visual hierarchy made of native scrollbar tracks. */\r\n  .patient-record-view\r\n    :is(.top-nav__items, .clinicos-table-wrap, .parametri-grid-wrapper, .fm, .modulo-content) {\r\n    -ms-overflow-style: none;\r\n    scrollbar-width: none;\r\n  }\r\n\r\n  .patient-record-view\r\n    :is(\r\n      .top-nav__items,\r\n      .clinicos-table-wrap,\r\n      .parametri-grid-wrapper,\r\n      .fm,\r\n      .modulo-content\r\n    )::-webkit-scrollbar {\r\n    display: none;\r\n    width: 0;\r\n    height: 0;\r\n  }\r\n\r\n  .patient-record-view\r\n    :is(\r\n      .clinical-card__header,\r\n      .cts__header,\r\n      .clinical-card__edit,\r\n      .inline-edit-row\r\n    ):focus-visible {\r\n    outline: 3px solid color-mix(in srgb, var(--blue, #2f6bed) 30%, transparent);\r\n    outline-offset: -2px;\r\n  }\r\n\r\n  @media (max-width: 768px) {\r\n    .patient-record-view {\r\n      --patient-data-cell-x: 12px;\r\n    }\r\n\r\n    .patient-record-view .pic-row,\r\n    .patient-record-view .cr-profilo-row,\r\n    .patient-record-view .cr-legacy-anamnesi-row {\r\n      grid-template-columns: minmax(0, 1fr);\r\n    }\r\n\r\n    .patient-record-view .pic-row__val,\r\n    .patient-record-view .cr-profilo-row > strong {\r\n      justify-content: flex-start;\r\n      text-align: left;\r\n    }\r\n\r\n    .patient-record-view .pic-row .inline-edit__value {\r\n      justify-self: stretch;\r\n      margin: 5px 8px;\r\n    }\r\n\r\n    .patient-record-view\r\n      :is(.parametri-modulo-table, .braden-modulo-table, .med-modulo-table, .med-followup-table) {\r\n      min-width: 680px;\r\n    }\r\n  }\r\n}\r\n/* Temporal urgency is separate from author role and historical acknowledgement. */\r\n.patient-record-view .diario-card.diario-card--urgent { border-left: 4px solid #b42335; background: #fffafb; }\r\n.patient-record-view .diario-card.diario-card--taken { border-left: 4px solid #8291a6; }\r\n.patient-record-view .cr-alert-band { margin: 16px 0 24px; gap: 12px; }\r\n@media screen {\r\n  .patient-record-view .cr-detail-content { display:flex; flex-direction:column; gap:16px; padding:0; }\r\n  .patient-record-view .chart-part { display:flex; flex:0 0 auto; flex-direction:column; gap:16px; margin:0; padding:0; }\r\n  .patient-record-view .cr-tab-content { display:flex; flex:0 0 auto; flex-direction:column; gap:16px; padding:0; margin:0; }\r\n  .patient-record-view :is(.cr-tab-content, .chart-part) > .cts { margin:0; }\r\n  .patient-record-view .assessment-catalog { margin-inline:0; }\r\n  .patient-record-view .cr-profilo-grid { grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr)); margin-top:0 !important; }\r\n}\r\n.patient-contacts { border-top:1px solid var(--border); margin-top:12px; padding-top:12px; }\r\n.patient-contacts__header { display:flex; align-items:center; justify-content:space-between; gap:12px; }\r\n.patient-contacts h4 { margin:0; }\r\n.patient-contacts dl { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr)); gap:8px 16px; margin:12px 0; }\r\n.patient-contacts dl > div { min-width:0; }\r\n.patient-contacts dt { color:var(--text-muted); font-size:12px; }\r\n.patient-contacts dd { margin:3px 0; overflow-wrap:anywhere; }\r\n.clinical-card__content[hidden] { display:none !important; }\r\n.patient-record-view .narrative-sections { display:flex; flex-direction:column; gap:16px; margin:0; padding:0; }\r\n.patient-record-view .narrative-sections:empty { display:none; }\r\n@media print { .clinical-card__content[hidden] { display:block !important; height:auto !important; } }\r\n.patient-record-view .cr-alert-strip { min-height: 48px; padding: 12px 16px; gap: 12px; border-radius: 12px; line-height: 1.5; }\r\n.patient-record-view .cr-alert-strip--allergie { color: #8f5500; background: #fdf3e2; border: 1px solid #ead0a7; border-left: 4px solid #8f5500; }\r\n.patient-record-view .cr-alert-strip--allergie:hover { background: #fae9cc; }\r\n.patient-record-view .cr-alert-strip--allergie.cr-alert-strip--severe {\r\n  color: #b42335;\r\n  background: #fdecee;\r\n  border-color: #efc3cb;\r\n  border-left-color: #b42335;\r\n}\r\n.patient-record-view .cr-alert-strip--allergie.cr-alert-strip--severe:hover { background: #fbe0e5; }\r\n.patient-record-view .cr-alert-strip > span { overflow-wrap: anywhere; }\r\n.patient-record-view .patient-allergy-strip { margin-bottom: 20px; padding: 12px 16px; background: #fdf3e2; border-color: #ead0a7; color: #8f5500; }\r\n"],["STYLE",{},"/* Compact overview only; full clinical editors and handoff cards keep their layout. */\r\n.patient-record-view .cr-tab-content--overview {\r\n  gap: 12px;\r\n}\r\n\r\n.patient-record-view .cr-overview-section {\r\n  padding: 12px;\r\n}\r\n\r\n.patient-record-view .cr-overview-section__header {\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-riepilogo-grid {\r\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));\r\n  gap: 10px;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-riepilogo-card {\r\n  gap: 4px;\r\n  padding: 10px 12px 4px;\r\n  border-left-width: 3px;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-riepilogo-card__title {\r\n  min-height: 24px;\r\n  grid-template-columns: 16px minmax(0, 1fr) auto;\r\n  gap: 6px;\r\n  font-size: 13px;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-overview-count {\r\n  grid-column: auto;\r\n  justify-self: end;\r\n  min-height: 22px;\r\n  max-width: 130px;\r\n  padding: 2px 6px;\r\n  font-size: 10.5px;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-empty {\r\n  margin: 2px 0;\r\n  font-size: 12.5px;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-overview-action {\r\n  min-height: 44px;\r\n  margin-top: 0;\r\n  padding: 5px 0;\r\n  font-weight: 700;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-compact-item {\r\n  gap: 4px 6px;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-compact-item__main {\r\n  white-space: normal;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-compact-item__sub {\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n/* Keep the complete narrative in the diagnosis dialog, with a bounded overview. */\r\n.patient-record-view .cr-tab-content--overview .cr-riepilogo-card--diagnosi {\r\n  display: grid;\r\n  grid-template-rows: auto minmax(0, 1fr) auto;\r\n  height: 10rem;\r\n}\r\n\r\n.patient-record-view .cr-riepilogo-card--diagnosi .cr-compact-list {\r\n  min-height: 0;\r\n  overflow: hidden;\r\n  gap: 4px;\r\n}\r\n\r\n.patient-record-view .cr-riepilogo-card--diagnosi .cr-compact-item {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) auto auto;\r\n  align-items: start;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.patient-record-view .cr-riepilogo-card--diagnosi .cr-compact-item__main {\r\n  display: -webkit-box;\r\n  -webkit-box-orient: vertical;\r\n  -webkit-line-clamp: 1;\r\n  overflow: hidden;\r\n  line-height: 1.35;\r\n}\r\n\r\n.patient-record-view\r\n  .cr-riepilogo-card--diagnosi\r\n  .cr-compact-item:only-child\r\n  .cr-compact-item__main {\r\n  -webkit-line-clamp: 3;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-compact-item--farmaco {\r\n  grid-template-columns: minmax(0, 1fr) minmax(0, 0.65fr);\r\n  align-items: start;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-compact-item__dose {\r\n  white-space: normal;\r\n  overflow-wrap: anywhere;\r\n  text-align: right;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-compact-item--farmaco .cr-compact-item__sub {\r\n  grid-column: 1 / -1;\r\n}\r\n\r\n.patient-record-view .cr-riepilogo-card--allergie .cr-compact-item {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) auto;\r\n}\r\n\r\n.patient-record-view .cr-riepilogo-card--allergie .cr-compact-item__main {\r\n  grid-column: 1 / -1;\r\n}\r\n\r\n.cr-overview-handoffs {\r\n  display: grid;\r\n  gap: 6px;\r\n  margin: 2px 0;\r\n  padding: 0;\r\n  list-style: none;\r\n}\r\n\r\n.cr-overview-handoff + .cr-overview-handoff {\r\n  padding-top: 6px;\r\n  border-top: 1px solid var(--border, #e3e9f1);\r\n}\r\n\r\n.cr-overview-handoff .consegna-card__top {\r\n  gap: 6px;\r\n  margin: 0;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.cr-overview-handoff__note {\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 2;\r\n  -webkit-box-orient: vertical;\r\n  overflow: hidden;\r\n  overflow-wrap: anywhere;\r\n  margin: 2px 0 0;\r\n  color: var(--text-muted, #65778c);\r\n  font-size: 12.5px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.cr-overview-placement {\r\n  display: grid;\r\n  gap: 3px;\r\n  margin: 2px 0;\r\n  font-size: 12.5px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.cr-overview-placement > div {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 10px;\r\n}\r\n\r\n.cr-overview-placement dt {\r\n  color: var(--text-muted, #65778c);\r\n}\r\n\r\n.cr-overview-placement dd {\r\n  margin: 0;\r\n  font-weight: 500;\r\n  text-align: right;\r\n  overflow-wrap: anywhere;\r\n  min-width: 0;\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  .patient-record-view .cr-overview-section {\r\n    padding: 10px;\r\n  }\r\n\r\n  .patient-record-view .cr-tab-content--overview .cr-riepilogo-grid {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }\r\n\r\n  .patient-record-view .cr-tab-content--overview .cr-overview-count {\r\n    max-width: 104px;\r\n  }\r\n}\r\n"],["STYLE",{},"/* UX2 W8 — stato dell'urgenza su una nota (diario / consegna). Rosso solo per l'urgenza ATTIVA\r\n   (allerta clinica); la traccia «presa in carico» è testo muted, sempre visibile. */\r\n.urgency-notice {\r\n  display: flex;\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n  gap: 8px 12px;\r\n  margin-top: 12px;\r\n  padding-top: 10px;\r\n  border-top: 1px solid var(--divider, var(--border));\r\n}\r\n.urgency-notice__text {\r\n  flex: 1 1 200px;\r\n  min-width: 0;\r\n  font-size: 13px;\r\n  line-height: 20px;\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n}\r\n.urgency-notice--active .urgency-notice__text {\r\n  font-weight: 600;\r\n  color: var(--red);\r\n}\r\n.urgency-notice__btn {\r\n  min-height: 44px;\r\n  margin-left: auto;\r\n}\r\n"],["STYLE",{},".table-filters {\r\n  background: var(--surface);\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.table-filters__toolbar {\r\n  min-height: calc(var(--ds-control-h) + 12px);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  padding: 6px 14px;\r\n  background: color-mix(in srgb, var(--surface-raised) 72%, var(--surface));\r\n}\r\n\r\n.table-filters__toggle {\r\n  min-width: 0;\r\n  min-height: var(--touch-target);\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  padding: 5px 8px;\r\n  color: var(--text);\r\n  background: transparent;\r\n  border: 0;\r\n  border-radius: 8px;\r\n  font: inherit;\r\n  text-align: left;\r\n  cursor: pointer;\r\n}\r\n\r\n.table-filters__toggle:hover {\r\n  background: var(--hover);\r\n}\r\n\r\n.table-filters__toggle:focus-visible,\r\n.table-filters__clear:focus-visible,\r\n.table-filters__field :is(input, select):focus-visible {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 2px;\r\n}\r\n\r\n.table-filters__icon {\r\n  width: 32px;\r\n  height: 32px;\r\n  flex: 0 0 32px;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: var(--blue);\r\n  background: var(--blue-glow);\r\n  border-radius: 8px;\r\n}\r\n\r\n.table-filters__icon svg {\r\n  width: 17px;\r\n  height: 17px;\r\n}\r\n\r\n.table-filters__toggle-copy {\r\n  min-width: 0;\r\n  display: grid;\r\n  gap: 1px;\r\n}\r\n\r\n.table-filters__title {\r\n  color: var(--text);\r\n  font-size: 12px;\r\n  font-weight: 750;\r\n}\r\n\r\n.table-filters__hint {\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  font-weight: 500;\r\n}\r\n\r\n.table-filters__active-badge {\r\n  min-width: 22px;\r\n  height: 22px;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 0 6px;\r\n  color: #fff;\r\n  background: var(--blue);\r\n  border-radius: 999px;\r\n  font-size: 11px;\r\n  font-weight: 750;\r\n}\r\n\r\n.table-filters__chevron {\r\n  width: 16px;\r\n  height: 16px;\r\n  display: inline-flex;\r\n  color: var(--text-muted);\r\n  transition: transform 0.16s ease;\r\n}\r\n\r\n.table-filters__chevron svg {\r\n  width: 16px;\r\n  height: 16px;\r\n}\r\n\r\n.table-filters.is-open .table-filters__chevron {\r\n  transform: rotate(180deg);\r\n}\r\n\r\n.table-filters__summary {\r\n  flex-shrink: 0;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n}\r\n\r\n.table-filters__results {\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  white-space: nowrap;\r\n}\r\n\r\n.table-filters__clear {\r\n  min-height: var(--touch-target);\r\n  padding: 6px 10px;\r\n  color: var(--blue);\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  font: inherit;\r\n  font-size: 11px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n}\r\n\r\n.table-filters__clear:hover {\r\n  border-color: var(--blue);\r\n  background: var(--blue-glow);\r\n}\r\n\r\n.table-filters__panel {\r\n  padding: 14px;\r\n  background: var(--surface);\r\n  border-top: 1px solid var(--divider);\r\n}\r\n\r\n.table-filters__grid {\r\n  display: grid;\r\n  gap: 12px;\r\n}\r\n\r\n.table-filters__grid--1 {\r\n  grid-template-columns: minmax(0, 1fr);\r\n}\r\n\r\n.table-filters__grid--2 {\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n}\r\n\r\n.table-filters__grid--3 {\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n}\r\n\r\n.table-filters__grid--4 {\r\n  grid-template-columns: repeat(4, minmax(0, 1fr));\r\n}\r\n\r\n.table-filters__field {\r\n  min-width: 0;\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n\r\n.table-filters__field label {\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  font-weight: 750;\r\n  letter-spacing: 0.45px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.table-filters__field :is(input, select) {\r\n  width: 100%;\r\n  min-width: 0;\r\n  min-height: var(--touch-target);\r\n  padding: 0 11px;\r\n  color: var(--text);\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  font: inherit;\r\n  font-size: var(--ds-field-font);\r\n}\r\n\r\n.table-filters__field :is(input, select):hover {\r\n  border-color: var(--text-xmuted);\r\n}\r\n\r\n.table-filters__field :is(input, select):focus {\r\n  border-color: var(--blue);\r\n  box-shadow: var(--shadow-focus);\r\n}\r\n\r\n.table-filters__field input::placeholder {\r\n  color: var(--text-xmuted);\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .table-filters__grid--3,\r\n  .table-filters__grid--4 {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  .table-filters__toolbar {\r\n    align-items: stretch;\r\n    flex-direction: column;\r\n    gap: 4px;\r\n    padding: 8px 10px;\r\n  }\r\n\r\n  .table-filters__toggle {\r\n    width: 100%;\r\n  }\r\n\r\n  .table-filters__summary {\r\n    min-height: 36px;\r\n    justify-content: space-between;\r\n    padding: 0 8px;\r\n  }\r\n\r\n  .table-filters__panel {\r\n    padding: 12px 10px;\r\n  }\r\n\r\n  .table-filters__grid--1,\r\n  .table-filters__grid--2,\r\n  .table-filters__grid--3,\r\n  .table-filters__grid--4 {\r\n    grid-template-columns: 1fr;\r\n    gap: 10px;\r\n  }\r\n}\r\n"],["STYLE",{},".op-management .operator-editor {\r\n  padding: 0;\r\n  overflow: hidden;\r\n  border-radius: 8px;\r\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);\r\n}\r\n\r\n.op-management .operator-editor__header {\r\n  min-height: 64px;\r\n  margin: 0;\r\n  padding: 12px 16px;\r\n  align-items: flex-start;\r\n  background: var(--surface-raised);\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.operator-editor__heading {\r\n  min-width: 0;\r\n}\r\n\r\n.operator-editor__eyebrow,\r\n.operator-editor__section > legend,\r\n.operator-editor__color-field > legend {\r\n  color: var(--text-xmuted);\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  letter-spacing: 0.65px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.operator-editor__eyebrow {\r\n  display: block;\r\n  margin-bottom: 2px;\r\n}\r\n\r\n.op-management .operator-editor .op-form-panel__title {\r\n  font-size: 16px;\r\n  line-height: 1.25;\r\n}\r\n\r\n.operator-editor__intro {\r\n  margin: 3px 0 0;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.operator-editor__close {\r\n  flex-shrink: 0;\r\n}\r\n\r\n.operator-editor__body {\r\n  padding: 0 16px;\r\n}\r\n\r\n.operator-editor__section {\r\n  min-width: 0;\r\n  margin: 0;\r\n  padding: 13px 0 15px;\r\n  border: 0;\r\n  border-bottom: 1px solid var(--divider);\r\n}\r\n\r\n.operator-editor__section > legend {\r\n  width: 100%;\r\n  margin: 0;\r\n  padding: 0 0 9px;\r\n}\r\n\r\n.operator-editor__grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(6, minmax(0, 1fr));\r\n  gap: 12px;\r\n}\r\n\r\n.operator-editor__field--span-2 {\r\n  grid-column: span 2;\r\n}\r\n\r\n.operator-editor__field--span-3 {\r\n  grid-column: span 3;\r\n}\r\n\r\n.operator-editor .form-field,\r\n.operator-editor .form-input,\r\n.operator-editor .form-select {\r\n  min-width: 0;\r\n}\r\n\r\n.operator-editor .form-input,\r\n.operator-editor .form-select {\r\n  width: 100%;\r\n}\r\n\r\n.operator-editor__optional {\r\n  margin: 0;\r\n  border-bottom: 0;\r\n}\r\n\r\n.operator-editor__optional > summary {\r\n  min-height: 46px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  padding: 0;\r\n  color: var(--text);\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n  list-style-position: inside;\r\n}\r\n\r\n.operator-editor__optional > summary:hover {\r\n  color: var(--blue);\r\n}\r\n\r\n.operator-editor__optional-title {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.operator-editor__selected-color {\r\n  width: 10px;\r\n  height: 10px;\r\n  flex-shrink: 0;\r\n  border-radius: 50%;\r\n  box-shadow: 0 0 0 1px var(--border);\r\n}\r\n\r\n.operator-editor__optional-badge {\r\n  margin-left: auto;\r\n  padding: 2px 8px;\r\n  border-radius: 999px;\r\n  color: var(--text-muted);\r\n  background: var(--surface-raised);\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.3px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.operator-editor__optional-content {\r\n  display: grid;\r\n  grid-template-columns: minmax(260px, 1fr) minmax(0, 2fr);\r\n  gap: 16px;\r\n  padding: 4px 0 15px;\r\n}\r\n\r\n.operator-editor__color-field {\r\n  min-width: 0;\r\n  margin: 0;\r\n  padding: 0;\r\n  border: 0;\r\n}\r\n\r\n.operator-editor__color-field > legend {\r\n  margin-bottom: 7px;\r\n}\r\n\r\n.operator-editor__color-picker {\r\n  display: flex;\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n  gap: 6px;\r\n}\r\n\r\n.operator-editor__color-swatch {\r\n  width: 40px;\r\n  height: 40px;\r\n  padding: 0;\r\n  border: 8px solid var(--surface);\r\n  border-radius: 50%;\r\n  outline: 1px solid var(--border);\r\n  cursor: pointer;\r\n}\r\n\r\n.operator-editor__color-swatch:hover {\r\n  outline-color: var(--blue);\r\n}\r\n\r\n.operator-editor__color-swatch.is-selected {\r\n  outline: 2px solid var(--text);\r\n  outline-offset: 1px;\r\n}\r\n\r\n.operator-editor__color-swatch:focus-visible,\r\n.operator-editor__custom-color:focus-within {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 2px;\r\n}\r\n\r\n.operator-editor__custom-color {\r\n  min-height: 40px;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 7px;\r\n  padding-left: 4px;\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n}\r\n\r\n.operator-editor__custom-color input {\r\n  width: 40px;\r\n  height: 40px;\r\n  padding: 4px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  background: var(--surface);\r\n  cursor: pointer;\r\n}\r\n\r\n.operator-editor__notes textarea {\r\n  min-height: 72px;\r\n}\r\n\r\n.op-management .operator-editor__actions {\r\n  min-height: 62px;\r\n  align-items: center;\r\n  margin: 0;\r\n  padding: 9px 16px;\r\n  background: var(--surface-raised);\r\n  border-top: 1px solid var(--border);\r\n}\r\n\r\n.operator-editor__required-note {\r\n  margin-right: auto;\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n}\r\n\r\n.operator-editor__required-note > span {\r\n  color: var(--red);\r\n  font-weight: 700;\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .op-management .cts .clinicos-table-wrap {\r\n    display: none;\r\n  }\r\n\r\n  .operator-editor__grid {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n\r\n  .operator-editor__field--span-2,\r\n  .operator-editor__field--span-3 {\r\n    grid-column: span 1;\r\n  }\r\n\r\n  .operator-editor__optional-content {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n\r\n@media (max-width: 520px) {\r\n  .op-management .operator-editor__header {\r\n    padding: 12px;\r\n  }\r\n\r\n  .operator-editor__intro {\r\n    max-width: 30ch;\r\n  }\r\n\r\n  .operator-editor__body {\r\n    padding: 0 12px;\r\n  }\r\n\r\n  .operator-editor__grid {\r\n    grid-template-columns: 1fr;\r\n    gap: 10px;\r\n  }\r\n\r\n  .op-management .operator-editor__actions {\r\n    flex-wrap: wrap;\r\n    padding: 10px 12px;\r\n  }\r\n\r\n  .operator-editor__required-note {\r\n    width: 100%;\r\n  }\r\n\r\n  .operator-editor__actions .btn-secondary,\r\n  .operator-editor__actions .btn-success {\r\n    flex: 1;\r\n    justify-content: center;\r\n  }\r\n}\r\n"],["STYLE",{},".patient-combobox {\r\n  position: relative;\r\n  min-width: 0;\r\n}\r\n\r\n.patient-combobox__control {\r\n  position: relative;\r\n}\r\n\r\n.patient-combobox__search-icon {\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 12px;\r\n  z-index: 1;\r\n  width: 18px;\r\n  height: 18px;\r\n  color: var(--text-muted);\r\n  pointer-events: none;\r\n  transform: translateY(-50%);\r\n}\r\n\r\n.patient-combobox__search-icon svg,\r\n.patient-combobox__clear svg {\r\n  width: 18px;\r\n  height: 18px;\r\n}\r\n\r\n.patient-combobox .patient-combobox__input {\r\n  min-width: 0;\r\n  width: 100%;\r\n  padding-right: 46px;\r\n  padding-left: 40px;\r\n}\r\n\r\n.patient-combobox__clear {\r\n  position: absolute;\r\n  top: 50%;\r\n  right: 4px;\r\n  display: grid;\r\n  width: 44px;\r\n  height: 44px;\r\n  padding: 0;\r\n  border: 0;\r\n  border-radius: 7px;\r\n  color: var(--text-muted);\r\n  background: transparent;\r\n  cursor: pointer;\r\n  place-items: center;\r\n  transform: translateY(-50%);\r\n}\r\n\r\n.patient-combobox__clear:hover,\r\n.patient-combobox__clear:focus-visible {\r\n  color: var(--blue);\r\n  background: var(--blue-dim);\r\n}\r\n\r\n.patient-combobox__help {\r\n  margin: 5px 0 0;\r\n  color: var(--text-muted);\r\n  font-size: 11.5px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.patient-combobox__selection {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 9px;\r\n  min-width: 0;\r\n  margin-top: 8px;\r\n  padding: 9px 11px;\r\n  border: 1px solid color-mix(in srgb, var(--emerald) 28%, var(--border));\r\n  border-radius: 8px;\r\n  color: var(--text);\r\n  background: var(--emerald-bg);\r\n}\r\n\r\n.patient-combobox__selection-icon {\r\n  display: grid;\r\n  width: 26px;\r\n  height: 26px;\r\n  flex: 0 0 26px;\r\n  border-radius: 50%;\r\n  color: var(--emerald);\r\n  background: var(--surface);\r\n  place-items: center;\r\n}\r\n\r\n.patient-combobox__selection-icon svg {\r\n  width: 15px;\r\n  height: 15px;\r\n}\r\n\r\n.patient-combobox__popup {\r\n  position: absolute;\r\n  top: calc(100% + 6px);\r\n  left: 0;\r\n  right: 0;\r\n  z-index: 250;\r\n  overflow: hidden;\r\n  border: 1px solid var(--border-strong, var(--border));\r\n  border-radius: 9px;\r\n  background: var(--surface);\r\n  box-shadow: 0 12px 30px rgba(20, 39, 72, 0.16);\r\n}\r\n\r\n.patient-combobox__list {\r\n  max-height: min(320px, 40vh);\r\n  margin: 0;\r\n  padding: 4px;\r\n  overflow-y: auto;\r\n  list-style: none;\r\n}\r\n\r\n.patient-combobox__option {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr);\r\n  gap: 12px;\r\n  align-items: center;\r\n  min-height: 52px;\r\n  padding: 8px 10px;\r\n  border-radius: 7px;\r\n  cursor: pointer;\r\n}\r\n\r\n.patient-combobox__option.is-active,\r\n.patient-combobox__option:hover {\r\n  background: var(--blue-dim);\r\n  box-shadow: inset 3px 0 0 var(--blue);\r\n}\r\n\r\n.patient-combobox__option-name {\r\n  overflow: hidden;\r\n  color: var(--text);\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.patient-combobox__option-identity {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-end;\r\n  color: var(--text-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 10.5px;\r\n  line-height: 1.35;\r\n}\r\n\r\n.patient-combobox__option-identity strong {\r\n  color: var(--text);\r\n  font-size: 11px;\r\n}\r\n\r\n.patient-combobox__status {\r\n  margin: 0;\r\n  padding: 13px 14px;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n}\r\n\r\n.patient-combobox__status--error {\r\n  color: var(--red);\r\n}\r\n\r\n@media (max-width: 520px) {\r\n  .patient-combobox__option {\r\n    grid-template-columns: 1fr;\r\n    gap: 3px;\r\n  }\r\n\r\n  .patient-combobox__option-identity {\r\n    align-items: flex-start;\r\n  }\r\n}\r\n"],["STYLE",{},".tdose-list {\r\n  list-style: none;\r\n  margin: 6px 0 0;\r\n  padding: 0;\r\n  display: grid;\r\n  gap: 4px;\r\n  text-align: left;\r\n}\r\n.tdose {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1px;\r\n  padding: 3px 6px;\r\n  border-left: 3px solid var(--blue);\r\n  border-radius: 4px;\r\n  background: var(--surface, #fff);\r\n  font-size: 11.5px;\r\n  line-height: 1.35;\r\n  overflow-wrap: anywhere;\r\n}\r\n.tdose__who {\r\n  font-weight: 650;\r\n  color: var(--text);\r\n}\r\n.tdose__what {\r\n  color: var(--text);\r\n}\r\n.tdose__status {\r\n  font-weight: 600;\r\n  color: #1d4fc4;\r\n}\r\n.tdose--late,\r\n.tdose--missed {\r\n  border-left-color: var(--red);\r\n}\r\n.tdose--late .tdose__status,\r\n.tdose--missed .tdose__status {\r\n  color: #a5202f;\r\n}\r\n.tdose--done {\r\n  border-left-color: #16a37b;\r\n}\r\n.tdose--done .tdose__status {\r\n  color: #0e7a55;\r\n}\r\n.tdose-list__partial {\r\n  margin: 4px 0 0;\r\n  font-size: 11.5px;\r\n  color: var(--text-muted);\r\n}\r\n"],["STYLE",{},".therapy-modal .therapy-modal__body {\r\n  min-height: 0;\r\n  padding-top: 0;\r\n  scroll-padding-block: 160px 16px;\r\n}\r\n.therapy-modal .therapy-patient-group {\r\n  min-width: 0;\r\n  margin-bottom: 18px;\r\n  border: 1px solid var(--border, #dce3ec);\r\n  border-radius: 8px;\r\n  background: var(--surface, #fff);\r\n}\r\n.therapy-modal .therapy-patient-header {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 2;\r\n  margin: 0;\r\n  padding: 12px 16px;\r\n  border-top: 0;\r\n  border-bottom: 2px solid var(--border, #dce3ec);\r\n  border-radius: 7px 7px 0 0;\r\n  background: var(--surface, #fff);\r\n  box-shadow: 0 3px 5px rgb(26 51 87 / 8%);\r\n}\r\n.therapy-modal .patient-identity__name {\r\n  font-size: 18px;\r\n  font-weight: 750;\r\n}\r\n.therapy-modal .therapy-drug-row {\r\n  padding-block: 12px;\r\n  flex-wrap: wrap;\r\n}\r\n.therapy-modal .therapy-drug-row__info {\r\n  min-width: 0;\r\n  flex-basis: 180px;\r\n  overflow-wrap: anywhere;\r\n}\r\n.therapy-modal .therapy-drug-row__actions {\r\n  flex-wrap: wrap;\r\n  min-width: 0;\r\n  max-width: 100%;\r\n}\r\n.therapy-modal button,\r\n.therapy-modal input {\r\n  min-height: 44px;\r\n}\r\n.therapy-modal button {\r\n  white-space: normal;\r\n  overflow-wrap: anywhere;\r\n}\r\n.therapy-modal button:focus-visible,\r\n.therapy-modal input:focus-visible {\r\n  outline: 2px solid var(--blue, #2463eb);\r\n  outline-offset: 3px;\r\n}\r\n.therapy-modal .therapy-modal__footer,\r\n.therapy-modal .therapy-modal__footer > div {\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n@media (max-width: 520px) {\r\n  .therapy-modal .therapy-modal__body {\r\n    padding: 0 8px 8px;\r\n  }\r\n  .therapy-modal .therapy-patient-header,\r\n  .therapy-modal .therapy-drug-row {\r\n    padding-inline: 12px;\r\n  }\r\n  .therapy-modal .therapy-drug-row__actions {\r\n    width: 100%;\r\n  }\r\n  .therapy-modal .therapy-motivi-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Agenda — informazione senza tocchi (UX direct-access, 2026-10-03). Condiviso da agenda\r\n   operatore e multi-operatore: nota sempre visibile, stato in parole (non solo colore), nome\r\n   dell'operatore accanto al pallino, mese senza «+N» (la cella cresce). Testo che va a capo. */\r\n.agt-note-inline {\r\n  white-space: pre-wrap;\r\n  overflow-wrap: anywhere;\r\n  font-size: 13px;\r\n  line-height: 18px;\r\n}\r\n.agt-inline-apt {\r\n  flex-wrap: wrap;\r\n  align-items: flex-start;\r\n  row-gap: 2px;\r\n  height: auto;\r\n}\r\n.agt-inline-apt .agt-week-apt__name,\r\n.agt-inline-apt .agt-month-apt__name {\r\n  white-space: normal;\r\n  overflow: visible;\r\n  text-overflow: clip;\r\n  overflow-wrap: anywhere;\r\n}\r\n.agt-inline-meta {\r\n  flex-basis: 100%;\r\n  min-width: 0;\r\n  font-size: 11px;\r\n  line-height: 15px;\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n}\r\n.agt-inline-meta strong {\r\n  font-weight: 700;\r\n  color: var(--text);\r\n}\r\n/* Mese: la cella mostra tutti gli appuntamenti e cresce in altezza. */\r\n.agt-month-day {\r\n  height: auto;\r\n}\r\n.agt-month-day__apts {\r\n  overflow: visible;\r\n}\r\n"]],[[5,30]],["BODY",{},[[5,31]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},["NAV",{"class":"teams-sidebar","aria-label":"Navigazione principale"},["DIV",{"class":"teams-sidebar__brand"},["SPAN",{"class":"teams-sidebar__brand-dot","aria-hidden":"true"},["svg",{"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","aria-hidden":"true"},["path",{"d":"M9 3h6v6h6v6h-6v6H9v-6H3V9h6z"}]]]],["DIV",{"class":"teams-sidebar__nav"},["BUTTON",{"type":"button","class":"teams-sidebar__item active","title":"Turno","aria-current":"page"},["SPAN",{"class":"teams-sidebar__item-icon"},["svg",{"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","aria-hidden":"true"},["path",{"d":"M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"}]]],["SPAN",{"class":"teams-sidebar__item-label"},"Turno"]],["BUTTON",{"type":"button","class":"teams-sidebar__item","title":"Pazienti"},["SPAN",{"class":"teams-sidebar__item-icon"},["svg",{"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","aria-hidden":"true"},["path",{"d":"M9 11.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5M16 4.6a3.5 3.5 0 0 1 0 6.8M18 14.8c1.9.7 3.1 2.4 3.5 5.2"}]]],["SPAN",{"class":"teams-sidebar__item-label"},"Pazienti"]],["BUTTON",{"type":"button","class":"teams-sidebar__item","title":"Terapia"},["SPAN",{"class":"teams-sidebar__item-icon"},["svg",{"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","aria-hidden":"true"},["path",{"d":"M10.5 3.5a5 5 0 0 1 7 7l-7 7a5 5 0 0 1-7-7zM7 7l10 10"}]]],["SPAN",{"class":"teams-sidebar__item-label"},"Terapia"]],["BUTTON",{"type