{"type":"frame-snapshot","snapshot":{"callId":"call@8218","snapshotName":"after@call@8218","pageId":"page@06145f9785f33f8cad61789f68499a86","frameId":"frame@0f33647fb7a6323797cb1d121e5f915e","frameUrl":"http://127.0.0.1:7483/#/pazienti","doctype":"html","html":["HTML",{"lang":"it"},["HEAD",{},[[13,0]],[[13,1]],[[13,2]],[[13,3]],[[13,4]],[[13,5]],[[13,6]],[[13,7]],[[13,8]],[[13,9]],[[13,10]],[[13,11]],[[13,12]],[[13,13]],[[13,15]],[[13,16]],[[13,18]],[[13,20]],[[13,22]],[[13,24]],[[13,26]],[[13,28]],[[9,1]],[[9,3]],[[9,5]],[[9,7]],[[9,9]],[[9,11]],[[9,13]],[[8,1]],[[8,3]],[[8,5]],[[8,7]],[[8,9]],[[8,11]],[[8,13]],[[8,15]],[[8,17]],[[8,19]],[[8,21]],[[8,23]],[[8,25]],[[8,27]],[[8,29]],[[8,31]],[[8,33]],[[8,35]],[[8,37]],[[8,39]],[[8,41]],[[8,43]],[[8,45]],[[8,47]],[[8,49]],[[8,51]],[[8,53]],[[8,55]],[[1,1]],[[1,3]],[[1,5]],[[1,7]],["STYLE",{},".therapy-calendar-grid {\r\n  overflow: auto;\r\n  max-height: 580px;\r\n  border: 1px solid var(--border-color, #dbe3f0);\r\n  border-radius: 12px;\r\n  scrollbar-gutter: stable;\r\n}\r\n.therapy-calendar-grid table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n  table-layout: fixed;\r\n}\r\n.therapy-calendar-grid th,\r\n.therapy-calendar-grid td {\r\n  border-bottom: 1px solid var(--border-color, #dbe3f0);\r\n  padding: 6px;\r\n  vertical-align: top;\r\n  text-align: left;\r\n}\r\n.therapy-calendar-grid th:first-child {\r\n  width: 64px;\r\n  font-size: 12px;\r\n  color: var(--text-secondary, #55708b);\r\n}\r\n.therapy-calendar-grid thead th {\r\n  position: sticky;\r\n  top: 0;\r\n  background: var(--surface, #fff);\r\n  z-index: 1;\r\n  font-size: 12px;\r\n}\r\n.therapy-calendar-grid.is-week table {\r\n  min-width: 760px;\r\n}\r\n.therapy-calendar-grid__empty {\r\n  display: block;\r\n  min-height: 24px;\r\n  color: var(--text-secondary, #55708b);\r\n}\r\n.therapy-calendar-grid__add {\r\n  width: 32px;\r\n  min-width: 32px;\r\n  height: 32px;\r\n  min-height: 32px;\r\n  color: #3269ed;\r\n  background: transparent;\r\n  border: 1px dashed #b9cafa;\r\n  border-radius: 8px;\r\n}\r\n.therapy-calendar-grid__add:focus-visible {\r\n  outline: 3px solid #3269ed;\r\n  outline-offset: 2px;\r\n}\r\n.therapy-calendar-cell {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  width: 100%;\r\n  min-height: 60px;\r\n  padding: 8px;\r\n  border: 1px solid #b9cafa;\r\n  border-left: 4px solid #3269ed;\r\n  border-radius: 8px;\r\n  background: #eef3ff;\r\n  color: #173355;\r\n  text-align: left;\r\n  font: inherit;\r\n  cursor: pointer;\r\n}\r\n.therapy-calendar-cell > svg {\r\n  width: 16px;\r\n  min-width: 16px;\r\n  height: 16px;\r\n}\r\n.therapy-calendar-cell > svg:last-child {\r\n  margin-left: auto;\r\n}\r\n.therapy-calendar-cell__text {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 3px;\r\n  min-width: 0;\r\n  overflow-wrap: anywhere;\r\n  font-size: 12px;\r\n}\r\n.therapy-calendar-cell__text strong {\r\n  font-size: 13px;\r\n}\r\n.therapy-calendar-cell.is-late,\r\n.therapy-calendar-cell.is-missed {\r\n  border-left-color: #cf2c47;\r\n  background: #fff0f3;\r\n}\r\n.therapy-calendar-cell.is-done,\r\n.therapy-calendar-cell.is-administered {\r\n  border-left-color: #008a80;\r\n  background: #e8f6f3;\r\n}\r\n.therapy-calendar-cell.is-focus {\r\n  outline: 2px solid #3269ed;\r\n  outline-offset: 2px;\r\n}\r\n.therapy-calendar-cell:focus-visible {\r\n  outline: 3px solid #3269ed;\r\n  outline-offset: 2px;\r\n}\r\n.therapy-calendar-dialog {\r\n  width: min(850px, calc(100vw - 32px));\r\n  max-width: 850px;\r\n  max-height: 85vh;\r\n  overflow: auto;\r\n  padding: 16px;\r\n}\r\n.therapy-calendar-dialog__head {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  align-items: center;\r\n  margin-bottom: 12px;\r\n}\r\n.therapy-calendar-dialog__head h3 {\r\n  margin: 0;\r\n  font-size: 18px;\r\n}\r\n.therapy-calendar-dialog__patient {\r\n  border-top: 1px solid #dbe3f0;\r\n  padding: 12px 0;\r\n}\r\n.therapy-calendar-dialog__patient-head {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  align-items: center;\r\n}\r\n.therapy-calendar-dialog__patient dl {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));\r\n  gap: 8px;\r\n}\r\n.therapy-calendar-dialog__patient dt {\r\n  font-size: 12px;\r\n  color: #55708b;\r\n}\r\n.therapy-calendar-dialog__patient dd {\r\n  margin: 2px 0 0;\r\n}\r\n@media (max-width: 600px) {\r\n  .therapy-calendar-dialog {\r\n    width: calc(100vw - 24px);\r\n    padding: 12px;\r\n  }\r\n  .therapy-calendar-cell__text strong {\r\n    font-size: 12px;\r\n  }\r\n}\r\n.therapy-calendar-count {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-width: 36px;\r\n  min-height: 36px;\r\n  width: max-content;\r\n  max-width: 100%;\r\n  padding: 4px 8px;\r\n  border: 1px solid #b9cafa;\r\n  border-radius: 8px;\r\n  background: #eef3ff;\r\n  color: #2054b2;\r\n  font: 650 14px/20px var(--ds-font);\r\n  cursor: pointer;\r\n}\r\n.therapy-calendar-count.is-late {\r\n  border-color: #f1b3be;\r\n  background: #fff0f3;\r\n  color: #b71938;\r\n}\r\n.therapy-calendar-count.is-done {\r\n  border-color: #a8d9d0;\r\n  background: #e8f6f3;\r\n  color: #006d62;\r\n}\r\n.therapy-calendar-count.is-missed {\r\n  border-color: #e5cd97;\r\n  background: #fff6e5;\r\n  color: #855600;\r\n}\r\n.therapy-calendar-count.is-unknown {\r\n  border-style: dashed;\r\n  background: #f4f6fa;\r\n  color: #55708b;\r\n}\r\n.therapy-calendar-count:focus-visible {\r\n  outline: 3px solid #3269ed;\r\n  outline-offset: 2px;\r\n}\r\n.therapy-calendar-legend {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px 16px;\r\n  font-size: 12px;\r\n  color: var(--text-secondary, #55708b);\r\n}\r\n.therapy-calendar-legend > span {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 5px;\r\n}\r\n.therapy-calendar-legend > span:before {\r\n  content: '';\r\n  width: 8px;\r\n  height: 8px;\r\n  border-radius: 50%;\r\n  background: #3269ed;\r\n}\r\n.therapy-calendar-legend > .therapy-calendar-legend__count:before {\r\n  display: none;\r\n}\r\n.therapy-calendar-legend > .is-late:before {\r\n  background: #cf2c47;\r\n}\r\n.therapy-calendar-legend > .is-done:before {\r\n  background: #008a80;\r\n}\r\n.therapy-calendar-legend > .is-missed:before {\r\n  background: #b87800;\r\n}\r\n.therapy-calendar-dialog__search {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  font-size: 12px;\r\n  margin-bottom: 12px;\r\n}\r\n.therapy-calendar-dialog__search input {\r\n  width: 100%;\r\n  max-width: 320px;\r\n}\r\n@media (pointer: coarse) {\r\n  .therapy-calendar-count {\r\n    min-width: 40px;\r\n    min-height: 40px;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Ward details: the title and search stay visible while only the doses scroll. */\r\n.modal-overlay:has(> .therapy-calendar-dialog--ward) {\r\n  z-index: 1300;\r\n  align-items: center;\r\n  padding: 12px;\r\n}\r\n.therapy-calendar-dialog.therapy-calendar-dialog--ward {\r\n  display: flex;\r\n  flex-direction: column;\r\n  width: min(820px, calc(100vw - 32px));\r\n  max-height: min(85vh, 820px);\r\n  padding: 0;\r\n  overflow: hidden;\r\n  background: var(--surface, #fff);\r\n}\r\n.therapy-calendar-dialog--ward .therapy-calendar-dialog__head {\r\n  flex-shrink: 0;\r\n  gap: 12px;\r\n  margin: 0;\r\n  padding: 12px 16px;\r\n  border-bottom: 1px solid var(--border, #dbe3f0);\r\n}\r\n.therapy-calendar-dialog--ward .therapy-calendar-dialog__date {\r\n  margin: 2px 0 0;\r\n  font-size: 12px;\r\n  color: var(--text-muted, #55708b);\r\n}\r\n.therapy-calendar-dialog__controls {\r\n  flex-shrink: 0;\r\n  padding: 8px 16px;\r\n  background: var(--surface-secondary, #f5f7fb);\r\n  border-bottom: 1px solid var(--border, #dbe3f0);\r\n}\r\n.therapy-calendar-dialog__controls > p {\r\n  margin: 0 0 6px;\r\n  font-size: 12px;\r\n}\r\n.therapy-calendar-dialog__controls > p:last-child {\r\n  margin: 0;\r\n}\r\n.therapy-calendar-dialog__controls > [role='alert'] {\r\n  color: #b71938;\r\n}\r\n.therapy-calendar-dialog__controls > [role='status'] > button {\r\n  margin: 4px 0 0 8px;\r\n}\r\n.therapy-calendar-dialog--ward .therapy-calendar-dialog__search {\r\n  margin: 0 0 6px;\r\n}\r\n.therapy-calendar-dialog--ward .therapy-calendar-dialog__search input {\r\n  max-width: none;\r\n}\r\n.therapy-calendar-dialog__count {\r\n  color: var(--text-muted, #55708b);\r\n}\r\n.therapy-calendar-dialog__body {\r\n  min-height: 0;\r\n  overflow-y: auto;\r\n  overscroll-behavior: contain;\r\n  scrollbar-gutter: stable;\r\n  padding: 12px 16px;\r\n}\r\n.therapy-calendar-dialog__body:focus-visible {\r\n  outline: 2px solid #3269ed;\r\n  outline-offset: -2px;\r\n}\r\n.therapy-calendar-dialog--ward .therapy-calendar-dialog__patient {\r\n  padding: 0;\r\n  margin: 0 0 10px;\r\n  border: 1px solid var(--border, #dbe3f0);\r\n  border-radius: 8px;\r\n  overflow: hidden;\r\n}\r\n.therapy-calendar-dialog--ward .therapy-calendar-dialog__patient:last-child {\r\n  margin-bottom: 0;\r\n}\r\n.therapy-calendar-dialog--ward .therapy-calendar-dialog__patient-head {\r\n  padding: 6px 10px;\r\n  background: var(--surface-secondary, #f5f7fb);\r\n  border-bottom: 1px solid var(--border, #dbe3f0);\r\n  font-size: 13px;\r\n}\r\n.therapy-calendar-dialog--ward .therapy-calendar-dialog__patient-head > strong {\r\n  min-width: 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n.therapy-calendar-dialog--ward .therapy-calendar-dialog__patient-head > button {\r\n  flex-shrink: 0;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n}\r\n.therapy-calendar-dialog__patient-head > button svg {\r\n  width: 16px;\r\n  height: 16px;\r\n}\r\n.therapy-calendar-dialog__dose {\r\n  padding: 8px 10px;\r\n  border-left: 3px solid #3269ed;\r\n}\r\n.therapy-calendar-dialog__dose + .therapy-calendar-dialog__dose {\r\n  border-top: 1px solid var(--border, #dbe3f0);\r\n}\r\n.therapy-calendar-dialog__dose.is-late {\r\n  border-left-color: #c42b46;\r\n}\r\n.therapy-calendar-dialog__dose.is-done {\r\n  border-left-color: #008a80;\r\n}\r\n.therapy-calendar-dialog__dose.is-missed {\r\n  border-left-color: #b87800;\r\n}\r\n.therapy-calendar-dialog--ward .therapy-calendar-dialog__patient dl {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1.5fr) minmax(70px, 0.55fr) minmax(0, 1fr);\r\n  align-items: start;\r\n  gap: 8px 16px;\r\n  margin: 0;\r\n  font-size: 13px;\r\n  line-height: 18px;\r\n  overflow-wrap: anywhere;\r\n}\r\n.therapy-calendar-dialog--ward .therapy-calendar-dialog__drug dt {\r\n  font-size: 13px;\r\n  font-weight: 650;\r\n  color: var(--text-primary, #173355);\r\n}\r\n.therapy-calendar-dialog--ward .therapy-calendar-dialog__drug dd {\r\n  color: var(--text-muted, #55708b);\r\n}\r\n.therapy-calendar-dialog__status {\r\n  display: inline-block;\r\n  padding: 2px 6px;\r\n  border-radius: 5px;\r\n  font-size: 12px;\r\n  line-height: 16px;\r\n  background: #eef3ff;\r\n  color: #2054b2;\r\n}\r\n.therapy-calendar-dialog__status.is-late {\r\n  background: #fff0f3;\r\n  color: #b71938;\r\n}\r\n.therapy-calendar-dialog__status.is-done {\r\n  background: #e8f6f3;\r\n  color: #006d62;\r\n}\r\n.therapy-calendar-dialog__status.is-missed {\r\n  background: #fff6e5;\r\n  color: #855600;\r\n}\r\n@media (max-width: 600px) {\r\n  .therapy-calendar-dialog.therapy-calendar-dialog--ward {\r\n    width: calc(100vw - 24px);\r\n    max-height: 90dvh;\r\n  }\r\n  .therapy-calendar-dialog--ward .therapy-calendar-dialog__head,\r\n  .therapy-calendar-dialog__controls,\r\n  .therapy-calendar-dialog__body {\r\n    padding: 10px 12px;\r\n  }\r\n  .therapy-calendar-dialog--ward .therapy-calendar-dialog__patient dl {\r\n    grid-template-columns: minmax(0, 0.65fr) minmax(0, 1fr);\r\n    gap: 6px 12px;\r\n  }\r\n  .therapy-calendar-dialog__drug {\r\n    grid-column: 1 / -1;\r\n  }\r\n  .therapy-calendar-dialog--ward .therapy-calendar-dialog__patient-head > button > span {\r\n    display: none;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Calendario del giro terapia (settimana × fasce). Controlli e colori dai token del design system. */\r\n.tcal {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.tcal__note {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px 16px;\r\n  margin: 0;\r\n  padding: 12px 16px;\r\n  border-radius: 12px;\r\n  background: var(--ds-surface-2);\r\n  color: var(--ds-text);\r\n  font: 400 14px/20px var(--ds-font);\r\n}\r\n.tcal__scroll {\r\n  overflow-x: auto;\r\n  border: 1px solid var(--ds-border);\r\n  border-radius: var(--ds-card-radius);\r\n  background: var(--ds-surface);\r\n}\r\n.tcal__table {\r\n  width: 100%;\r\n  min-width: 640px;\r\n  border-collapse: collapse;\r\n  table-layout: fixed;\r\n}\r\n.tcal__table th,\r\n.tcal__table td {\r\n  padding: 8px;\r\n  border-bottom: 1px solid var(--ds-border);\r\n  text-align: center;\r\n}\r\n.tcal__corner,\r\n.tcal__fascia {\r\n  width: 72px;\r\n}\r\n.tcal__fascia {\r\n  font: 600 16px/24px var(--ds-font);\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--ds-text);\r\n  text-align: left;\r\n}\r\n.tcal__day {\r\n  font: 400 14px/20px var(--ds-font);\r\n  color: var(--ds-text-muted);\r\n}\r\n.tcal__weekday {\r\n  display: block;\r\n  text-transform: capitalize;\r\n}\r\n.tcal__date {\r\n  display: block;\r\n  font-weight: 600;\r\n  color: var(--ds-text);\r\n}\r\n.tcal__day--today {\r\n  background: var(--ds-blue-tint);\r\n  color: var(--ds-blue-active);\r\n}\r\n.tcal__day--today .tcal__date {\r\n  color: var(--ds-blue-active);\r\n}\r\n.tcal__cell {\r\n  height: 72px;\r\n}\r\n.tcal__none,\r\n.tcal__cell--wait {\r\n  color: var(--ds-text-muted);\r\n}\r\n/* La cella è un pulsante di griglia (componente dichiarato), non una chip. */\r\n.tcal__btn {\r\n  box-sizing: border-box;\r\n  width: 100%;\r\n  min-height: 56px;\r\n  padding: 4px;\r\n  border: var(--ds-border-w) solid var(--ds-border);\r\n  border-radius: var(--ds-radius);\r\n  background: var(--ds-surface);\r\n  color: var(--ds-text);\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 2px;\r\n  cursor: pointer;\r\n}\r\n.tcal__btn:hover {\r\n  border-color: var(--ds-blue);\r\n}\r\n.tcal__btn:focus-visible {\r\n  outline: var(--ds-focus);\r\n  outline-offset: 2px;\r\n}\r\n.tcal__count {\r\n  font: 600 16px/24px var(--ds-font);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.tcal__hint {\r\n  font: 400 12px/16px var(--ds-font);\r\n}\r\n.tcal__btn--completa {\r\n  background: var(--emerald-bg);\r\n  border-color: var(--emerald);\r\n  color: color-mix(in srgb, var(--emerald) 65%, black);\r\n}\r\n.tcal__btn--da-fare {\r\n  background: var(--ds-blue-tint);\r\n  border-color: var(--ds-blue);\r\n  color: var(--ds-blue-active);\r\n}\r\n.tcal__btn--mancanti {\r\n  background: var(--amber-bg);\r\n  border-color: var(--amber);\r\n  color: color-mix(in srgb, var(--amber) 70%, black);\r\n}\r\n/* Totali non esatti (pageInfo.summaryExact falso): nessun colore di stato, solo il dato parziale. */\r\n.tcal__btn--parziale {\r\n  background: var(--ds-surface-2);\r\n  border-style: dashed;\r\n  color: var(--ds-text);\r\n}\r\n/* La colonna delle ore resta ferma mentre i giorni scorrono (telefono). */\r\n.tcal__corner,\r\n.tcal__fascia {\r\n  position: sticky;\r\n  left: 0;\r\n  z-index: 1;\r\n  background: var(--ds-surface);\r\n}\r\n/* UX 2026-10-03: la cella elenca le dosi (paziente · farmaco · dose · stato) e cresce in altezza. */\r\n.tcal__cell {\r\n  vertical-align: top;\r\n  height: auto;\r\n}\r\n/* Su tablet verticale e telefono: un blocco per giorno invece della griglia a 7 colonne. */\r\n.tcal__stack {\r\n  display: none;\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  gap: 12px;\r\n}\r\n@media (max-width: 1099px) {\r\n  .tcal__scroll {\r\n    display: none;\r\n  }\r\n  .tcal__stack {\r\n    display: grid;\r\n  }\r\n}\r\n.tcal__stack-day {\r\n  padding: 12px;\r\n  border: 1px solid var(--ds-border);\r\n  border-radius: var(--ds-card-radius);\r\n  background: var(--ds-surface);\r\n}\r\n.tcal__stack-day.is-today {\r\n  border-color: var(--ds-blue);\r\n}\r\n.tcal__stack-head {\r\n  margin: 0 0 8px;\r\n  font: 600 15px/22px var(--ds-font);\r\n  text-transform: capitalize;\r\n}\r\n.tcal__stack-fascia + .tcal__stack-fascia {\r\n  margin-top: 10px;\r\n}\r\n.tcal__stack-open {\r\n  min-height: 44px;\r\n  padding: 4px 10px;\r\n  border: var(--ds-border-w) solid var(--ds-border);\r\n  border-radius: var(--ds-radius);\r\n  background: var(--ds-surface-2);\r\n  color: var(--ds-text);\r\n  font: 500 14px/20px var(--ds-font);\r\n  cursor: pointer;\r\n}\r\n.tcal__stack-open:focus-visible {\r\n  outline: var(--ds-focus);\r\n  outline-offset: 2px;\r\n}\r\n.tcal__none-text {\r\n  margin: 0;\r\n  color: var(--ds-text-muted);\r\n}\r\n"],["STYLE",{},"/* Giro terapia — HMI 1 (artifacts/hmi-parity/proto/terapia.png). */\r\n.giro-allergies {\r\n  margin: 0 16px 12px;\r\n  padding: 12px 16px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 12px;\r\n  background: var(--surface);\r\n  color: var(--text);\r\n  overflow-wrap: anywhere;\r\n  font: 400 14px/20px var(--font-ui);\r\n}\r\n.giro-allergies__status { margin: 0; display: flex; flex-wrap: wrap; gap: 4px 12px; }\r\n.giro-allergies__source { color: var(--text-muted); }\r\n.giro-allergies__list { margin: 8px 0; padding-left: 20px; }\r\n.giro-allergies__details summary {\r\n  cursor: pointer;\r\n  min-height: 44px;\r\n  padding: 12px 0;\r\n  color: var(--text);\r\n  font-weight: 600;\r\n}\r\n.giro-allergies__details summary:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }\r\n.giro-allergies__details p { margin: 4px 0; }\r\n.giro-allergies__documentation { padding: 8px 0; border-top: 1px solid var(--border); }\r\n\r\n.giro-view {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.giro-sr {\r\n  position: absolute;\r\n  width: 1px;\r\n  height: 1px;\r\n  overflow: hidden;\r\n  clip: rect(0 0 0 0);\r\n  white-space: nowrap;\r\n}\r\n\r\n.giro-bar {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 16px;\r\n}\r\n.giro-slots,\r\n.giro-filters,\r\n.giro-reasons {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n\r\n.giro-progress {\r\n  flex: 1 1 200px;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.giro-progress__track {\r\n  flex: 1;\r\n  height: 8px;\r\n  border-radius: 4px;\r\n  background: #e8edf4;\r\n  overflow: hidden;\r\n}\r\n.giro-progress__track i {\r\n  display: block;\r\n  height: 100%;\r\n  background: #16a37b;\r\n}\r\n.giro-progress__count {\r\n  font: 600 16px/24px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.giro-tools {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px 16px;\r\n}\r\n.giro-tools .roster-order {\r\n  margin: 0;\r\n}\r\n.giro-note-box {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px 16px;\r\n  padding: 12px 16px;\r\n  border-radius: 12px;\r\n  background: var(--amber-bg);\r\n  color: #7a4a00;\r\n}\r\n\r\n.giro-rows {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n.giro-row {\r\n  display: grid;\r\n  grid-template-columns: 48px minmax(0, 1fr) minmax(0, 1fr) auto;\r\n  gap: 16px;\r\n  align-items: center;\r\n  padding: 16px;\r\n  border-radius: 16px;\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n}\r\n.giro-row > * {\r\n  min-width: 0;\r\n}\r\n.giro-row--done {\r\n  background: #f5f7fb;\r\n}\r\n.giro-row__bed {\r\n  width: 48px;\r\n  height: 48px;\r\n  border-radius: 12px;\r\n  background: #f5f7fb;\r\n  border: 1px solid var(--border);\r\n  display: grid;\r\n  place-items: center;\r\n  font: 600 18px/24px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--text);\r\n}\r\n.giro-row--done .giro-row__bed {\r\n  background: var(--surface);\r\n}\r\n.giro-row__who,\r\n.giro-row__drug {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n}\r\n.giro-row__name {\r\n  font: 600 16px/24px var(--font-ui);\r\n  color: var(--text);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.giro-row__cap {\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.giro-row__act {\r\n  display: flex;\r\n  gap: 8px;\r\n  justify-content: flex-end;\r\n}\r\n\r\n.giro-badge {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  min-height: 32px;\r\n  padding: 4px 10px;\r\n  border-radius: 8px;\r\n  font: 600 14px/20px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.giro-badge svg {\r\n  width: 16px;\r\n  height: 16px;\r\n}\r\n.giro-badge--ok {\r\n  background: #e6f6ef;\r\n  color: #0e7a55;\r\n}\r\n.giro-badge--warn {\r\n  background: var(--amber-bg);\r\n  color: #8a5300;\r\n}\r\n.giro-badge--due {\r\n  background: #eaf1fe;\r\n  color: #1d4fc4;\r\n}\r\n.giro-row__reasons {\r\n  grid-column: 2 / -1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n}\r\n.giro-note {\r\n  height: 48px;\r\n  max-width: 480px;\r\n}\r\n.giro-reasons__actions {\r\n  display: flex;\r\n  gap: 8px;\r\n}\r\n.giro-empty {\r\n  margin: 0;\r\n  padding: 24px;\r\n  border-radius: 16px;\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  color: var(--text-muted);\r\n}\r\n\r\n/* Telefono: camera + paziente in alto, farmaco sotto, azioni a tutta larghezza. */\r\n@media (max-width: 720px) {\r\n  .giro-row {\r\n    grid-template-columns: 48px minmax(0, 1fr);\r\n    gap: 8px 12px;\r\n  }\r\n  .giro-row__drug,\r\n  .giro-row__act,\r\n  .giro-row__reasons {\r\n    grid-column: 1 / -1;\r\n  }\r\n\r\n  .giro-row__act {\r\n    justify-content: stretch;\r\n  }\r\n  .giro-row__act > .giro-badge {\r\n    margin-right: auto;\r\n  }\r\n}\r\n\r\n.giro-tools__right {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px;\r\n  margin-left: auto;\r\n}\r\n\r\n.giro-row:focus-visible {\r\n  outline: 3px solid #245bb5;\r\n  outline-offset: 2px;\r\n}\r\n\r\n/* Contatori delle fasce allineati: cifre tabellari (solo tipografia numerica, non l'aspetto). */\r\n.giro-slot {\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n@media (max-width: 720px) {\r\n  .giro-row__act > .ds-btn {\r\n    flex: 1;\r\n  }\r\n}\r\n\r\n/* ── Giro per paziente: testata del paziente, sotto i suoi farmaci dell'ora ─────────────────\r\n   Il nome del paziente conserva il carattere di prima (giro-row__name); i farmaci usano un\r\n   carattere diverso e più piccolo, come richiesto. */\r\n.giro-patients {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n}\r\n.giro-patient {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  padding: 16px;\r\n  border-radius: 16px;\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  min-width: 0;\r\n}\r\n.giro-patient--done {\r\n  background: #f5f7fb;\r\n}\r\n.giro-patient--done .giro-row__bed {\r\n  background: var(--surface);\r\n}\r\n.giro-patient__head {\r\n  display: grid;\r\n  grid-template-columns: 48px minmax(0, 1fr);\r\n  gap: 16px;\r\n  align-items: center;\r\n}\r\n.giro-drugs {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0 0 0 64px;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n.giro-drug {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) auto;\r\n  gap: 8px 16px;\r\n  align-items: center;\r\n  padding: 8px 0;\r\n  border-top: 1px solid var(--border);\r\n  min-width: 0;\r\n}\r\n.giro-drug__info {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n}\r\n.giro-drug__name {\r\n  font: 500 14px/20px var(--font-ui);\r\n  color: var(--text);\r\n  overflow-wrap: anywhere;\r\n}\r\n.giro-drug__cap {\r\n  font: 400 13px/18px var(--font-ui);\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n}\r\n.giro-drug--done .giro-drug__name {\r\n  color: var(--text-muted);\r\n}\r\n.giro-drug > .giro-row__reasons {\r\n  grid-column: 1 / -1;\r\n}\r\n.giro-drug:focus-visible {\r\n  outline: 3px solid #245bb5;\r\n  outline-offset: 2px;\r\n}\r\n@media (max-width: 720px) {\r\n  .giro-drugs {\r\n    padding-left: 0;\r\n  }\r\n  .giro-drug {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }\r\n  .giro-drug > .giro-row__act {\r\n    justify-content: stretch;\r\n  }\r\n  .giro-drug > .giro-row__act > .giro-badge {\r\n    margin-right: auto;\r\n  }\r\n  .giro-drug > .giro-row__act > .ds-btn {\r\n    flex: 1;\r\n  }\r\n}\r\n/* In ritardo (UX 2026-10-03): rosso solo per il ritardo, sempre con il testo «In ritardo di N min». */\r\n.giro-badge--late {\r\n  background: #fdecee;\r\n  color: #a5202f;\r\n  font-weight: 600;\r\n}\r\n.giro-feedback {\r\n  margin: 0 0 8px;\r\n  font: 500 13px/18px var(--font-ui);\r\n}\r\n.giro-feedback.is-ok {\r\n  color: var(--green, #1f7a4d);\r\n}\r\n.giro-feedback.is-error {\r\n  color: var(--red);\r\n}\r\n/* Accesso diretto: paziente richiesto evidenziato nel giro. */\r\n.giro-patient.therapy-list-row--focus {\r\n  outline: 3px solid var(--blue);\r\n  outline-offset: 2px;\r\n  border-radius: 12px;\r\n}\r\n"]],[[13,30]],["BODY",{},[[13,31]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},["NAV",{"class":"teams-sidebar","aria-label":"Navigazione principale"},[[8,60]],["DIV",{"class":"teams-sidebar__nav"},["BUTTON",{"type":"button","class":"teams-sidebar__item","title":"Turno"},[[8,63]],[[8,65]]],["BUTTON",{"__playwright_target__":"","type":"button","class":"teams-sidebar__item active","title":"Pazienti","aria-current":"page"},[[8,69]],[[8,71]]],[[8,78]],[[8,84]],[[8,90]],[[8,96]],[[8,102]]],[[8,104]]],["DIV",{"class":"main-area-clean"},["DIV",{"class":"compact-topbar"},["BUTTON",{"type":"button","class":"topbar-hamburger","aria-label":"Apri menu","aria-expanded":"false"},[[8,109]]],["BUTTON",{"type":"button","class":"topbar-back","aria-label":"Indietro: Dashboard","title":"Torna a Dashboard (Alt+←)"},["svg",{"width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","aria-hidden":"true"},["path",{"d":"M15 5l-7 7 7 7"}]]],["DIV",{"class":"topbar-title"}],[[8,122]],[[8,138]]],["MAIN",{"class":"page-content content-panel"},["DIV",{"class":"page-loading","role":"status","aria-live":"polite"},["SPAN",{"class":"page-loading__spinner","aria-hidden":"true"}],"Caricamento modulo…"]]]]],[[13,65]],[[13,66]]]],"viewport":{"width":390,"height":844},"timestamp":37558.696,"wallTime":1792890302126,"collectionTime":1,"resourceOverrides":[],"isMainFrame":true}}
