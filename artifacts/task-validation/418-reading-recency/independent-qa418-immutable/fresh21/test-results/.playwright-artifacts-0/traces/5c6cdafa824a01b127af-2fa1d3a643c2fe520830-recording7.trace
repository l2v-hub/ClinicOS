{"type":"frame-snapshot","snapshot":{"callId":"call@8292","snapshotName":"input@call@8292","pageId":"page@06145f9785f33f8cad61789f68499a86","frameId":"frame@0f33647fb7a6323797cb1d121e5f915e","frameUrl":"http://127.0.0.1:7483/#/pazienti","doctype":"html","html":["HTML",{"lang":"it"},["HEAD",{},[[15,0]],[[15,1]],[[15,2]],[[15,3]],[[15,4]],[[15,5]],[[15,6]],[[15,7]],[[15,8]],[[15,9]],[[15,10]],[[15,11]],[[15,12]],[[15,13]],[[15,15]],[[15,16]],[[15,18]],[[15,20]],[[15,22]],[[15,24]],[[15,26]],[[15,28]],[[11,1]],[[11,3]],[[11,5]],[[11,7]],[[11,9]],[[11,11]],[[11,13]],[[10,1]],[[10,3]],[[10,5]],[[10,7]],[[10,9]],[[10,11]],[[10,13]],[[10,15]],[[10,17]],[[10,19]],[[10,21]],[[10,23]],[[10,25]],[[10,27]],[[10,29]],[[10,31]],[[10,33]],[[10,35]],[[10,37]],[[10,39]],[[10,41]],[[10,43]],[[10,45]],[[10,47]],[[10,49]],[[10,51]],[[10,53]],[[10,55]],[[3,1]],[[3,3]],[[3,5]],[[3,7]],[[2,1]],[[2,3]],[[2,5]],[[2,7]],["STYLE",{},"/* Agenda operatore — HMI 1 (artifacts/hmi-parity/proto/agenda.png). Solo `.agt-view--hmi`:\r\n   le classes agt- sono condivise con l'agenda multi-operatore dell'admin. */\r\n.agt-view--hmi .agt-day-card {\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 16px;\r\n  padding: 24px;\r\n  min-width: 0;\r\n}\r\n.agt-view--hmi .agt-day-card__head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  flex-wrap: wrap;\r\n  padding-bottom: 16px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n.agt-view--hmi .agt-day-card__title {\r\n  margin: 0;\r\n  font: 600 20px/28px var(--font-ui);\r\n  color: var(--text);\r\n}\r\n.agt-view--hmi .agt-day-card__title::first-letter {\r\n  text-transform: uppercase;\r\n}\r\n\r\n.agt-view--hmi .agt-day-wrap {\r\n  overflow: visible;\r\n}\r\n.agt-view--hmi .agt-slot,\r\n.agt-view--hmi .agt-slot--hour,\r\n.agt-view--hmi .agt-slot--half {\r\n  min-height: 56px;\r\n  align-items: center;\r\n  gap: 16px;\r\n  border-bottom: 1px solid var(--border);\r\n  padding: 8px 0;\r\n}\r\n.agt-view--hmi .agt-slot__time {\r\n  width: 72px;\r\n  font: 600 16px/24px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--text);\r\n  align-self: center;\r\n  padding: 0;\r\n}\r\n/* Fascia libera: vuota come nel prototipo, \"+ Disponibile\" al passaggio o al fuoco. */\r\n.agt-view--hmi .agt-free-slot {\r\n  opacity: 0;\r\n  transition: opacity 0.15s;\r\n}\r\n.agt-view--hmi .agt-slot--free:hover .agt-free-slot,\r\n.agt-view--hmi .agt-slot--free:focus-visible .agt-free-slot {\r\n  opacity: 1;\r\n}\r\n.agt-view--hmi .agt-slot--free:focus-visible {\r\n  outline: 3px solid #245bb5;\r\n  outline-offset: -3px;\r\n  border-radius: 8px;\r\n}\r\n.agt-view--hmi .agt-apt-card {\r\n  flex: 1;\r\n  min-width: 0;\r\n  border: 0;\r\n  border-radius: 8px;\r\n  padding: 8px 16px;\r\n  background: #eaf1fe;\r\n}\r\n.agt-view--hmi .agt-apt-card--in_corso,\r\n.agt-view--hmi .agt-apt-card--urgent {\r\n  background: #fdf3e2;\r\n}\r\n.agt-view--hmi .agt-apt-card--completato {\r\n  background: #e6f6ef;\r\n}\r\n.agt-view--hmi .agt-apt-card--annullato {\r\n  background: #eef1f6;\r\n}\r\n.agt-view--hmi .agt-apt-card__row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.agt-view--hmi .agt-apt-card__title {\r\n  font: 600 16px/24px var(--font-ui);\r\n  color: #1d4fc4;\r\n  white-space: nowrap;\r\n}\r\n.agt-view--hmi .agt-apt-card--annullato .agt-apt-card__title {\r\n  color: var(--text-muted);\r\n  text-decoration: line-through;\r\n}\r\n.agt-view--hmi .agt-apt-card__detail {\r\n  flex: 1;\r\n  min-width: 0;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: #1d4fc4;\r\n  overflow: hidden;\r\n  white-space: nowrap;\r\n}\r\n.agt-view--hmi .agt-apt-card__detail .agt-apt-card__patient {\r\n  font: inherit;\r\n  color: inherit;\r\n  padding: 0;\r\n  min-height: 0;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n.agt-view--hmi .agt-apt-card__badges {\r\n  margin-left: auto;\r\n  flex: none;\r\n}\r\n@media (max-width: 600px) {\r\n  .agt-view--hmi .agt-day-card {\r\n    padding: 16px;\r\n  }\r\n  .agt-view--hmi .agt-slot__time {\r\n    width: 52px;\r\n  }\r\n  .agt-view--hmi .agt-apt-card__row {\r\n    flex-wrap: wrap;\r\n    gap: 4px 12px;\r\n  }\r\n  .agt-view--hmi .agt-apt-card__detail {\r\n    order: 3;\r\n    flex-basis: 100%;\r\n  }\r\n}\r\n/* Allineamento al prototipo sopra gli stili storici dell'agenda (app-additions.css). */\r\n.agt-view--hmi .agt-filter-row {\r\n  background: transparent;\r\n  border: 0;\r\n  padding: 0 0 16px;\r\n}\r\n.agt-view--hmi .agt-slot--free,\r\n.agt-view--hmi .agt-slot--half.agt-slot--free {\r\n  background: transparent;\r\n}\r\n.agt-view--hmi .agt-slot--free:hover,\r\n.agt-view--hmi .agt-slot--free:focus-visible {\r\n  background: #f5f7fb;\r\n}\r\n.agt-view--hmi .agt-slot__time,\r\n.agt-view--hmi .agt-slot--half .agt-slot__time {\r\n  padding: 0;\r\n}\r\n.agt-view--hmi .agt-apt-card {\r\n  min-height: 0;\r\n  align-self: center;\r\n  box-shadow: none;\r\n  border-left: 0;\r\n  gap: 8px;\r\n}\r\n.agt-view--hmi .agt-apt-card__detail {\r\n  flex: 0 1 auto;\r\n}\r\n.agt-view--hmi .agt-apt-card__detail .agt-meta-sep {\r\n  color: inherit;\r\n}\r\n.agt-view--hmi .agt-day-wrap,\r\n.agt-view--hmi .agt-slot {\r\n  background: transparent;\r\n  border-left: 0;\r\n}\r\n/* Sottotitolo nell'intestazione: va a capo (settimana/data sempre leggibili, niente «…»). */\r\n.topbar-title .agt-page-subtitle {\r\n  flex-wrap: wrap;\r\n  row-gap: 0;\r\n  column-gap: 6px;\r\n  white-space: normal;\r\n}\r\n.topbar-title .agt-page-subtitle > * {\r\n  flex: 0 1 auto;\r\n  min-width: 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n.agt-view--hmi .agt-day-card__heading {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n}\r\n.agt-view--hmi .agt-day-card__op {\r\n  display: none;\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n@media (max-width: 600px) {\r\n  /* Sul telefono l'intestazione mostra solo la data (a capo se non entra); l'operatore\r\n     passa nella card del giorno. */\r\n  .topbar-title .agt-page-subtitle .agt-op-chip,\r\n  .topbar-title .agt-page-subtitle .agt-page-subtitle__separator,\r\n  .topbar-title .agt-page-subtitle .agt-header__date ~ span {\r\n    display: none;\r\n  }\r\n  .topbar-title .agt-page-subtitle .agt-header__date {\r\n    flex: 0 1 auto;\r\n    min-width: 0;\r\n  }\r\n  .agt-view--hmi .agt-day-card__op {\r\n    display: block;\r\n  }\r\n}\r\n"],["STYLE",{},".notes-page .note-editor {\r\n  max-width: 1040px;\r\n  margin: 0 auto 20px;\r\n  padding: 0;\r\n  overflow: visible;\r\n  border-radius: 9px;\r\n  box-shadow: 0 1px 4px rgba(20, 39, 72, 0.08);\r\n}\r\n\r\n.note-editor__header {\r\n  min-height: 68px;\r\n  margin: 0;\r\n  padding: 13px 16px;\r\n  align-items: flex-start;\r\n  border-bottom: 1px solid var(--border);\r\n  border-radius: 9px 9px 0 0;\r\n  background: var(--surface-raised);\r\n}\r\n\r\n.note-editor__eyebrow,\r\n.note-editor__section > legend {\r\n  color: var(--text-xmuted);\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  letter-spacing: 0.65px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.note-editor__eyebrow {\r\n  display: block;\r\n  margin-bottom: 2px;\r\n}\r\n\r\n.note-editor__intro {\r\n  max-width: 70ch;\r\n  margin: 3px 0 0;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.note-editor__body {\r\n  padding: 0 16px;\r\n}\r\n\r\n.note-editor__section {\r\n  min-width: 0;\r\n  margin: 0;\r\n  padding: 14px 0 16px;\r\n  border: 0;\r\n  border-bottom: 1px solid var(--divider);\r\n}\r\n\r\n.note-editor__section--last {\r\n  border-bottom: 0;\r\n}\r\n\r\n.note-editor__section > legend {\r\n  width: 100%;\r\n  padding: 0 0 9px;\r\n}\r\n\r\n.note-editor__grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(12, minmax(0, 1fr));\r\n  gap: 12px;\r\n  align-items: start;\r\n}\r\n\r\n.note-editor__field--recipient {\r\n  grid-column: span 5;\r\n}\r\n\r\n.note-editor__field--patient {\r\n  grid-column: span 7;\r\n  min-width: 0;\r\n}\r\n\r\n.note-editor__field--priority {\r\n  grid-column: span 3;\r\n}\r\n\r\n.note-editor__field--message {\r\n  grid-column: span 9;\r\n}\r\n\r\n.note-editor .form-field,\r\n.note-editor .form-input,\r\n.note-editor .form-select {\r\n  min-width: 0;\r\n}\r\n\r\n.note-editor .form-input,\r\n.note-editor .form-select {\r\n  width: 100%;\r\n}\r\n\r\n.note-editor__helper {\r\n  display: block;\r\n  margin-top: 5px;\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  line-height: 1.35;\r\n}\r\n\r\n.note-editor__message {\r\n  min-height: 86px;\r\n  resize: vertical;\r\n}\r\n\r\n.note-editor__counter {\r\n  display: block;\r\n  margin-top: 4px;\r\n  color: var(--text-xmuted);\r\n  font-size: 10.5px;\r\n  text-align: right;\r\n}\r\n\r\n.note-editor__actions {\r\n  min-height: 62px;\r\n  align-items: center;\r\n  margin: 0;\r\n  padding: 9px 16px;\r\n  border-top: 1px solid var(--border);\r\n  border-radius: 0 0 9px 9px;\r\n  background: var(--surface-raised);\r\n}\r\n\r\n.note-editor__required-note,\r\n.note-editor__error {\r\n  margin: 0 auto 0 0;\r\n  font-size: 11px;\r\n}\r\n\r\n.note-editor__required-note {\r\n  color: var(--text-muted);\r\n}\r\n\r\n.note-editor__required-note > span {\r\n  color: var(--red);\r\n  font-weight: 700;\r\n}\r\n\r\n.note-editor__error {\r\n  color: var(--red);\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .note-editor__grid {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n\r\n  .note-editor__field--recipient,\r\n  .note-editor__field--priority {\r\n    grid-column: span 1;\r\n  }\r\n\r\n  .note-editor__field--patient,\r\n  .note-editor__field--message {\r\n    grid-column: 1 / -1;\r\n  }\r\n}\r\n\r\n@media (max-width: 639px) {\r\n  .note-editor__header,\r\n  .note-editor__body,\r\n  .note-editor__actions {\r\n    padding-right: 12px;\r\n    padding-left: 12px;\r\n  }\r\n\r\n  .note-editor__intro {\r\n    max-width: 34ch;\r\n  }\r\n\r\n  .note-editor__grid {\r\n    grid-template-columns: minmax(0, 1fr);\r\n    gap: 10px;\r\n  }\r\n\r\n  .note-editor__field--recipient,\r\n  .note-editor__field--patient,\r\n  .note-editor__field--priority,\r\n  .note-editor__field--message {\r\n    grid-column: 1;\r\n  }\r\n\r\n  .note-editor__actions {\r\n    flex-wrap: wrap;\r\n  }\r\n\r\n  .note-editor__required-note,\r\n  .note-editor__error {\r\n    width: 100%;\r\n  }\r\n\r\n  .note-editor__actions .btn-secondary,\r\n  .note-editor__actions .btn-success {\r\n    min-height: 44px;\r\n    flex: 1;\r\n    justify-content: center;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Note e messaggi — HMI 1 (artifacts/hmi-parity/proto/note.png). */\r\n.notes-page--hmi .nm-card {\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 16px;\r\n  padding: 24px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.nm-card__head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  flex-wrap: wrap;\r\n}\r\n.nm-card__title {\r\n  margin: 0;\r\n  font: 600 20px/28px var(--font-ui);\r\n  color: var(--text);\r\n}\r\n\r\n.nm-tools {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px 16px;\r\n}\r\n.nm-search {\r\n  flex: 1 1 280px;\r\n  min-width: 0;\r\n}\r\n.nm-search .search-input {\r\n  height: 48px;\r\n}\r\n\r\n.nm-list {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  border-top: 1px solid var(--border);\r\n}\r\n.nm-row {\r\n  display: grid;\r\n  grid-template-columns: 48px minmax(0, 1fr) auto;\r\n  gap: 16px;\r\n  align-items: start;\r\n  padding: 16px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n.nm-row--done {\r\n  background: #f5f7fb;\r\n}\r\n.nm-avatar {\r\n  width: 48px;\r\n  height: 48px;\r\n  border-radius: 50%;\r\n  background: #eaf1fe;\r\n  color: #1d4fc4;\r\n  display: grid;\r\n  place-items: center;\r\n  font: 600 16px/24px var(--font-ui);\r\n}\r\n.nm-row__body {\r\n  min-width: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n}\r\n.nm-row__meta {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 4px 8px;\r\n  min-width: 0;\r\n}\r\n.nm-dot {\r\n  width: 8px;\r\n  height: 8px;\r\n  border-radius: 50%;\r\n  background: var(--blue);\r\n  flex: none;\r\n}\r\n.nm-author {\r\n  font: 600 16px/24px var(--font-ui);\r\n  color: var(--text);\r\n  overflow-wrap: anywhere;\r\n}\r\n.nm-dest {\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n}\r\n.nm-prio {\r\n  font: 600 13px/18px var(--font-ui);\r\n  padding: 2px 8px;\r\n  border-radius: 6px;\r\n}\r\n/* Urgenza: il rosso resta riservato agli allarmi clinici e ai conteggi. */\r\n.nm-prio--urgente {\r\n  background: #fdecee;\r\n  color: #b3261e;\r\n}\r\n.nm-prio--alta {\r\n  background: var(--amber-bg);\r\n  color: #8a5300;\r\n}\r\n.nm-state {\r\n  font: 600 13px/18px var(--font-ui);\r\n  padding: 2px 8px;\r\n  border-radius: 6px;\r\n  background: #e6f6ef;\r\n  color: #0e7a55;\r\n}\r\n.nm-sr {\r\n  position: absolute;\r\n  width: 1px;\r\n  height: 1px;\r\n  overflow: hidden;\r\n  clip: rect(0 0 0 0);\r\n  white-space: nowrap;\r\n}\r\n.nm-message {\r\n  font: 400 16px/24px var(--font-ui);\r\n  color: var(--text);\r\n  min-width: 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n.nm-row__side {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-end;\r\n  gap: 8px;\r\n}\r\n.nm-time {\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n  white-space: nowrap;\r\n}\r\n.nm-actions {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n}\r\n\r\n.nm-empty {\r\n  padding: 32px 16px;\r\n  text-align: center;\r\n  color: var(--text-muted);\r\n}\r\n.nm-more {\r\n  display: flex;\r\n  justify-content: center;\r\n}\r\n@media (max-width: 600px) {\r\n  .notes-page--hmi .nm-card {\r\n    padding: 16px;\r\n  }\r\n  .nm-row {\r\n    grid-template-columns: 40px minmax(0, 1fr);\r\n    padding: 12px 0;\r\n  }\r\n  .nm-avatar {\r\n    width: 40px;\r\n    height: 40px;\r\n  }\r\n  .nm-row__side {\r\n    grid-column: 2;\r\n    flex-direction: row;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Parametri vitali — HMI 1 (artifacts/hmi-parity/proto/parametri.png). */\r\n.par-view {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.par-grid {\r\n  display: grid;\r\n  grid-template-columns: 240px minmax(0, 1fr);\r\n  grid-template-areas: 'list form';\r\n  gap: 24px;\r\n  align-items: start;\r\n}\r\n.par-patients {\r\n  grid-area: list;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  min-width: 0;\r\n}\r\n.par-form {\r\n  grid-area: form;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.par-side {\r\n  grid-area: side;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.par-eyebrow {\r\n  font: 600 14px/20px var(--font-ui);\r\n  letter-spacing: 0.06em;\r\n  text-transform: uppercase;\r\n  color: var(--text-muted);\r\n}\r\n.par-cap {\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n  min-width: 0;\r\n}\r\n\r\n.par-pad__key:focus-visible,\r\n.par-pick__main:focus-visible {\r\n  outline: 3px solid #245bb5;\r\n  outline-offset: 2px;\r\n}\r\n\r\n/* Colonna pazienti */\r\n.par-search {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n.par-search__ico {\r\n  position: absolute;\r\n  left: 14px;\r\n  display: grid;\r\n  color: var(--text-muted);\r\n}\r\n.par-search__ico svg {\r\n  width: 18px;\r\n  height: 18px;\r\n}\r\n.par-search__input {\r\n  width: 100%;\r\n  height: 48px;\r\n  padding: 0 44px;\r\n  border-radius: 12px;\r\n  border: 2px solid var(--border);\r\n  background: var(--surface);\r\n  font: 400 16px/24px var(--font-ui);\r\n  color: var(--text);\r\n}\r\n.par-search__clear {\r\n  position: absolute;\r\n  right: 4px;\r\n  width: 40px;\r\n  height: 40px;\r\n  border: 0;\r\n  background: none;\r\n  display: grid;\r\n  place-items: center;\r\n  color: var(--text-muted);\r\n  cursor: pointer;\r\n}\r\n.par-patients__tools {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n}\r\n.par-plist {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n.par-pick {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding-right: 8px;\r\n  border-radius: 12px;\r\n  background: var(--surface);\r\n  border: 2px solid transparent;\r\n}\r\n.par-pick--selected {\r\n  border-color: var(--blue);\r\n  background: #eaf1fe;\r\n}\r\n.par-pick__main {\r\n  flex: 1;\r\n  min-width: 0;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n  padding: 8px;\r\n  border: 0;\r\n  background: none;\r\n  text-align: left;\r\n  cursor: pointer;\r\n  border-radius: 10px;\r\n}\r\n.par-pick__bed {\r\n  width: 48px;\r\n  height: 48px;\r\n  flex: none;\r\n  border-radius: 12px;\r\n  background: #f5f7fb;\r\n  border: 1px solid var(--border);\r\n  display: grid;\r\n  place-items: center;\r\n  font: 600 18px/24px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--text);\r\n}\r\n.par-pick__text {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n}\r\n.par-pick__name {\r\n  font: 600 16px/24px var(--font-ui);\r\n  color: var(--text);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.par-pick .par-cap {\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n.par-pick__draft {\r\n  color: #8a5300;\r\n  font-weight: 600;\r\n}\r\n.par-pick .turno-pcard__news2 {\r\n  flex: none;\r\n}\r\n.par-more {\r\n  align-self: flex-start;\r\n  min-height: 48px;\r\n}\r\n\r\n/* Paziente scelto */\r\n.par-form__head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n}\r\n.par-form__who {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n}\r\n.par-form__name {\r\n  margin: 0;\r\n  font: 600 20px/28px var(--font-ui);\r\n  color: var(--text);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.par-cards {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  gap: 16px;\r\n}\r\n.par-card {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  padding: 16px;\r\n  border-radius: 16px;\r\n  background: var(--surface);\r\n  border: 2px solid var(--border);\r\n  cursor: text;\r\n  min-width: 0;\r\n  margin: 0;\r\n}\r\n.par-card--active {\r\n  border-color: var(--blue);\r\n}\r\n.par-card__label {\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n.par-card__value {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: 8px;\r\n  min-width: 0;\r\n}\r\n/* Il campo è la card: niente riquadro del campo globale (form-controls.css). */\r\n.par-view .par-card input.par-card__input {\r\n  --control-bg: transparent;\r\n  --control-border: transparent;\r\n  box-shadow: none;\r\n  /* Il campo cresce col valore: l'unità resta accanto, come nel prototipo. */\r\n  field-sizing: content;\r\n  width: auto;\r\n  min-width: 2ch;\r\n  max-width: 100%;\r\n  flex: 0 1 auto;\r\n  height: 40px;\r\n  border: 0;\r\n  padding: 0;\r\n  background: none;\r\n  font: 600 28px/36px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--text);\r\n}\r\n.par-view .par-card input.par-card__input:focus {\r\n  outline: none;\r\n}\r\n.par-card__input::placeholder {\r\n  color: var(--text);\r\n}\r\n.par-card__unit {\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n  white-space: nowrap;\r\n}\r\n.par-choice,\r\n.par-field {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  margin: 0;\r\n}\r\n.par-choice__label {\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n\r\n.par-extra {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  gap: 16px;\r\n}\r\n.par-text {\r\n  min-height: 48px;\r\n  width: 100%;\r\n}\r\n\r\n/* Tastierino e salvataggio */\r\n.par-pad {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, 1fr);\r\n  gap: 8px;\r\n}\r\n.par-pad__key {\r\n  height: 48px;\r\n  border-radius: 12px;\r\n  border: 2px solid var(--border);\r\n  background: var(--surface);\r\n  color: var(--text);\r\n  font: 600 20px/28px var(--font-ui);\r\n  cursor: pointer;\r\n}\r\n.par-pad__key:active:not(:disabled) {\r\n  background: #eaf1fe;\r\n}\r\n\r\n.par-pad__key:disabled {\r\n  opacity: 0.45;\r\n  cursor: not-allowed;\r\n}\r\n.par-news2 {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  padding: 16px;\r\n  border-radius: 16px;\r\n  background: #eaf1fe;\r\n  color: #1d4fc4;\r\n}\r\n.par-news2__title {\r\n  font: 600 14px/20px var(--font-ui);\r\n}\r\n.par-news2__score {\r\n  font: 700 28px/36px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.par-news2__text {\r\n  font: 400 16px/24px var(--font-ui);\r\n}\r\n.par-news2--ok {\r\n  background: #e6f6ef;\r\n  color: #0e7a55;\r\n}\r\n.par-news2--low {\r\n  background: #eaf1fe;\r\n  color: #1d4fc4;\r\n}\r\n.par-news2--single,\r\n.par-news2--medium {\r\n  background: var(--amber-bg);\r\n  color: #8a5300;\r\n}\r\n.par-news2--high {\r\n  background: #fdecee;\r\n  color: #b3261e;\r\n}\r\n.par-result {\r\n  margin: 0;\r\n  color: #0e7a55;\r\n  font: 600 14px/20px var(--font-ui);\r\n}\r\n.par-error {\r\n  color: #b3261e;\r\n  font: 400 14px/20px var(--font-ui);\r\n}\r\n\r\n/* Tablet: pazienti a sinistra, tastierino sotto il modulo. */\r\n@media (max-width: 1099px) {\r\n  .par-grid {\r\n    grid-template-columns: 240px minmax(0, 1fr);\r\n    grid-template-areas: 'list form';\r\n  }\r\n}\r\n/* Telefono: una colonna; l'elenco pazienti scorre in un riquadro. */\r\n@media (max-width: 699px) {\r\n  .par-grid {\r\n    grid-template-columns: minmax(0, 1fr);\r\n    grid-template-areas: 'list' 'form';\r\n  }\r\n  .par-plist {\r\n    max-height: 40vh;\r\n    overflow-y: auto;\r\n  }\r\n  .par-cards,\r\n  .par-extra {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }\r\n  .par-cards {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n  /* Sul telefono c'è già la tastiera numerica di sistema (inputMode). */\r\n  .par-pad {\r\n    display: none;\r\n  }\r\n}\r\n/* Schermi larghi: tastierino, NEWS2 e Salva restano a vista mentre si scorre il modulo. */\r\n@media (min-width: 1100px) {\r\n  .par-side {\r\n    position: sticky;\r\n    top: 16px;\r\n  }\r\n}\r\n\r\n/* QA: il nome non si tronca (omonimi, stessa camera). Va a capo su più righe se serve. */\r\n.par-pick__name,\r\n.par-pick .par-cap {\r\n  white-space: normal;\r\n  overflow: visible;\r\n  text-overflow: clip;\r\n  overflow-wrap: anywhere;\r\n}\r\n.par-pick__main {\r\n  align-items: flex-start;\r\n}\r\n.par-pick { display:grid; grid-template-columns:minmax(0,1fr); padding:8px; gap:4px; }\r\n.par-pick__main { width:100%; padding:0; gap:10px; }\r\n.par-pick__text { flex:1; min-width:0; }\r\n.par-pick__bed { width:32px; height:32px; border-radius:8px; font-size:14px; }\r\n.par-pick__name { font-size:14px; line-height:20px; overflow-wrap:normal; word-break:normal; }\r\n.par-pick .par-cap { font-size:12px; line-height:18px; overflow-wrap:normal; }\r\n.par-pick .turno-pcard__news2 { justify-self:start; max-width:100%; margin-left:42px; font-size:12px; line-height:18px; }\r\n@media (max-width: 1099px) {\r\n  .par-grid {\r\n    grid-template-columns: 240px minmax(0, 1fr);\r\n  }\r\n}\r\n@media (max-width: 699px) {\r\n  .par-grid {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }\r\n}\r\n.par-outside {\r\n  margin: 0;\r\n  padding: 8px 12px;\r\n  border-radius: 12px;\r\n  background: var(--amber-bg);\r\n  color: #8a5300;\r\n  font: 600 14px/20px var(--font-ui);\r\n}\r\n\r\n/* Un solo pulsante per cancellare la ricerca (quello della pagina). */\r\n.par-search__input::-webkit-search-cancel-button {\r\n  display: none;\r\n}\r\n\r\n/* Azioni della colonna laterale a tutta larghezza (solo layout). */\r\n.par-wide {\r\n  width: 100%;\r\n}\r\n"],["STYLE",{},"/* Ricerca in anagrafica AIFA. Token del design system; nessun rosso come colore di marca. */\r\n\r\n.ricerca-farmaco {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  padding: 16px 20px 20px;\r\n  min-height: 0;\r\n}\r\n\r\n.ricerca-farmaco__campo {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding: 8px 12px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: #fff;\r\n}\r\n\r\n/* Stesso vincolo del campo nella maschera terapia: senza, il flex stira l'icona a tutto campo. */\r\n.ricerca-farmaco__campo > svg {\r\n  flex: none;\r\n  width: 18px;\r\n  height: 18px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.ricerca-farmaco__campo:focus-within {\r\n  border-color: var(--blue);\r\n  box-shadow: 0 0 0 3px rgb(47 107 237 / 12%);\r\n}\r\n\r\n.ricerca-farmaco__campo input {\r\n  flex: 1;\r\n  min-width: 0;\r\n  border: 0;\r\n  outline: none;\r\n  font-size: 14px;\r\n  color: var(--text);\r\n  background: transparent;\r\n}\r\n\r\n.ricerca-farmaco__criterio {\r\n  width: fit-content;\r\n  max-width: 100%;\r\n}\r\n\r\n.ricerca-farmaco__esiti {\r\n  flex: 1;\r\n  min-height: 0;\r\n  overflow: auto;\r\n}\r\n\r\n.ricerca-farmaco__nota {\r\n  margin: 0;\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.ricerca-farmaco__nota--errore {\r\n  color: var(--red);\r\n}\r\n\r\n.ricerca-farmaco__lista {\r\n  margin: 0;\r\n  padding: 0;\r\n  list-style: none;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n\r\n.ricerca-farmaco__riga {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  padding: 10px 12px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: #fff;\r\n}\r\n\r\n.ricerca-farmaco__nome {\r\n  margin: 0;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  color: var(--text);\r\n}\r\n\r\n/* Il rosso qui e' corretto: e' un avviso, non un accento di marca. */\r\n.ricerca-farmaco__revocato {\r\n  margin-left: 8px;\r\n  padding: 1px 7px;\r\n  border-radius: 999px;\r\n  background: var(--red);\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n  text-transform: uppercase;\r\n  color: #fff;\r\n}\r\n\r\n.ricerca-farmaco__dettagli,\r\n.ricerca-farmaco__pa {\r\n  margin: 2px 0 0;\r\n  font-size: 11px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n/* ── Modale ─────────────────────────────────────────────────────────────────────────────── */\r\n\r\n.ricerca-farmaco-modale {\r\n  display: flex;\r\n  flex-direction: column;\r\n  width: min(720px, 96vw);\r\n  max-height: 88vh;\r\n  max-width: none;\r\n  padding: 0;\r\n  overflow: hidden;\r\n}\r\n\r\n.ricerca-farmaco-modale__testa {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  padding: 18px 20px 12px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.ricerca-farmaco-modale__testa h2 {\r\n  margin: 0 0 4px;\r\n  font-size: 16px;\r\n  font-weight: 700;\r\n  color: var(--text);\r\n}\r\n\r\n/* ── Pagina dedicata ────────────────────────────────────────────────────────────────────── */\r\n\r\n.page-anagrafica-farmaci {\r\n  max-width: 1400px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.page-anagrafica-farmaci__corpo {\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--card-radius, 14px);\r\n  background: var(--surface);\r\n}\r\n\r\n/* ── Indicatore sulla riga di terapia ───────────────────────────────────────────────────── */\r\n\r\n.farmaco-trovato {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  margin: 3px 0 0 6px;\r\n  padding: 2px 6px;\r\n  border-radius: 999px;\r\n  background: var(--emerald-bg);\r\n  color: var(--text);\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  line-height: 1.4;\r\n  white-space: nowrap;\r\n  vertical-align: middle;\r\n}\r\n\r\n.farmaco-trovato svg {\r\n  display: block;\r\n  width: 12px;\r\n  height: 12px;\r\n  color: var(--teal);\r\n}\r\n\r\n/* \"non in anagrafica\" / \"senza documento\": ds-badge--warning canonico (ambra, mai rosso: non è\r\n   un allarme clinico ma un dato mancante su cui l'operatore può agire). */\r\n.ricerca-farmaco__icona {\r\n  flex: none;\r\n  display: grid;\r\n  place-items: center;\r\n  width: 24px;\r\n  height: 24px;\r\n  color: var(--text);\r\n}\r\n.ricerca-farmaco__icona svg {\r\n  width: 20px;\r\n  height: 20px;\r\n}\r\n.ricerca-farmaco__testo {\r\n  /* Base esplicita: su schermi stretti è il pulsante ad andare a capo, non le parole a spezzarsi. */\r\n  flex: 1 1 200px;\r\n  min-width: 0;\r\n  overflow-wrap: break-word;\r\n}\r\n@media (max-width: 600px) {\r\n  .ricerca-farmaco__riga {\r\n    flex-wrap: wrap;\r\n  }\r\n  .ricerca-farmaco__riga > :last-child {\r\n    margin-left: 36px;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Farmaci — HMI 1 (artifacts/hmi-parity/proto/farmaci.png). Solo la pagina: la modale della\r\n   terapia usa lo stesso corpo di ricerca con i suoi stili. */\r\n.page-anagrafica-farmaci {\r\n  max-width: none;\r\n}\r\n.page-anagrafica-farmaci__corpo {\r\n  border-radius: 16px;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco {\r\n  padding: 24px;\r\n  gap: 16px;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__campo {\r\n  height: 48px;\r\n  padding: 0 16px;\r\n  border: 2px solid var(--border);\r\n  border-radius: 12px;\r\n  background: #f5f7fb;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__campo input {\r\n  font-size: 16px;\r\n}\r\n\r\n.page-anagrafica-farmaci .ricerca-farmaco__nota {\r\n  font-size: 14px;\r\n  line-height: 20px;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__vuoto {\r\n  padding: 16px 0;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__esiti {\r\n  overflow: visible;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__lista {\r\n  gap: 0;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__riga {\r\n  gap: 16px;\r\n  padding: 12px 0;\r\n  border: 0;\r\n  border-bottom: 1px solid var(--border);\r\n  border-radius: 0;\r\n  background: transparent;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__nome {\r\n  font: 600 16px/24px var(--font-ui);\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__dettagli,\r\n.page-anagrafica-farmaci .ricerca-farmaco__pa {\r\n  font: 400 14px/20px var(--font-ui);\r\n}\r\n\r\n@media (max-width: 600px) {\r\n  .page-anagrafica-farmaci .ricerca-farmaco {\r\n    padding: 16px;\r\n  }\r\n  .page-anagrafica-farmaci .ricerca-farmaco__riga {\r\n    flex-wrap: wrap;\r\n  }\r\n  .page-anagrafica-farmaci .ricerca-farmaco__riga > :last-child {\r\n    margin-left: 40px;\r\n  }\r\n}\r\n"],["STYLE",{},".agnos-panel { height: 100dvh; max-width: 100%; }\r\n.agnos-panel > header, .agnos-panel > .agnos-intro,\r\n.agnos-workflow-status, .agnos-composer { flex-shrink: 0; }\r\n.agnos-panel .ai-drawer__body { min-height: 0; overscroll-behavior: contain; padding: 16px 24px; }\r\n/* HMI 1: testata alta come la barra in alto, titolo \"✧ Assistente\" viola, poi la dichiarazione. */\r\n.agnos-panel .ai-drawer__header { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 8px; min-height: 72px; padding: 12px 16px 12px 24px; box-sizing: border-box; }\r\n.agnos-panel .agnos-title { display: flex; align-items: center; gap: 8px; min-width: 0; margin: 0; font: 600 20px/28px var(--ds-font); color: var(--purple, #6c4bd1); }\r\n.agnos-panel .agnos-title svg { width: 20px; height: 20px; flex: none; }\r\n.agnos-intro { padding: 16px 24px 0; }\r\n.agnos-intro p { margin: 0; }\r\n.agnos-intro__text { font: 400 14px/20px var(--ds-font); color: var(--text-muted); }\r\n.agnos-intro .agnos-intro__scope { margin-top: 8px; font: 600 14px/20px var(--ds-font); color: var(--ds-blue-active); }\r\n.agnos-panel .agnos-compose { display: flex; flex-direction: column; align-items: stretch; gap: 8px; padding: 16px 24px; }\r\n.agnos-compose-row { display: flex; align-items: flex-end; gap: 8px; }\r\n.agnos-compose-label { font-size: 13px; font-weight: 650; color: var(--text); }\r\n/* il campo parte da una riga (48px) e cresce col testo o con la dettatura */\r\n.agnos-panel textarea.agnos-input { width: 100%; min-width: 0; min-height: 48px; height: auto; max-height: 150px; flex: auto; field-sizing: content; line-height: 24px; padding-block: 10px; resize: none; }\r\n.agnos-compose-actions { display: flex; align-items: center; justify-content: flex-end; gap: 8px; }\r\n.agnos-compose-help { margin: 0; padding: 0 12px 8px; font-size: 12px; color: var(--text-muted); line-height: 1.4; }\r\n.agnos-compose .agnos-compose-help { padding: 0; }\r\n.agnos-panel .agnos-voice-consent { padding: 0 14px max(8px, env(safe-area-inset-bottom)); }\r\n.agnos-voice-consent .link-btn { font-size: 12px; min-height: 28px; }\r\n.agnos-consent-prompt { padding: 16px; border-top: 1px solid var(--border); background: #f3f7fd; font-size: 13px; line-height: 1.5; }\r\n.agnos-consent-prompt > strong { display: block; font-size: 15px; color: var(--text); }\r\n.agnos-consent-prompt p { margin: 8px 0 12px; }\r\n.agnos-composer { max-height: 65%; overflow-y: auto; overscroll-behavior: contain; }\r\n.agnos-consent-prompt .agnos-compose-actions { flex-wrap: wrap; }\r\n.agnos-workflow-status { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; padding: 10px 14px; background: #eef4ff; border-bottom: 1px solid var(--border); color: #244676; font-size: 13px; line-height: 1.4; }\r\n.agnos-workflow-status > span:not(.agnos-workflow-spinner) { flex: 1 1 220px; }\r\n.agnos-workflow-status[data-phase='error'] { background: #fff7e8; color: #76501c; }\r\n.agnos-workflow-status .link-btn { font-size: 12px; min-height: 32px; }\r\n.agnos-workflow-spinner { width: 14px; height: 14px; flex: 0 0 14px; border: 2px solid #cbdaf2; border-top-color: #316dda; border-radius: 50%; animation: agnos-spin 900ms linear infinite; }\r\n.agnos-transcript-label { align-self: flex-end; font-size: 11px; color: var(--text-muted); }\r\n.agnos-proposed-text { padding: 12px; border: 1px solid var(--border); border-radius: 8px; background: white; }\r\n.agnos-proposed-text p, .agnos-preview .voice-preview__row dd { white-space: pre-wrap; overflow-wrap: anywhere; }\r\n.agnos-proposed-text p { margin: 8px 0 12px; line-height: 1.5; }\r\n.agnos-proposed-text summary { cursor: pointer; color: var(--blue); margin-bottom: 12px; }\r\n.agnos-approval-hint { font-size: 13px; line-height: 1.45; margin: 12px 0 8px; }\r\n.agnos-panel .voice-actions { flex-wrap: wrap; }\r\n.agnos-workflow-dock { position: fixed; bottom: max(52px, env(safe-area-inset-bottom)); right: 12px; z-index: 202; max-width: min(440px, calc(100vw - 24px)); padding: 12px; display: flex; align-items: center; flex-wrap: wrap; gap: 10px; background: white; border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 4px 20px #10284726; font-size: 13px; }\r\n.agnos-workflow-dock span { flex: 1 1 190px; }\r\n@keyframes agnos-spin { to { transform: rotate(360deg); } }\r\n@media (min-width: 1100px) {\r\n  .app-shell:has(.agnos-panel--workspace[aria-hidden='false']) .main-area-clean { margin-right: 420px; }\r\n}\r\n@media (max-width: 1099px) {\r\n  .agnos-panel--workspace { top: auto; bottom: 0; height: 76dvh; border-radius: 16px 16px 0 0; }\r\n}\r\n@media (max-width: 480px) {\r\n  .agnos-panel--workspace { top: 0; height: 100dvh; border-radius: 0; }\r\n  .agnos-panel .agnos-compose { padding: 12px 16px; }\r\n  .agnos-panel .ai-drawer__header { padding-left: 16px; }\r\n  .agnos-intro { padding: 12px 16px 0; }\r\n  .agnos-panel .ai-drawer__body { padding: 12px 16px; }\r\n}\r\n@media (prefers-reduced-motion: reduce) { .agnos-workflow-spinner { animation: none; } }\r\n@media print { .agnos-workflow-dock { display: none !important; } }\r\n"]],[[15,30]],["BODY",{},[[15,31]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},[[1,2]],["DIV",{"class":"main-area-clean"},["DIV",{"class":"compact-topbar"},[[2,13]],[[2,16]],["DIV",{"class":"topbar-title"},["DIV",{"class":"page-header__titles"},["H1",{"class":"page-header__title"},"Pazienti"],["P",{"class":"page-header__subtitle"},"1 caricati su 1"]]],[[10,122]],[[10,138]]],["MAIN",{"class":"page-content content-panel"},["DIV",{"class":"patient-list-view"},["SECTION",{"class":"plist-card plist-list","aria-label":"Elenco pazienti"},["DIV",{"class":"plist-toolbar"},["DIV",{"class":"search-wrap plist-search"},["SPAN",{"class":"search-wrap__ico"},["svg",{"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.75","stroke-linecap":"round","stroke-linejoin":"round"},["circle",{"cx":"11","cy":"11","r":"8"}],["line",{"x1":"21","y1":"21","x2":"16.65","y2":"16.65"}]]],["INPUT",{"__playwright_value_":"","class":"search-input","placeholder":"Cerca per nome o codice fiscale…","aria-label":"Cerca paziente per nome o codice fiscale","maxlength":"80","type":"search","value":""}]],["DIV",{"class":"plist-views","role":"group","aria-label":"Vista dei pazienti caricati"},["BUTTON",{"type":"button","class":"ds-chip","aria-pressed":"true"},"Non dimessi",["SPAN",{"class":"ds-chip__count"},"1"]],["BUTTON",{"type":"button","class":"ds-chip","aria-pressed":"false"},"Dimessi e archivio",["SPAN",{"class":"ds-chip__count"},"0"]],["BUTTON",{"type":"button","class":"ds-chip","aria-pressed":"false"},"Tutti",["SPAN",{"class":"ds-chip__count"},"1"]],["BUTTON",{"type":"button","class":"ds-chip","aria-expanded":"false","aria-controls":"plist-filters"},"Filtri e ordine"]]],["DIV",{"class":"plist-regime-controls"},["LABEL",{"class":"plist-regime-field","for":"patient-regime"},"Regime registrato",["SELECT",{"id":"patient-regime","class":"form-input"},["OPTION",{"__playwright_selected_":"true","value":"tutti"},"Tutti i regimi"],["OPTION",{"__playwrig