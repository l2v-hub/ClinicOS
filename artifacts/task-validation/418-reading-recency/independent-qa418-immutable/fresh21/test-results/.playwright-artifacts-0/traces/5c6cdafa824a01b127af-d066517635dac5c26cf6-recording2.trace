{"type":"frame-snapshot","snapshot":{"callId":"call@2958","snapshotName":"after@call@2958","pageId":"page@2ec5165cb08609dd9e148f60fe3684d1","frameId":"frame@15df736652bbc3a65eb1b0f089a8406f","frameUrl":"http://127.0.0.1:7483/#/parametri-multipaziente","doctype":"html","html":["HTML",{"lang":"it"},["HEAD",{},[[48,0]],[[48,1]],[[48,2]],[[48,3]],[[48,4]],[[48,5]],[[48,6]],[[48,7]],[[48,8]],[[48,9]],[[48,10]],[[48,11]],[[48,12]],[[48,13]],[[48,15]],[[48,16]],[[48,18]],[[48,20]],[[48,22]],[[48,24]],[[48,26]],[[48,28]],[[45,1]],[[45,3]],[[45,5]],[[45,7]],[[45,9]],[[45,11]],[[45,13]],[[45,15]],[[45,17]],[[45,19]],[[45,21]],[[45,23]],[[45,25]],[[45,27]],[[45,29]],[[44,1]],[[44,3]],[[44,5]],[[44,7]],[[44,9]],[[44,11]],[[44,13]],[[44,15]],[[44,17]],[[44,19]],[[44,21]],[[44,23]],[[44,25]],[[44,27]],[[43,1]],[[43,3]],[[43,5]],[[43,7]],[[43,9]],[[43,11]],[[36,1]],[[36,3]],[[36,5]],[[36,7]],[[36,9]],[[36,11]],[[36,13]],[[36,15]],[[36,17]],[[36,19]],[[36,21]],[[36,23]],[[17,1]],[[17,3]],["STYLE",{},".agnos-panel { height: 100dvh; max-width: 100%; }\r\n.agnos-panel > header, .agnos-panel > .agnos-intro,\r\n.agnos-workflow-status, .agnos-composer { flex-shrink: 0; }\r\n.agnos-panel .ai-drawer__body { min-height: 0; overscroll-behavior: contain; padding: 16px 24px; }\r\n/* HMI 1: testata alta come la barra in alto, titolo \"✧ Assistente\" viola, poi la dichiarazione. */\r\n.agnos-panel .ai-drawer__header { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 8px; min-height: 72px; padding: 12px 16px 12px 24px; box-sizing: border-box; }\r\n.agnos-panel .agnos-title { display: flex; align-items: center; gap: 8px; min-width: 0; margin: 0; font: 600 20px/28px var(--ds-font); color: var(--purple, #6c4bd1); }\r\n.agnos-panel .agnos-title svg { width: 20px; height: 20px; flex: none; }\r\n.agnos-intro { padding: 16px 24px 0; }\r\n.agnos-intro p { margin: 0; }\r\n.agnos-intro__text { font: 400 14px/20px var(--ds-font); color: var(--text-muted); }\r\n.agnos-intro .agnos-intro__scope { margin-top: 8px; font: 600 14px/20px var(--ds-font); color: var(--ds-blue-active); }\r\n.agnos-panel .agnos-compose { display: flex; flex-direction: column; align-items: stretch; gap: 8px; padding: 16px 24px; }\r\n.agnos-compose-row { display: flex; align-items: flex-end; gap: 8px; }\r\n.agnos-compose-label { font-size: 13px; font-weight: 650; color: var(--text); }\r\n/* il campo parte da una riga (48px) e cresce col testo o con la dettatura */\r\n.agnos-panel textarea.agnos-input { width: 100%; min-width: 0; min-height: 48px; height: auto; max-height: 150px; flex: auto; field-sizing: content; line-height: 24px; padding-block: 10px; resize: none; }\r\n.agnos-compose-actions { display: flex; align-items: center; justify-content: flex-end; gap: 8px; }\r\n.agnos-compose-help { margin: 0; padding: 0 12px 8px; font-size: 12px; color: var(--text-muted); line-height: 1.4; }\r\n.agnos-compose .agnos-compose-help { padding: 0; }\r\n.agnos-panel .agnos-voice-consent { padding: 0 14px max(8px, env(safe-area-inset-bottom)); }\r\n.agnos-voice-consent .link-btn { font-size: 12px; min-height: 28px; }\r\n.agnos-consent-prompt { padding: 16px; border-top: 1px solid var(--border); background: #f3f7fd; font-size: 13px; line-height: 1.5; }\r\n.agnos-consent-prompt > strong { display: block; font-size: 15px; color: var(--text); }\r\n.agnos-consent-prompt p { margin: 8px 0 12px; }\r\n.agnos-composer { max-height: 65%; overflow-y: auto; overscroll-behavior: contain; }\r\n.agnos-consent-prompt .agnos-compose-actions { flex-wrap: wrap; }\r\n.agnos-workflow-status { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; padding: 10px 14px; background: #eef4ff; border-bottom: 1px solid var(--border); color: #244676; font-size: 13px; line-height: 1.4; }\r\n.agnos-workflow-status > span:not(.agnos-workflow-spinner) { flex: 1 1 220px; }\r\n.agnos-workflow-status[data-phase='error'] { background: #fff7e8; color: #76501c; }\r\n.agnos-workflow-status .link-btn { font-size: 12px; min-height: 32px; }\r\n.agnos-workflow-spinner { width: 14px; height: 14px; flex: 0 0 14px; border: 2px solid #cbdaf2; border-top-color: #316dda; border-radius: 50%; animation: agnos-spin 900ms linear infinite; }\r\n.agnos-transcript-label { align-self: flex-end; font-size: 11px; color: var(--text-muted); }\r\n.agnos-proposed-text { padding: 12px; border: 1px solid var(--border); border-radius: 8px; background: white; }\r\n.agnos-proposed-text p, .agnos-preview .voice-preview__row dd { white-space: pre-wrap; overflow-wrap: anywhere; }\r\n.agnos-proposed-text p { margin: 8px 0 12px; line-height: 1.5; }\r\n.agnos-proposed-text summary { cursor: pointer; color: var(--blue); margin-bottom: 12px; }\r\n.agnos-approval-hint { font-size: 13px; line-height: 1.45; margin: 12px 0 8px; }\r\n.agnos-panel .voice-actions { flex-wrap: wrap; }\r\n.agnos-workflow-dock { position: fixed; bottom: max(52px, env(safe-area-inset-bottom)); right: 12px; z-index: 202; max-width: min(440px, calc(100vw - 24px)); padding: 12px; display: flex; align-items: center; flex-wrap: wrap; gap: 10px; background: white; border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 4px 20px #10284726; font-size: 13px; }\r\n.agnos-workflow-dock span { flex: 1 1 190px; }\r\n@keyframes agnos-spin { to { transform: rotate(360deg); } }\r\n@media (min-width: 1100px) {\r\n  .app-shell:has(.agnos-panel--workspace[aria-hidden='false']) .main-area-clean { margin-right: 420px; }\r\n}\r\n@media (max-width: 1099px) {\r\n  .agnos-panel--workspace { top: auto; bottom: 0; height: 76dvh; border-radius: 16px 16px 0 0; }\r\n}\r\n@media (max-width: 480px) {\r\n  .agnos-panel--workspace { top: 0; height: 100dvh; border-radius: 0; }\r\n  .agnos-panel .agnos-compose { padding: 12px 16px; }\r\n  .agnos-panel .ai-drawer__header { padding-left: 16px; }\r\n  .agnos-intro { padding: 12px 16px 0; }\r\n  .agnos-panel .ai-drawer__body { padding: 12px 16px; }\r\n}\r\n@media (prefers-reduced-motion: reduce) { .agnos-workflow-spinner { animation: none; } }\r\n@media print { .agnos-workflow-dock { display: none !important; } }\r\n"]],[[48,30]],["BODY",{},[[48,31]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},[[37,2]],["DIV",{"class":"main-area-clean"},[[36,31]],["MAIN",{"class":"page-content content-panel"},["DIV",{"class":"par-view"},["DIV",{"class":"par-grid"},[[34,6]],["SECTION",{"class":"par-form","aria-label":"Rilevazione di Sintetico QA, Caso"},[[36,67]],["FORM",{"class":"parameter-reading-form","aria-label":"Nuova rilevazione"},["DIV",{"class":"parameter-reading-form__layout"},["FIELDSET",{"class":"parameter-reading-form__fields"},[[36,69]],[[5,1]],[[3,1]],[[1,1]],["LABEL",{"for":"_r_8_-pas","class":"parameter-reading-form__field"},[[36,105]],["INPUT",{"__playwright_value_":"","__playwright_target__":"","id":"_r_8_-pas","class":"form-input","aria-label":"Nuova rilevazione PA sistolica","aria-describedby":"_r_8_-pas-previous","placeholder":"—","inputmode":"numeric","type":"text","value":""}],[[36,108]]],[[36,118]],[[11,0]],[[36,136]],[[36,155]],[[36,164]],[[36,169]],[[36,176]]],[[36,219]]]]]],[[36,227]]]]]]],[[48,65]],[[48,66]]]],"viewport":{"width":1150,"height":1004},"timestamp":13987.097,"wallTime":1792890302192,"collectionTime":1,"resourceOverrides":[],"isMainFrame":true}}
