{"type":"frame-snapshot","snapshot":{"callId":"call@2672","snapshotName":"after@call@2672","pageId":"page@2ec5165cb08609dd9e148f60fe3684d1","frameId":"frame@15df736652bbc3a65eb1b0f089a8406f","frameUrl":"http://127.0.0.1:7483/#/operator-dashboard","doctype":"html","html":["HTML",{"lang":"it"},["HEAD",{},[[5,0]],[[5,1]],[[5,2]],[[5,3]],[[5,4]],[[5,5]],[[5,6]],[[5,7]],[[5,8]],[[5,9]],[[5,10]],[[5,11]],[[5,12]],[[5,13]],[[5,15]],[[5,16]],[[5,18]],[[5,20]],[[5,22]],[[5,24]],[[5,26]],[[5,28]],[[2,1]],[[2,3]],[[2,5]],[[2,7]],[[2,9]],[[2,11]],[[2,13]],[[2,15]],[[2,17]],[[2,19]],[[2,21]],[[2,23]],[[2,25]],[[2,27]],[[2,29]],[[1,1]],[[1,3]],[[1,5]],[[1,7]],[[1,9]],[[1,11]],[[1,13]],[[1,15]],[[1,17]],[[1,19]],[[1,21]],[[1,23]],[[1,25]],[[1,27]],["STYLE",{},".table-filters {\r\n  background: var(--surface);\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.table-filters__toolbar {\r\n  min-height: calc(var(--ds-control-h) + 12px);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  padding: 6px 14px;\r\n  background: color-mix(in srgb, var(--surface-raised) 72%, var(--surface));\r\n}\r\n\r\n.table-filters__toggle {\r\n  min-width: 0;\r\n  min-height: var(--touch-target);\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  padding: 5px 8px;\r\n  color: var(--text);\r\n  background: transparent;\r\n  border: 0;\r\n  border-radius: 8px;\r\n  font: inherit;\r\n  text-align: left;\r\n  cursor: pointer;\r\n}\r\n\r\n.table-filters__toggle:hover {\r\n  background: var(--hover);\r\n}\r\n\r\n.table-filters__toggle:focus-visible,\r\n.table-filters__clear:focus-visible,\r\n.table-filters__field :is(input, select):focus-visible {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 2px;\r\n}\r\n\r\n.table-filters__icon {\r\n  width: 32px;\r\n  height: 32px;\r\n  flex: 0 0 32px;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: var(--blue);\r\n  background: var(--blue-glow);\r\n  border-radius: 8px;\r\n}\r\n\r\n.table-filters__icon svg {\r\n  width: 17px;\r\n  height: 17px;\r\n}\r\n\r\n.table-filters__toggle-copy {\r\n  min-width: 0;\r\n  display: grid;\r\n  gap: 1px;\r\n}\r\n\r\n.table-filters__title {\r\n  color: var(--text);\r\n  font-size: 12px;\r\n  font-weight: 750;\r\n}\r\n\r\n.table-filters__hint {\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  font-weight: 500;\r\n}\r\n\r\n.table-filters__active-badge {\r\n  min-width: 22px;\r\n  height: 22px;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 0 6px;\r\n  color: #fff;\r\n  background: var(--blue);\r\n  border-radius: 999px;\r\n  font-size: 11px;\r\n  font-weight: 750;\r\n}\r\n\r\n.table-filters__chevron {\r\n  width: 16px;\r\n  height: 16px;\r\n  display: inline-flex;\r\n  color: var(--text-muted);\r\n  transition: transform 0.16s ease;\r\n}\r\n\r\n.table-filters__chevron svg {\r\n  width: 16px;\r\n  height: 16px;\r\n}\r\n\r\n.table-filters.is-open .table-filters__chevron {\r\n  transform: rotate(180deg);\r\n}\r\n\r\n.table-filters__summary {\r\n  flex-shrink: 0;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n}\r\n\r\n.table-filters__results {\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  white-space: nowrap;\r\n}\r\n\r\n.table-filters__clear {\r\n  min-height: var(--touch-target);\r\n  padding: 6px 10px;\r\n  color: var(--blue);\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  font: inherit;\r\n  font-size: 11px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n}\r\n\r\n.table-filters__clear:hover {\r\n  border-color: var(--blue);\r\n  background: var(--blue-glow);\r\n}\r\n\r\n.table-filters__panel {\r\n  padding: 14px;\r\n  background: var(--surface);\r\n  border-top: 1px solid var(--divider);\r\n}\r\n\r\n.table-filters__grid {\r\n  display: grid;\r\n  gap: 12px;\r\n}\r\n\r\n.table-filters__grid--1 {\r\n  grid-template-columns: minmax(0, 1fr);\r\n}\r\n\r\n.table-filters__grid--2 {\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n}\r\n\r\n.table-filters__grid--3 {\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n}\r\n\r\n.table-filters__grid--4 {\r\n  grid-template-columns: repeat(4, minmax(0, 1fr));\r\n}\r\n\r\n.table-filters__field {\r\n  min-width: 0;\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n\r\n.table-filters__field label {\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  font-weight: 750;\r\n  letter-spacing: 0.45px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.table-filters__field :is(input, select) {\r\n  width: 100%;\r\n  min-width: 0;\r\n  min-height: var(--touch-target);\r\n  padding: 0 11px;\r\n  color: var(--text);\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  font: inherit;\r\n  font-size: var(--ds-field-font);\r\n}\r\n\r\n.table-filters__field :is(input, select):hover {\r\n  border-color: var(--text-xmuted);\r\n}\r\n\r\n.table-filters__field :is(input, select):focus {\r\n  border-color: var(--blue);\r\n  box-shadow: var(--shadow-focus);\r\n}\r\n\r\n.table-filters__field input::placeholder {\r\n  color: var(--text-xmuted);\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .table-filters__grid--3,\r\n  .table-filters__grid--4 {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  .table-filters__toolbar {\r\n    align-items: stretch;\r\n    flex-direction: column;\r\n    gap: 4px;\r\n    padding: 8px 10px;\r\n  }\r\n\r\n  .table-filters__toggle {\r\n    width: 100%;\r\n  }\r\n\r\n  .table-filters__summary {\r\n    min-height: 36px;\r\n    justify-content: space-between;\r\n    padding: 0 8px;\r\n  }\r\n\r\n  .table-filters__panel {\r\n    padding: 12px 10px;\r\n  }\r\n\r\n  .table-filters__grid--1,\r\n  .table-filters__grid--2,\r\n  .table-filters__grid--3,\r\n  .table-filters__grid--4 {\r\n    grid-template-columns: 1fr;\r\n    gap: 10px;\r\n  }\r\n}\r\n"],["STYLE",{},".op-management .operator-editor {\r\n  padding: 0;\r\n  overflow: hidden;\r\n  border-radius: 8px;\r\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);\r\n}\r\n\r\n.op-management .operator-editor__header {\r\n  min-height: 64px;\r\n  margin: 0;\r\n  padding: 12px 16px;\r\n  align-items: flex-start;\r\n  background: var(--surface-raised);\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.operator-editor__heading {\r\n  min-width: 0;\r\n}\r\n\r\n.operator-editor__eyebrow,\r\n.operator-editor__section > legend,\r\n.operator-editor__color-field > legend {\r\n  color: var(--text-xmuted);\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  letter-spacing: 0.65px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.operator-editor__eyebrow {\r\n  display: block;\r\n  margin-bottom: 2px;\r\n}\r\n\r\n.op-management .operator-editor .op-form-panel__title {\r\n  font-size: 16px;\r\n  line-height: 1.25;\r\n}\r\n\r\n.operator-editor__intro {\r\n  margin: 3px 0 0;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.operator-editor__close {\r\n  flex-shrink: 0;\r\n}\r\n\r\n.operator-editor__body {\r\n  padding: 0 16px;\r\n}\r\n\r\n.operator-editor__section {\r\n  min-width: 0;\r\n  margin: 0;\r\n  padding: 13px 0 15px;\r\n  border: 0;\r\n  border-bottom: 1px solid var(--divider);\r\n}\r\n\r\n.operator-editor__section > legend {\r\n  width: 100%;\r\n  margin: 0;\r\n  padding: 0 0 9px;\r\n}\r\n\r\n.operator-editor__grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(6, minmax(0, 1fr));\r\n  gap: 12px;\r\n}\r\n\r\n.operator-editor__field--span-2 {\r\n  grid-column: span 2;\r\n}\r\n\r\n.operator-editor__field--span-3 {\r\n  grid-column: span 3;\r\n}\r\n\r\n.operator-editor .form-field,\r\n.operator-editor .form-input,\r\n.operator-editor .form-select {\r\n  min-width: 0;\r\n}\r\n\r\n.operator-editor .form-input,\r\n.operator-editor .form-select {\r\n  width: 100%;\r\n}\r\n\r\n.operator-editor__optional {\r\n  margin: 0;\r\n  border-bottom: 0;\r\n}\r\n\r\n.operator-editor__optional > summary {\r\n  min-height: 46px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  padding: 0;\r\n  color: var(--text);\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n  list-style-position: inside;\r\n}\r\n\r\n.operator-editor__optional > summary:hover {\r\n  color: var(--blue);\r\n}\r\n\r\n.operator-editor__optional-title {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.operator-editor__selected-color {\r\n  width: 10px;\r\n  height: 10px;\r\n  flex-shrink: 0;\r\n  border-radius: 50%;\r\n  box-shadow: 0 0 0 1px var(--border);\r\n}\r\n\r\n.operator-editor__optional-badge {\r\n  margin-left: auto;\r\n  padding: 2px 8px;\r\n  border-radius: 999px;\r\n  color: var(--text-muted);\r\n  background: var(--surface-raised);\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.3px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.operator-editor__optional-content {\r\n  display: grid;\r\n  grid-template-columns: minmax(260px, 1fr) minmax(0, 2fr);\r\n  gap: 16px;\r\n  padding: 4px 0 15px;\r\n}\r\n\r\n.operator-editor__color-field {\r\n  min-width: 0;\r\n  margin: 0;\r\n  padding: 0;\r\n  border: 0;\r\n}\r\n\r\n.operator-editor__color-field > legend {\r\n  margin-bottom: 7px;\r\n}\r\n\r\n.operator-editor__color-picker {\r\n  display: flex;\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n  gap: 6px;\r\n}\r\n\r\n.operator-editor__color-swatch {\r\n  width: 40px;\r\n  height: 40px;\r\n  padding: 0;\r\n  border: 8px solid var(--surface);\r\n  border-radius: 50%;\r\n  outline: 1px solid var(--border);\r\n  cursor: pointer;\r\n}\r\n\r\n.operator-editor__color-swatch:hover {\r\n  outline-color: var(--blue);\r\n}\r\n\r\n.operator-editor__color-swatch.is-selected {\r\n  outline: 2px solid var(--text);\r\n  outline-offset: 1px;\r\n}\r\n\r\n.operator-editor__color-swatch:focus-visible,\r\n.operator-editor__custom-color:focus-within {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 2px;\r\n}\r\n\r\n.operator-editor__custom-color {\r\n  min-height: 40px;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 7px;\r\n  padding-left: 4px;\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n}\r\n\r\n.operator-editor__custom-color input {\r\n  width: 40px;\r\n  height: 40px;\r\n  padding: 4px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  background: var(--surface);\r\n  cursor: pointer;\r\n}\r\n\r\n.operator-editor__notes textarea {\r\n  min-height: 72px;\r\n}\r\n\r\n.op-management .operator-editor__actions {\r\n  min-height: 62px;\r\n  align-items: center;\r\n  margin: 0;\r\n  padding: 9px 16px;\r\n  background: var(--surface-raised);\r\n  border-top: 1px solid var(--border);\r\n}\r\n\r\n.operator-editor__required-note {\r\n  margin-right: auto;\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n}\r\n\r\n.operator-editor__required-note > span {\r\n  color: var(--red);\r\n  font-weight: 700;\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .op-management .cts .clinicos-table-wrap {\r\n    display: none;\r\n  }\r\n\r\n  .operator-editor__grid {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n\r\n  .operator-editor__field--span-2,\r\n  .operator-editor__field--span-3 {\r\n    grid-column: span 1;\r\n  }\r\n\r\n  .operator-editor__optional-content {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n\r\n@media (max-width: 520px) {\r\n  .op-management .operator-editor__header {\r\n    padding: 12px;\r\n  }\r\n\r\n  .operator-editor__intro {\r\n    max-width: 30ch;\r\n  }\r\n\r\n  .operator-editor__body {\r\n    padding: 0 12px;\r\n  }\r\n\r\n  .operator-editor__grid {\r\n    grid-template-columns: 1fr;\r\n    gap: 10px;\r\n  }\r\n\r\n  .op-management .operator-editor__actions {\r\n    flex-wrap: wrap;\r\n    padding: 10px 12px;\r\n  }\