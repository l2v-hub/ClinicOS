{"type":"frame-snapshot","snapshot":{"callId":"call@2908","snapshotName":"before@call@2908","pageId":"page@2ec5165cb08609dd9e148f60fe3684d1","frameId":"frame@15df736652bbc3a65eb1b0f089a8406f","frameUrl":"http://127.0.0.1:7483/#/parametri-multipaziente","doctype":"html","html":["HTML",{"lang":"it"},["HEAD",{},[[31,0]],[[31,1]],[[31,2]],[[31,3]],[[31,4]],[[31,5]],[[31,6]],[[31,7]],[[31,8]],[[31,9]],[[31,10]],[[31,11]],[[31,12]],[[31,13]],[[31,15]],[[31,16]],[[31,18]],[[31,20]],[[31,22]],[[31,24]],[[31,26]],[[31,28]],[[28,1]],[[28,3]],[[28,5]],[[28,7]],[[28,9]],[[28,11]],[[28,13]],[[28,15]],[[28,17]],[[28,19]],[[28,21]],[[28,23]],[[28,25]],[[28,27]],[[28,29]],[[27,1]],[[27,3]],[[27,5]],[[27,7]],[[27,9]],[[27,11]],[[27,13]],[[27,15]],[[27,17]],[[27,19]],[[27,21]],[[27,23]],[[27,25]],[[27,27]],[[26,1]],[[26,3]],[[26,5]],[[26,7]],[[26,9]],[[26,11]],[[19,1]],[[19,3]],[[19,5]],[[19,7]],[[19,9]],[[19,11]],[[19,13]],[[19,15]],[[19,17]],[[19,19]],[[19,21]],[[19,23]],["STYLE",{},"/* Ricerca in anagrafica AIFA. Token del design system; nessun rosso come colore di marca. */\r\n\r\n.ricerca-farmaco {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  padding: 16px 20px 20px;\r\n  min-height: 0;\r\n}\r\n\r\n.ricerca-farmaco__campo {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding: 8px 12px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: #fff;\r\n}\r\n\r\n/* Stesso vincolo del campo nella maschera terapia: senza, il flex stira l'icona a tutto campo. */\r\n.ricerca-farmaco__campo > svg {\r\n  flex: none;\r\n  width: 18px;\r\n  height: 18px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.ricerca-farmaco__campo:focus-within {\r\n  border-color: var(--blue);\r\n  box-shadow: 0 0 0 3px rgb(47 107 237 / 12%);\r\n}\r\n\r\n.ricerca-farmaco__campo input {\r\n  flex: 1;\r\n  min-width: 0;\r\n  border: 0;\r\n  outline: none;\r\n  font-size: 14px;\r\n  color: var(--text);\r\n  background: transparent;\r\n}\r\n\r\n.ricerca-farmaco__criterio {\r\n  width: fit-content;\r\n  max-width: 100%;\r\n}\r\n\r\n.ricerca-farmaco__esiti {\r\n  flex: 1;\r\n  min-height: 0;\r\n  overflow: auto;\r\n}\r\n\r\n.ricerca-farmaco__nota {\r\n  margin: 0;\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.ricerca-farmaco__nota--errore {\r\n  color: var(--red);\r\n}\r\n\r\n.ricerca-farmaco__lista {\r\n  margin: 0;\r\n  padding: 0;\r\n  list-style: none;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n\r\n.ricerca-farmaco__riga {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  padding: 10px 12px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: #fff;\r\n}\r\n\r\n.ricerca-farmaco__nome {\r\n  margin: 0;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  color: var(--text);\r\n}\r\n\r\n/* Il rosso qui e' corretto: e' un avviso, non un accento di marca. */\r\n.ricerca-farmaco__revocato {\r\n  margin-left: 8px;\r\n  padding: 1px 7px;\r\n  border-radius: 999px;\r\n  background: var(--red);\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n  text-transform: uppercase;\r\n  color: #fff;\r\n}\r\n\r\n.ricerca-farmaco__dettagli,\r\n.ricerca-farmaco__pa {\r\n  margin: 2px 0 0;\r\n  font-size: 11px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n/* ── Modale ─────────────────────────────────────────────────────────────────────────────── */\r\n\r\n.ricerca-farmaco-modale {\r\n  display: flex;\r\n  flex-direction: column;\r\n  width: min(720px, 96vw);\r\n  max-height: 88vh;\r\n  max-width: none;\r\n  padding: 0;\r\n  overflow: hidden;\r\n}\r\n\r\n.ricerca-farmaco-modale__testa {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  padding: 18px 20px 12px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.ricerca-farmaco-modale__testa h2 {\r\n  margin: 0 0 4px;\r\n  font-size: 16px;\r\n  font-weight: 700;\r\n  color: var(--text);\r\n}\r\n\r\n/* ── Pagina dedicata ────────────────────────────────────────────────────────────────────── */\r\n\r\n.page-anagrafica-farmaci {\r\n  max-width: 1400px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.page-anagrafica-farmaci__corpo {\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--card-radius, 14px);\r\n  background: var(--surface);\r\n}\r\n\r\n/* ── Indicatore sulla riga di terapia ───────────────────────────────────────────────────── */\r\n\r\n.farmaco-trovato {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  margin: 3px 0 0 6px;\r\n  padding: 2px 6px;\r\n  border-radius: 999px;\r\n  background: var(--emerald-bg);\r\n  color: var(--text);\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  line-height: 1.4;\r\n  white-space: nowrap;\r\n  vertical-align: middle;\r\n}\r\n\r\n.farmaco-trovato svg {\r\n  display: block;\r\n  width: 12px;\r\n  height: 12px;\r\n  color: var(--teal);\r\n}\r\n\r\n/* \"non in anagrafica\" / \"senza documento\": ds-badge--warning canonico (ambra, mai rosso: non è\r\n   un allarme clinico ma un dato mancante su cui l'operatore può agire). */\r\n.ricerca-farmaco__icona {\r\n  flex: none;\r\n  display: grid;\r\n  place-items: center;\r\n  width: 24px;\r\n  height: 24px;\r\n  color: var(--text);\r\n}\r\n.ricerca-farmaco__icona svg {\r\n  width: 20px;\r\n  height: 20px;\r\n}\r\n.ricerca-farmaco__testo {\r\n  /* Base esplicita: su schermi stretti è il pulsante ad andare a capo, non le parole a spezzarsi. */\r\n  flex: 1 1 200px;\r\n  min-width: 0;\r\n  overflow-wrap: break-word;\r\n}\r\n@media (max-width: 600px) {\r\n  .ricerca-farmaco__riga {\r\n    flex-wrap: wrap;\r\n  }\r\n  .ricerca-farmaco__riga > :last-child {\r\n    margin-left: 36px;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Farmaci — HMI 1 (artifacts/hmi-parity/proto/farmaci.png). Solo la pagina: la modale della\r\n   terapia usa lo stesso corpo di ricerca con i suoi stili. */\r\n.page-anagrafica-farmaci {\r\n  max-width: none;\r\n}\r\n.page-anagrafica-farmaci__corpo {\r\n  border-radius: 16px;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco {\r\n  padding: 24px;\r\n  gap: 16px;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__campo {\r\n  height: 48px;\r\n  padding: 0 16px;\r\n  border: 2px solid var(--border);\r\n  border-radius: 12px;\r\n  background: #f5f7fb;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__campo input {\r\n  font-size: 16px;\r\n}\r\n\r\n.page-anagrafica-farmaci .ricerca-farmaco__nota {\r\n  font-size: 14px;\r\n  line-height: 20px;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__vuoto {\r\n  padding: 16px 0;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__esiti {\r\n  overflow: visible;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__lista {\r\n  gap: 0;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__riga {\r\n  gap: 16px;\r\n  padding: 12px 0;\r\n  border: 0;\r\n  border-bottom: 1px solid var(--border);\r\n  border-radius: 0;\r\n  background: transparent;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__nome {\r\n  font: 600 16px/24px var(--font-ui);\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__dettagli,\r\n.page-anagrafica-farmaci .ricerca-farmaco__pa {\r\n  font: 400 14px/20px var(--font-ui);\r\n}\r\n\r\n@media (max-width: 600px) {\r\n  .page-anagrafica-farmaci .ricerca-farmaco {\r\n    padding: 16px;\r\n  }\r\n  .page-anagrafica-farmaci .ricerca-farmaco__riga {\r\n    flex-wrap: wrap;\r\n  }\r\n  .page-anagrafica-farmaci .ricerca-farmaco__riga > :last-child {\r\n    margin-left: 40px;\r\n  }\r\n}\r\n"]],[[31,30]],["BODY",{},[[31,31]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},[[20,2]],["DIV",{"class":"main-area-clean"},[[19,31]],["MAIN",{"class":"page-content content-panel"},["DIV",{"class":"par-view"},["DIV",{"class":"par-grid"},[[17,6]],["SECTION",{"class":"par-form","aria-label":"Rilevazione di Sintetico QA, Caso"},[[19,67]],["FORM",{"class":"parameter-reading-form","aria-label":"Nuova rilevazione"},["DIV",{"class":"parameter-reading-form__layout"},["FIELDSET",{"class"