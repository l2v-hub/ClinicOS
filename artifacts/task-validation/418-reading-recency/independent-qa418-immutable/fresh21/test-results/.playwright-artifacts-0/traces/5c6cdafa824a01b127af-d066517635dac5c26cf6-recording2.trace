{"type":"frame-snapshot","snapshot":{"callId":"call@3094","snapshotName":"after@call@3094","pageId":"page@2ec5165cb08609dd9e148f60fe3684d1","frameId":"frame@15df736652bbc3a65eb1b0f089a8406f","frameUrl":"http://127.0.0.1:7483/#/parametri-multipaziente","doctype":"html","html":["HTML",{"lang":"it"},["HEAD",{},[[83,0]],[[83,1]],[[83,2]],[[83,3]],[[83,4]],[[83,5]],[[83,6]],[[83,7]],[[83,8]],[[83,9]],[[83,10]],[[83,11]],[[83,12]],[[83,13]],[[83,15]],[[83,16]],[[83,18]],[[83,20]],[[83,22]],[[83,24]],[[83,26]],[[83,28]],[[80,1]],[[80,3]],[[80,5]],[[80,7]],[[80,9]],[[80,11]],[[80,13]],[[80,15]],[[80,17]],[[80,19]],[[80,21]],[[80,23]],[[80,25]],[[80,27]],[[80,29]],[[79,1]],[[79,3]],[[79,5]],[[79,7]],[[79,9]],[[79,11]],[[79,13]],[[79,15]],[[79,17]],[[79,19]],[[79,21]],[[79,23]],[[79,25]],[[79,27]],[[78,1]],[[78,3]],[[78,5]],[[78,7]],[[78,9]],[[78,11]],[[71,1]],[[71,3]],[[71,5]],[[71,7]],[[71,9]],[[71,11]],[[71,13]],[[71,15]],[[71,17]],[[71,19]],[[71,21]],[[71,23]],[[52,1]],[[52,3]],[[35,1]],[[15,1]],["STYLE",{},".therapy-calendar-dialog--patient .therapy-calendar-dialog__head {\r\n  margin-bottom: 8px;\r\n}\r\n.therapy-calendar-dialog--patient .therapy-calendar-dialog__head > button:not(#ds) {\r\n  width: var(--ds-control-h);\r\n  height: var(--ds-control-h);\r\n  min-height: var(--ds-control-h);\r\n  padding: 0;\r\n  font-size: var(--ds-icon-size);\r\n}\r\n.therapy-calendar-dialog--patient .patient-therapy-slot-detail--embedded {\r\n  margin: 0;\r\n  padding: 0;\r\n  border: 0;\r\n  border-radius: 0;\r\n  background: transparent;\r\n}\r\n.patient-therapy-slot-detail--embedded .patient-therapy-slot-detail__sub {\r\n  margin: 0 0 6px;\r\n  color: var(--text-muted);\r\n  font-weight: 400;\r\n}\r\n.patient-therapy-slot-detail--embedded .giro-patients {\r\n  gap: 0;\r\n}\r\n.patient-therapy-slot-detail--embedded .giro-patient {\r\n  padding: 0;\r\n  border: 0;\r\n  border-radius: 0;\r\n  background: transparent;\r\n}\r\n.patient-therapy-slot-detail--embedded .giro-drugs {\r\n  padding: 0;\r\n}\r\n.patient-therapy-slot-detail--embedded .giro-drug {\r\n  gap: 8px 16px;\r\n  padding: 12px 0;\r\n  align-items: start;\r\n}\r\n.patient-therapy-slot-detail--embedded .giro-drug__name {\r\n  font-weight: 650;\r\n}\r\n.patient-therapy-slot-detail__prescription {\r\n  font-size: 12px;\r\n  line-height: 18px;\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n}\r\n.patient-therapy-slot-detail__note {\r\n  margin-top: 4px;\r\n  font-size: 13px;\r\n  line-height: 19px;\r\n  white-space: pre-wrap;\r\n  overflow-wrap: anywhere;\r\n}\r\n.patient-therapy-slot-detail--embedded .giro-row__act {\r\n  display: grid;\r\n  grid-template-columns: auto auto;\r\n  align-items: start;\r\n  gap: 6px;\r\n}\r\n.patient-therapy-slot-detail--embedded .giro-row__act > .giro-badge {\r\n  grid-column: 1 / -1;\r\n  justify-self: end;\r\n  margin: 0;\r\n  min-height: 24px;\r\n  padding: 2px 7px;\r\n  font-size: 12px;\r\n  line-height: 18px;\r\n  max-width: 250px;\r\n  overflow-wrap: anywhere;\r\n}\r\n.patient-therapy-slot-detail--embedded .ds-btn:not(#ds),\r\n.patient-therapy-slot-detail--embedded .ds-chip:not(#ds) {\r\n  min-height: var(--ds-control-h);\r\n  padding: 0 var(--ds-control-px);\r\n  font-size: var(--ds-control-font);\r\n  line-height: 20px;\r\n}\r\n.patient-therapy-slot-detail--embedded .ds-btn svg {\r\n  width: var(--ds-icon-size);\r\n  height: var(--ds-icon-size);\r\n}\r\n.patient-therapy-slot-detail--embedded .giro-row__act > .patient-therapy-slot-detail__retry {\r\n  grid-column: 1 / -1;\r\n}\r\n.patient-therapy-slot-detail__prescriptions {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n.patient-therapy-slot-detail__prescriptions > li {\r\n  padding: 12px 0;\r\n  border-top: 1px solid var(--border);\r\n}\r\n@media (max-width: 720px) {\r\n  .patient-therapy-slot-detail--embedded .giro-row__act {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n  .patient-therapy-slot-detail--embedded .giro-row__act > .giro-badge {\r\n    justify-self: start;\r\n    max-width: 100%;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Pannello in linea del farmaco (UX 2026-10-03): dosi del giorno e azioni dove si legge il farmaco. */\r\n.drug-dose-panel {\r\n  padding: 12px 16px 16px;\r\n  background: var(--surface-2, #f6f8fc);\r\n  border-top: 1px solid var(--border);\r\n  border-bottom: 1px solid var(--border);\r\n  white-space: normal;\r\n}\r\n.drug-dose-panel__title {\r\n  margin: 0 0 4px;\r\n  font: 600 13px/18px var(--font-ui);\r\n  color: var(--text);\r\n}\r\n.drug-dose-panel__ro,\r\n.drug-dose-panel__msg,\r\n.drug-dose-panel__hint {\r\n  margin: 4px 0;\r\n  font: 400 13px/18px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n.drug-dose-panel__msg.is-error {\r\n  color: var(--red);\r\n}\r\n.drug-dose-panel__time.is-focus {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 2px;\r\n  border-radius: 8px;\r\n}\r\n.drug-dose-panel__feedback {\r\n  margin: 8px 0 0;\r\n  font: 500 13px/18px var(--font-ui);\r\n}\r\n.drug-dose-panel__feedback.is-ok {\r\n  color: var(--green, #1f7a4d);\r\n}\r\n.drug-dose-panel__feedback.is-error {\r\n  color: var(--red);\r\n}\r\n.drug-dose-panel__prn-list {\r\n  list-style: none;\r\n  margin: 4px 0 8px;\r\n  padding: 0;\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n.drug-dose-panel__prn-list > li {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 4px 12px;\r\n  font: 400 13px/18px var(--font-ui);\r\n  overflow-wrap: anywhere;\r\n}\r\n.drug-dose-panel__indication {\r\n  color: var(--text-muted);\r\n}\r\n.drug-dose-panel__prn-form {\r\n  display: grid;\r\n  gap: 4px;\r\n  max-width: 560px;\r\n}\r\n.drug-dose-panel__prn-form > button {\r\n  justify-self: start;\r\n  margin-top: 4px;\r\n}\r\n/* Riga del farmaco espandibile nelle tabelle della terapia. */\r\n.therapy-row--open > td {\r\n  background: var(--blue-50, #eef3fd);\r\n}\r\n.therapy-expand-row > td {\r\n  padding: 0 !important;\r\n}\r\n.therapy-drug-toggle {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  min-height: 44px;\r\n  padding: 0;\r\n  border: 0;\r\n  background: none;\r\n  font: inherit;\r\n  color: inherit;\r\n  text-align: left;\r\n  cursor: pointer;\r\n}\r\n.therapy-drug-toggle__hint {\r\n  font: 500 12px/16px var(--font-ui);\r\n  color: var(--blue);\r\n}\r\n.therapy-drug-toggle:focus-visible {\r\n  outline: 3px solid #245bb5;\r\n  outline-offset: 2px;\r\n}\r\n"],["STYLE",{},".patient-therapy-calendar {\r\n  padding: 16px;\r\n  min-width: 0;\r\n}\r\n/* One vertical path through summary, details and hours. Horizontal week content remains\r\n   locally reachable on narrow screens, without adding a height-limited inner scroller. */\r\n.patient-therapy-calendar .therapy-calendar-grid {\r\n  max-height: none;\r\n  overflow-x: auto;\r\n  overflow-y: visible;\r\n}\r\n.patient-therapy-calendar__summary {\r\n  margin-bottom: 12px;\r\n}\r\n.patient-therapy-calendar__empty {\r\n  margin: 8px 0;\r\n  font-size: 14px;\r\n  line-height: 1.5;\r\n}\r\n.patient-therapy-calendar__programming {\r\n  padding: 12px 14px;\r\n  border: 1px solid var(--ds-border, #e1e7f0);\r\n  border-left: 4px solid var(--ds-blue, #2f6bed);\r\n  border-radius: var(--ds-radius, 12px);\r\n  background: var(--ds-blue-tint, #eaf1fe);\r\n  color: var(--ds-text, #16202e);\r\n  font-size: 14px;\r\n  line-height: 1.5;\r\n  overflow-wrap: anywhere;\r\n}\r\n.patient-therapy-calendar__programming p {\r\n  margin: 0 0 6px;\r\n}\r\n.patient-therapy-calendar__programming summary {\r\n  min-height: 44px;\r\n  padding: 10px 0;\r\n  cursor: pointer;\r\n  font-weight: 650;\r\n}\r\n.patient-therapy-calendar__programming summary:focus-visible {\r\n  outline: var(--ds-focus, 3px solid #245bb5);\r\n  outline-offset: 2px;\r\n}\r\n.patient-therapy-calendar__programming ul {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 0;\r\n}\r\n.patient-therapy-calendar__programming li {\r\n  padding: 12px 0;\r\n  border-top: 1px solid var(--ds-border, #e1e7f0);\r\n}\r\n.patient-therapy-calendar__programming li > strong,\r\n.patient-therapy-calendar__programming li > span {\r\n  display: block;\r\n}\r\n.patient-therapy-calendar__programming li > p {\r\n  margin-top: 4px;\r\n}\r\n.patient-therapy-calendar__programming button {\r\n  min-height: 44px;\r\n  max-width: 100%;\r\n  white-space: normal;\r\n}\r\n.patient-therapy-calendar__toolbar {\r\n  display: flex;\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n  gap: 12px;\r\n}\r\n.patient-therapy-calendar__toolbar .agt-today-btn {\r\n  min-height: 44px;\r\n}\r\n.patient-therapy-calendar__toolbar .agt-nav-btn {\r\n  font-size: 26px;\r\n}\r\n.patient-therapy-calendar__date {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  font-size: 13px;\r\n}\r\n.patient-therapy-calendar__date .form-input {\r\n  width: 160px;\r\n  min-height: 44px;\r\n}\r\n.patient-therapy-calendar__heading {\r\n  margin: 18px 0 10px;\r\n}\r\n.patient-therapy-calendar__heading h3 {\r\n  margin: 0 0 6px;\r\n  font-size: 16px;\r\n  font-weight: 650;\r\n  text-transform: capitalize;\r\n}\r\n.patient-therapy-calendar__heading p {\r\n  margin: 4px 0;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n}\r\n.patient-therapy-calendar__message,\r\n.patient-therapy-calendar__count {\r\n  margin: 14px 0;\r\n  font-size: 13px;\r\n}\r\n.patient-therapy-calendar__timeline {\r\n  position: relative;\r\n  max-height: 560px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  overscroll-behavior-y: contain;\r\n}\r\n.patient-therapy-calendar__timeline:focus-visible {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 2px;\r\n}\r\n.patient-therapy-calendar__timeline .agt-slot {\r\n  min-height: 48px;\r\n}\r\n.patient-therapy-calendar__timeline .agt-slot__time {\r\n  width: 60px;\r\n  padding: 14px 8px;\r\n}\r\n.patient-therapy-calendar__events {\r\n  flex: 1;\r\n  min-width: 0;\r\n  margin: 0;\r\n  padding: 4px 8px 4px 0;\r\n  list-style: none;\r\n}\r\n.patient-therapy-calendar .agt-slot--hour {\r\n  flex-wrap: wrap;\r\n}\r\n/* Ogni dose è un'azione: apre il dettaglio dell'orario (terapie + somministrazione). */\r\n.patient-therapy-calendar .patient-therapy-calendar__event {\r\n  grid-template-columns: 32px minmax(0, 1fr);\r\n  min-height: 44px;\r\n  cursor: pointer;\r\n}\r\n.patient-therapy-calendar .patient-therapy-calendar__event:hover,\r\n.patient-therapy-calendar .patient-therapy-calendar__event[aria-expanded='true'] {\r\n  background: #e4dbff;\r\n  border-color: #b3a0ef;\r\n  border-left-color: var(--purple);\r\n}\r\n.patient-therapy-calendar .patient-therapy-calendar__event:focus-visible {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 2px;\r\n}\r\n.patient-therapy-calendar__event-dose {\r\n  display: block;\r\n  margin-top: 4px;\r\n  font-size: 12px;\r\n  line-height: 1.45;\r\n}\r\n.patient-therapy-slot-detail {\r\n  flex-basis: 100%;\r\n  margin: 0 8px 10px 60px;\r\n  padding: 12px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: var(--surface, #fff);\r\n  min-width: 0;\r\n}\r\n.patient-therapy-slot-detail__head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n}\r\n.patient-therapy-slot-detail__head h4,\r\n.patient-therapy-slot-detail__sub {\r\n  margin: 0;\r\n  font-size: 13px;\r\n  font-weight: 650;\r\n}\r\n.patient-therapy-slot-detail__head .btn-sm {\r\n  min-height: 44px;\r\n}\r\n.patient-therapy-slot-detail__sub {\r\n  margin-top: 12px;\r\n  text-transform: none;\r\n}\r\n.patient-therapy-slot-detail__list {\r\n  list-style: none;\r\n  margin: 8px 0 0;\r\n  padding: 0;\r\n}\r\n.patient-therapy-slot-detail__list li {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 4px 10px;\r\n  padding: 6px 0;\r\n  font-size: 12px;\r\n  overflow-wrap: anywhere;\r\n}\r\n.patient-therapy-slot-detail__msg,\r\n.patient-therapy-slot-detail__feedback {\r\n  margin: 8px 0 0;\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n}\r\n.patient-therapy-slot-detail__feedback.is-ok {\r\n  color: var(--green, #1f7a4d);\r\n}\r\n.patient-therapy-slot-detail__feedback.is-error {\r\n  color: var(--red);\r\n}\r\n.patient-therapy-calendar__medication {\r\n  min-width: 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n.patient-therapy-calendar__event-title {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: baseline;\r\n  gap: 4px 10px;\r\n}\r\n.patient-therapy-calendar__event-title time {\r\n  font-size: 13px;\r\n  font-weight: 650;\r\n  font-variant-numeric: tabular-nums;\r\n  color: #4e2ba7;\r\n}\r\n.patient-therapy-calendar__unscheduled {\r\n  margin-top: 16px;\r\n  padding: 12px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n}\r\n.patient-therapy-calendar__unscheduled h4 {\r\n  font-size: 13px;\r\n  margin: 0 0 10px;\r\n}\r\n.patient-therapy-calendar__unscheduled h4 span {\r\n  font-weight: 400;\r\n}\r\n.patient-therapy-calendar__unscheduled ul {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 0;\r\n}\r\n.patient-therapy-calendar__unscheduled li {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 4px 10px;\r\n  padding: 8px 0;\r\n  font-size: 12px;\r\n  overflow-wrap: anywhere;\r\n}\r\n.patient-therapy-calendar__unscheduled li + li {\r\n  border-top: 1px solid var(--border);\r\n}\r\n.patient-therapy-calendar__unscheduled p {\r\n  flex-basis: 100%;\r\n  margin: 0;\r\n  color: var(--text-muted);\r\n}\r\n@media (max-width: 600px) {\r\n  .patient-therapy-calendar {\r\n    padding: 12px 8px;\r\n  }\r\n  .patient-therapy-calendar__toolbar {\r\n    gap: 8px;\r\n  }\r\n  .patient-therapy-calendar__timeline {\r\n    max-height: 480px;\r\n  }\r\n  .patient-therapy-calendar__timeline .agt-slot__time {\r\n    width: 48px;\r\n    padding-inline: 6px;\r\n  }\r\n  .patient-therapy-calendar .patient-therapy-calendar__event {\r\n    grid-template-columns: 24px minmax(0, 1fr);\r\n    gap: 7px;\r\n    padding: 8px;\r\n    border-left-width: 4px;\r\n  }\r\n  .patient-therapy-slot-detail {\r\n    margin-left: 8px;\r\n  }\r\n  .patient-therapy-calendar__event .agt-therapy-slot__icon {\r\n    width: 24px;\r\n    height: 28px;\r\n  }\r\n}\r\n\r\n/* ── UX 2026-10-03: informazione senza clic (stato, dose, prescrittore, nota sull'evento) ── */\r\n.ptc-views {\r\n  display: flex;\r\n  gap: 6px;\r\n}\r\n.patient-therapy-calendar__event-dose {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 4px 10px;\r\n}\r\n.ptc-dose {\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  color: var(--text);\r\n  overflow-wrap: anywhere;\r\n}\r\n.ptc-meta {\r\n  display: block;\r\n  margin-top: 4px;\r\n  font-size: 12px;\r\n  line-height: 1.45;\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n}\r\n.ptc-hour-summary {\r\n  flex-basis: 100%;\r\n  order: -1;\r\n  margin: 6px 8px 0 60px;\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  color: var(--text-muted);\r\n}\r\n.ptc-status {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  min-height: 24px;\r\n  padding: 2px 8px;\r\n  border-radius: 999px;\r\n  font-size: 12px;\r\n  font-weight: 650;\r\n  line-height: 1.25;\r\n  overflow-wrap: anywhere;\r\n}\r\n.ptc-status--due,\r\n.ptc-status--future {\r\n  background: #eaf1fe;\r\n  color: #1d4fc4;\r\n}\r\n.ptc-status--late {\r\n  background: #fdecee;\r\n  color: #a5202f;\r\n}\r\n.ptc-status--done {\r\n  background: #e6f6ef;\r\n  color: #0e7a55;\r\n}\r\n.ptc-status--missed {\r\n  background: #fdecee;\r\n  color: #a5202f;\r\n}\r\n.ptc-status--unknown {\r\n  background: var(--surface-2, #f1f4f9);\r\n  color: var(--text-muted);\r\n}\r\n.patient-therapy-calendar .patient-therapy-calendar__event.is-late {\r\n  border-left-color: var(--red);\r\n}\r\n.patient-therapy-calendar .patient-therapy-calendar__event.is-done {\r\n  background: #eef8f2;\r\n  border-color: #c6e6d4;\r\n  border-left-color: #16a37b;\r\n}\r\n.patient-therapy-calendar .patient-therapy-calendar__event.is-missed {\r\n  border-left-color: var(--red);\r\n}\r\n.ptc-prn-panel {\r\n  flex-basis: 100%;\r\n}\r\n/* Settimana: 7 colonne quando c'è spazio, un blocco per giorno su tablet verticale. */\r\n.ptc-week {\r\n  list-style: none;\r\n  margin: 12px 0 0;\r\n  padding: 0;\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr);\r\n  gap: 10px;\r\n}\r\n@media (min-width: 1100px) {\r\n  .ptc-week {\r\n    grid-template-columns: repeat(7, minmax(0, 1fr));\r\n    gap: 6px;\r\n  }\r\n}\r\n.ptc-week__day {\r\n  min-width: 0;\r\n  padding: 8px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: var(--surface, #fff);\r\n}\r\n.ptc-week__day.is-today {\r\n  border-color: var(--blue);\r\n  box-shadow: inset 0 3px 0 var(--blue);\r\n}\r\n.ptc-week__head {\r\n  margin: 0 0 6px;\r\n  font-size: 13px;\r\n  font-weight: 650;\r\n  text-transform: capitalize;\r\n}\r\n.ptc-week__none {\r\n  margin: 4px 0;\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n}\r\n.ptc-week__doses {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n.ptc-week__dose {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-start;\r\n  gap: 2px;\r\n  width: 100%;\r\n  min-height: 44px;\r\n  padding: 6px 8px;\r\n  border: 1px solid #c9baf2;\r\n  border-left: 4px solid var(--purple);\r\n  border-radius: 8px;\r\n  background: #f6f2ff;\r\n  color: var(--text);\r\n  font: inherit;\r\n  font-size: 12px;\r\n  text-align: left;\r\n  cursor: pointer;\r\n}\r\n.ptc-week__dose.is-late,\r\n.ptc-week__dose.is-missed {\r\n  border-left-color: var(--red);\r\n}\r\n.ptc-week__dose.is-done {\r\n  border-left-color: #16a37b;\r\n  background: #eef8f2;\r\n}\r\n.ptc-week__dose:focus-visible {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 2px;\r\n}\r\n.ptc-week__line {\r\n  overflow-wrap: anywhere;\r\n}\r\n.ptc-week__line time {\r\n  font-weight: 650;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.patient-therapy-calendar__heading h3.is-week {\r\n  text-transform: none;\r\n}\r\n\r\n/* UX ciclo 2 — W5: dose del farmaco richiesto da un collegamento diretto. */\r\n.patient-therapy-calendar__event.is-focus {\r\n  outline: 3px solid var(--ds-blue, #2f6bed);\r\n  outline-offset: 1px;\r\n}\r\n/* «Somministra ora» di una dose di oggi segnata come non somministrata. */\r\n.patient-therapy-slot-detail__again {\r\n  list-style: none;\r\n  margin: 10px 0 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n.patient-therapy-slot-detail__again li {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  font-size: 14px;\r\n}\r\n"],["STYLE",{},"/* Campo farmaco con ricerca in anagrafica. Token del design system. */\r\n\r\n.campo-farmaco__criterio {\r\n  display: flex;\r\n  gap: 6px;\r\n  margin-bottom: 6px;\r\n}\r\n\r\n.campo-farmaco__criterio button {\r\n  padding: 4px 11px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 999px;\r\n  background: #fff;\r\n  font-size: 11px;\r\n  color: var(--text-muted);\r\n  cursor: pointer;\r\n}\r\n\r\n.campo-farmaco__criterio button.is-attivo {\r\n  border-color: var(--blue);\r\n  background: var(--blue);\r\n  color: #fff;\r\n}\r\n\r\n.campo-farmaco__campo {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding: 7px 11px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: #fff;\r\n}\r\n\r\n/* Senza vincolo l'SVG dell'icona viene stirato dal flex e riempie il campo. */\r\n.campo-farmaco__campo > svg {\r\n  flex: none;\r\n  width: 16px;\r\n  height: 16px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.campo-farmaco__campo:focus-within {\r\n  border-color: var(--blue);\r\n  box-shadow: 0 0 0 3px rgb(47 107 237 / 12%);\r\n}\r\n\r\n.campo-farmaco__input {\r\n  flex: 1;\r\n  min-width: 0;\r\n  border: 0;\r\n  outline: none;\r\n  font-size: 14px;\r\n  color: var(--text);\r\n  background: transparent;\r\n}\r\n\r\n.campo-farmaco__esiti {\r\n  margin-top: 6px;\r\n  max-height: 260px;\r\n  overflow: auto;\r\n}\r\n\r\n.campo-farmaco__nota {\r\n  margin: 4px 0 0;\r\n  font-size: 11px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.campo-farmaco__nota--errore {\r\n  color: var(--red);\r\n}\r\n\r\n.campo-farmaco__lista {\r\n  margin: 0;\r\n  padding: 0;\r\n  list-style: none;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n}\r\n\r\n.campo-farmaco__lista button {\r\n  display: block;\r\n  width: 100%;\r\n  padding: 7px 10px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  background: #fff;\r\n  text-align: left;\r\n  cursor: pointer;\r\n}\r\n\r\n.campo-farmaco__lista button:hover {\r\n  border-color: var(--blue);\r\n  background: rgb(47 107 237 / 5%);\r\n}\r\n\r\n.campo-farmaco__nome {\r\n  display: block;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  color: var(--text);\r\n}\r\n\r\n.campo-farmaco__dettagli,\r\n.campo-farmaco__pa {\r\n  display: block;\r\n  margin-top: 1px;\r\n  font-size: 11px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n/* Ripiego per galenici ed esteri: deve essere raggiungibile ma non invitante. */\r\n.campo-farmaco__ripiego {\r\n  margin-top: 8px;\r\n  padding: 9px 11px;\r\n  border: 1px dashed rgb(180 120 0 / 45%);\r\n  border-radius: 8px;\r\n  background: rgb(255 196 0 / 8%);\r\n}\r\n\r\n.campo-farmaco__usa-comunque {\r\n  margin-top: 6px;\r\n  padding: 5px 11px;\r\n  border: 1px solid #c98a00;\r\n  border-radius: 8px;\r\n  background: #fff;\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  color: #7a5300;\r\n  cursor: pointer;\r\n}\r\n\r\n.campo-farmaco__usa-comunque:hover {\r\n  background: #c98a00;\r\n  color: #fff;\r\n}\r\n\r\n/* Farmaco già scelto */\r\n.campo-farmaco__scelto {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  padding: 9px 12px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: #fff;\r\n}\r\n\r\n.campo-farmaco__scelto.is-fuori-anagrafica {\r\n  border-color: rgb(180 120 0 / 45%);\r\n  background: rgb(255 196 0 / 8%);\r\n}\r\n\r\n.campo-farmaco__stato {\r\n  margin: 2px 0 0;\r\n  font-size: 11px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.campo-farmaco__scelto.is-fuori-anagrafica .campo-farmaco__stato {\r\n  color: #8a5a00;\r\n}\r\n"],["STYLE",{},".therapy-form {\r\n  container: therapy-form / inline-size;\r\n  grid-column: 1 / -1;\r\n  width: 100%;\r\n  min-width: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  color: var(--text-primary, #1e293b);\r\n}\r\n\r\n.terapia-sched-form.therapy-form-shell {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  padding: 0;\r\n  margin: 0;\r\n  background: transparent;\r\n}\r\n\r\n.therapy-form-shell__heading h2 {\r\n  margin: 0 0 4px;\r\n  font-size: 19px;\r\n}\r\n\r\n.therapy-form-shell__heading p {\r\n  margin: 0;\r\n  color: var(--text-muted, #64748b);\r\n  font-size: 12px;\r\n}\r\n\r\n.therapy-form__section {\r\n  padding: 16px;\r\n  border: 1px solid var(--border, #dce3ec);\r\n  border-radius: 12px;\r\n  background: var(--surface, #fff);\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 14px;\r\n  min-width: 0;\r\n}\r\n\r\n.therapy-form__section h3 {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  margin: 0;\r\n  font-size: 15px;\r\n  font-weight: 650;\r\n}\r\n\r\n.therapy-form__section h3 > span {\r\n  display: grid;\r\n  place-items: center;\r\n  width: 24px;\r\n  height: 24px;\r\n  border-radius: 50%;\r\n  background: #eef4ff;\r\n  color: #2458a8;\r\n  font-size: 12px;\r\n}\r\n\r\n.therapy-form .form-group {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  min-width: 0;\r\n  margin: 0;\r\n}\r\n\r\n.therapy-form label,\r\n.therapy-form__field-label {\r\n  color: var(--text-primary, #344054);\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  letter-spacing: 0;\r\n  text-transform: none;\r\n}\r\n\r\n.therapy-form .form-input,\r\n.therapy-form .form-select,\r\n.therapy-form .campo-farmaco__input {\r\n  width: 100%;\r\n  min-width: 0;\r\n  min-height: 44px;\r\n  box-sizing: border-box;\r\n}\r\n\r\n.therapy-form textarea {\r\n  resize: vertical;\r\n}\r\n.therapy-form__error {\r\n  color: var(--red);\r\n  font-size: 13px;\r\n  margin: 5px 0 0;\r\n}\r\n\r\n.therapy-correction-link {\r\n  background: none;\r\n  border: 0;\r\n  color: var(--blue);\r\n  cursor: pointer;\r\n  font: inherit;\r\n  padding: 4px 0;\r\n  text-align: left;\r\n  text-decoration: underline;\r\n  text-underline-offset: 3px;\r\n}\r\n\r\n.therapy-correction-link:focus-visible {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 3px;\r\n}\r\n\r\n.therapy-form [aria-invalid='true'] {\r\n  border-color: var(--red);\r\n}\r\n\r\n.therapy-form__optional {\r\n  font-weight: 400;\r\n  color: var(--text-muted, #64748b);\r\n}\r\n.therapy-form__grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  gap: 12px;\r\n}\r\n.therapy-form__strength {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) 88px;\r\n  gap: 6px;\r\n}\r\n.therapy-form__types {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  gap: 8px;\r\n}\r\n\r\n.therapy-form label.therapy-form__type {\r\n  display: flex;\r\n  gap: 9px;\r\n  align-items: center;\r\n  padding: 10px;\r\n  min-height: 58px;\r\n  border: 1px solid var(--border, #dce3ec);\r\n  border-radius: 8px;\r\n  cursor: pointer;\r\n  background: #fff;\r\n}\r\n\r\n.therapy-form__type input {\r\n  accent-color: #2563b8;\r\n  margin: 0;\r\n  flex: 0 0 auto;\r\n}\r\n.therapy-form__type strong {\r\n  display: block;\r\n  font-size: 13px;\r\n  font-weight: 650;\r\n}\r\n.therapy-form__type small {\r\n  display: block;\r\n  margin-top: 3px;\r\n  font-size: 11px;\r\n  font-weight: 400;\r\n  color: #526278;\r\n}\r\n.therapy-form label.therapy-form__type.is-selected {\r\n  background: #eff6ff;\r\n  border-color: #6095d9;\r\n}\r\n.therapy-form__type:focus-within {\r\n  outline: 2px solid #2563b8;\r\n  outline-offset: 2px;\r\n}\r\n.therapy-form__weekdays {\r\n  display: flex;\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n  gap: 10px;\r\n}\r\n.therapy-form .weekday-toggle {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px;\r\n}\r\n.therapy-form .weekday-toggle button {\r\n  min-width: 44px;\r\n  min-height: 44px;\r\n}\r\n\r\n.therapy-form__disclosure {\r\n  border: 1px solid var(--border, #dce3ec);\r\n  border-radius: 8px;\r\n  background: #fafbfd;\r\n  min-width: 0;\r\n}\r\n\r\n.therapy-form__disclosure summary {\r\n  cursor: pointer;\r\n  padding: 12px;\r\n  min-height: 44px;\r\n  box-sizing: border-box;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n}\r\n\r\n.therapy-form__disclosure summary > span {\r\n  margin-left: 8px;\r\n  color: #64748b;\r\n  font-size: 12px;\r\n  font-weight: 400;\r\n}\r\n.therapy-form__disclosure-body {\r\n  padding: 0 12px 12px;\r\n}\r\n.therapy-form__disclosure-body .form-hint {\r\n  margin: 0 0 10px;\r\n}\r\n.therapy-form__note-grid {\r\n  display: grid;\r\n  grid-template-columns: minmax(140px, 1fr) minmax(0, 2fr);\r\n  gap: 12px;\r\n}\r\n\r\n.therapy-form .therapy-schedules__row {\r\n  display: grid;\r\n  grid-template-columns: 112px minmax(140px, 1fr) 140px 44px;\r\n  grid-template-areas: 'time quantity unit remove' 'resolved resolved resolved resolved';\r\n  align-items: start;\r\n  gap: 8px 12px;\r\n  padding: 12px;\r\n}\r\n\r\n.therapy-schedules__time {\r\n  grid-area: time;\r\n}\r\n.therapy-schedules__quantity {\r\n  grid-area: quantity;\r\n}\r\n.therapy-schedules__unit {\r\n  grid-area: unit;\r\n}\r\n.therapy-form .therapy-schedules__remove {\r\n  grid-area: remove;\r\n  margin-top: 22px;\r\n  width: 44px;\r\n  height: 44px;\r\n  padding: 0;\r\n  display: grid;\r\n  place-items: center;\r\n}\r\n.therapy-form .sched-row__resolved {\r\n  grid-area: resolved;\r\n  margin: 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n.therapy-form .sched-row__qty {\r\n  gap: 6px;\r\n}\r\n.therapy-form .qty-chip__other {\r\n  flex: 1 1 115px;\r\n  width: 115px;\r\n}\r\n.therapy-form .therapy-schedules__add {\r\n  align-self: flex-start;\r\n  min-height: 44px;\r\n}\r\n\r\n.therapy-form__preview {\r\n  padding: 14px 16px;\r\n  background: #f0f6fd;\r\n  border: 1px solid #d7e5f6;\r\n  border-radius: 10px;\r\n  font-size: 13px;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.therapy-form__preview h3 {\r\n  font-size: 12px;\r\n  color: #47658a;\r\n  margin: 0 0 8px;\r\n  font-weight: 600;\r\n}\r\n.therapy-form__preview-heading {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: baseline;\r\n  gap: 6px 14px;\r\n}\r\n.therapy-form__preview-heading > strong {\r\n  font-size: 15px;\r\n}\r\n.therapy-form__preview-heading > span {\r\n  color: #526278;\r\n  font-size: 12px;\r\n}\r\n.therapy-form__preview p {\r\n  margin: 6px 0 0;\r\n}\r\n.therapy-form__preview ul {\r\n  display: flex;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n  margin: 10px 0 0;\r\n  padding: 0;\r\n  list-style: none;\r\n}\r\n.therapy-form__preview li {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n  background: #fff;\r\n  border: 1px solid #d7e5f6;\r\n  border-radius: 6px;\r\n  padding: 6px 10px;\r\n}\r\n\r\n.therapy-form-shell .form-actions.therapy-form-shell__actions {\r\n  position: sticky;\r\n  bottom: 0;\r\n  z-index: 2;\r\n  margin: 0;\r\n  padding: 12px 0;\r\n  border-top: 1px solid var(--border, #dce3ec);\r\n  background: var(--surface, #fff);\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n/* Let the patient panel own scrolling so the form actions stay within reach. */\r\n.cts:has(.therapy-form-shell),\r\n.cts__body:has(.therapy-form-shell),\r\n.cr-tab-content:has(.therapy-form-shell) {\r\n  overflow: clip;\r\n}\r\n\r\n.therapy-form-shell__actions button {\r\n  min-height: 44px;\r\n}\r\n.therapy-form__sr {\r\n  position: absolute;\r\n  width: 1px;\r\n  height: 1px;\r\n  padding: 0;\r\n  margin: -1px;\r\n  overflow: hidden;\r\n  clip: rect(0, 0, 0, 0);\r\n  white-space: nowrap;\r\n  border: 0;\r\n}\r\n\r\n@container therapy-form (max-width: 650px) {\r\n  .therapy-form__grid {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n  .therapy-form__types {\r\n    grid-template-columns: 1fr;\r\n  }\r\n  .therapy-form__type small {\r\n    display: inline;\r\n    margin-left: 8px;\r\n  }\r\n  .therapy-form label.therapy-form__type {\r\n    min-height: 48px;\r\n  }\r\n  .therapy-form .therapy-schedules__row {\r\n    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 44px;\r\n    grid-template-areas: 'time unit remove' 'quantity quantity quantity' 'resolved resolved resolved';\r\n  }\r\n  .therapy-form__note-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n\r\n@container therapy-form (max-width: 420px) {\r\n  .therapy-form .therapy-schedules__row {\r\n    grid-template-columns: minmax(0, 1fr) 44px;\r\n    grid-template-areas: 'time remove' 'quantity quantity' 'unit unit' 'resolved resolved';\r\n  }\r\n  .therapy-form__section {\r\n    padding: 12px;\r\n  }\r\n  .therapy-form__grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n  .therapy-form__disclosure summary > span {\r\n    display: block;\r\n    margin: 4px 0 0 16px;\r\n  }\r\n  .therapy-form .campo-farmaco__scelto {\r\n    flex-wrap: wrap;\r\n  }\r\n  .therapy-form .form-input,\r\n  .therapy-form .form-select,\r\n  .therapy-form .campo-farmaco__input {\r\n    font-size: 16px;\r\n  }\r\n}\r\n\r\n@media (max-width: 600px) {\r\n  .therapy-form-shell .form-actions .form-hint {\r\n    flex-basis: 100%;\r\n  }\r\n}\r\n\r\n/* Prescrittori proposti: un tocco compila il campo (ingresso). */\r\n.therapy-form__chips {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n  margin-top: 8px;\r\n}\r\n"],["STYLE",{},"/* Diario terapia: riga della terapia aperta da \"apri\" nella voce del diario, evidenziata per\r\n   qualche secondo. Solo lo sfondo della riga: nessun controllo cambia aspetto. */\r\n.clinicos-table tr.therapy-list-row--focus > td,\r\ntr.therapy-list-row--focus > td {\r\n  background: var(--ds-blue-tint, #eaf1fe);\r\n  box-shadow:\r\n    inset 0 2px 0 var(--blue, #2f6bed),\r\n    inset 0 -2px 0 var(--blue, #2f6bed);\r\n  transition: background-color 0.3s;\r\n}\r\n@media (prefers-reduced-motion: reduce) {\r\n  tr.therapy-list-row--focus > td {\r\n    transition: none;\r\n  }\r\n}\r\n"],["STYLE",{},"/* UX ciclo 2 — W5: viste della Terapia del paziente (Calendario con elenco compatto dei farmaci,\r\n   Storico, Nuova terapia). Solo token del design system; pulsanti e chip sono ds-btn / ds-chip. */\r\n\r\n.tf-error {\r\n  margin: 12px 16px 0;\r\n}\r\n.tf-calendar-view {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  min-width: 0;\r\n}\r\n.tf-calendar-view > .patient-therapy-calendar {\r\n  padding: 0;\r\n}\r\n.tf-programming-toggle {\r\n  display: flex;\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n  width: 100%;\r\n  min-height: 48px;\r\n  padding: 10px 12px;\r\n  border: 1px solid var(--ds-border, #e1e7f0);\r\n  border-radius: var(--ds-radius, 12px);\r\n  background: var(--ds-surface, #fff);\r\n  color: var(--ds-text, #16202e);\r\n  font: inherit;\r\n  text-align: left;\r\n  cursor: pointer;\r\n}\r\n.tf-programming-toggle:focus-visible {\r\n  outline: var(--ds-focus, 3px solid #245bb5);\r\n  outline-offset: 2px;\r\n}\r\n.tf-programming-toggle > span:last-child {\r\n  color: var(--ds-text-muted, #5a6b80);\r\n  font-size: 13px;\r\n}\r\n#therapy-programming-panel:not([hidden]) { margin-top: 8px; }\r\n.tf-pager__error {\r\n  flex-basis: 100%;\r\n  margin: 0;\r\n  color: var(--ds-danger, #b42335);\r\n}\r\n\r\n/* ── Farmaci attivi: una riga per farmaco ─────────────────────────────────── */\r\n.tf-active__title {\r\n  margin: 4px 0 8px;\r\n  font-size: 16px;\r\n  font-weight: 650;\r\n}\r\n.tf-active__title span {\r\n  color: var(--ds-text-muted, #5a6b80);\r\n  font-weight: 500;\r\n}\r\n.tf-drugs {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  border: var(--ds-border-w, 2px) solid var(--ds-border, #e1e7f0);\r\n  border-radius: var(--ds-radius, 12px);\r\n  overflow: hidden;\r\n}\r\n.tf-drugs__item + .tf-drugs__item {\r\n  border-top: 1px solid var(--ds-border, #e1e7f0);\r\n}\r\n.tf-drugs__item.is-open,\r\n.tf-drugs__item.is-focus {\r\n  background: var(--ds-blue-tint, #eaf1fe);\r\n}\r\n.tf-drugs__item.is-focus {\r\n  box-shadow: inset 4px 0 0 var(--ds-blue, #2f6bed);\r\n}\r\n.tf-drugs__line {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 4px 10px;\r\n  width: 100%;\r\n  min-height: 56px;\r\n  padding: 8px 14px;\r\n  border: 0;\r\n  background: transparent;\r\n  color: var(--ds-text, #16202e);\r\n  font: inherit;\r\n  text-align: left;\r\n  cursor: pointer;\r\n}\r\n.tf-drugs__line:focus-visible {\r\n  outline: var(--ds-focus, 3px solid #245bb5);\r\n  outline-offset: -3px;\r\n}\r\n.tf-drugs__name {\r\n  font-size: 15px;\r\n  font-weight: 650;\r\n}\r\n.tf-drugs__meta {\r\n  flex: 1 1 260px;\r\n  min-width: 0;\r\n  color: var(--ds-text-muted, #5a6b80);\r\n  font-size: 13px;\r\n  overflow-wrap: anywhere;\r\n}\r\n.tf-drugs__empty {\r\n  margin: 4px 0;\r\n  color: var(--ds-text-muted, #5a6b80);\r\n  font-size: 14px;\r\n}\r\n\r\n/* ── Prescrizione (dettaglio del farmaco) ─────────────────────────────────── */\r\n.tf-detail {\r\n  padding: 4px 14px 14px;\r\n}\r\n.tf-detail__grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));\r\n  gap: 8px 16px;\r\n  margin: 0;\r\n}\r\n.tf-detail__row {\r\n  min-width: 0;\r\n}\r\n.tf-detail__row dt {\r\n  color: var(--ds-text-muted, #5a6b80);\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n}\r\n.tf-detail__row dd {\r\n  margin: 2px 0 0;\r\n  font-size: 14px;\r\n  overflow-wrap: anywhere;\r\n}\r\n.tf-detail__schedule {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n.tf-detail__actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n  margin-top: 12px;\r\n}\r\n.tf-farmaco {\r\n  display: inline-flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 6px;\r\n}\r\n.tf-pager {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 8px;\r\n  margin-top: 10px;\r\n  color: var(--ds-text-muted, #5a6b80);\r\n  font-size: 13px;\r\n}\r\n\r\n/* ── Storico ──────────────────────────────────────────────────────────────── */\r\n.tf-history {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  min-width: 0;\r\n}\r\n.tf-history__filters {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: flex-end;\r\n  gap: 12px 20px;\r\n}\r\n.tf-history__filter {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  min-width: 0;\r\n}\r\n.tf-chips {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n.tf-history__drug .form-input {\r\n  min-width: 220px;\r\n  min-height: 48px;\r\n}\r\n.tf-history__note,\r\n.tf-history__count,\r\n.tf-history__more {\r\n  margin: 0;\r\n  color: var(--ds-text-muted, #5a6b80);\r\n  font-size: 13px;\r\n}\r\n.tf-history__more {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n.tf-history__days {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 14px;\r\n}\r\n.tf-history__day h4 {\r\n  margin: 0 0 6px;\r\n  font-size: 14px;\r\n  font-weight: 650;\r\n  text-transform: capitalize;\r\n}\r\n.tf-history__day ul {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  border: var(--ds-border-w, 2px) solid var(--ds-border, #e1e7f0);\r\n  border-radius: var(--ds-radius, 12px);\r\n  overflow: hidden;\r\n}\r\n.tf-history__row {\r\n  display: grid;\r\n  grid-template-columns: 56px minmax(0, 1fr) minmax(0, 1.2fr);\r\n  gap: 4px 12px;\r\n  align-items: start;\r\n  padding: 10px 14px;\r\n  font-size: 14px;\r\n}\r\n.tf-history__row + .tf-history__row {\r\n  border-top: 1px solid var(--ds-border, #e1e7f0);\r\n}\r\n.tf-history__time {\r\n  font-weight: 650;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.tf-history__drug-cell,\r\n.tf-history__outcome {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n  min-width: 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n.tf-history__drug-cell span,\r\n.tf-history__detail {\r\n  color: var(--ds-text-muted, #5a6b80);\r\n  font-size: 13px;\r\n}\r\n@media (max-width: 900px) {\r\n  .tf-history__row {\r\n    grid-template-columns: 56px minmax(0, 1fr);\r\n  }\r\n  .tf-history__outcome {\r\n    grid-column: 2;\r\n  }\r\n}\r\n.tf-active__verify {\r\n  color: var(--ds-text-muted, #5a6b80);\r\n  font-size: 13px;\r\n  font-weight: 500;\r\n}\r\n"]],[[83,30]],["BODY",{},[[83,31]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},[[72,2]],["DIV",{"class":"main-area-clean"},[[15,6]],["MAIN",{"class":"page-content content-panel"},["DIV",{"class":"par-view"},["DIV",{"class":"par-grid"},[[16,7]],["SECTION",{"class":"par-form","aria-label":"Rilevazione di Sintetico QA, Caso"},[[71,67]],["FORM",{"class":"parameter-reading-form","aria-label":"Nuova rilevazione"},["DIV",{"class":"parameter-reading-form__layout"},["FIELDSET",{"class":"parameter-reading-form__fields"},[[71,69]],[[5,1]],[[1,1]],["LABEL",{"for":"_r_8_-o2","class":"parameter-reading-form__field"},[[71,90]],["SELECT",{"__playwright_target__":"","id":"_r_8_-o2","class":"form-input","aria-label":"Nuova rilevazione O₂","aria-describedby":"_r_8_-o2-previous _r_8_-news2-help"},[[71,92]],[[71,94]],[[71,96]]],[[71,99]]],[[34,1]],[[32,1]],[[30,1]],[[28,1]],[[26,1]],[[11,1]],[[22,1]],[[20,1]]],[[2,13]]]]]],[[71,227]]]]]]],[[83,65]],[[83,66]]]],"viewport":{"width":1150,"height":1004},"timestamp":14340.148,"wallTime":1792890422521,"collectionTime":2,"resourceOverrides":[],"isMainFrame":true}}
