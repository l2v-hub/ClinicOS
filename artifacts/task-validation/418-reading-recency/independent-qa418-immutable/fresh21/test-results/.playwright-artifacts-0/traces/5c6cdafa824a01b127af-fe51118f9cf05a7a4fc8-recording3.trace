{"type":"frame-snapshot","snapshot":{"callId":"call@3978","snapshotName":"after@call@3978","pageId":"page@4c8671201d38c598f82804ca8e8e0ef1","frameId":"frame@ecb36252399e3411ee6a52b7f59e5fd2","frameUrl":"http://127.0.0.1:7483/#/dettaglio-paziente/QA-418-INDEPENDENT","doctype":"html","html":["HTML",{"lang":"it"},["HEAD",{},[[18,0]],[[18,1]],[[18,2]],[[18,3]],[[18,4]],[[18,5]],[[18,6]],[[18,7]],[[18,8]],[[18,9]],[[18,10]],[[18,11]],[[18,12]],[[18,13]],[[18,15]],[[18,16]],[[18,18]],[[18,20]],[[18,22]],[[18,24]],[[18,26]],[[18,28]],[[15,1]],[[15,3]],[[15,5]],[[15,7]],[[15,9]],[[15,11]],[[15,13]],[[14,1]],[[14,3]],[[14,5]],[[14,7]],[[14,9]],[[14,11]],[[14,13]],[[14,15]],[[13,1]],[[13,3]],[[13,5]],[[13,7]],[[13,9]],[[13,11]],[[13,13]],[[13,15]],[[13,17]],[[13,19]],[[13,21]],[[13,23]],[[13,25]],[[13,27]],[[12,1]],[[12,3]],[[6,1]],[[6,3]],[[6,5]],[[6,7]],[[3,1]],[[3,3]],[[3,5]],[[3,7]],[[3,9]],[[3,11]],[[3,13]],[[3,15]],[[3,17]],[[3,19]],[[3,21]],[[3,23]],["STYLE",{},"/* Ricerca in anagrafica AIFA. Token del design system; nessun rosso come colore di marca. */\r\n\r\n.ricerca-farmaco {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  padding: 16px 20px 20px;\r\n  min-height: 0;\r\n}\r\n\r\n.ricerca-farmaco__campo {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding: 8px 12px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: #fff;\r\n}\r\n\r\n/* Stesso vincolo del campo nella maschera terapia: senza, il flex stira l'icona a tutto campo. */\r\n.ricerca-farmaco__campo > svg {\r\n  flex: none;\r\n  width: 18px;\r\n  height: 18px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.ricerca-farmaco__campo:focus-within {\r\n  border-color: var(--blue);\r\n  box-shadow: 0 0 0 3px rgb(47 107 237 / 12%);\r\n}\r\n\r\n.ricerca-farmaco__campo input {\r\n  flex: 1;\r\n  min-width: 0;\r\n  border: 0;\r\n  outline: none;\r\n  font-size: 14px;\r\n  color: var(--text);\r\n  background: transparent;\r\n}\r\n\r\n.ricerca-farmaco__criterio {\r\n  width: fit-content;\r\n  max-width: 100%;\r\n}\r\n\r\n.ricerca-farmaco__esiti {\r\n  flex: 1;\r\n  min-height: 0;\r\n  overflow: auto;\r\n}\r\n\r\n.ricerca-farmaco__nota {\r\n  margin: 0;\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.ricerca-farmaco__nota--errore {\r\n  color: var(--red);\r\n}\r\n\r\n.ricerca-farmaco__lista {\r\n  margin: 0;\r\n  padding: 0;\r\n  list-style: none;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n\r\n.ricerca-farmaco__riga {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  padding: 10px 12px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: #fff;\r\n}\r\n\r\n.ricerca-farmaco__nome {\r\n  margin: 0;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  color: var(--text);\r\n}\r\n\r\n/* Il rosso qui e' corretto: e' un avviso, non un accento di marca. */\r\n.ricerca-farmaco__revocato {\r\n  margin-left: 8px;\r\n  padding: 1px 7px;\r\n  border-radius: 999px;\r\n  background: var(--red);\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n  text-transform: uppercase;\r\n  color: #fff;\r\n}\r\n\r\n.ricerca-farmaco__dettagli,\r\n.ricerca-farmaco__pa {\r\n  margin: 2px 0 0;\r\n  font-size: 11px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n/* ── Modale ─────────────────────────────────────────────────────────────────────────────── */\r\n\r\n.ricerca-farmaco-modale {\r\n  display: flex;\r\n  flex-direction: column;\r\n  width: min(720px, 96vw);\r\n  max-height: 88vh;\r\n  max-width: none;\r\n  padding: 0;\r\n  overflow: hidden;\r\n}\r\n\r\n.ricerca-farmaco-modale__testa {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  padding: 18px 20px 12px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.ricerca-farmaco-modale__testa h2 {\r\n  margin: 0 0 4px;\r\n  font-size: 16px;\r\n  font-weight: 700;\r\n  color: var(--text);\r\n}\r\n\r\n/* ── Pagina dedicata ────────────────────────────────────────────────────────────────────── */\r\n\r\n.page-anagrafica-farmaci {\r\n  max-width: 1400px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.page-anagrafica-farmaci__corpo {\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--card-radius, 14px);\r\n  background: var(--surface);\r\n}\r\n\r\n/* ── Indicatore sulla riga di terapia ───────────────────────────────────────────────────── */\r\n\r\n.farmaco-trovato {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  margin: 3px 0 0 6px;\r\n  padding: 2px 6px;\r\n  border-radius: 999px;\r\n  background: var(--emerald-bg);\r\n  color: var(--text);\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  line-height: 1.4;\r\n  white-space: nowrap;\r\n  vertical-align: middle;\r\n}\r\n\r\n.farmaco-trovato svg {\r\n  display: block;\r\n  width: 12px;\r\n  height: 12px;\r\n  color: var(--teal);\r\n}\r\n\r\n/* \"non in anagrafica\" / \"senza documento\": ds-badge--warning canonico (ambra, mai rosso: non è\r\n   un allarme clinico ma un dato mancante su cui l'operatore può agire). */\r\n.ricerca-farmaco__icona {\r\n  flex: none;\r\n  display: grid;\r\n  place-items: center;\r\n  width: 24px;\r\n  height: 24px;\r\n  color: var(--text);\r\n}\r\n.ricerca-farmaco__icona svg {\r\n  width: 20px;\r\n  height: 20px;\r\n}\r\n.ricerca-farmaco__testo {\r\n  /* Base esplicita: su schermi stretti è il pulsante ad andare a capo, non le parole a spezzarsi. */\r\n  flex: 1 1 200px;\r\n  min-width: 0;\r\n  overflow-wrap: break-word;\r\n}\r\n@media (max-width: 600px) {\r\n  .ricerca-farmaco__riga {\r\n    flex-wrap: wrap;\r\n  }\r\n  .ricerca-farmaco__riga > :last-child {\r\n    margin-left: 36px;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Farmaci — HMI 1 (artifacts/hmi-parity/proto/farmaci.png). Solo la pagina: la modale della\r\n   terapia usa lo stesso corpo di ricerca con i suoi stili. */\r\n.page-anagrafica-farmaci {\r\n  max-width: none;\r\n}\r\n.page-anagrafica-farmaci__corpo {\r\n  border-radius: 16px;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco {\r\n  padding: 24px;\r\n  gap: 16px;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__campo {\r\n  height: 48px;\r\n  padding: 0 16px;\r\n  border: 2px solid var(--border);\r\n  border-radius: 12px;\r\n  background: #f5f7fb;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__campo input {\r\n  font-size: 16px;\r\n}\r\n\r\n.page-anagrafica-farmaci .ricerca-farmaco__nota {\r\n  font-size: 14px;\r\n  line-height: 20px;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__vuoto {\r\n  padding: 16px 0;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__esiti {\r\n  overflow: visible;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__lista {\r\n  gap: 0;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__riga {\r\n  gap: 16px;\r\n  padding: 12px 0;\r\n  border: 0;\r\n  border-bottom: 1px solid var(--border);\r\n  border-radius: 0;\r\n  background: transparent;\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__nome {\r\n  font: 600 16px/24px var(--font-ui);\r\n}\r\n.page-anagrafica-farmaci .ricerca-farmaco__dettagli,\r\n.page-anagrafica-farmaci .ricerca-farmaco__pa {\r\n  font: 400 14px/20px var(--font-ui);\r\n}\r\n\r\n@media (max-width: 600px) {\r\n  .page-anagrafica-farmaci .ricerca-farmaco {\r\n    padding: 16px;\r\n  }\r\n  .page-anagrafica-farmaci .ricerca-farmaco__riga {\r\n    flex-wrap: wrap;\r\n  }\r\n  .page-anagrafica-farmaci .ricerca-farmaco__riga > :last-child {\r\n    margin-left: 40px;\r\n  }\r\n}\r\n"],["STYLE",{},".agnos-panel { height: 100dvh; max-width: 100%; }\r\n.agnos-panel > header, .agnos-panel > .agnos-intro,\r\n.agnos-workflow-status, .agnos-composer { flex-shrink: 0; }\r\n.agnos-panel .ai-drawer__body { min-height: 0; overscroll-behavior: contain; padding: 16px 24px; }\r\n/* HMI 1: testata alta come la barra in alto, titolo \"✧ Assistente\" viola, poi la dichiarazione. */\r\n.agnos-panel .ai-drawer__header { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 8px; min-height: 72px; padding: 12px 16px 12px 24px; box-sizing: border-box; }\r\n.agnos-panel .agnos-title { display: flex; align-items: center; gap: 8px; min-width: 0; margin: 0; font: 600 20px/28px var(--ds-font); color: var(--purple, #6c4bd1); }\r\n.agnos-panel .agnos-title svg { width: 20px; height: 20px; flex: none; }\r\n.agnos-intro { padding: 16px 24px 0; }\r\n.agnos-intro p { margin: 0; }\r\n.agnos-intro__text { font: 400 14px/20px var(--ds-font); color: var(--text-muted); }\r\n.agnos-intro .agnos-intro__scope { margin-top: 8px; font: 600 14px/20px var(--ds-font); color: var(--ds-blue-active); }\r\n.agnos-panel .agnos-compose { display: flex; flex-direction: column; align-items: stretch; gap: 8px; padding: 16px 24px; }\r\n.agnos-compose-row { display: flex; align-items: flex-end; gap: 8px; }\r\n.agnos-compose-label { font-size: 13px; font-weight: 650; color: var(--text); }\r\n/* il campo parte da una riga (48px) e cresce col testo o con la dettatura */\r\n.agnos-panel textarea.agnos-input { width: 100%; min-width: 0; min-height: 48px; height: auto; max-height: 150px; flex: auto; field-sizing: content; line-height: 24px; padding-block: 10px; resize: none; }\r\n.agnos-compose-actions { display: flex; align-items: center; justify-content: flex-end; gap: 8px; }\r\n.agnos-compose-help { margin: 0; padding: 0 12px 8px; font-size: 12px; color: var(--text-muted); line-height: 1.4; }\r\n.agnos-compose .agnos-compose-help { padding: 0; }\r\n.agnos-panel .agnos-voice-consent { padding: 0 14px max(8px, env(safe-area-inset-bottom)); }\r\n.agnos-voice-consent .link-btn { font-size: 12px; min-height: 28px; }\r\n.agnos-consent-prompt { padding: 16px; border-top: 1px solid var(--border); background: #f3f7fd; font-size: 13px; line-height: 1.5; }\r\n.agnos-consent-prompt > strong { display: block; font-size: 15px; color: var(--text); }\r\n.agnos-consent-prompt p { margin: 8px 0 12px; }\r\n.agnos-composer { max-height: 65%; overflow-y: auto; overscroll-behavior: contain; }\r\n.agnos-consent-prompt .agnos-compose-actions { flex-wrap: wrap; }\r\n.agnos-workflow-status { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; padding: 10px 14px; background: #eef4ff; border-bottom: 1px solid var(--border); color: #244676; font-size: 13px; line-height: 1.4; }\r\n.agnos-workflow-status > span:not(.agnos-workflow-spinner) { flex: 1 1 220px; }\r\n.agnos-workflow-status[data-phase='error'] { background: #fff7e8; color: #76501c; }\r\n.agnos-workflow-status .link-btn { font-size: 12px; min-height: 32px; }\r\n.agnos-workflow-spinner { width: 14px; height: 14px; flex: 0 0 14px; border: 2px solid #cbdaf2; border-top-color: #316dda; border-radius: 50%; animation: agnos-spin 900ms linear infinite; }\r\n.agnos-transcript-label { align-self: flex-end; font-size: 11px; color: var(--text-muted); }\r\n.agnos-proposed-text { padding: 12px; border: 1px solid var(--border); border-radius: 8px; background: white; }\r\n.agnos-proposed-text p, .agnos-preview .voice-preview__row dd { white-space: pre-wrap; overflow-wrap: anywhere; }\r\n.agnos-proposed-text p { margin: 8px 0 12px; line-height: 1.5; }\r\n.agnos-proposed-text summary { cursor: pointer; color: var(--blue); margin-bottom: 12px; }\r\n.agnos-approval-hint { font-size: 13px; line-height: 1.45; margin: 12px 0 8px; }\r\n.agnos-panel .voice-actions { flex-wrap: wrap; }\r\n.agnos-workflow-dock { position: fixed; bottom: max(52px, env(safe-area-inset-bottom)); right: 12px; z-index: 202; max-width: min(440px, calc(100vw - 24px)); padding: 12px; display: flex; align-items: center; flex-wrap: wrap; gap: 10px; background: white; border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 4px 20px #10284726; font-size: 13px; }\r\n.agnos-workflow-dock span { flex: 1 1 190px; }\r\n@keyframes agnos-spin { to { transform: rotate(360deg); } }\r\n@media (min-width: 1100px) {\r\n  .app-shell:has(.agnos-panel--workspace[aria-hidden='false']) .main-area-clean { margin-right: 420px; }\r\n}\r\n@media (max-width: 1099px) {\r\n  .agnos-panel--workspace { top: auto; bottom: 0; height: 76dvh; border-radius: 16px 16px 0 0; }\r\n}\r\n@media (max-width: 480px) {\r\n  .agnos-panel--workspace { top: 0; height: 100dvh; border-radius: 0; }\r\n  .agnos-panel .agnos-compose { padding: 12px 16px; }\r\n  .agnos-panel .ai-drawer__header { padding-left: 16px; }\r\n  .agnos-intro { padding: 12px 16px 0; }\r\n  .agnos-panel .ai-drawer__body { padding: 12px 16px; }\r\n}\r\n@media (prefers-reduced-motion: reduce) { .agnos-workflow-spinner { animation: none; } }\r\n@media print { .agnos-workflow-dock { display: none !important; } }\r\n"],["STYLE",{},"/* Amministrazione → Ruoli e permessi. Solo layout e colori degli effetti: i controlli (chip,\r\n   pulsanti, campi) restano quelli canonici di design-system.css. Rosso solo per gli errori. */\r\n\r\n.rp-page {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n  /* .page-content already provides the page gutter. */\r\n  padding: 0;\r\n}\r\n\r\n.rp-body {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n  padding-bottom: 24px;\r\n}\r\n\r\n.rp-stack {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n\r\n.rp-muted {\r\n  color: var(--text-muted);\r\n  font-size: 13px;\r\n}\r\n\r\n.rp-mono {\r\n  font-family: var(--font-mono);\r\n  font-size: 12.5px;\r\n}\r\n\r\n/* ── Banner ─────────────────────────────────────────────────────────────────────────────── */\r\n.rp-banner {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  margin: 0;\r\n  padding: 12px 16px;\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--radius);\r\n  background: var(--surface);\r\n  color: var(--text);\r\n  font-size: 14px;\r\n}\r\n.rp-banner__actions {\r\n  display: inline-flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n.rp-banner--success {\r\n  background: var(--emerald-bg);\r\n  border-color: color-mix(in srgb, var(--emerald) 35%, transparent);\r\n}\r\n.rp-banner--warning {\r\n  background: var(--amber-bg);\r\n  border-color: color-mix(in srgb, var(--amber) 35%, transparent);\r\n  color: color-mix(in srgb, var(--amber) 55%, black);\r\n}\r\n.rp-banner--error {\r\n  background: var(--red-bg);\r\n  border-color: var(--red-border);\r\n  color: color-mix(in srgb, var(--red) 80%, black);\r\n}\r\n.rp-warnings {\r\n  display: block;\r\n  margin-bottom: 12px;\r\n  padding-left: 32px;\r\n}\r\n.rp-warnings li + li {\r\n  margin-top: 4px;\r\n}\r\n\r\n/* ── Filtri ─────────────────────────────────────────────────────────────────────────────── */\r\n.rp-filters {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: flex-end;\r\n  gap: 12px;\r\n  padding: 12px 16px;\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--radius);\r\n}\r\n.rp-filters__field {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  min-width: 160px;\r\n}\r\n.rp-filters__field--grow {\r\n  flex: 1 1 240px;\r\n}\r\n.rp-filters__label {\r\n  color: var(--field-label);\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n}\r\n.rp-filters__chips {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n.rp-filters__count {\r\n  margin-left: auto;\r\n  align-self: center;\r\n  color: var(--text-muted);\r\n  font-size: 13px;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.rp-capability-picker {\r\n  max-width: 640px;\r\n}\r\n\r\n/* ── Etichette ──────────────────────────────────────────────────────────────────────────── */\r\n.rp-tags,\r\n.rp-name-list {\r\n  display: inline-flex;\r\n  flex-wrap: wrap;\r\n  gap: 4px;\r\n}\r\n.rp-tag {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  padding: 1px 7px;\r\n  border-radius: 6px;\r\n  background: var(--c-neutral-bg);\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  line-height: 18px;\r\n  white-space: nowrap;\r\n}\r\n.rp-tag--write,\r\n.rp-tag--action {\r\n  background: var(--c-primary-bg);\r\n  color: var(--c-primary-active);\r\n}\r\n.rp-tag--sens-high,\r\n.rp-tag--sens-critical {\r\n  background: var(--amber-bg);\r\n  color: color-mix(in srgb, var(--amber) 65%, black);\r\n}\r\n.rp-tag--sens-critical {\r\n  font-weight: 800;\r\n}\r\n.rp-tag--tool,\r\n.rp-tag--sim {\r\n  background: color-mix(in srgb, var(--purple) 12%, white);\r\n  color: var(--purple);\r\n}\r\n.rp-tag--active,\r\n.rp-tag--gain {\r\n  background: var(--emerald-bg);\r\n  color: color-mix(in srgb, var(--emerald) 60%, black);\r\n}\r\n.rp-tag--loss {\r\n  background: var(--c-neutral-bg);\r\n  color: var(--text);\r\n  text-decoration: line-through;\r\n}\r\n.rp-legacy-tag {\r\n  display: inline-block;\r\n  margin-left: 6px;\r\n  padding: 0 6px;\r\n  border: 1px dashed var(--text-xmuted);\r\n  border-radius: 6px;\r\n  color: var(--text-xmuted);\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.04em;\r\n  line-height: 16px;\r\n  text-transform: lowercase;\r\n}\r\n.rp-count {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  min-width: 24px;\r\n  justify-content: center;\r\n  padding: 0 8px;\r\n  border-radius: 8px;\r\n  background: var(--c-neutral-bg);\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  line-height: 22px;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.rp-count--doubt {\r\n  background: var(--amber-bg);\r\n  color: color-mix(in srgb, var(--amber) 65%, black);\r\n}\r\n.rp-count--changed {\r\n  background: var(--c-primary-bg);\r\n  color: var(--c-primary-active);\r\n}\r\n\r\n/* ── Effetti ────────────────────────────────────────────────────────────────────────────── */\r\n.rp-effect,\r\n.rp-effect-badge {\r\n  --rp-bg: var(--c-neutral-bg);\r\n  --rp-fg: var(--text-muted);\r\n  --rp-bd: #d3dbe6;\r\n  background-color: var(--rp-bg);\r\n  color: var(--rp-fg);\r\n  border: 1px solid var(--rp-bd);\r\n}\r\n.rp-effect--ALLOWED,\r\n.rp-effect-badge--ALLOWED {\r\n  --rp-bg: var(--emerald-bg);\r\n  --rp-fg: color-mix(in srgb, var(--emerald) 60%, black);\r\n  --rp-bd: color-mix(in srgb, var(--emerald) 40%, white);\r\n}\r\n.rp-effect--ALLOWED_WITH_CONFIRMATION,\r\n.rp-effect-badge--ALLOWED_WITH_CONFIRMATION {\r\n  --rp-bg: var(--amber-bg);\r\n  --rp-fg: color-mix(in srgb, var(--amber) 65%, black);\r\n  --rp-bd: color-mix(in srgb, var(--amber) 40%, white);\r\n}\r\n.rp-effect--READ_ONLY,\r\n.rp-effect-badge--READ_ONLY {\r\n  --rp-bg: var(--ds-blue-tint, #eaf1fe);\r\n  --rp-fg: var(--c-primary-active);\r\n  --rp-bd: color-mix(in srgb, var(--blue) 30%, white);\r\n}\r\n\r\n.rp-effect {\r\n  box-sizing: border-box;\r\n  width: 100%;\r\n  min-width: 132px;\r\n  height: 40px;\r\n  padding: 0 28px 0 10px;\r\n  border-radius: var(--radius-sm);\r\n  font: 600 13px/1 var(--font-ui);\r\n  cursor: pointer;\r\n  appearance: none;\r\n  background-image:\r\n    linear-gradient(45deg, transparent 50%, currentColor 50%),\r\n    linear-gradient(135deg, currentColor 50%, transparent 50%);\r\n  background-position:\r\n    calc(100% - 14px) 50%,\r\n    calc(100% - 9px) 50%;\r\n  background-size: 5px 5px;\r\n  background-repeat: no-repeat;\r\n}\r\n.rp-effect:focus-visible {\r\n  outline: var(--ds-focus, 3px solid #245bb5);\r\n  outline-offset: 1px;\r\n}\r\n.rp-effect option {\r\n  background: var(--surface);\r\n  color: var(--text);\r\n}\r\n.rp-effect--changed {\r\n  box-shadow: inset 0 0 0 2px var(--blue);\r\n  border-color: var(--blue);\r\n}\r\n.rp-effect--inert {\r\n  border-style: dashed;\r\n  text-decoration: line-through;\r\n}\r\n\r\n.rp-effect-badge {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  padding: 1px 8px;\r\n  border-radius: 6px;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  line-height: 20px;\r\n  white-space: nowrap;\r\n}\r\n.rp-effect-badge--none {\r\n  border-style: dashed;\r\n}\r\n\r\n.rp-doubt {\r\n  display: inline-flex;\r\n  flex: none;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 22px;\r\n  height: 22px;\r\n  border-radius: 50%;\r\n  background: var(--amber-bg);\r\n  border: 1px solid color-mix(in srgb, var(--amber) 50%, white);\r\n  color: color-mix(in srgb, var(--amber) 65%, black);\r\n  font-size: 12px;\r\n  font-weight: 800;\r\n  cursor: help;\r\n}\r\n.rp-doubt:focus-visible {\r\n  outline: var(--ds-focus, 3px solid #245bb5);\r\n  outline-offset: 1px;\r\n}\r\n.rp-note {\r\n  display: inline-flex;\r\n  align-items: flex-start;\r\n  gap: 6px;\r\n  color: var(--text);\r\n  font-size: 13px;\r\n  white-space: normal;\r\n}\r\n\r\n.rp-outcome {\r\n  font-weight: 700;\r\n}\r\n.rp-outcome--yes {\r\n  color: color-mix(in srgb, var(--emerald) 60%, black);\r\n}\r\n.rp-outcome--no {\r\n  color: var(--text-muted);\r\n}\r\n\r\n/* ── Matrice ────────────────────────────────────────────────────────────────────────────── */\r\n.rp-matrix {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  min-width: 0;\r\n}\r\n.rp-matrix__tools {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n.rp-matrix__wrap {\r\n  max-height: calc(100vh - 300px);\r\n  min-height: 320px;\r\n  overflow: auto;\r\n  overscroll-behavior: contain;\r\n  margin-bottom: 0;\r\n  background: var(--surface);\r\n}\r\n.rp-matrix__table {\r\n  border-collapse: separate;\r\n  border-spacing: 0;\r\n}\r\n.rp-matrix__table thead th {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 3;\r\n  vertical-align: bottom;\r\n  white-space: normal;\r\n}\r\n.rp-matrix__cap-col {\r\n  left: 0;\r\n  z-index: 4 !important;\r\n  min-width: 260px;\r\n}\r\n.rp-matrix__role-col {\r\n  min-width: 144px;\r\n  text-transform: none !important;\r\n  letter-spacing: 0 !important;\r\n}\r\n.rp-matrix__role-label {\r\n  color: var(--text);\r\n  font-size: 13px;\r\n}\r\n.rp-col--legacy {\r\n  background-image: repeating-linear-gradient(\r\n    135deg,\r\n    transparent 0 8px,\r\n    rgba(90, 107, 128, 0.05) 8px 16px\r\n  );\r\n}\r\n.rp-matrix__table tbody td.rp-matrix__cell {\r\n  height: auto;\r\n  min-height: 0;\r\n  padding: 6px 8px;\r\n}\r\n.rp-cell {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n}\r\n\r\n:is(.rp-matrix__table, .rp-list-table) tbody th.rp-matrix__cap {\r\n  padding: 8px 14px;\r\n  border-bottom: 1px solid #f0f4f8;\r\n  background: var(--surface);\r\n  text-align: left;\r\n  font-weight: 400;\r\n  vertical-align: middle;\r\n}\r\n.rp-matrix__table tbody th.rp-matrix__cap {\r\n  position: sticky;\r\n  left: 0;\r\n  z-index: 2;\r\n  max-width: 340px;\r\n  box-shadow: 1px 0 0 var(--border);\r\n}\r\n.rp-cap-name {\r\n  display: block;\r\n  color: var(--text);\r\n  font-size: 13.5px;\r\n  font-weight: 600;\r\n}\r\n.rp-cap-id {\r\n  display: block;\r\n  margin: 1px 0 4px;\r\n  color: var(--text-xmuted);\r\n  font-family: var(--font-mono);\r\n  font-size: 11px;\r\n  word-break: break-all;\r\n}\r\n\r\n.rp-group-row th {\r\n  position: sticky;\r\n  left: 0;\r\n  padding: 0;\r\n  background: var(--surface-raised);\r\n  border-bottom: 1px solid var(--border);\r\n  text-align: left;\r\n}\r\n.rp-group-toggle {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 10px;\r\n  width: 100%;\r\n  min-height: 48px;\r\n  padding: 8px 14px;\r\n  border: 0;\r\n  background: transparent;\r\n  color: var(--text);\r\n  font: 700 14px/1.3 var(--font-ui);\r\n  text-align: left;\r\n  cursor: pointer;\r\n}\r\n.rp-group-toggle:hover {\r\n  background: var(--hover);\r\n}\r\n.rp-group-toggle:focus-visible {\r\n  outline: var(--ds-focus, 3px solid #245bb5);\r\n  outline-offset: -3px;\r\n}\r\n.rp-chevron {\r\n  width: 8px;\r\n  height: 8px;\r\n  border-right: 2px solid currentColor;\r\n  border-bottom: 2px solid currentColor;\r\n  transform: rotate(-45deg);\r\n  transition: transform 0.15s ease-out;\r\n}\r\n.rp-chevron--open {\r\n  transform: rotate(45deg);\r\n}\r\n\r\n/* ── Per ruolo / per capability ─────────────────────────────────────────────────────────── */\r\n.rp-list-table tbody td {\r\n  height: auto;\r\n  min-height: 0;\r\n  padding: 8px 14px;\r\n}\r\n.rp-list-table .rp-effect {\r\n  max-width: 220px;\r\n}\r\n.rp-row--legacy td,\r\n.rp-row--legacy th {\r\n  background-image: repeating-linear-gradient(\r\n    135deg,\r\n    transparent 0 8px,\r\n    rgba(90, 107, 128, 0.05) 8px 16px\r\n  );\r\n}\r\n.rp-role-summary {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n}\r\n.rp-role-summary__desc {\r\n  margin: 0;\r\n  color: var(--text);\r\n  font-size: 14px;\r\n}\r\n.rp-facts {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));\r\n  gap: 10px 16px;\r\n  margin: 0;\r\n}\r\n.rp-facts dt {\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n}\r\n.rp-facts dd {\r\n  margin: 2px 0 0;\r\n  color: var(--text);\r\n  font-size: 14px;\r\n}\r\n.rp-subtitle {\r\n  margin: 0 0 6px;\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  color: var(--text);\r\n}\r\n.rp-identity-list,\r\n.rp-derived-list {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  margin: 0;\r\n  padding: 0;\r\n  list-style: none;\r\n}\r\n.rp-identity-list li,\r\n.rp-derived-list li {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px;\r\n  font-size: 13.5px;\r\n}\r\n.rp-derived-list .rp-cap-name,\r\n.rp-derived-list .rp-cap-id {\r\n  display: inline;\r\n  margin: 0;\r\n}\r\n\r\n/* ── Identità ───────────────────────────────────────────────────────────────────────────── */\r\n.rp-assign {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n.rp-assign__select {\r\n  min-width: 220px;\r\n}\r\nselect.rp-assign__select--changed:not(#ds) {\r\n  border-color: var(--blue);\r\n  box-shadow: inset 0 0 0 1px var(--blue);\r\n}\r\n\r\n/* ── Storico ────────────────────────────────────────────────────────────────────────────── */\r\n.rp-history {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  margin: 0;\r\n  padding: 0;\r\n  list-style: none;\r\n}\r\n.rp-history__item {\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--radius);\r\n  background: var(--surface);\r\n  overflow: hidden;\r\n}\r\n.rp-history__item.is-open {\r\n  border-color: color-mix(in srgb, var(--blue) 35%, var(--border));\r\n}\r\n.rp-history__head {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding-right: 12px;\r\n}\r\n.rp-history__toggle {\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n}\r\n.rp-history__version {\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.rp-history__meta,\r\n.rp-history__counts {\r\n  color: var(--text-muted);\r\n  font-size: 13px;\r\n  font-weight: 500;\r\n}\r\n.rp-history__counts {\r\n  margin-left: auto;\r\n}\r\n.rp-history__note,\r\n.rp-history__item > .rp-muted {\r\n  margin: 0;\r\n  padding: 0 14px 10px 36px;\r\n  font-size: 13.5px;\r\n}\r\n.rp-history__body {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  padding: 12px 14px 14px;\r\n  border-top: 1px solid var(--divider);\r\n}\r\n.rp-history__roles {\r\n  margin: 0;\r\n  font-size: 13.5px;\r\n}\r\n\r\n/* ── Impatto e conferma ─────────────────────────────────────────────────────────────────── */\r\n.rp-impact__table td {\r\n  vertical-align: top;\r\n  min-width: 140px;\r\n}\r\n.rp-confirm-summary {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n}\r\n.rp-confirm-summary__line {\r\n  display: block;\r\n}\r\n.rp-confirm-summary__warning {\r\n  padding: 6px 10px;\r\n  border-radius: var(--radius-sm);\r\n  background: var(--amber-bg);\r\n  color: color-mix(in srgb, var(--amber) 65%, black);\r\n}\r\n\r\n/* ── Barra modifiche ────────────────────────────────────────────────────────────────────── */\r\n.rp-changebar {\r\n  position: sticky;\r\n  bottom: 0;\r\n  z-index: 20;\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 12px;\r\n  margin: 0 calc(var(--gutter, 20px) * -1);\r\n  padding: 12px var(--gutter, 20px);\r\n  border-top: 2px solid var(--blue);\r\n  background: var(--surface);\r\n  box-shadow: 0 -6px 18px rgba(16, 32, 54, 0.1);\r\n}\r\n.rp-changebar__count {\r\n  display: flex;\r\n  flex-direction: column;\r\n  font-size: 14px;\r\n  color: var(--text);\r\n}\r\n.rp-changebar__count strong {\r\n  font-size: 18px;\r\n  color: var(--c-primary-active);\r\n}\r\n.rp-changebar__note {\r\n  flex: 1 1 240px;\r\n  min-width: 200px;\r\n}\r\n.rp-changebar__note .form-input {\r\n  width: 100%;\r\n}\r\n.rp-changebar__actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n\r\n@media (max-width: 1023px) {\r\n  .rp-page {\r\n    padding: 0;\r\n  }\r\n  .rp-changebar {\r\n    margin: 0 -14px;\r\n    padding: 10px 14px;\r\n  }\r\n  .rp-matrix__cap-col {\r\n    min-width: 200px;\r\n  }\r\n  .rp-matrix__table tbody th.rp-matrix__cap {\r\n    max-width: 220px;\r\n  }\r\n  .rp-filters__count {\r\n    margin-left: 0;\r\n  }\r\n  .rp-history__counts {\r\n    margin-left: 0;\r\n  }\r\n}\r\n\r\n/* Views (L3) and the reload action share one row: no empty action row above the tabs. */\r\n.rp-tabs-row {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  flex-wrap: wrap;\r\n}\r\n"],["STYLE",{},".therapy-calendar-dialog--patient .therapy-calendar-dialog__head {\r\n  margin-bottom: 8px;\r\n}\r\n.therapy-calendar-dialog--patient .therapy-calendar-dialog__head > button:not(#ds) {\r\n  width: var(--ds-control-h);\r\n  height: var(--ds-control-h);\r\n  min-height: var(--ds-control-h);\r\n  padding: 0;\r\n  font-size: var(--ds-icon-size);\r\n}\r\n.therapy-calendar-dialog--patient .patient-therapy-slot-detail--embedded {\r\n  margin: 0;\r\n  padding: 0;\r\n  border: 0;\r\n  border-radius: 0;\r\n  background: transparent;\r\n}\r\n.patient-therapy-slot-detail--embedded .patient-therapy-slot-detail__sub {\r\n  margin: 0 0 6px;\r\n  color: var(--text-muted);\r\n  font-weight: 400;\r\n}\r\n.patient-therapy-slot-detail--embedded .giro-patients {\r\n  gap: 0;\r\n}\r\n.patient-therapy-slot-detail--embedded .giro-patient {\r\n  padding: 0;\r\n  border: 0;\r\n  border-radius: 0;\r\n  background: transparent;\r\n}\r\n.patient-therapy-slot-detail--embedded .giro-drugs {\r\n  padding: 0;\r\n}\r\n.patient-therapy-slot-detail--embedded .giro-drug {\r\n  gap: 8px 16px;\r\n  padding: 12px 0;\r\n  align-items: start;\r\n}\r\n.patient-therapy-slot-detail--embedded .giro-drug__name {\r\n  font-weight: 650;\r\n}\r\n.patient-therapy-slot-detail__prescription {\r\n  font-size: 12px;\r\n  line-height: 18px;\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n}\r\n.patient-therapy-slot-detail__note {\r\n  margin-top: 4px;\r\n  font-size: 13px;\r\n  line-height: 19px;\r\n  white-space: pre-wrap;\r\n  overflow-wrap: anywhere;\r\n}\r\n.patient-therapy-slot-detail--embedded .giro-row__act {\r\n  display: grid;\r\n  grid-template-columns: auto auto;\r\n  align-items: start;\r\n  gap: 6px;\r\n}\r\n.patient-therapy-slot-detail--embedded .giro-row__act > .giro-badge {\r\n  grid-column: 1 / -1;\r\n  justify-self: end;\r\n  margin: 0;\r\n  min-height: 24px;\r\n  padding: 2px 7px;\r\n  font-size: 12px;\r\n  line-height: 18px;\r\n  max-width: 250px;\r\n  overflow-wrap: anywhere;\r\n}\r\n.patient-therapy-slot-detail--embedded .ds-btn:not(#ds),\r\n.patient-therapy-slot-detail--embedded .ds-chip:not(#ds) {\r\n  min-height: var(--ds-control-h);\r\n  padding: 0 var(--ds-control-px);\r\n  font-size: var(--ds-control-font);\r\n  line-height: 20px;\r\n}\r\n.patient-therapy-slot-detail--embedded .ds-btn svg {\r\n  width: var(--ds-icon-size);\r\n  height: var(--ds-icon-size);\r\n}\r\n.patient-therapy-slot-detail--embedded .giro-row__act > .patient-therapy-slot-detail__retry {\r\n  grid-column: 1 / -1;\r\n}\r\n.patient-therapy-slot-detail__prescriptions {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n.patient-therapy-slot-detail__prescriptions > li {\r\n  padding: 12px 0;\r\n  border-top: 1px solid var(--border);\r\n}\r\n@media (max-width: 720px) {\r\n  .patient-therapy-slot-detail--embedded .giro-row__act {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n  .patient-therapy-slot-detail--embedded .giro-row__act > .giro-badge {\r\n    justify-self: start;\r\n    max-width: 100%;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Pannello in linea del farmaco (UX 2026-10-03): dosi del giorno e azioni dove si legge il farmaco. */\r\n.drug-dose-panel {\r\n  padding: 12px 16px 16px;\r\n  background: var(--surface-2, #f6f8fc);\r\n  border-top: 1px solid var(--border);\r\n  border-bottom: 1px solid var(--border);\r\n  white-space: normal;\r\n}\r\n.drug-dose-panel__title {\r\n  margin: 0 0 4px;\r\n  font: 600 13px/18px var(--font-ui);\r\n  color: var(--text);\r\n}\r\n.drug-dose-panel__ro,\r\n.drug-dose-panel__msg,\r\n.drug-dose-panel__hint {\r\n  margin: 4px 0;\r\n  font: 400 13px/18px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n.drug-dose-panel__msg.is-error {\r\n  color: var(--red);\r\n}\r\n.drug-dose-panel__time.is-focus {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 2px;\r\n  border-radius: 8px;\r\n}\r\n.drug-dose-panel__feedback {\r\n  margin: 8px 0 0;\r\n  font: 500 13px/18px var(--font-ui);\r\n}\r\n.drug-dose-panel__feedback.is-ok {\r\n  color: var(--green, #1f7a4d);\r\n}\r\n.drug-dose-panel__feedback.is-error {\r\n  color: var(--red);\r\n}\r\n.drug-dose-panel__prn-list {\r\n  list-style: none;\r\n  margin: 4px 0 8px;\r\n  padding: 0;\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n.drug-dose-panel__prn-list > li {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 4px 12px;\r\n  font: 400 13px/18px var(--font-ui);\r\n  overflow-wrap: anywhere;\r\n}\r\n.drug-dose-panel__indication {\r\n  color: var(--text-muted);\r\n}\r\n.drug-dose-panel__prn-form {\r\n  display: grid;\r\n  gap: 4px;\r\n  max-width: 560px;\r\n}\r\n.drug-dose-panel__prn-form > button {\r\n  justify-self: start;\r\n  margin-top: 4px;\r\n}\r\n/* Riga del farmaco espandibile nelle tabelle della terapia. */\r\n.therapy-row--open > td {\r\n  background: var(--blue-50, #eef3fd);\r\n}\r\n.therapy-expand-row > td {\r\n  padding: 0 !important;\r\n}\r\n.therapy-drug-toggle {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  min-height: 44px;\r\n  padding: 0;\r\n  border: 0;\r\n  background: none;\r\n  font: inherit;\r\n  color: inherit;\r\n  text-align: left;\r\n  cursor: pointer;\r\n}\r\n.therapy-drug-toggle__hint {\r\n  font: 500 12px/16px var(--font-ui);\r\n  color: var(--blue);\r\n}\r\n.therapy-drug-toggle:focus-visible {\r\n  outline: 3px solid #245bb5;\r\n  outline-offset: 2px;\r\n}\r\n"],["STYLE",{},".patient-therapy-calendar {\r\n  padding: 16px;\r\n  min-width: 0;\r\n}\r\n/* One vertical path through summary, details and hours. Horizontal week content remains\r\n   locally reachable on narrow screens, without adding a height-limited inner scroller. */\r\n.patient-therapy-calendar .therapy-calendar-grid {\r\n  max-height: none;\r\n  overflow-x: auto;\r\n  overflow-y: visible;\r\n}\r\n.patient-therapy-calendar__summary {\r\n  margin-bottom: 12px;\r\n}\r\n.patient-therapy-calendar__empty {\r\n  margin: 8px 0;\r\n  font-size: 14px;\r\n  line-height: 1.5;\r\n}\r\n.patient-therapy-calendar__programming {\r\n  padding: 12px 14px;\r\n  border: 1px solid var(--ds-border, #e1e7f0);\r\n  border-left: 4px solid var(--ds-blue, #2f6bed);\r\n  border-radius: var(--ds-radius, 12px);\r\n  background: var(--ds-blue-tint, #eaf1fe);\r\n  color: var(--ds-text, #16202e);\r\n  font-size: 14px;\r\n  line-height: 1.5;\r\n  overflow-wrap: anywhere;\r\n}\r\n.patient-therapy-calendar__programming p {\r\n  margin: 0 0 6px;\r\n}\r\n.patient-therapy-calendar__programming summary {\r\n  min-height: 44px;\r\n  padding: 10px 0;\r\n  cursor: pointer;\r\n  font-weight: 650;\r\n}\r\n.patient-therapy-calendar__programming summary:focus-visible {\r\n  outline: var(--ds-focus, 3px solid #245bb5);\r\n  outline-offset: 2px;\r\n}\r\n.patient-therapy-calendar__programming ul {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 0;\r\n}\r\n.patient-therapy-calendar__programming li {\r\n  padding: 12px 0;\r\n  border-top: 1px solid var(--ds-border, #e1e7f0);\r\n}\r\n.patient-therapy-calendar__programming li > strong,\r\n.patient-therapy-calendar__programming li > span {\r\n  display: block;\r\n}\r\n.patient-therapy-calendar__programming li > p {\r\n  margin-top: 4px;\r\n}\r\n.patient-therapy-calendar__programming button {\r\n  min-height: 44px;\r\n  max-width: 100%;\r\n  white-space: normal;\r\n}\r\n.patient-therapy-calendar__toolbar {\r\n  display: flex;\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n  gap: 12px;\r\n}\r\n.patient-therapy-calendar__toolbar .agt-today-btn {\r\n  min-height: 44px;\r\n}\r\n.patient-therapy-calendar__toolbar .agt-nav-btn {\r\n  font-size: 26px;\r\n}\r\n.patient-therapy-calendar__date {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  font-size: 13px;\r\n}\r\n.patient-therapy-calendar__date .form-input {\r\n  width: 160px;\r\n  min-height: 44px;\r\n}\r\n.patient-therapy-calendar__heading {\r\n  margin: 18px 0 10px;\r\n}\r\n.patient-therapy-calendar__heading h3 {\r\n  margin: 0 0 6px;\r\n  font-size: 16px;\r\n  font-weight: 650;\r\n  text-transform: capitalize;\r\n}\r\n.patient-therapy-calendar__heading p {\r\n  margin: 4px 0;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n}\r\n.patient-therapy-calendar__message,\r\n.patient-therapy-calendar__count {\r\n  margin: 14px 0;\r\n  font-size: 13px;\r\n}\r\n.patient-therapy-calendar__timeline {\r\n  position: relative;\r\n  max-height: 560px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  overscroll-behavior-y: contain;\r\n}\r\n.patient-therapy-calendar__timeline:focus-visible {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 2px;\r\n}\r\n.patient-therapy-calendar__timeline .agt-slot {\r\n  min-height: 48px;\r\n}\r\n.patient-therapy-calendar__timeline .agt-slot__time {\r\n  width: 60px;\r\n  padding: 14px 8px;\r\n}\r\n.patient-therapy-calendar__events {\r\n  flex: 1;\r\n  min-width: 0;\r\n  margin: 0;\r\n  padding: 4px 8px 4px 0;\r\n  list-style: none;\r\n}\r\n.patient-therapy-calendar .agt-slot--hour {\r\n  flex-wrap: wrap;\r\n}\r\n/* Ogni dose è un'azione: apre il dettaglio dell'orario (terapie + somministrazione). */\r\n.patient-therapy-calendar .patient-therapy-calendar__event {\r\n  grid-template-columns: 32px minmax(0, 1fr);\r\n  min-height: 44px;\r\n  cursor: pointer;\r\n}\r\n.patient-therapy-calendar .patient-therapy-calendar__event:hover,\r\n.patient-therapy-calendar .patient-therapy-calendar__event[aria-expanded='true'] {\r\n  background: #e4dbff;\r\n  border-color: #b3a0ef;\r\n  border-left-color: var(--purple);\r\n}\r\n.patient-therapy-calendar .patient-therapy-calendar__event:focus-visible {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 2px;\r\n}\r\n.patient-therapy-calendar__event-dose {\r\n  display: block;\r\n  margin-top: 4px;\r\n  font-size: 12px;\r\n  line-height: 1.45;\r\n}\r\n.patient-therapy-slot-detail {\r\n  flex-basis: 100%;\r\n  margin: 0 8px 10px 60px;\r\n  padding: 12px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: var(--surface, #fff);\r\n  min-width: 0;\r\n}\r\n.patient-therapy-slot-detail__head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n}\r\n.patient-therapy-slot-detail__head h4,\r\n.patient-therapy-slot-detail__sub {\r\n  margin: 0;\r\n  font-size: 13px;\r\n  font-weight: 650;\r\n}\r\n.patient-therapy-slot-detail__head .btn-sm {\r\n  min-height: 44px;\r\n}\r\n.patient-therapy-slot-detail__sub {\r\n  margin-top: 12px;\r\n  text-transform: none;\r\n}\r\n.patient-therapy-slot-detail__list {\r\n  list-style: none;\r\n  margin: 8px 0 0;\r\n  padding: 0;\r\n}\r\n.patient-therapy-slot-detail__list li {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 4px 10px;\r\n  padding: 6px 0;\r\n  font-size: 12px;\r\n  overflow-wrap: anywhere;\r\n}\r\n.patient-therapy-slot-detail__msg,\r\n.patient-therapy-slot-detail__feedback {\r\n  margin: 8px 0 0;\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n}\r\n.patient-therapy-slot-detail__feedback.is-ok {\r\n  color: var(--green, #1f7a4d);\r\n}\r\n.patient-therapy-slot-detail__feedback.is-error {\r\n  color: var(--red);\r\n}\r\n.patient-therapy-calendar__medication {\r\n  min-width: 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n.patient-therapy-calendar__event-title {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: baseline;\r\n  gap: 4px 10px;\r\n}\r\n.patient-therapy-calendar__event-title time {\r\n  font-size: 13px;\r\n  font-weight: 650;\r\n  font-variant-numeric: tabular-nums;\r\n  color: #4e2ba7;\r\n}\r\n.patient-therapy-calendar__unscheduled {\r\n  margin-top: 16px;\r\n  padding: 12px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n}\r\n.patient-therapy-calendar__unscheduled h4 {\r\n  font-size: 13px;\r\n  margin: 0 0 10px;\r\n}\r\n.patient-therapy-calendar__unscheduled h4 span {\r\n  font-weight: 400;\r\n}\r\n.patient-therapy-calendar__unscheduled ul {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 0;\r\n}\r\n.patient-therapy-calendar__unscheduled li {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 4px 10px;\r\n  padding: 8px 0;\r\n  font-size: 12px;\r\n  overflow-wrap: anywhere;\r\n}\r\n.patient-therapy-calendar__unscheduled li + li {\r\n  border-top: 1px solid var(--border);\r\n}\r\n.patient-therapy-calendar__unscheduled p {\r\n  flex-basis: 100%;\r\n  margin: 0;\r\n  color: var(--text-muted);\r\n}\r\n@media (max-width: 600px) {\r\n  .patient-therapy-calendar {\r\n    padding: 12px 8px;\r\n  }\r\n  .patient-therapy-calendar__toolbar {\r\n    gap: 8px;\r\n  }\r\n  .patient-therapy-calendar__timeline {\r\n    max-height: 480px;\r\n  }\r\n  .patient-therapy-calendar__timeline .agt-slot__time {\r\n    width: 48px;\r\n    padding-inline: 6px;\r\n  }\r\n  .patient-therapy-calendar .patient-therapy-calendar__event {\r\n    grid-template-columns: 24px minmax(0, 1fr);\r\n    gap: 7px;\r\n    padding: 8px;\r\n    border-left-width: 4px;\r\n  }\r\n  .patient-therapy-slot-detail {\r\n    margin-left: 8px;\r\n  }\r\n  .patient-therapy-calendar__event .agt-therapy-slot__icon {\r\n    width: 24px;\r\n    height: 28px;\r\n  }\r\n}\r\n\r\n/* ── UX 2026-10-03: informazione senza clic (stato, dose, prescrittore, nota sull'evento) ── */\r\n.ptc-views {\r\n  display: flex;\r\n  gap: 6px;\r\n}\r\n.patient-therapy-calendar__event-dose {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 4px 10px;\r\n}\r\n.ptc-dose {\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  color: var(--text);\r\n  overflow-wrap: anywhere;\r\n}\r\n.ptc-meta {\r\n  display: block;\r\n  margin-top: 4px;\r\n  font-size: 12px;\r\n  line-height: 1.45;\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n}\r\n.ptc-hour-summary {\r\n  flex-basis: 100%;\r\n  order: -1;\r\n  margin: 6px 8px 0 60px;\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  color: var(--text-muted);\r\n}\r\n.ptc-status {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  min-height: 24px;\r\n  padding: 2px 8px;\r\n  border-radius: 999px;\r\n  font-size: 12px;\r\n  font-weight: 650;\r\n  line-height: 1.25;\r\n  overflow-wrap: anywhere;\r\n}\r\n.ptc-status--due,\r\n.ptc-status--future {\r\n  background: #eaf1fe;\r\n  color: #1d4fc4;\r\n}\r\n.ptc-status--late {\r\n  background: #fdecee;\r\n  color: #a5202f;\r\n}\r\n.ptc-status--done {\r\n  background: #e6f6ef;\r\n  color: #0e7a55;\r\n}\r\n.ptc-status--missed {\r\n  background: #fdecee;\r\n  color: #a5202f;\r\n}\r\n.ptc-status--unknown {\r\n  background: var(--surface-2, #f1f4f9);\r\n  color: var(--text-muted);\r\n}\r\n.patient-therapy-calendar .patient-therapy-calendar__event.is-late {\r\n  border-left-color: var(--red);\r\n}\r\n.patient-therapy-calendar .patient-therapy-calendar__event.is-done {\r\n  background: #eef8f2;\r\n  border-color: #c6e6d4;\r\n  border-left-color: #16a37b;\r\n}\r\n.patient-therapy-calendar .patient-therapy-calendar__event.is-missed {\r\n  border-left-color: var(--red);\r\n}\r\n.ptc-prn-panel {\r\n  flex-basis: 100%;\r\n}\r\n/* Settimana: 7 colonne quando c'è spazio, un blocco per giorno su tablet verticale. */\r\n.ptc-week {\r\n  list-style: none;\r\n  margin: 12px 0 0;\r\n  padding: 0;\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr);\r\n  gap: 10px;\r\n}\r\n@media (min-width: 1100px) {\r\n  .ptc-week {\r\n    grid-template-columns: repeat(7, minmax(0, 1fr));\r\n    gap: 6px;\r\n  }\r\n}\r\n.ptc-week__day {\r\n  min-width: 0;\r\n  padding: 8px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: var(--surface, #fff);\r\n}\r\n.ptc-week__day.is-today {\r\n  border-color: var(--blue);\r\n  box-shadow: inset 0 3px 0 var(--blue);\r\n}\r\n.ptc-week__head {\r\n  margin: 0 0 6px;\r\n  font-size: 13px;\r\n  font-weight: 650;\r\n  text-transform: capitalize;\r\n}\r\n.ptc-week__none {\r\n  margin: 4px 0;\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n}\r\n.ptc-week__doses {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n.ptc-week__dose {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-start;\r\n  gap: 2px;\r\n  width: 100%;\r\n  min-height: 44px;\r\n  padding: 6px 8px;\r\n  border: 1px solid #c9baf2;\r\n  border-left: 4px solid var(--purple);\r\n  border-radius: 8px;\r\n  background: #f6f2ff;\r\n  color: var(--text);\r\n  font: inherit;\r\n  font-size: 12px;\r\n  text-align: left;\r\n  cursor: pointer;\r\n}\r\n.ptc-week__dose.is-late,\r\n.ptc-week__dose.is-missed {\r\n  border-left-color: var(--red);\r\n}\r\n.ptc-week__dose.is-done {\r\n  border-left-color: #16a37b;\r\n  background: #eef8f2;\r\n}\r\n.ptc-week__dose:focus-visible {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 2px;\r\n}\r\n.ptc-week__line {\r\n  overflow-wrap: anywhere;\r\n}\r\n.ptc-week__line time {\r\n  font-weight: 650;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.patient-therapy-calendar__heading h3.is-week {\r\n  text-transform: none;\r\n}\r\n\r\n/* UX ciclo 2 — W5: dose del farmaco richiesto da un collegamento diretto. */\r\n.patient-therapy-calendar__event.is-focus {\r\n  outline: 3px solid var(--ds-blue, #2f6bed);\r\n  outline-offset: 1px;\r\n}\r\n/* «Somministra ora» di una dose di oggi segnata come non somministrata. */\r\n.patient-therapy-slot-detail__again {\r\n  list-style: none;\r\n  margin: 10px 0 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n.patient-therapy-slot-detail__again li {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  font-size: 14px;\r\n}\r\n"],["STYLE",{},"/* Campo farmaco con ricerca in anagrafica. Token del design system. */\r\n\r\n.campo-farmaco__criterio {\r\n  display: flex;\r\n  gap: 6px;\r\n  margin-bottom: 6px;\r\n}\r\n\r\n.campo-farmaco__criterio button {\r\n  padding: 4px 11px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 999px;\r\n  background: #fff;\r\n  font-size: 11px;\r\n  color: var(--text-muted);\r\n  cursor: pointer;\r\n}\r\n\r\n.campo-farmaco__criterio button.is-attivo {\r\n  border-color: var(--blue);\r\n  background: var(--blue);\r\n  color: #fff;\r\n}\r\n\r\n.campo-farmaco__campo {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding: 7px 11px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: #fff;\r\n}\r\n\r\n/* Senza vincolo l'SVG dell'icona viene stirato dal flex e riempie il campo. */\r\n.campo-farmaco__campo > svg {\r\n  flex: none;\r\n  width: 16px;\r\n  height: 16px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.campo-farmaco__campo:focus-within {\r\n  border-color: var(--blue);\r\n  box-shadow: 0 0 0 3px rgb(47 107 237 / 12%);\r\n}\r\n\r\n.campo-farmaco__input {\r\n  flex: 1;\r\n  min-width: 0;\r\n  border: 0;\r\n  outline: none;\r\n  font-size: 14px;\r\n  color: var(--text);\r\n  background: transparent;\r\n}\r\n\r\n.campo-farmaco__esiti {\r\n  margin-top: 6px;\r\n  max-height: 260px;\r\n  overflow: auto;\r\n}\r\n\r\n.campo-farmaco__nota {\r\n  margin: 4px 0 0;\r\n  font-size: 11px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.campo-farmaco__nota--errore {\r\n  color: var(--red);\r\n}\r\n\r\n.campo-farmaco__lista {\r\n  margin: 0;\r\n  padding: 0;\r\n  list-style: none;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n}\r\n\r\n.campo-farmaco__lista button {\r\n  display: block;\r\n  width: 100%;\r\n  padding: 7px 10px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  background: #fff;\r\n  text-align: left;\r\n  cursor: pointer;\r\n}\r\n\r\n.campo-farmaco__lista button:hover {\r\n  border-color: var(--blue);\r\n  background: rgb(47 107 237 / 5%);\r\n}\r\n\r\n.campo-farmaco__nome {\r\n  display: block;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  color: var(--text);\r\n}\r\n\r\n.campo-farmaco__dettagli,\r\n.campo-farmaco__pa {\r\n  display: block;\r\n  margin-top: 1px;\r\n  font-size: 11px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n/* Ripiego per galenici ed esteri: deve essere raggiungibile ma non invitante. */\r\n.campo-farmaco__ripiego {\r\n  margin-top: 8px;\r\n  padding: 9px 11px;\r\n  border: 1px dashed rgb(180 120 0 / 45%);\r\n  border-radius: 8px;\r\n  background: rgb(255 196 0 / 8%);\r\n}\r\n\r\n.campo-farmaco__usa-comunque {\r\n  margin-top: 6px;\r\n  padding: 5px 11px;\r\n  border: 1px solid #c98a00;\r\n  border-radius: 8px;\r\n  background: #fff;\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  color: #7a5300;\r\n  cursor: pointer;\r\n}\r\n\r\n.campo-farmaco__usa-comunque:hover {\r\n  background: #c98a00;\r\n  color: #fff;\r\n}\r\n\r\n/* Farmaco già scelto */\r\n.campo-farmaco__scelto {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  padding: 9px 12px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: #fff;\r\n}\r\n\r\n.campo-farmaco__scelto.is-fuori-anagrafica {\r\n  border-color: rgb(180 120 0 / 45%);\r\n  background: rgb(255 196 0 / 8%);\r\n}\r\n\r\n.campo-farmaco__stato {\r\n  margin: 2px 0 0;\r\n  font-size: 11px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.campo-farmaco__scelto.is-fuori-anagrafica .campo-farmaco__stato {\r\n  color: #8a5a00;\r\n}\r\n"],["STYLE",{},".therapy-form {\r\n  container: therapy-form / inline-size;\r\n  grid-column: 1 / -1;\r\n  width: 100%;\r\n  min-width: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  color: var(--text-primary, #1e293b);\r\n}\r\n\r\n.terapia-sched-form.therapy-form-shell {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  padding: 0;\r\n  margin: 0;\r\n  background: transparent;\r\n}\r\n\r\n.therapy-form-shell__heading h2 {\r\n  margin: 0 0 4px;\r\n  font-size: 19px;\r\n}\r\n\r\n.therapy-form-shell__heading p {\r\n  margin: 0;\r\n  color: var(--text-muted, #64748b);\r\n  font-size: 12px;\r\n}\r\n\r\n.therapy-form__section {\r\n  padding: 16px;\r\n  border: 1px solid var(--border, #dce3ec);\r\n  border-radius: 12px;\r\n  background: var(--surface, #fff);\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 14px;\r\n  min-width: 0;\r\n}\r\n\r\n.therapy-form__section h3 {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  margin: 0;\r\n  font-size: 15px;\r\n  font-weight: 650;\r\n}\r\n\r\n.therapy-form__section h3 > span {\r\n  display: grid;\r\n  place-items: center;\r\n  width: 24px;\r\n  height: 24px;\r\n  border-radius: 50%;\r\n  background: #eef4ff;\r\n  color: #2458a8;\r\n  font-size: 12px;\r\n}\r\n\r\n.therapy-form .form-group {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  min-width: 0;\r\n  margin: 0;\r\n}\r\n\r\n.therapy-form label,\r\n.therapy-form__field-label {\r\n  color: var(--text-primary, #344054);\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  letter-spacing: 0;\r\n  text-transform: none;\r\n}\r\n\r\n.therapy-form .form-input,\r\n.therapy-form .form-select,\r\n.therapy-form .campo-farmaco__input {\r\n  width: 100%;\r\n  min-width: 0;\r\n  min-height: 44px;\r\n  box-sizing: border-box;\r\n}\r\n\r\n.therapy-form textarea {\r\n  resize: vertical;\r\n}\r\n.therapy-form__error {\r\n  color: var(--red);\r\n  font-size: 13px;\r\n  margin: 5px 0 0;\r\n}\r\n\r\n.therapy-correction-link {\r\n  background: none;\r\n  border: 0;\r\n  color: var(--blue);\r\n  cursor: pointer;\r\n  font: inherit;\r\n  padding: 4px 0;\r\n  text-align: left;\r\n  text-decoration: underline;\r\n  text-underline-offset: 3px;\r\n}\r\n\r\n.therapy-correction-link:focus-visible {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 3px;\r\n}\r\n\r\n.therapy-form [aria-invalid='true'] {\r\n  border-color: var(--red);\r\n}\r\n\r\n.therapy-form__optional {\r\n  font-weight: 400;\r\n  color: var(--text-muted, #64748b);\r\n}\r\n.therapy-form__grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  gap: 12px;\r\n}\r\n.therapy-form__strength {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) 88px;\r\n  gap: 6px;\r\n}\r\n.therapy-form__types {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  gap: 8px;\r\n}\r\n\r\n.therapy-form label.therapy-form__type {\r\n  display: flex;\r\n  gap: 9px;\r\n  align-items: center;\r\n  padding: 10px;\r\n  min-height: 58px;\r\n  border: 1px solid var(--border, #dce3ec);\r\n  border-radius: 8px;\r\n  cursor: pointer;\r\n  background: #fff;\r\n}\r\n\r\n.therapy-form__type input {\r\n  accent-color: #2563b8;\r\n  margin: 0;\r\n  flex: 0 0 auto;\r\n}\r\n.therapy-form__type strong {\r\n  display: block;\r\n  font-size: 13px;\r\n  font-weight: 650;\r\n}\r\n.therapy-form__type small {\r\n  display: block;\r\n  margin-top: 3px;\r\n  font-size: 11px;\r\n  font-weight: 400;\r\n  color: #526278;\r\n}\r\n.therapy-form label.therapy-form__type.is-selected {\r\n  background: #eff6ff;\r\n  border-color: #6095d9;\r\n}\r\n.therapy-form__type:focus-within {\r\n  outline: 2px solid #2563b8;\r\n  outline-offset: 2px;\r\n}\r\n.therapy-form__weekdays {\r\n  display: flex;\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n  gap: 10px;\r\n}\r\n.therapy-form .weekday-toggle {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px;\r\n}\r\n.therapy-form .weekday-toggle button {\r\n  min-width: 44px;\r\n  min-height: 44px;\r\n}\r\n\r\n.therapy-form__disclosure {\r\n  border: 1px solid var(--border, #dce3ec);\r\n  border-radius: 8px;\r\n  background: #fafbfd;\r\n  min-width: 0;\r\n}\r\n\r\n.therapy-form__disclosure summary {\r\n  cursor: pointer;\r\n  padding: 12px;\r\n  min-height: 44px;\r\n  box-sizing: border-box;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n}\r\n\r\n.therapy-form__disclosure summary > span {\r\n  margin-left: 8px;\r\n  color: #64748b;\r\n  font-size: 12px;\r\n  font-weight: 400;\r\n}\r\n.therapy-form__disclosure-body {\r\n  padding: 0 12px 12px;\r\n}\r\n.therapy-form__disclosure-body .form-hint {\r\n  margin: 0 0 10px;\r\n}\r\n.therapy-form__note-grid {\r\n  display: grid;\r\n  grid-template-columns: minmax(140px, 1fr) minmax(0, 2fr);\r\n  gap: 12px;\r\n}\r\n\r\n.therapy-form .therapy-schedules__row {\r\n  display: grid;\r\n  grid-template-columns: 112px minmax(140px, 1fr) 140px 44px;\r\n  grid-template-areas: 'time quantity unit remove' 'resolved resolved resolved resolved';\r\n  align-items: start;\r\n  gap: 8px 12px;\r\n  padding: 12px;\r\n}\r\n\r\n.therapy-schedules__time {\r\n  grid-area: time;\r\n}\r\n.therapy-schedules__quantity {\r\n  grid-area: quantity;\r\n}\r\n.therapy-schedules__unit {\r\n  grid-area: unit;\r\n}\r\n.therapy-form .therapy-schedules__remove {\r\n  grid-area: remove;\r\n  margin-top: 22px;\r\n  width: 44px;\r\n  height: 44px;\r\n  padding: 0;\r\n  display: grid;\r\n  place-items: center;\r\n}\r\n.therapy-form .sched-row__resolved {\r\n  grid-area: resolved;\r\n  margin: 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n.therapy-form .sched-row__qty {\r\n  gap: 6px;\r\n}\r\n.therapy-form .qty-chip__other {\r\n  flex: 1 1 115px;\r\n  width: 115px;\r\n}\r\n.therapy-form .therapy-schedules__add {\r\n  align-self: flex-start;\r\n  min-height: 44px;\r\n}\r\n\r\n.therapy-form__preview {\r\n  padding: 14px 16px;\r\n  background: #f0f6fd;\r\n  border: 1px solid #d7e5f6;\r\n  border-radius: 10px;\r\n  font-size: 13px;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.therapy-form__preview h3 {\r\n  font-size: 12px;\r\n  color: #47658a;\r\n  margin: 0 0 8px;\r\n  font-weight: 600;\r\n}\r\n.therapy-form__preview-heading {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: baseline;\r\n  gap: 6px 14px;\r\n}\r\n.therapy-form__preview-heading > strong {\r\n  font-size: 15px;\r\n}\r\n.therapy-form__preview-heading > span {\r\n  color: #526278;\r\n  font-size: 12px;\r\n}\r\n.therapy-form__preview p {\r\n  margin: 6px 0 0;\r\n}\r\n.therapy-form__preview ul {\r\n  display: flex;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n  margin: 10px 0 0;\r\n  padding: 0;\r\n  list-style: none;\r\n}\r\n.therapy-form__preview li {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n  background: #fff;\r\n  border: 1px solid #d7e5f6;\r\n  border-radius: 6px;\r\n  padding: 6px 10px;\r\n}\r\n\r\n.therapy-form-shell .form-actions.therapy-form-shell__actions {\r\n  position: sticky;\r\n  bottom: 0;\r\n  z-index: 2;\r\n  margin: 0;\r\n  padding: 12px 0;\r\n  border-top: 1px solid var(--border, #dce3ec);\r\n  background: var(--surface, #fff);\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n/* Let the patient panel own scrolling so the form actions stay within reach. */\r\n.cts:has(.therapy-form-shell),\r\n.cts__body:has(.therapy-form-shell),\r\n.cr-tab-content:has(.therapy-form-shell) {\r\n  overflow: clip;\r\n}\r\n\r\n.therapy-form-shell__actions button {\r\n  min-height: 44px;\r\n}\r\n.therapy-form__sr {\r\n  position: absolute;\r\n  width: 1px;\r\n  height: 1px;\r\n  padding: 0;\r\n  margin: -1px;\r\n  overflow: hidden;\r\n  clip: rect(0, 0, 0, 0);\r\n  white-space: nowrap;\r\n  border: 0;\r\n}\r\n\r\n@container therapy-form (max-width: 650px) {\r\n  .therapy-form__grid {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n  .therapy-form__types {\r\n    grid-template-columns: 1fr;\r\n  }\r\n  .therapy-form__type small {\r\n    display: inline;\r\n    margin-left: 8px;\r\n  }\r\n  .therapy-form label.therapy-form__type {\r\n    min-height: 48px;\r\n  }\r\n  .therapy-form .therapy-schedules__row {\r\n    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 44px;\r\n    grid-template-areas: 'time unit remove' 'quantity quantity quantity' 'resolved resolved resolved';\r\n  }\r\n  .therapy-form__note-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n\r\n@container therapy-form (max-width: 420px) {\r\n  .therapy-form .therapy-schedules__row {\r\n    grid-template-columns: minmax(0, 1fr) 44px;\r\n    grid-template-areas: 'time remove' 'quantity quantity' 'unit unit' 'resolved resolved';\r\n  }\r\n  .therapy-form__section {\r\n    padding: 12px;\r\n  }\r\n  .therapy-form__grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n  .therapy-form__disclosure summary > span {\r\n    display: block;\r\n    margin: 4px 0 0 16px;\r\n  }\r\n  .therapy-form .campo-farmaco__scelto {\r\n    flex-wrap: wrap;\r\n  }\r\n  .therapy-form .form-input,\r\n  .therapy-form .form-select,\r\n  .therapy-form .campo-farmaco__input {\r\n    font-size: 16px;\r\n  }\r\n}\r\n\r\n@media (max-width: 600px) {\r\n  .therapy-form-shell .form-actions .form-hint {\r\n    flex-basis: 100%;\r\n  }\r\n}\r\n\r\n/* Prescrittori proposti: un tocco compila il campo (ingresso). */\r\n.therapy-form__chips {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n  margin-top: 8px;\r\n}\r\n"],["STYLE",{},"/* Diario terapia: riga della terapia aperta da \"apri\" nella voce del diario, evidenziata per\r\n   qualche secondo. Solo lo sfondo della riga: nessun controllo cambia aspetto. */\r\n.clinicos-table tr.therapy-list-row--focus > td,\r\ntr.therapy-list-row--focus > td {\r\n  background: var(--ds-blue-tint, #eaf1fe);\r\n  box-shadow:\r\n    inset 0 2px 0 var(--blue, #2f6bed),\r\n    inset 0 -2px 0 var(--blue, #2f6bed);\r\n  transition: background-color 0.3s;\r\n}\r\n@media (prefers-reduced-motion: reduce) {\r\n  tr.therapy-list-row--focus > td {\r\n    transition: none;\r\n  }\r\n}\r\n"],["STYLE",{},"/* UX ciclo 2 — W5: viste della Terapia del paziente (Calendario con elenco compatto dei farmaci,\r\n   Storico, Nuova terapia). Solo token del design system; pulsanti e chip sono ds-btn / ds-chip. */\r\n\r\n.tf-error {\r\n  margin: 12px 16px 0;\r\n}\r\n.tf-calendar-view {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  min-width: 0;\r\n}\r\n.tf-calendar-view > .patient-therapy-calendar {\r\n  padding: 0;\r\n}\r\n.tf-programming-toggle {\r\n  display: flex;\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n  width: 100%;\r\n  min-height: 48px;\r\n  padding: 10px 12px;\r\n  border: 1px solid var(--ds-border, #e1e7f0);\r\n  border-radius: var(--ds-radius, 12px);\r\n  background: var(--ds-surface, #fff);\r\n  color: var(--ds-text, #16202e);\r\n  font: inherit;\r\n  text-align: left;\r\n  cursor: pointer;\r\n}\r\n.tf-programming-toggle:focus-visible {\r\n  outline: var(--ds-focus, 3px solid #245bb5);\r\n  outline-offset: 2px;\r\n}\r\n.tf-programming-toggle > span:last-child {\r\n  color: var(--ds-text-muted, #5a6b80);\r\n  font-size: 13px;\r\n}\r\n#therapy-programming-panel:not([hidden]) { margin-top: 8px; }\r\n.tf-pager__error {\r\n  flex-basis: 100%;\r\n  margin: 0;\r\n  color: var(--ds-danger, #b42335);\r\n}\r\n\r\n/* ── Farmaci attivi: una riga per farmaco ─────────────────────────────────── */\r\n.tf-active__title {\r\n  margin: 4px 0 8px;\r\n  font-size: 16px;\r\n  font-weight: 650;\r\n}\r\n.tf-active__title span {\r\n  color: var(--ds-text-muted, #5a6b80);\r\n  font-weight: 500;\r\n}\r\n.tf-drugs {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  border: var(--ds-border-w, 2px) solid var(--ds-border, #e1e7f0);\r\n  border-radius: var(--ds-radius, 12px);\r\n  overflow: hidden;\r\n}\r\n.tf-drugs__item + .tf-drugs__item {\r\n  border-top: 1px solid var(--ds-border, #e1e7f0);\r\n}\r\n.tf-drugs__item.is-open,\r\n.tf-drugs__item.is-focus {\r\n  background: var(--ds-blue-tint, #eaf1fe);\r\n}\r\n.tf-drugs__item.is-focus {\r\n  box-shadow: inset 4px 0 0 var(--ds-blue, #2f6bed);\r\n}\r\n.tf-drugs__line {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 4px 10px;\r\n  width: 100%;\r\n  min-height: 56px;\r\n  padding: 8px 14px;\r\n  border: 0;\r\n  background: transparent;\r\n  color: var(--ds-text, #16202e);\r\n  font: inherit;\r\n  text-align: left;\r\n  cursor: pointer;\r\n}\r\n.tf-drugs__line:focus-visible {\r\n  outline: var(--ds-focus, 3px solid #245bb5);\r\n  outline-offset: -3px;\r\n}\r\n.tf-drugs__name {\r\n  font-size: 15px;\r\n  font-weight: 650;\r\n}\r\n.tf-drugs__meta {\r\n  flex: 1 1 260px;\r\n  min-width: 0;\r\n  color: var(--ds-text-muted, #5a6b80);\r\n  font-size: 13px;\r\n  overflow-wrap: anywhere;\r\n}\r\n.tf-drugs__empty {\r\n  margin: 4px 0;\r\n  color: var(--ds-text-muted, #5a6b80);\r\n  font-size: 14px;\r\n}\r\n\r\n/* ── Prescrizione (dettaglio del farmaco) ─────────────────────────────────── */\r\n.tf-detail {\r\n  padding: 4px 14px 14px;\r\n}\r\n.tf-detail__grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));\r\n  gap: 8px 16px;\r\n  margin: 0;\r\n}\r\n.tf-detail__row {\r\n  min-width: 0;\r\n}\r\n.tf-detail__row dt {\r\n  color: var(--ds-text-muted, #5a6b80);\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n}\r\n.tf-detail__row dd {\r\n  margin: 2px 0 0;\r\n  font-size: 14px;\r\n  overflow-wrap: anywhere;\r\n}\r\n.tf-detail__schedule {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n.tf-detail__actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n  margin-top: 12px;\r\n}\r\n.tf-farmaco {\r\n  display: inline-flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 6px;\r\n}\r\n.tf-pager {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 8px;\r\n  margin-top: 10px;\r\n  color: var(--ds-text-muted, #5a6b80);\r\n  font-size: 13px;\r\n}\r\n\r\n/* ── Storico ──────────────────────────────────────────────────────────────── */\r\n.tf-history {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  min-width: 0;\r\n}\r\n.tf-history__filters {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: flex-end;\r\n  gap: 12px 20px;\r\n}\r\n.tf-history__filter {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  min-width: 0;\r\n}\r\n.tf-chips {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n.tf-history__drug .form-input {\r\n  min-width: 220px;\r\n  min-height: 48px;\r\n}\r\n.tf-history__note,\r\n.tf-history__count,\r\n.tf-history__more {\r\n  margin: 0;\r\n  color: var(--ds-text-muted, #5a6b80);\r\n  font-size: 13px;\r\n}\r\n.tf-history__more {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n.tf-history__days {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 14px;\r\n}\r\n.tf-history__day h4 {\r\n  margin: 0 0 6px;\r\n  font-size: 14px;\r\n  font-weight: 650;\r\n  text-transform: capitalize;\r\n}\r\n.tf-history__day ul {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  border: var(--ds-border-w, 2px) solid var(--ds-border, #e1e7f0);\r\n  border-radius: var(--ds-radius, 12px);\r\n  overflow: hidden;\r\n}\r\n.tf-history__row {\r\n  display: grid;\r\n  grid-template-columns: 56px minmax(0, 1fr) minmax(0, 1.2fr);\r\n  gap: 4px 12px;\r\n  align-items: start;\r\n  padding: 10px 14px;\r\n  font-size: 14px;\r\n}\r\n.tf-history__row + .tf-history