e-glow);\r\n  border-radius: 8px;\r\n}\r\n\r\n.table-filters__icon svg {\r\n  width: 17px;\r\n  height: 17px;\r\n}\r\n\r\n.table-filters__toggle-copy {\r\n  min-width: 0;\r\n  display: grid;\r\n  gap: 1px;\r\n}\r\n\r\n.table-filters__title {\r\n  color: var(--text);\r\n  font-size: 12px;\r\n  font-weight: 750;\r\n}\r\n\r\n.table-filters__hint {\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  font-weight: 500;\r\n}\r\n\r\n.table-filters__active-badge {\r\n  min-width: 22px;\r\n  height: 22px;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 0 6px;\r\n  color: #fff;\r\n  background: var(--blue);\r\n  border-radius: 999px;\r\n  font-size: 11px;\r\n  font-weight: 750;\r\n}\r\n\r\n.table-filters__chevron {\r\n  width: 16px;\r\n  height: 16px;\r\n  display: inline-flex;\r\n  color: var(--text-muted);\r\n  transition: transform 0.16s ease;\r\n}\r\n\r\n.table-filters__chevron svg {\r\n  width: 16px;\r\n  height: 16px;\r\n}\r\n\r\n.table-filters.is-open .table-filters__chevron {\r\n  transform: rotate(180deg);\r\n}\r\n\r\n.table-filters__summary {\r\n  flex-shrink: 0;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n}\r\n\r\n.table-filters__results {\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  white-space: nowrap;\r\n}\r\n\r\n.table-filters__clear {\r\n  min-height: var(--touch-target);\r\n  padding: 6px 10px;\r\n  color: var(--blue);\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  font: inherit;\r\n  font-size: 11px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n}\r\n\r\n.table-filters__clear:hover {\r\n  border-color: var(--blue);\r\n  background: var(--blue-glow);\r\n}\r\n\r\n.table-filters__panel {\r\n  padding: 14px;\r\n  background: var(--surface);\r\n  border-top: 1px solid var(--divider);\r\n}\r\n\r\n.table-filters__grid {\r\n  display: grid;\r\n  gap: 12px;\r\n}\r\n\r\n.table-filters__grid--1 {\r\n  grid-template-columns: minmax(0, 1fr);\r\n}\r\n\r\n.table-filters__grid--2 {\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n}\r\n\r\n.table-filters__grid--3 {\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n}\r\n\r\n.table-filters__grid--4 {\r\n  grid-template-columns: repeat(4, minmax(0, 1fr));\r\n}\r\n\r\n.table-filters__field {\r\n  min-width: 0;\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n\r\n.table-filters__field label {\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  font-weight: 750;\r\n  letter-spacing: 0.45px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.table-filters__field :is(input, select) {\r\n  width: 100%;\r\n  min-width: 0;\r\n  min-height: var(--touch-target);\r\n  padding: 0 11px;\r\n  color: var(--text);\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  font: inherit;\r\n  font-size: var(--ds-field-font);\r\n}\r\n\r\n.table-filters__field :is(input, select):hover {\r\n  border-color: var(--text-xmuted);\r\n}\r\n\r\n.table-filters__field :is(input, select):focus {\r\n  border-color: var(--blue);\r\n  box-shadow: var(--shadow-focus);\r\n}\r\n\r\n.table-filters__field input::placeholder {\r\n  color: var(--text-xmuted);\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .table-filters__grid--3,\r\n  .table-filters__grid--4 {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  .table-filters__toolbar {\r\n    align-items: stretch;\r\n    flex-direction: column;\r\n    gap: 4px;\r\n    padding: 8px 10px;\r\n  }\r\n\r\n  .table-filters__toggle {\r\n    width: 100%;\r\n  }\r\n\r\n  .table-filters__summary {\r\n    min-height: 36px;\r\n    justify-content: space-between;\r\n    padding: 0 8px;\r\n  }\r\n\r\n  .table-filters__panel {\r\n    padding: 12px 10px;\r\n  }\r\n\r\n  .table-filters__grid--1,\r\n  .table-filters__grid--2,\r\n  .table-filters__grid--3,\r\n  .table-filters__grid--4 {\r\n    grid-template-columns: 1fr;\r\n    gap: 10px;\r\n  }\r\n}\r\n"],["STYLE",{},".op-management .operator-editor {\r\n  padding: 0;\r\n  overflow: hidden;\r\n  border-radius: 8px;\r\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);\r\n}\r\n\r\n.op-management .operator-editor__header {\r\n  min-height: 64px;\r\n  margin: 0;\r\n  padding: 12px 16px;\r\n  align-items: flex-start;\r\n  background: var(--surface-raised);\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.operator-editor__heading {\r\n  min-width: 0;\r\n}\r\n\r\n.operator-editor__eyebrow,\r\n.operator-editor__section > legend,\r\n.operator-editor__color-field > legend {\r\n  color: var(--text-xmuted);\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  letter-spacing: 0.65px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.operator-editor__eyebrow {\r\n  display: block;\r\n  margin-bottom: 2px;\r\n}\r\n\r\n.op-management .operator-editor .op-form-panel__title {\r\n  font-size: 16px;\r\n  line-height: 1.25;\r\n}\r\n\r\n.operator-editor__intro {\r\n  margin: 3px 0 0;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.operator-editor__close {\r\n  flex-shrink: 0;\r\n}\r\n\r\n.operator-editor__body {\r\n  padding: 0 16px;\r\n}\r\n\r\n.operator-editor__section {\r\n  min-width: 0;\r\n  margin: 0;\r\n  padding: 13px 0 15px;\r\n  border: 0;\r\n  border-bottom: 1px solid var(--divider);\r\n}\r\n\r\n.operator-editor__section > legend {\r\n  width: 100%;\r\n  margin: 0;\r\n  padding: 0 0 9px;\r\n}\r\n\r\n.operator-editor__grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(6, minmax(0, 1fr));\r\n  gap: 12px;\r\n}\r\n\r\n.operator-editor__field--span-2 {\r\n  grid-column: span 2;\r\n}\r\n\r\n.operator-editor__field--span-3 {\r\n  grid-column: span 3;\r\n}\r\n\r\n.operator-editor .form-field,\r\n.operator-editor .form-input,\r\n.operator-editor .form-select {\r\n  min-width: 0;\r\n}\r\n\r\n.operator-editor .form-input,\r\n.operator-editor .form-select {\r\n  width: 100%;\r\n}\r\n\r\n.operator-editor__optional {\r\n  margin: 0;\r\n  border-bottom: 0;\r\n}\r\n\r\n.operator-editor__optional > summary {\r\n  min-height: 46px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  padding: 0;\r\n  color: var(--text);\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n  list-style-position: inside;\r\n}\r\n\r\n.operator-editor__optional > summary:hover {\r\n  color: var(--blue);\r\n}\r\n\r\n.operator-editor__optional-title {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.operator-editor__selected-color {\r\n  width: 10px;\r\n  height: 10px;\r\n  flex-shrink: 0;\r\n  border-radius: 50%;\r\n  box-shadow: 0 0 0 1px var(--border);\r\n}\r\n\r\n.operator-editor__optional-badge {\r\n  margin-left: auto;\r\n  padding: 2px 8px;\r\n  border-radius: 999px;\r\n  color: var(--text-muted);\r\n  background: var(--surface-raised);\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.3px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.operator-editor__optional-content {\r\n  display: grid;\r\n  grid-template-columns: minmax(260px, 1fr) minmax(0, 2fr);\r\n  gap: 16px;\r\n  padding: 4px 0 15px;\r\n}\r\n\r\n.operator-editor__color-field {\r\n  min-width: 0;\r\n  margin: 0;\r\n  padding: 0;\r\n  border: 0;\r\n}\r\n\r\n.operator-editor__color-field > legend {\r\n  margin-bottom: 7px;\r\n}\r\n\r\n.operator-editor__color-picker {\r\n  display: flex;\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n  gap: 6px;\r\n}\r\n\r\n.operator-editor__color-swatch {\r\n  width: 40px;\r\n  height: 40px;\r\n  padding: 0;\r\n  border: 8px solid var(--surface);\r\n  border-radius: 50%;\r\n  outline: 1px solid var(--border);\r\n  cursor: pointer;\r\n}\r\n\r\n.operator-editor__color-swatch:hover {\r\n  outline-color: var(--blue);\r\n}\r\n\r\n.operator-editor__color-swatch.is-selected {\r\n  outline: 2px solid var(--text);\r\n  outline-offset: 1px;\r\n}\r\n\r\n.operator-editor__color-swatch:focus-visible,\r\n.operator-editor__custom-color:focus-within {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 2px;\r\n}\r\n\r\n.operator-editor__custom-color {\r\n  min-height: 40px;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 7px;\r\n  padding-left: 4px;\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n}\r\n\r\n.operator-editor__custom-color input {\r\n  width: 40px;\r\n  height: 40px;\r\n  padding: 4px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  background: var(--surface);\r\n  cursor: pointer;\r\n}\r\n\r\n.operator-editor__notes textarea {\r\n  min-height: 72px;\r\n}\r\n\r\n.op-management .operator-editor__actions {\r\n  min-height: 62px;\r\n  align-items: center;\r\n  margin: 0;\r\n  padding: 9px 16px;\r\n  background: var(--surface-raised);\r\n  border-top: 1px solid var(--border);\r\n}\r\n\r\n.operator-editor__required-note {\r\n  margin-right: auto;\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n}\r\n\r\n.operator-editor__required-note > span {\r\n  color: var(--red);\r\n  font-weight: 700;\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .op-management .cts .clinicos-table-wrap {\r\n    display: none;\r\n  }\r\n\r\n  .operator-editor__grid {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n\r\n  .operator-editor__field--span-2,\r\n  .operator-editor__field--span-3 {\r\n    grid-column: span 1;\r\n  }\r\n\r\n  .operator-editor__optional-content {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n\r\n@media (max-width: 520px) {\r\n  .op-management .operator-editor__header {\r\n    padding: 12px;\r\n  }\r\n\r\n  .operator-editor__intro {\r\n    max-width: 30ch;\r\n  }\r\n\r\n  .operator-editor__body {\r\n    padding: 0 12px;\r\n  }\r\n\r\n  .operator-editor__grid {\r\n    grid-template-columns: 1fr;\r\n    gap: 10px;\r\n  }\r\n\r\n  .op-management .operator-editor__actions {\r\n    flex-wrap: wrap;\r\n    padding: 10px 12px;\r\n  }\r\n\r\n  .operator-editor__required-note {\r\n    width: 100%;\r\n  }\r\n\r\n  .operator-editor__actions .btn-secondary,\r\n  .operator-editor__actions .btn-success {\r\n    flex: 1;\r\n    justify-content: center;\r\n  }\r\n}\r\n"]],[[6,30]],["BODY",{},[[6,31]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},[[1,77]],["DIV",{"class":"main-area-clean"},["DIV",{"class":"compact-topbar"},[[1,82]],["DIV",{"class":"topbar-title"},["DIV",{"class":"page-header__titles"},["H1",{"class":"page-header__title"},[[1,83]]],[[1,86]]]],[[1,94]],[[1,110]]],["MAIN",{"class":"page-content content-panel"},[[1,114]],["DIV",{"class":"operator-dashboard turno"},["SECTION",{"class":"dashboard-kpi-band dashboard-kpi-band--5","aria-label":"Quadro clinico operativo","aria-busy":"false"},[[1,129]],[[1,144]],[[1,161]],[[1,177]],["BUTTON",{"type":"button","class":"dashboard-kpi-card dashboard-kpi-card--positive","data-kpi-id":"somministrazioni","aria-label":"Terapie in ritardo: 0 su 0 da fare. su 0 da fare. Apri terapia"},[[1,186]],["SPAN",{"class":"dashboard-kpi-card__value"},"0"],[[1,190]],["SPAN",{"class":"dashboard-kpi-card__status"},["svg",{"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2.5","stroke-linecap":"round","stroke-linejoin":"round"},["polyline",{"points":"20,6 9,17 4,12"}]],"su 0 da fare"],[[1,195]]]],[[1,199]],["DIV",{"class":"turno-grid"},["SECTION",{"class":"adesso-queue turno-card","aria-labelledby":"_r_1_"},["DIV",{"class":"turno-card__head"},[[1,202]],["BUTTON",{"type":"button","class":"dashboard-notification-compact dashboard-notification-compact--clear","aria-haspopup":"dialog","aria-label":"Segnalazioni operative: 0 allarmi, 0 attenzioni, 0 avvisi. Apri dettaglio"},[[1,206]],["SPAN",{},"Nessuna segnalazione"],["STRONG",{},"0"]],[[1,212]],[[1,214]]],["DIV",{"id":"widget-_r_2_"},["P",{"class":"adesso-queue__empty","role":"status"},"Niente in sospeso adesso."],["P",{"class":"adesso-queue__foot"},[[1,220]],["BUTTON",{"type":"button","class":"ds-lin