{"type":"before","callId":"call@13140","startTime":61917.265,"class":"Route","method":"fulfill","params":{"status":200,"headers":[{"name":"content-type","value":"application/json"},{"name":"content-length","value":"852"}],"body":"{\"readings\":[{\"id\":\"QA-minutes\",\"patientId\":\"QA-418-INDEPENDENT\",\"requestId\":\"QA-minutes\",\"measuredAt\":\"2026-02-30T10:00:00Z\",\"values\":{\"fr\":\"19\"},\"createdAt\":\"2026-10-25T00:59:00Z\",\"authorOperatorId\":\"QA-418-NURSE\",\"authorName\":\"Infermiere QA418\"},{\"id\":\"QA-days\",\"patientId\":\"QA-418-INDEPENDENT\",\"requestId\":\"QA-days\",\"measuredAt\":\"2026-10-26T01:05:00Z\",\"values\":{\"spo2\":\"95\",\"o2\":\"no\"},\"createdAt\":\"2026-10-21T01:05:00Z\",\"authorOperatorId\":\"QA-418-NURSE\",\"authorName\":\"Infermiere QA418\"},{\"id\":\"QA-weeks\",\"patientId\":\"QA-418-INDEPENDENT\",\"requestId\":\"QA-weeks\",\"measuredAt\":\"2026-10-04T03:05:00\",\"values\":{\"fr\":\"15\",\"spo2\":\"98\",\"o2\":\"no\",\"pa\":\"124/76\",\"fc\":\"74\",\"temperatura\":\"36,6\",\"coscienza\":\"A\",\"dtx\":\"104\"},\"createdAt\":\"2026-10-04T01:05:00Z\",\"authorOperatorId\":\"QA-418-NURSE\",\"authorName\":\"Infermiere QA418\"}],\"hasMore\":false,\"nextCursor\":null}","isBase64":false},"stepId":"pw:api@383","pageId":"page@d3f21ac7fa89704ffe7ffa7eac19de63"}
