{"type":"frame-snapshot","snapshot":{"callId":"call@13152","snapshotName":"before@call@13152","pageId":"page@d3f21ac7fa89704ffe7ffa7eac19de63","frameId":"frame@27c39c0b436611405efd7bc73fde5928","frameUrl":"http://127.0.0.1:7483/#/parametri-multipaziente","doctype":"html","html":["HTML",{"lang":"it"},["HEAD",{},[[17,0]],[[17,1]],[[17,2]],[[17,3]],[[17,4]],[[17,5]],[[17,6]],[[17,7]],[[17,8]],[[17,9]],[[17,10]],[[17,11]],[[17,12]],[[17,13]],[[17,15]],[[17,16]],[[17,18]],[[17,20]],[[17,22]],[[17,24]],[[17,26]],[[17,28]],[[14,1]],[[14,3]],[[14,5]],[[14,7]],[[14,9]],[[14,11]],[[14,13]],[[14,15]],[[14,17]],[[14,19]],[[14,21]],[[14,23]],[[14,25]],[[14,27]],[[14,29]],[[12,1]],[[12,3]],[[12,5]],[[12,7]],[[12,9]],[[12,11]],[[12,13]],[[12,15]],[[12,17]],[[12,19]],[[12,21]],[[12,23]],[[12,25]],[[12,27]],[[12,29]],[[12,31]],[[12,33]],[[12,35]],[[12,37]],[[12,39]],[[5,1]],[[5,3]],[[5,5]],[[5,7]],[[5,9]],[[5,11]],[[5,13]],[[5,15]],[[5,17]],[[5,19]],["STYLE",{},".notes-page .note-editor {\r\n  max-width: 1040px;\r\n  margin: 0 auto 20px;\r\n  padding: 0;\r\n  overflow: visible;\r\n  border-radius: 9px;\r\n  box-shadow: 0 1px 4px rgba(20, 39, 72, 0.08);\r\n}\r\n\r\n.note-editor__header {\r\n  min-height: 68px;\r\n  margin: 0;\r\n  padding: 13px 16px;\r\n  align-items: flex-start;\r\n  border-bottom: 1px solid var(--border);\r\n  border-radius: 9px 9px 0 0;\r\n  background: var(--surface-raised);\r\n}\r\n\r\n.note-editor__eyebrow,\r\n.note-editor__section > legend {\r\n  color: var(--text-xmuted);\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  letter-spacing: 0.65px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.note-editor__eyebrow {\r\n  display: block;\r\n  margin-bottom: 2px;\r\n}\r\n\r\n.note-editor__intro {\r\n  max-width: 70ch;\r\n  margin: 3px 0 0;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.note-editor__body {\r\n  padding: 0 16px;\r\n}\r\n\r\n.note-editor__section {\r\n  min-width: 0;\r\n  margin: 0;\r\n  padding: 14px 0 16px;\r\n  border: 0;\r\n  border-bottom: 1px solid var(--divider);\r\n}\r\n\r\n.note-editor__section--last {\r\n  border-bottom: 0;\r\n}\r\n\r\n.note-editor__section > legend {\r\n  width: 100%;\r\n  padding: 0 0 9px;\r\n}\r\n\r\n.note-editor__grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(12, minmax(0, 1fr));\r\n  gap: 12px;\r\n  align-items: start;\r\n}\r\n\r\n.note-editor__field--recipient {\r\n  grid-column: span 5;\r\n}\r\n\r\n.note-editor__field--patient {\r\n  grid-column: span 7;\r\n  min-width: 0;\r\n}\r\n\r\n.note-editor__field--priority {\r\n  grid-column: span 3;\r\n}\r\n\r\n.note-editor__field--message {\r\n  grid-column: span 9;\r\n}\r\n\r\n.note-editor .form-field,\r\n.note-editor .form-input,\r\n.note-editor .form-select {\r\n  min-width: 0;\r\n}\r\n\r\n.note-editor .form-input,\r\n.note-editor .form-select {\r\n  width: 100%;\r\n}\r\n\r\n.note-editor__helper {\r\n  display: block;\r\n  margin-top: 5px;\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  line-height: 1.35;\r\n}\r\n\r\n.note-editor__message {\r\n  min-height: 86px;\r\n  resize: vertical;\r\n}\r\n\r\n.note-editor__counter {\r\n  display: block;\r\n  margin-top: 4px;\r\n  color: var(--text-xmuted);\r\n  font-size: 10.5px;\r\n  text-align: right;\r\n}\r\n\r\n.note-editor__actions {\r\n  min-height: 62px;\r\n  align-items: center;\r\n  margin: 0;\r\n  padding: 9px 16px;\r\n  border-top: 1px solid var(--border);\r\n  border-radius: 0 0 9px 9px;\r\n  background: var(--surface-raised);\r\n}\r\n\r\n.note-editor__required-note,\r\n.note-editor__error {\r\n  margin: 0 auto 0 0;\r\n  font-size: 11px;\r\n}\r\n\r\n.note-editor__required-note {\r\n  color: var(--text-muted);\r\n}\r\n\r\n.note-editor__required-note > span {\r\n  color: var(--red);\r\n  font-weight: 700;\r\n}\r\n\r\n.note-editor__error {\r\n  color: var(--red);\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .note-editor__grid {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n\r\n  .note-editor__field--recipient,\r\n  .note-editor__field--priority {\r\n    grid-column: span 1;\r\n  }\r\n\r\n  .note-editor__field--patient,\r\n  .note-editor__field--message {\r\n    grid-column: 1 / -1;\r\n  }\r\n}\r\n\r\n@media (max-width: 639px) {\r\n  .note-editor__header,\r\n  .note-editor__body,\r\n  .note-editor__actions {\r\n    padding-right: 12px;\r\n    padding-left: 12px;\r\n  }\r\n\r\n  .note-editor__intro {\r\n    max-width: 34ch;\r\n  }\r\n\r\n  .note-editor__grid {\r\n    grid-template-columns: minmax(0, 1fr);\r\n    gap: 10px;\r\n  }\r\n\r\n  .note-editor__field--recipient,\r\n  .note-editor__field--patient,\r\n  .note-editor__field--priority,\r\n  .note-editor__field--message {\r\n    grid-column: 1;\r\n  }\r\n\r\n  .note-editor__actions {\r\n    flex-wrap: wrap;\r\n  }\r\n\r\n  .note-editor__required-note,\r\n  .note-editor__error {\r\n    width: 100%;\r\n  }\r\n\r\n  .note-editor__actions .btn-secondary,\r\n  .note-editor__actions .btn-success {\r\n    min-height: 44px;\r\n    flex: 1;\r\n    justify-content: center;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Note e messaggi — HMI 1 (artifacts/hmi-parity/proto/note.png). */\r\n.notes-page--hmi .nm-card {\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 16px;\r\n  padding: 24px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.nm-card__head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  flex-wrap: wrap;\r\n}\r\n.nm-card__title {\r\n  margin: 0;\r\n  font: 600 20px/28px var(--font-ui);\r\n  color: var(--text);\r\n}\r\n\r\n.nm-tools {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px 16px;\r\n}\r\n.nm-search {\r\n  flex: 1 1 280px;\r\n  min-width: 0;\r\n}\r\n.nm-search .search-input {\r\n  height: 48px;\r\n}\r\n\r\n.nm-list {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  border-top: 1px solid var(--border);\r\n}\r\n.nm-row {\r\n  display: grid;\r\n  grid-template-columns: 48px minmax(0, 1fr) auto;\r\n  gap: 16px;\r\n  align-items: start;\r\n  padding: 16px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n.nm-row--done {\r\n  background: #f5f7fb;\r\n}\r\n.nm-avatar {\r\n  width: 48px;\r\n  height: 48px;\r\n  border-radius: 50%;\r\n  background: #eaf1fe;\r\n  color: #1d4fc4;\r\n  display: grid;\r\n  place-items: center;\r\n  font: 600 16px/24px var(--font-ui);\r\n}\r\n.nm-row__body {\r\n  min-width: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n}\r\n.nm-row__meta {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 4px 8px;\r\n  min-width: 0;\r\n}\r\n.nm-dot {\r\n  width: 8px;\r\n  height: 8px;\r\n  border-radius: 50%;\r\n  background: var(--blue);\r\n  flex: none;\r\n}\r\n.nm-author {\r\n  font: 600 16px/24px var(--font-ui);\r\n  color: var(--text);\r\n  overflow-wrap: anywhere;\r\n}\r\n.nm-dest {\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n}\r\n.nm-prio {\r\n  font: 600 13px/18px var(--font-ui);\r\n  padding: 2px 8px;\r\n  border-radius: 6px;\r\n}\r\n/* Urgenza: il rosso resta riservato agli allarmi clinici e ai conteggi. */\r\n.nm-prio--urgente {\r\n  background: #fdecee;\r\n  color: #b3261e;\r\n}\r\n.nm-prio--alta {\r\n  background: var(--amber-bg);\r\n  color: #8a5300;\r\n}\r\n.nm-state {\r\n  font: 600 13px/18px var(--font-ui);\r\n  padding: 2px 8px;\r\n  border-radius: 6px;\r\n  background: #e6f6ef;\r\n  color: #0e7a55;\r\n}\r\n.nm-sr {\r\n  position: absolute;\r\n  width: 1px;\r\n  height: 1px;\r\n  overflow: hidden;\r\n  clip: rect(0 0 0 0);\r\n  white-space: nowrap;\r\n}\r\n.nm-message {\r\n  font: 400 16px/24px var(--font-ui);\r\n  color: var(--text);\r\n  min-width: 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n.nm-row__side {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-end;\r\n  gap: 8px;\r\n}\r\n.nm-time {\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n  white-space: nowrap;\r\n}\r\n.nm-actions {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n}\r\n\r\n.nm-empty {\r\n  padding: 32px 16px;\r\n  text-align: center;\r\n  color: var(--text-muted);\r\n}\r\n.nm-more {\r\n  display: flex;\r\n  justify-content: center;\r\n}\r\n@media (max-width: 600px) {\r\n  .notes-page--hmi .nm-card {\r\n    padding: 16px;\r\n  }\r\n  .nm-row {\r\n    grid-template-columns: 40px minmax(0, 1fr);\r\n    padding: 12px 0;\r\n  }\r\n  .nm-avatar {\r\n    width: 40px;\r\n    height: 40px;\r\n  }\r\n  .nm-row__side {\r\n    grid-column: 2;\r\n    flex-direction: row;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n  }\r\n}\r\n"]],[[17,30]],["BODY",{},[[17,31]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},[[6,2]],["DIV",{"class":"main-area-clean"},[[5,27]],["MAIN",{"class":"page-content content-panel"},["DIV",{"class":"par-view"},["DIV",{"class":"par-grid"},[[3,6]],["SECTION",{"class":"par-form","aria-label":"Rilevazione di Sintetico QA, Caso"},[[5,63]],["FORM",{"class":"parameter-reading-form","aria-label":"Nuova rilevazione"},[[5,216]]]]],[[5,223]]]]]]],[[17,65]],[[17,66]]]],"viewport":{"width":1150,"height":1004},"timestamp":61966.736,"wallTime":1792890302063,"collectionTime":2,"resourceOverrides":[],"isMainFrame":true}}
