t: 750;\r\n}\r\n.therapy-modal .therapy-drug-row {\r\n  padding-block: 12px;\r\n  flex-wrap: wrap;\r\n}\r\n.therapy-modal .therapy-drug-row__info {\r\n  min-width: 0;\r\n  flex-basis: 180px;\r\n  overflow-wrap: anywhere;\r\n}\r\n.therapy-modal .therapy-drug-row__actions {\r\n  flex-wrap: wrap;\r\n  min-width: 0;\r\n  max-width: 100%;\r\n}\r\n.therapy-modal button,\r\n.therapy-modal input {\r\n  min-height: 44px;\r\n}\r\n.therapy-modal button {\r\n  white-space: normal;\r\n  overflow-wrap: anywhere;\r\n}\r\n.therapy-modal button:focus-visible,\r\n.therapy-modal input:focus-visible {\r\n  outline: 2px solid var(--blue, #2463eb);\r\n  outline-offset: 3px;\r\n}\r\n.therapy-modal .therapy-modal__footer,\r\n.therapy-modal .therapy-modal__footer > div {\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n@media (max-width: 520px) {\r\n  .therapy-modal .therapy-modal__body {\r\n    padding: 0 8px 8px;\r\n  }\r\n  .therapy-modal .therapy-patient-header,\r\n  .therapy-modal .therapy-drug-row {\r\n    padding-inline: 12px;\r\n  }\r\n  .therapy-modal .therapy-drug-row__actions {\r\n    width: 100%;\r\n  }\r\n  .therapy-modal .therapy-motivi-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Agenda — informazione senza tocchi (UX direct-access, 2026-10-03). Condiviso da agenda\r\n   operatore e multi-operatore: nota sempre visibile, stato in parole (non solo colore), nome\r\n   dell'operatore accanto al pallino, mese senza «+N» (la cella cresce). Testo che va a capo. */\r\n.agt-note-inline {\r\n  white-space: pre-wrap;\r\n  overflow-wrap: anywhere;\r\n  font-size: 13px;\r\n  line-height: 18px;\r\n}\r\n.agt-inline-apt {\r\n  flex-wrap: wrap;\r\n  align-items: flex-start;\r\n  row-gap: 2px;\r\n  height: auto;\r\n}\r\n.agt-inline-apt .agt-week-apt__name,\r\n.agt-inline-apt .agt-month-apt__name {\r\n  white-space: normal;\r\n  overflow: visible;\r\n  text-overflow: clip;\r\n  overflow-wrap: anywhere;\r\n}\r\n.agt-inline-meta {\r\n  flex-basis: 100%;\r\n  min-width: 0;\r\n  font-size: 11px;\r\n  line-height: 15px;\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n}\r\n.agt-inline-meta strong {\r\n  font-weight: 700;\r\n  color: var(--text);\r\n}\r\n/* Mese: la cella mostra tutti gli appuntamenti e cresce in altezza. */\r\n.agt-month-day {\r\n  height: auto;\r\n}\r\n.agt-month-day__apts {\r\n  overflow: visible;\r\n}\r\n"]],[[5,30]],["BODY",{},[[5,31]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},["NAV",{"class":"teams-sidebar","aria-label":"Navigazione principale"},["DIV",{"class":"teams-sidebar__brand"},["SPAN",{"class":"teams-sidebar__brand-dot","aria-hidden":"true"},["svg",{"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","aria-hidden":"true"},["path",{"d":"M9 3h6v6h6v6h-6v6H9v-6H3V9h6z"}]]]],["DIV",{"class":"teams-sidebar__nav"},["BUTTON",{"type":"button","class":"teams-sidebar__item active","title":"Turno","aria-current":"page"},["SPAN",{"class":"teams-sidebar__item-icon"},["svg",{"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","aria-hidden":"true"},["path",{"d":"M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"}]]],["SPAN",{"class":"teams-sidebar__item-label"},"Turno"]],["BUTTON",{"type":"button","class":"teams-sidebar__item","title":"Pazienti"},["SPAN",{"class":"teams-sidebar__item-icon"},["svg",{"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","aria-hidden":"true"},["path",{"d":"M9 11.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5M16 4.6a3.5 3.5 0 0 1 0 6.8M18 14.8c1.9.7 3.1 2.4 3.5 5.2"}]]],["SPAN",{"class":"teams-sidebar__item-label"},"Pazienti"]],["BUTTON",{"type":"button","class":"teams-sidebar__item","title":"Terapia"},["SPAN",{"class":"teams-sidebar__item-icon"},["svg",{"viewBox":"0 0 24 24","fill":"non