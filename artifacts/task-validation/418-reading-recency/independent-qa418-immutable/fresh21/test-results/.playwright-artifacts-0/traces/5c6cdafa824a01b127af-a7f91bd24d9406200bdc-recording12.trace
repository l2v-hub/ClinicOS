{"type":"frame-snapshot","snapshot":{"callId":"call@12940","snapshotName":"after@call@12940","pageId":"page@d3f21ac7fa89704ffe7ffa7eac19de63","frameId":"frame@27c39c0b436611405efd7bc73fde5928","frameUrl":"http://127.0.0.1:7483/#/operator-dashboard","doctype":"html","html":["HTML",{"lang":"it"},["HEAD",{},[[5,0]],[[5,1]],[[5,2]],[[5,3]],[[5,4]],[[5,5]],[[5,6]],[[5,7]],[[5,8]],[[5,9]],[[5,10]],[[5,11]],[[5,12]],[[5,13]],[[5,15]],[[5,16]],[[5,18]],[[5,20]],[[5,22]],[[5,24]],[[5,26]],[[5,28]],[[2,1]],[[2,3]],[[2,5]],[[2,7]],[[2,9]],[[2,11]],[[2,13]],[[2,15]],[[2,17]],[[2,19]],[[2,21]],[[2,23]],[[2,25]],[[2,27]],[[2,29]],["STYLE",{},".demographics-status {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 0.25rem 0.5rem;\r\n  align-items: baseline;\r\n  margin: 0.75rem 0;\r\n  padding: 0.75rem 1rem;\r\n  border: 1px solid var(--border, #d4dce4);\r\n  border-radius: 0.5rem;\r\n  background: var(--bg-subtle, #f5f7fa);\r\n  font-size: 0.875rem;\r\n}\r\n.demographics-status ul {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 0.25rem 0.75rem;\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n.demographics-status button {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  min-height: 44px;\r\n  min-width: 44px;\r\n  border: 0;\r\n  background: none;\r\n  color: var(--accent, #245a91);\r\n  padding: 0.25rem;\r\n  font: inherit;\r\n  text-decoration: underline;\r\n  cursor: pointer;\r\n}\r\n.demographics-status button:focus-visible {\r\n  outline: 2px solid currentColor;\r\n  outline-offset: 3px;\r\n}\r\n"],["STYLE",{},".clinical-note-editor {\r\n  display: grid;\r\n  gap: 14px;\r\n  margin-top: 16px;\r\n}\r\n.clinical-note-editor label {\r\n  display: grid;\r\n  gap: 6px;\r\n  color: var(--text, #17263b);\r\n  font-size: 0.9rem;\r\n  font-weight: 500;\r\n}\r\n.clinical-note-editor .form-hint {\r\n  margin: 0;\r\n}\r\n.clinical-note-editor textarea:not(#ds) {\r\n  resize: vertical;\r\n  min-height: 160px;\r\n  padding: 12px;\r\n  line-height: 1.6;\r\n  background: #fff;\r\n}\r\n.clinical-note-editor__options {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));\r\n  gap: 14px;\r\n}\r\n.clinical-note-editor__options > div {\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n.clinical-note-editor__content {\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n.clinical-note-editor__options select {\r\n  width: 100%;\r\n  min-width: 0;\r\n}\r\n.diario-history-filters {\r\n  display: flex;\r\n  align-items: end;\r\n  flex-wrap: wrap;\r\n  gap: 10px;\r\n  margin-bottom: 10px;\r\n}\r\n.diario-history-filters label {\r\n  display: grid;\r\n  gap: 4px;\r\n  font-size: 0.85rem;\r\n}\r\n.diario-history-filters input {\r\n  max-width: 170px;\r\n}\r\n.am-support-note {\r\n  margin: 0;\r\n  padding: 8px 20px;\r\n  font-size: 0.8rem;\r\n  background: var(--info-light, #edf3ff);\r\n  color: var(--text-secondary);\r\n}\r\n"],["STYLE",{},".handover-workspace {\r\n  min-width: 0;\r\n}\r\n.handover-workspace :is(button, input, select) {\r\n  min-height: var(--ds-control-h);\r\n}\r\n.handover-workspace :is(button, input, select, textarea, a):focus-visible {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 3px;\r\n}\r\n.handover-rounds__layout {\r\n  display: grid;\r\n  grid-template-columns: 272px minmax(0, 1fr);\r\n  gap: 24px;\r\n  align-items: start;\r\n}\r\n.handover-rounds__list,\r\n.handover-rounds__filters {\r\n  display: grid;\r\n  gap: 12px;\r\n  min-width: 0;\r\n}\r\n.handover-rounds__filters label {\r\n  display: grid;\r\n  gap: 5px;\r\n  min-width: 0;\r\n}\r\n.handover-rounds__filters input {\r\n  width: 100%;\r\n  min-width: 0;\r\n  font-size: 14px;\r\n  background: #fff;\r\n}\r\n.handover-rounds__list > .ds-link {\r\n  justify-self: start;\r\n}\r\n.ho-eyebrow {\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.06em;\r\n  color: var(--text-muted);\r\n  text-transform: uppercase;\r\n}\r\n.ho-label {\r\n  font-size: 13px;\r\n  color: var(--text-secondary);\r\n}\r\n.handover-rounds__roster {\r\n  display: grid;\r\n  gap: 5px;\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 0;\r\n  min-width: 0;\r\n}\r\n.handover-rounds__patient {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) auto;\r\n  align-items: center;\r\n  min-width: 0;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  background: var(--surface, #fff);\r\n  overflow-wrap: anywhere;\r\n}\r\n.handover-rounds__patient.is-selected {\r\n  border-color: var(--blue);\r\n  background: #edf3ff;\r\n  box-shadow: inset 3px 0 var(--blue);\r\n}\r\n.handover-rounds__select {\r\n  display: flex;\r\n  gap: 6px;\r\n  width: 100%;\r\n  min-width: 0;\r\n  text-align: left;\r\n  border: 0;\r\n  border-radius: 8px;\r\n  background: transparent;\r\n  padding: 6px;\r\n  cursor: pointer;\r\n  color: inherit;\r\n}\r\n.ho-bed {\r\n  display: grid;\r\n  place-items: center;\r\n  flex: 0 0 28px;\r\n  height: 28px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 7px;\r\n  background: #f5f8fc;\r\n  font-size: 13px;\r\n}\r\n.ho-who {\r\n  flex: 1;\r\n  min-width: 0;\r\n}\r\n.handover-rounds__patient .patient-identity {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1px;\r\n  min-width: 0;\r\n}\r\n.handover-rounds__patient .patient-identity__name {\r\n  font-size: 13px;\r\n  line-height: 18px;\r\n  white-space: normal;\r\n  overflow-wrap: anywhere;\r\n}\r\n.handover-rounds__patient\r\n  :is(.patient-identity__identifier, .patient-identity__location, .patient-identity__context) {\r\n  font-size: 11px;\r\n  line-height: 1.4;\r\n}\r\n.handover-rounds__patient > .handover-rounds__diary:not(#ds) {\r\n  --ds-icon-size: 16px;\r\n  display: inline-flex;\r\n  justify-content: center;\r\n  margin: 0 8px 0 0;\r\n  padding: 0;\r\n  align-items: center;\r\n  width: 32px;\r\n  min-width: 32px;\r\n  height: 32px;\r\n  min-height: 32px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 7px;\r\n  color: var(--blue);\r\n  background: var(--surface, #fff);\r\n  text-decoration: none;\r\n}\r\n.handover-rounds__diary svg {\r\n  width: 16px;\r\n  height: 16px;\r\n}\r\n@media (pointer: coarse) {\r\n  .handover-rounds__patient > .handover-rounds__diary:not(#ds) {\r\n    width: 40px;\r\n    min-width: 40px;\r\n    height: 40px;\r\n    min-height: 40px;\r\n  }\r\n}\r\n.handover-rounds__badges {\r\n  display: flex;\r\n  gap: 6px;\r\n  flex-wrap: wrap;\r\n  font-size: 11px;\r\n  margin-top: 5px;\r\n}\r\n.handover-rounds__badges:empty {\r\n  display: none;\r\n}\r\n.handover-rounds__badges > span,\r\n.handover-rounds__draft-chip {\r\n  background: #fff1d9;\r\n  color: #815105;\r\n  border-radius: 6px;\r\n  padding: 2px 6px;\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n}\r\n.handover-rounds__detail {\r\n  min-width: 0;\r\n}\r\n.handover-rounds__patient-heading {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  background: #fff;\r\n  border: 1px solid var(--border);\r\n  border-radius: 14px 14px 0 0;\r\n  padding: 18px 20px;\r\n}\r\n.handover-rounds__patient-heading .patient-identity {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  min-width: 0;\r\n}\r\n.handover-rounds__patient-heading .patient-identity .patient-identity__name {\r\n  font-size: 20px;\r\n  line-height: 1.35;\r\n  overflow-wrap: anywhere;\r\n}\r\n.handover-rounds__patient-heading :is(.patient-identity__identifier, .patient-identity__location) {\r\n  font-size: 12px;\r\n}\r\n.handover-rounds__patient-heading > a:not(#ds) {\r\n  flex: 0 0 auto;\r\n  font-size: 13px;\r\n}\r\n.handover-rounds__tabs {\r\n  display: flex;\r\n  gap: 8px;\r\n  padding: 0 16px;\r\n  margin-bottom: 18px;\r\n  border: 1px solid var(--border);\r\n  border-top: 0;\r\n  border-radius: 0 0 14px 14px;\r\n  background: #fff;\r\n}\r\n.handover-rounds__tabs button {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding: 12px 8px;\r\n  border: 0;\r\n  border-bottom: 3px solid transparent;\r\n  border-radius: 0;\r\n  background: transparent;\r\n  color: var(--text-secondary);\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n}\r\n.handover-rounds__tabs button[aria-selected='true'] {\r\n  color: var(--blue);\r\n  border-bottom-color: var(--blue);\r\n}\r\n.handover-rounds__history > .cr-tab-content {\r\n  padding: 0;\r\n  overflow: visible;\r\n}\r\n.handover-rounds__history .cts {\r\n  margin: 0;\r\n  box-shadow: none;\r\n}\r\n.handover-rounds__history .cts__header {\r\n  padding: 12px 16px;\r\n  background: #fff;\r\n}\r\n.handover-rounds__history .cts__title {\r\n  font-size: 15px;\r\n  letter-spacing: 0;\r\n  text-transform: none;\r\n}\r\n.handover-rounds__history .cts__body {\r\n  padding: 16px;\r\n}\r\n.handover-rounds__history .diario-history-filters {\r\n  padding: 12px;\r\n  background: #f7f9fc;\r\n  border-radius: 10px;\r\n  gap: 10px;\r\n}\r\n.handover-rounds__history .diario-history-filters input {\r\n  background: #fff;\r\n  min-height: var(--ds-control-h);\r\n  font-size: var(--ds-field-font);\r\n}\r\n.handover-rounds__history .diario-history-filters button:not(#ds) {\r\n  min-height: var(--ds-control-h);\r\n  padding: 0 var(--ds-control-px);\r\n  font-size: var(--ds-control-font);\r\n}\r\n.handover-rounds__history .diario-cards {\r\n  gap: 12px;\r\n  margin-top: 14px;\r\n}\r\n.handover-rounds__history .diario-card {\r\n  background: #fff;\r\n  padding: 16px;\r\n  border-radius: 10px;\r\n  border-left-width: 3px;\r\n}\r\n.handover-rounds__history .diario-card__head {\r\n  gap: 6px;\r\n  flex-wrap: wrap;\r\n}\r\n.handover-rounds__history .diario-card__author {\r\n  margin: 10px 0 4px;\r\n  font-size: 12px;\r\n  font-weight: 500;\r\n}\r\n.handover-rounds__history .diario-card__title {\r\n  font-size: 15px;\r\n  margin-bottom: 6px;\r\n}\r\n.handover-rounds__history .diario-card__content {\r\n  color: var(--text, #17263b);\r\n  font-size: 14px;\r\n  line-height: 1.65;\r\n}\r\n.handover-rounds__history .diario-card__time {\r\n  font-size: 11px;\r\n}\r\n.handover-rounds__composer {\r\n  border: 1px solid var(--border);\r\n  border-radius: 14px;\r\n  background: #fff;\r\n  padding: 20px;\r\n}\r\n.ho-card-head {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n}\r\n.ho-card-head h3 {\r\n  margin: 0;\r\n  font-size: 18px;\r\n}\r\n.ho-cap {\r\n  font-size: 12px;\r\n  color: var(--text-secondary);\r\n}\r\n.handover-rounds__composer-identity {\r\n  padding-block: 12px;\r\n  border-bottom: 1px solid var(--border);\r\n  margin-bottom: 16px;\r\n  overflow-wrap: anywhere;\r\n}\r\n.handover-rounds__composer .clinical-note-editor select {\r\n  background: #fff;\r\n  font-size: 14px;\r\n}\r\n.handover-rounds__actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  justify-content: flex-end;\r\n  align-items: center;\r\n  gap: 10px;\r\n  margin-top: 20px;\r\n  padding-top: 16px;\r\n  border-top: 1px solid var(--border);\r\n}\r\n.handover-rounds__actions button:not(#ds) {\r\n  font-size: 14px;\r\n  padding: 10px 14px;\r\n}\r\n.handover-rounds__actions .link-btn {\r\n  margin-right: auto;\r\n}\r\n.handover-workspace__memory {\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n  margin-top: 16px;\r\n}\r\n.ho-sr {\r\n  position: absolute;\r\n  width: 1px;\r\n  height: 1px;\r\n  overflow: hidden;\r\n  clip: rect(0 0 0 0);\r\n  white-space: nowrap;\r\n}\r\n@media (min-width: 801px) {\r\n  .handover-rounds__list {\r\n    position: sticky;\r\n    top: 16px;\r\n  }\r\n  .handover-rounds__roster {\r\n    max-height: max(240px, calc(100dvh - 350px));\r\n    overflow-y: auto;\r\n    padding: 2px;\r\n    scrollbar-gutter: stable;\r\n  }\r\n}\r\n@media (max-width: 1023px) and (min-width: 801px) {\r\n  .handover-rounds__layout {\r\n    grid-template-columns: 240px minmax(0, 1fr);\r\n    gap: 16px;\r\n  }\r\n}\r\n@media (max-width: 800px) {\r\n  .handover-rounds__layout {\r\n    grid-template-columns: minmax(0, 1fr);\r\n    gap: 20px;\r\n  }\r\n  .handover-rounds__filters {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n  .handover-rounds__roster {\r\n    max-height: 230px;\r\n    overflow-y: auto;\r\n    padding: 2px;\r\n  }\r\n  .handover-rounds__patient-heading {\r\n    padding: 14px;\r\n  }\r\n  .handover-rounds__patient-heading .patient-identity .patient-identity__name {\r\n    font-size: 18px;\r\n  }\r\n  .handover-rounds__patient-heading > a:not(#ds) {\r\n    font-size: 12px;\r\n  }\r\n  .handover-rounds__composer {\r\n    padding: 16px;\r\n  }\r\n  .handover-rounds__history .cts__body,\r\n  .handover-rounds__history .diario-card {\r\n    padding: 12px;\r\n  }\r\n}\r\n@media (max-width: 440px) {\r\n  .handover-rounds__patient-heading {\r\n    align-items: flex-start;\r\n    flex-direction: column;\r\n  }\r\n  .handover-rounds__tabs {\r\n    padding-inline: 10px;\r\n    gap: 4px;\r\n  }\r\n  .handover-rounds__tabs button {\r\n    font-size: 13px;\r\n    gap: 5px;\r\n  }\r\n  .handover-rounds__history .diario-history-filters label {\r\n    flex: 1 1 110px;\r\n    min-width: 0;\r\n  }\r\n  .handover-rounds__history .diario-history-filters input {\r\n    width: 100%;\r\n    max-width: 100%;\r\n  }\r\n  .handover-rounds__actions {\r\n    gap: 8px;\r\n  }\r\n}\r\n"],["STYLE",{},".assessment-catalog { display: grid; gap: 18px; --ds-control-h: 44px; }\r\n/* Keep the catalog on the same left axis as the patient TopNav. */\r\n@media screen { .assessment-catalog { margin-inline: 24px; } }\r\n@media screen and (max-width: 900px) { .assessment-catalog { margin-inline: 16px; } }\r\n@media screen and (max-width: 600px) { .assessment-catalog { margin-inline: 12px; } }\r\n.assessment-catalog h2, .assessment-catalog h3, .assessment-catalog h4, .assessment-catalog p { margin: 0; }\r\n.assessment-catalog h3 { margin-bottom: 10px; }\r\n.assessment-catalog-list { display: grid; gap: 8px; }\r\n.assessment-catalog-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 12px; border: 1px solid var(--border-color, #d8e0e8); border-radius: 10px; background: var(--surface, #fff); }\r\n.assessment-catalog-row > div:first-child { min-width: 0; display: grid; gap: 5px; overflow-wrap: anywhere; }\r\n.assessment-catalog-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; max-width: 100%; }\r\n.assessment-catalog-purpose { color: var(--text-secondary, #526170); font-size: .9rem; }\r\n.assessment-catalog-action { white-space: normal; }\r\n.assessment-catalog-action:focus-visible { outline: 3px solid var(--primary, #2563eb); outline-offset: 3px; }\r\n.assessment-catalog-secondary { font-size: .85rem; color: var(--text-muted, #526170); }\r\n.patient-module-return { align-self: flex-start; width: fit-content; max-width: 100%; margin-bottom: 12px; }\r\n.nrs-legacy { display: grid; gap: 12px; }\r\n.nrs-legacy details { padding: 12px; border: 1px solid var(--border-color, #d8e0e8); border-radius: 8px; }\r\n.nrs-legacy summary { cursor: pointer; overflow-wrap: anywhere; }\r\n.nrs-legacy pre { white-space: pre-wrap; overflow-wrap: anywhere; font: inherit; }\r\n.nrs-legacy dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }\r\n.nrs-legacy dd { margin: 4px 0 0; overflow-wrap: anywhere; }\r\n.nrs-legacy-note { white-space: pre-wrap; overflow-wrap: anywhere; }\r\n.nrs-print-surface { display: none; }\r\n.assessment-catalog-icon { width:40px; height:40px; min-width:40px; min-height:40px; padding:0; display:grid; place-items:center; font-size:24px; }\r\n.assessment-draft-chip { padding:2px 8px; border-radius:20px; width:fit-content; background:var(--amber-bg,#fdf3e2); color:#8a5300; font-size:12px; }\r\n@media (max-width: 900px) { .assessment-catalog-row { align-items:flex-start; flex-direction:column; } .assessment-catalog-actions { display:flex; } }\r\n@media (max-width: 768px) {\r\n  .assessment-catalog > button, .assessment-catalog .assessment-catalog-actions button, .patient-module-return {\r\n    min-width: 44px;\r\n    min-height: 44px;\r\n    max-width: 100%;\r\n    white-space: normal;\r\n  }\r\n}\r\n@media print {\r\n  .nrs-legacy .no-print { display: none !important; }\r\n  body[data-nrs-print] > *:not(.nrs-print-surface) { display: none !important; }\r\n  body[data-nrs-print] > .nrs-print-surface { display: block !important; padding: 12mm; }\r\n  .nrs-legacy details { break-inside: avoid; }\r\n}\r\n"],["STYLE",{},"/* Navigazione condivisa (un solo componente). Nella cartella paziente è una barra unica di sezioni\r\n   (level2 + top-nav--section-grid, con etichette di gruppo); level3 resta per le sotto-navigazioni\r\n   interne di altre pagine (es. Terapia Farmacologica). */\r\n\r\n.top-nav {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  min-width: 0;\r\n  margin-inline: 24px;\r\n  box-sizing: border-box;\r\n  font-family: inherit;\r\n}\r\n\r\n.top-nav__context-label {\r\n  flex: 0 0 auto;\r\n  min-width: max-content;\r\n  padding-right: 14px;\r\n  border-right: 1px solid var(--border, #d8e0ea);\r\n  color: #52667d;\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  line-height: 1.2;\r\n  letter-spacing: 0.07em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.top-nav__items {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  min-width: 0;\r\n  overflow-x: auto;\r\n  overscroll-behavior-inline: contain;\r\n  scrollbar-width: thin;\r\n  scrollbar-color: #c2cedd transparent;\r\n}\r\n\r\n.top-nav__item {\r\n  position: relative;\r\n  display: inline-flex;\r\n  flex: 0 0 auto;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 7px;\r\n  min-height: 44px;\r\n  padding: 9px 14px;\r\n  border: 1px solid transparent;\r\n  border-radius: 8px;\r\n  color: #40546b;\r\n  background: transparent;\r\n  font: inherit;\r\n  font-size: 14px;\r\n  font-weight: 700;\r\n  white-space: nowrap;\r\n  cursor: pointer;\r\n  transition:\r\n    color 0.15s ease-out,\r\n    background 0.15s ease-out,\r\n    border-color 0.15s ease-out,\r\n    box-shadow 0.15s ease-out;\r\n}\r\n\r\n.top-nav__item:hover {\r\n  color: #17345f;\r\n  background: #edf3fb;\r\n  border-color: #d4dfed;\r\n}\r\n\r\n.top-nav__item:focus-visible {\r\n  outline: 3px solid rgba(47, 107, 237, 0.3);\r\n  outline-offset: 2px;\r\n  z-index: 1;\r\n}\r\n\r\n/* L2 — strong, stable primary tab rail. */\r\n.top-nav--level2 {\r\n  min-height: 58px;\r\n  margin-top: 12px;\r\n  padding: 7px 9px;\r\n  border: 1px solid #d8e0ea;\r\n  border-radius: 12px;\r\n  background: var(--surface, #fff);\r\n  box-shadow: 0 1px 3px rgba(16, 32, 54, 0.07);\r\n}\r\n\r\n.top-nav--level2 .top-nav__item.is-active {\r\n  color: #fff;\r\n  background: #1f5bd8;\r\n  border-color: #1f5bd8;\r\n  box-shadow: 0 2px 5px rgba(31, 91, 216, 0.25);\r\n}\r\n\r\n/* L3 — flat contextual navigation, visibly subordinate to L2. */\r\n.top-nav--level3 {\r\n  min-height: 50px;\r\n  margin-top: 6px;\r\n  padding-inline: 10px;\r\n  border-bottom: 1px solid #dbe3ed;\r\n  background: transparent;\r\n}\r\n\r\n.top-nav--level3 .top-nav__items {\r\n  gap: 15px;\r\n}\r\n\r\n.top-nav--level3 .top-nav__item {\r\n  min-height: 44px;\r\n  padding: 8px 2px 7px;\r\n  border: 0;\r\n  border-radius: 0;\r\n  color: #52667d;\r\n  background: transparent;\r\n  font-size: 13px;\r\n  font-weight: 650;\r\n}\r\n\r\n.top-nav--level3 .top-nav__item::after {\r\n  content: '';\r\n  position: absolute;\r\n  right: 0;\r\n  bottom: 0;\r\n  left: 0;\r\n  height: 3px;\r\n  border-radius: 999px 999px 0 0;\r\n  background: transparent;\r\n}\r\n\r\n.top-nav--level3 .top-nav__item:hover {\r\n  color: #174fae;\r\n  background: transparent;\r\n}\r\n\r\n.top-nav--level3 .top-nav__item.is-active {\r\n  color: #174fae;\r\n  font-weight: 800;\r\n}\r\n\r\n.top-nav--level3 .top-nav__item.is-active::after {\r\n  background: #2f6bed;\r\n}\r\n\r\n/* Patient-record section rail: content-sized tabs wrap without horizontal scrolling.\r\n   Keep destinations compact even when an area contains only a few short labels. */\r\n.top-nav--section-grid {\r\n  min-height: 52px;\r\n  margin-top: 8px;\r\n  padding: 6px 8px;\r\n  border: 1px solid #d8e0ea;\r\n  border-radius: 10px;\r\n  background: var(--surface, #fff);\r\n  box-shadow: 0 1px 2px rgba(16, 32, 54, 0.05);\r\n}\r\n\r\n.top-nav--section-grid .top-nav__items {\r\n  flex: 1 1 100%;\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: stretch;\r\n  gap: 4px 8px;\r\n  overflow: visible;\r\n  width: 100%;\r\n  padding: 0;\r\n}\r\n\r\n.top-nav--section-grid .top-nav__item {\r\n  width: auto;\r\n  max-width: 100%;\r\n  min-width: 0;\r\n  min-height: 44px;\r\n  padding: 8px 12px;\r\n  border-radius: 7px;\r\n  line-height: 1.25;\r\n  white-space: normal;\r\n  text-wrap: balance;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.top-nav--section-grid .top-nav__item:hover {\r\n  background: #f3f6fb;\r\n}\r\n\r\n.top-nav--section-grid .top-nav__item.is-active {\r\n  background: #eef4ff;\r\n}\r\n\r\n.top-nav--section-grid .top-nav__item::after {\r\n  right: 8px;\r\n  bottom: 2px;\r\n  left: 8px;\r\n}\r\n\r\n.top-nav__badge {\r\n  min-width: 20px;\r\n  padding: 2px 6px;\r\n  border-radius: 999px;\r\n  color: #285cae;\r\n  background: #e4edfb;\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  line-height: 1.35;\r\n  text-align: center;\r\n}\r\n\r\n.top-nav--level2 .top-nav__item.is-active .top-nav__badge {\r\n  /* Sfondo scuro: contrasto ≥ 4,5:1 anche per il testo piccolo del badge (WCAG AA). */\r\n  color: #fff;\r\n  background: #143f99;\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .top-nav {\r\n    align-items: stretch;\r\n    flex-direction: column;\r\n    gap: 5px;\r\n    margin-inline: 16px;\r\n  }\r\n\r\n  .top-nav__context-label {\r\n    padding: 1px 2px 5px;\r\n    border-right: 0;\r\n    border-bottom: 1px solid #d8e0ea;\r\n  }\r\n\r\n  .top-nav__items {\r\n    padding-bottom: 2px;\r\n  }\r\n\r\n  .top-nav--level2 {\r\n    padding: 7px;\r\n  }\r\n\r\n  .top-nav--level3 {\r\n    padding-inline: 4px;\r\n  }\r\n\r\n  .top-nav--section-grid {\r\n    flex-direction: row;\r\n    margin-inline: 16px;\r\n    padding: 6px;\r\n  }\r\n}\r\n\r\n@media (max-width: 600px) {\r\n  .top-nav {\r\n    margin-inline: 12px;\r\n  }\r\n\r\n  .top-nav--section-grid {\r\n    margin-inline: 12px;\r\n  }\r\n\r\n  .top-nav--level2 .top-nav__item,\r\n  .top-nav--level3 .top-nav__item {\r\n    font-size: 13px;\r\n  }\r\n}\r\n\r\n/* Etichette e separatori di gruppo nella barra a un livello della cartella: solo visivi. */\r\n.top-nav__group-label {\r\n  align-self: center;\r\n  padding: 0 2px 0 10px;\r\n  color: var(--text-muted, #5a6b80);\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  letter-spacing: 0.06em;\r\n  text-transform: uppercase;\r\n  white-space: nowrap;\r\n}\r\n.top-nav__group-label:first-child {\r\n  padding-left: 4px;\r\n}\r\n.top-nav__group-sep {\r\n  align-self: stretch;\r\n  width: 1px;\r\n  margin: 8px 4px;\r\n  background: var(--border, #e6ebf2);\r\n}\r\n\r\n/* Barra unica della cartella (primo livello + griglia): va a capo, allineata a sinistra, etichetta\r\n   sopra e pillola blu piena per la sezione attiva. Sul telefono una riga sola che scorre dentro la\r\n   barra, così la navigazione non spinge il contenuto fuori dallo schermo. */\r\n.top-nav--level2.top-nav--section-grid {\r\n  flex-wrap: wrap;\r\n  align-items: flex-start;\r\n  row-gap: 4px;\r\n}\r\n.top-nav--level2.top-nav--section-grid .top-nav__context-label {\r\n  /* Sul tablet ogni riga conta: le etichette di gruppo bastano a orientarsi. */\r\n  display: none;\r\n}\r\n.top-nav--level2.top-nav--section-grid .top-nav__item {\r\n  padding: 8px 8px;\r\n}\r\n.top-nav--level2.top-nav--section-grid .top-nav__group-sep {\r\n  margin: 8px 2px;\r\n}\r\n.top-nav--level2.top-nav--section-grid .top-nav__group-label {\r\n  padding-left: 6px;\r\n}\r\n.top-nav--level2.top-nav--section-grid .top-nav__items {\r\n  gap: 4px 4px;\r\n}\r\n.top-nav--level2.top-nav--section-grid .top-nav__items {\r\n  justify-content: flex-start;\r\n}\r\n.top-nav--level2.top-nav--section-grid .top-nav__item.is-active,\r\n.top-nav--level2.top-nav--section-grid .top-nav__item.is-active:hover {\r\n  color: #fff;\r\n  background: #1f5bd8;\r\n  border-color: #1f5bd8;\r\n}\r\n@media (max-width: 600px) {\r\n  .top-nav--level2.top-nav--section-grid .top-nav__items {\r\n    flex-wrap: nowrap;\r\n    overflow-x: auto;\r\n    scrollbar-width: thin;\r\n  }\r\n  .top-nav--level2.top-nav--section-grid .top-nav__item {\r\n    flex: 0 0 auto;\r\n    white-space: nowrap;\r\n  }\r\n}\r\n\r\n/* ── HMI 1: sezioni della cartella a chip (prototipo) ─────────────────────────\r\n   Chip 48 px, bordo 2 px, raggio 12; attiva = fondo azzurro, bordo blu, testo blu semibold.\r\n   Nessuna etichetta di contesto: le chip parlano da sole. */\r\n.top-nav--chips {\r\n  flex: 1 1 auto;\r\n  min-height: 0;\r\n  margin: 0;\r\n  padding: 0;\r\n  border: 0;\r\n  border-radius: 0;\r\n  background: transparent;\r\n  box-shadow: none;\r\n}\r\n.top-nav--chips .top-nav__context-label {\r\n  display: none;\r\n}\r\n.top-nav--chips .top-nav__items {\r\n  gap: 8px;\r\n  overflow-x: auto;\r\n  padding: 0;\r\n}\r\n.top-nav--chips .top-nav__item {\r\n  height: 48px;\r\n  min-height: 48px;\r\n  padding: 0 16px;\r\n  border: 2px solid var(--border, #e1e7f0);\r\n  border-radius: 12px;\r\n  background: var(--surface, #fff);\r\n  color: var(--text, #16202e);\r\n  font: 400 16px/24px var(--font-ui);\r\n  box-shadow: none;\r\n}\r\n.top-nav--chips .top-nav__item:hover {\r\n  background: var(--surface, #fff);\r\n  border-color: var(--blue, #2f6bed);\r\n  color: var(--text, #16202e);\r\n}\r\n.top-nav--chips .top-nav__item.is-active {\r\n  background: #eaf1fe;\r\n  border-color: var(--blue, #2f6bed);\r\n  color: #1d4fc4;\r\n  font-weight: 600;\r\n  box-shadow: none;\r\n}\r\n.top-nav--chips .top-nav__item.is-active .top-nav__badge {\r\n  color: #1d4fc4;\r\n  background: #fff;\r\n}\r\n.top-nav--chips .top-nav__item:focus-visible {\r\n  outline: 3px solid #245bb5;\r\n  outline-offset: 2px;\r\n}\r\n@media (max-width: 900px) {\r\n  .top-nav--chips {\r\n    flex-direction: row;\r\n    margin: 0;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Direct access: the item a navigation landed on (handover, diary entry, allergy table) is\r\n   outlined in medical blue for a few seconds, so the eye finds it without searching. */\r\n.chart-focus-item {\r\n  outline: 3px solid var(--blue, #2f6bed);\r\n  outline-offset: 3px;\r\n  border-radius: 10px;\r\n  box-shadow: 0 0 0 6px color-mix(in srgb, var(--blue, #2f6bed) 14%, transparent);\r\n  transition:\r\n    outline-color 0.4s ease,\r\n    box-shadow 0.4s ease;\r\n  scroll-margin: 96px;\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  .chart-focus-item {\r\n    transition: none;\r\n  }\r\n}\r\n"],["STYLE",{},".diagnosis-description {\r\n  min-width: 0;\r\n}\r\n\r\ntextarea.diagnosis-description__input {\r\n  width: 100%;\r\n  min-height: 200px;\r\n  line-height: 1.65;\r\n  resize: vertical;\r\n}\r\n\r\n.diagnosis-preview {\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--radius-sm);\r\n  background: var(--surface);\r\n  padding: 10px 12px;\r\n}\r\n\r\n.diagnosis-preview summary {\r\n  cursor: pointer;\r\n  color: var(--text);\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n}\r\n\r\n.diagnosis-preview[open] summary {\r\n  margin-bottom: 12px;\r\n}\r\n\r\n.diagnosis-text {\r\n  color: var(--text);\r\n  font-size: 14px;\r\n  font-weight: 400;\r\n  line-height: 1.65;\r\n  min-width: 0;\r\n  overflow-wrap: anywhere;\r\n  white-space: pre-wrap;\r\n}\r\n\r\n.diagnosis-text > * {\r\n  margin: 0 0 12px;\r\n}\r\n\r\n.diagnosis-text > :last-child {\r\n  margin-bottom: 0;\r\n}\r\n\r\n.diagnosis-text h4 {\r\n  color: var(--text);\r\n  font-size: 14px;\r\n  font-weight: 700;\r\n  line-height: inherit;\r\n}\r\n\r\n.diagnosis-text ul {\r\n  list-style: none;\r\n  padding-left: 8px;\r\n}\r\n\r\n.diagnosis-text li {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: 8px;\r\n  margin-bottom: 6px;\r\n}\r\n\r\n.diagnosis-text__marker {\r\n  flex-shrink: 0;\r\n}\r\n\r\n.diagnosis-notes {\r\n  border-top: 1px solid var(--border);\r\n  padding-top: 10px;\r\n  margin-top: 8px;\r\n}\r\n\r\n.diagnosis-notes > .form-label {\r\n  display: block;\r\n  margin-bottom: 6px;\r\n}\r\n\r\n.diagnosis-error {\r\n  margin: 0;\r\n  color: var(--text);\r\n  font-size: 13px;\r\n}\r\n\r\n@media (max-width: 480px) {\r\n  .diagnosis-item {\r\n    flex-direction: column;\r\n    align-items: stretch;\r\n  }\r\n\r\n  .diagnosis-item > .cr-item-row__actions {\r\n    order: -1;\r\n    align-self: flex-end;\r\n    padding-top: 0;\r\n  }\r\n}\r\n"],["STYLE",{},".parameter-entry-clock {\r\n  display: grid;\r\n  grid-template-columns: auto 1fr;\r\n  column-gap: 20px;\r\n  align-items: center;\r\n  margin: 0 0 20px;\r\n  padding: 18px 22px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 12px;\r\n  background: var(--surface);\r\n}\r\n.parameter-entry-clock > span {\r\n  color: var(--text-muted);\r\n  font-size: 14px;\r\n}\r\n.parameter-entry-clock time {\r\n  grid-row: 1 / 3;\r\n  grid-column: 1;\r\n  font-size: clamp(36px, 5vw, 54px);\r\n  font-weight: 750;\r\n  line-height: 1.1;\r\n  color: var(--blue);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.parameter-entry-clock > span:first-child {\r\n  grid-column: 2;\r\n  font-weight: 650;\r\n  color: var(--text);\r\n}\r\n.parameter-entry-patient {\r\n  border: 0;\r\n  background: transparent;\r\n  padding: 0;\r\n  text-align: left;\r\n  font: inherit;\r\n  min-height: 44px;\r\n  white-space: normal;\r\n}\r\n.parameter-entry-patient:focus-visible {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 3px;\r\n}\r\n.parameter-entry-patient__text {\r\n  display: grid;\r\n  min-width: 0;\r\n  gap: 3px;\r\n}\r\n.parameter-entry-last {\r\n  font-size: 11px;\r\n  color: var(--blue);\r\n}\r\n.parameter-entry-result {\r\n  grid-column: 1 / -1;\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 12px;\r\n  font-size: 13px;\r\n  color: var(--text);\r\n  padding: 6px 0;\r\n}\r\n.parameter-entry-row .qe-row__note-btn svg {\r\n  width: 15px;\r\n  height: 15px;\r\n}\r\n.parameter-entry-row .qe-row__note-btn {\r\n  gap: 5px;\r\n  padding-inline: 8px;\r\n}\r\n.parameter-note-count {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-width: 19px;\r\n  height: 19px;\r\n  padding-inline: 4px;\r\n  border-radius: 10px;\r\n  background: var(--blue);\r\n  color: #fff;\r\n  font-size: 11px;\r\n  font-weight: 700;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.parameter-note-count--draft {\r\n  background: var(--text-muted);\r\n}\r\n.parameter-note-summary {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  margin-bottom: 8px;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n}\r\n.parameter-note-label {\r\n  display: grid;\r\n  gap: 6px;\r\n  font-size: 13px;\r\n}\r\n.parameter-entry-help {\r\n  color: var(--text-muted);\r\n  font-size: 13px;\r\n  line-height: 1.5;\r\n  margin: 16px 0;\r\n}\r\n.parameter-entry-progress {\r\n  color: var(--text-muted);\r\n  font-size: 13px;\r\n}\r\n.parameter-history {\r\n  min-width: 0;\r\n}\r\n.parameter-history-toolbar {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 12px;\r\n  align-items: end;\r\n  margin: 20px 0;\r\n}\r\n.parameter-history-toolbar > div {\r\n  flex: 1 1 240px;\r\n}\r\n.parameter-history-toolbar h3 {\r\n  margin: 0 0 6px;\r\n  font-size: 17px;\r\n}\r\n.parameter-history-toolbar p {\r\n  margin: 0;\r\n  color: var(--text-muted);\r\n  font-size: 13px;\r\n}\r\n.parameter-history-toolbar label {\r\n  display: grid;\r\n  gap: 5px;\r\n  font-size: 12px;\r\n}\r\n.parameter-history-error {\r\n  color: var(--red);\r\n  padding: 12px;\r\n  background: var(--surface);\r\n}\r\n.parameter-history-list {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 0;\r\n}\r\n.parameter-history-day {\r\n  font-size: 14px;\r\n  margin: 22px 0 10px;\r\n  color: var(--text-muted);\r\n}\r\n.parameter-history-reading {\r\n  display: grid;\r\n  grid-template-columns: 135px minmax(0, 1fr);\r\n  gap: 14px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  padding: 16px;\r\n  margin-bottom: 10px;\r\n  background: var(--surface);\r\n}\r\n.parameter-history-stamp {\r\n  display: grid;\r\n  align-content: start;\r\n  gap: 5px;\r\n  overflow-wrap: anywhere;\r\n}\r\n.parameter-history-stamp time {\r\n  font-size: 24px;\r\n  color: var(--blue);\r\n  font-weight: 750;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.parameter-history-stamp span {\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n}\r\n.parameter-history-reading dl {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 14px 24px;\r\n  margin: 0;\r\n}\r\n.parameter-history-reading dt {\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n  margin-bottom: 5px;\r\n}\r\n.parameter-history-reading dd {\r\n  margin: 0;\r\n  font-size: 17px;\r\n  font-weight: 650;\r\n  overflow-wrap: anywhere;\r\n}\r\n.parameter-history-reading dd small {\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n  font-weight: 400;\r\n}\r\n.parameter-history-note {\r\n  grid-column: 1 / -1;\r\n  margin: 0;\r\n  border-top: 1px solid var(--border);\r\n  padding-top: 12px;\r\n  white-space: pre-wrap;\r\n  overflow-wrap: anywhere;\r\n  font-size: 14px;\r\n}\r\n.parameter-month-scroll {\r\n  max-width: 100%;\r\n  overflow-x: auto;\r\n  margin-top: 16px;\r\n}\r\n.parameter-month-table {\r\n  min-width: 660px;\r\n}\r\n.parameter-month-table caption {\r\n  text-align: left;\r\n  color: var(--text-muted);\r\n  font-size: 13px;\r\n  padding: 0 0 12px;\r\n}\r\n.parameter-month-table th,\r\n.parameter-month-table td {\r\n  vertical-align: top;\r\n}\r\n.parameter-month-table th[scope='row'] {\r\n  white-space: nowrap;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.parameter-month-table dl {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px 14px;\r\n  margin: 0;\r\