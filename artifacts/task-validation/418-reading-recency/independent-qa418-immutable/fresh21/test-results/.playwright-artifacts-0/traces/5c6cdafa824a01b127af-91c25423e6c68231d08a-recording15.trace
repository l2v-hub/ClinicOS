{"type":"frame-snapshot","snapshot":{"callId":"call@15292","snapshotName":"after@call@15292","pageId":"page@b0d04129d368ecaa701b8a9f4ab6d246","frameId":"frame@2df4bc428c602a34604ffd251e6e1b00","frameUrl":"http://127.0.0.1:7483/#/parametri-multipaziente","doctype":"html","html":["HTML",{"lang":"it"},["HEAD",{},[[13,0]],[[13,1]],[[13,2]],[[13,3]],[[13,4]],[[13,5]],[[13,6]],[[13,7]],[[13,8]],[[13,9]],[[13,10]],[[13,11]],[[13,12]],[[13,13]],[[13,15]],[[13,16]],[[13,18]],[[13,20]],[[13,22]],[[13,24]],[[13,26]],[[13,28]],[[10,1]],[[10,3]],[[10,5]],[[10,7]],[[10,9]],[[10,11]],[[10,13]],[[9,1]],[[9,3]],[[9,5]],[[9,7]],[[9,9]],[[9,11]],[[9,13]],[[9,15]],[[8,1]],[[8,3]],[[8,5]],[[8,7]],[[8,9]],[[8,11]],[[8,13]],[[8,15]],[[8,17]],[[8,19]],[[8,21]],[[8,23]],[[8,25]],[[8,27]],[[7,1]],[[7,3]],[[1,1]],[[1,3]],[[1,5]],[[1,7]],["STYLE",{},".consegne-page .handover-editor {\r\n  max-width: 1040px;\r\n  margin: 0 auto 20px;\r\n  padding: 0;\r\n  overflow: visible;\r\n  border-radius: 9px;\r\n  box-shadow: 0 1px 4px rgba(20, 39, 72, 0.08);\r\n}\r\n\r\n.handover-editor__header {\r\n  min-height: 68px;\r\n  margin: 0;\r\n  padding: 13px 16px;\r\n  align-items: flex-start;\r\n  border-bottom: 1px solid var(--border);\r\n  border-radius: 9px 9px 0 0;\r\n  background: var(--surface-raised);\r\n}\r\n\r\n.handover-editor__eyebrow,\r\n.handover-editor__section > legend {\r\n  color: var(--text-xmuted);\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  letter-spacing: 0.65px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.handover-editor__eyebrow {\r\n  display: block;\r\n  margin-bottom: 2px;\r\n}\r\n\r\n.handover-editor__intro {\r\n  margin: 3px 0 0;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.handover-editor__body {\r\n  padding: 0 16px;\r\n}\r\n\r\n.handover-editor__section {\r\n  min-width: 0;\r\n  margin: 0;\r\n  padding: 14px 0 16px;\r\n  border: 0;\r\n  border-bottom: 1px solid var(--divider);\r\n}\r\n\r\n.handover-editor__section--last {\r\n  border-bottom: 0;\r\n}\r\n\r\n.handover-editor__section > legend {\r\n  width: 100%;\r\n  padding: 0 0 9px;\r\n}\r\n\r\n.handover-editor__grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(12, minmax(0, 1fr));\r\n  gap: 12px;\r\n}\r\n\r\n.handover-editor__field--patient {\r\n  grid-column: span 7;\r\n  min-width: 0;\r\n}\r\n\r\n.handover-editor__field--assignee {\r\n  grid-column: span 5;\r\n}\r\n\r\n.handover-editor__field--third {\r\n  grid-column: span 3;\r\n}\r\n\r\n.handover-editor .form-field,\r\n.handover-editor .form-input,\r\n.handover-editor .form-select {\r\n  min-width: 0;\r\n}\r\n\r\n.handover-editor .form-input,\r\n.handover-editor .form-select {\r\n  width: 100%;\r\n}\r\n\r\n.handover-editor__optional-label {\r\n  color: var(--text-muted);\r\n  font-size: 10px;\r\n  font-weight: 500;\r\n  text-transform: none;\r\n}\r\n\r\n.handover-editor__notes {\r\n  min-height: 86px;\r\n  resize: vertical;\r\n}\r\n\r\n.handover-editor__counter {\r\n  display: block;\r\n  margin-top: 4px;\r\n  color: var(--text-xmuted);\r\n  font-size: 10.5px;\r\n  text-align: right;\r\n}\r\n\r\n.handover-editor__actions {\r\n  min-height: 62px;\r\n  align-items: center;\r\n  margin: 0;\r\n  padding: 9px 16px;\r\n  border-top: 1px solid var(--border);\r\n  border-radius: 0 0 9px 9px;\r\n  background: var(--surface-raised);\r\n}\r\n\r\n.handover-editor__required-note,\r\n.handover-editor__error {\r\n  margin: 0 auto 0 0;\r\n  font-size: 11px;\r\n}\r\n\r\n.handover-editor__required-note {\r\n  color: var(--text-muted);\r\n}\r\n\r\n.handover-editor__required-note > span {\r\n  color: var(--red);\r\n  font-weight: 700;\r\n}\r\n\r\n.handover-editor__error {\r\n  color: var(--red);\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .handover-editor__grid {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n\r\n  .handover-editor__field--patient {\r\n    grid-column: 1 / -1;\r\n  }\r\n\r\n  .handover-editor__field--assignee,\r\n  .handover-editor__field--third {\r\n    grid-column: span 1;\r\n  }\r\n}\r\n\r\n@media (max-width: 639px) {\r\n  .handover-editor__header,\r\n  .handover-editor__body,\r\n  .handover-editor__actions {\r\n    padding-right: 12px;\r\n    padding-left: 12px;\r\n  }\r\n\r\n  .handover-editor__intro {\r\n    max-width: 34ch;\r\n  }\r\n\r\n  .handover-editor__grid {\r\n    grid-template-columns: minmax(0, 1fr);\r\n    gap: 10px;\r\n  }\r\n\r\n  .handover-editor__field--patient,\r\n  .handover-editor__field--assignee,\r\n  .handover-editor__field--third {\r\n    grid-column: 1;\r\n  }\r\n\r\n  .handover-editor__actions {\r\n    flex-wrap: wrap;\r\n  }\r\n\r\n  .handover-editor__required-note,\r\n  .handover-editor__error {\r\n    width: 100%;\r\n  }\r\n\r\n  .handover-editor__actions .btn-secondary,\r\n  .handover-editor__actions .btn-success {\r\n    min-height: 44px;\r\n    flex: 1;\r\n    justify-content: center;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Diario terapia: pannello \"Valida terapia\" dentro il modulo di nuova voce del diario.\r\n   Solo layout e superfici del pannello: l'aspetto dei controlli (ds-btn, ds-badge, ds-link) lo\r\n   decide design-system.css. */\r\n\r\n.diary-therapy {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n  padding: 16px;\r\n  border: 2px solid var(--border, #e6ebf2);\r\n  border-radius: 16px;\r\n  background: var(--surface, #fff);\r\n}\r\n\r\n.diary-therapy__head h3 {\r\n  margin: 0 0 4px;\r\n  font-size: 1rem;\r\n  font-weight: 600;\r\n  color: var(--text-primary, #16202e);\r\n}\r\n.diary-therapy__head p {\r\n  margin: 0;\r\n}\r\n\r\n.diary-therapy__source {\r\n  margin: 0;\r\n  min-width: 0;\r\n}\r\n.diary-therapy__source blockquote {\r\n  margin: 4px 0 0;\r\n  padding: 12px 16px;\r\n  border-left: 4px solid var(--blue, #2f6bed);\r\n  border-radius: 8px;\r\n  background: var(--bg, #eef1f6);\r\n  color: var(--text-primary, #16202e);\r\n  white-space: pre-wrap;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.diary-therapy__notices {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  margin: 0;\r\n  padding: 0;\r\n  list-style: none;\r\n}\r\n.diary-therapy__notices li {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px;\r\n  min-width: 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.diary-therapy__intent {\r\n  padding: 12px 16px;\r\n  border-radius: 12px;\r\n  background: var(--amber-bg, #fdf3e2);\r\n  color: var(--text-primary, #16202e);\r\n}\r\n.diary-therapy__intent p {\r\n  margin: 0;\r\n}\r\n.diary-therapy__intent p + p {\r\n  margin-top: 4px;\r\n}\r\n\r\n.diary-therapy__alert {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px 12px;\r\n  padding: 8px 12px;\r\n  border-radius: 8px;\r\n  background: var(--red-bg, #fdecee);\r\n  color: var(--red, #d93a4a);\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.diary-therapy__actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  justify-content: flex-end;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n.diary-therapy__blockers {\r\n  flex: 1 1 100%;\r\n  margin: 0;\r\n  padding-left: 20px;\r\n  color: var(--text-secondary, #5a6b80);\r\n  font-size: 0.875rem;\r\n}\r\n\r\n/* Riga \"Terapia aggiunta: FARMACO — apri\" nella card della voce */\r\n.diario-card__therapy {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 4px 8px;\r\n  margin-top: 8px;\r\n  min-width: 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n/* Il modulo della voce ha tre azioni: su schermi stretti vanno a capo invece di uscire */\r\n.cr-inline-form__actions.diario-form__actions {\r\n  flex-wrap: wrap;\r\n}\r\n\r\n@media (max-width: 600px) {\r\n  .diary-therapy {\r\n    padding: 12px;\r\n  }\r\n  .diary-therapy__actions > button {\r\n    flex: 1 1 auto;\r\n  }\r\n}\r\n\r\n/* Campi che l'interprete non ha letto dal testo: da compilare a mano. */\r\n.diary-therapy__unread {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px;\r\n  font-size: 14px;\r\n}\r\n"],["STYLE",{},"/* UX2 W8 — urgenze del diario: evidenza della voce che CHI legge può prendere in carico\r\n   («Ho capito», components/shared/UrgencyNotice). Rosso solo per l'allerta clinica attiva. */\r\n.diario-card--to-see {\r\n  box-shadow:\r\n    0 0 0 2px rgba(217, 58, 74, 0.18),\r\n    var(--shadow-card);\r\n}\r\n.diario-to-see {\r\n  margin: 0 0 12px;\r\n  font: 600 14px/20px var(--font-ui);\r\n  color: var(--red);\r\n}\r\n.diario-ack-error { margin: 0 0 12px; padding: 12px 16px; border: 1px solid #efc3cb; border-radius: 12px; background: #fdecee; color: #b42335; font-size: 14px; line-height: 1.5; }\r\n"],["STYLE",{},".diary-thread {\r\n  margin: 14px 0 0 12px;\r\n  padding: 0 0 0 16px;\r\n  border-left: 2px solid #cdd8e8;\r\n  display: grid;\r\n  gap: 10px;\r\n  min-width: 0;\r\n}\r\n.diary-thread__reply {\r\n  position: relative;\r\n  padding: 12px 14px;\r\n  border: 1px solid #d8e3f1;\r\n  border-radius: 0 12px 12px 12px;\r\n  background: #f4f8fd;\r\n  color: #263e5e;\r\n  font-size: 13px;\r\n  line-height: 1.5;\r\n  overflow-wrap: anywhere;\r\n}\r\n.diary-thread__reply::before {\r\n  content: '';\r\n  position: absolute;\r\n  left: -18px;\r\n  top: 18px;\r\n  width: 16px;\r\n  border-top: 2px solid #cdd8e8;\r\n}\r\n.diary-thread__head {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: baseline;\r\n  gap: 4px 12px;\r\n}\r\n.diary-thread__head time {\r\n  color: #536782;\r\n  font-size: 12px;\r\n}\r\n.diary-thread__message {\r\n  margin: 5px 0;\r\n}\r\n.diary-thread__reply small {\r\n  display: block;\r\n  color: #536782;\r\n  font-size: 12px;\r\n}\r\n.diary-thread--active > .diary-thread__reply {\r\n  border-color: #efc3cb;\r\n  background: #fff7f8;\r\n}\r\n.diary-thread--active > .diary-thread__reply > strong {\r\n  color: #b42335;\r\n}\r\n.diary-thread .urgency-notice {\r\n  margin-top: 6px;\r\n  padding-top: 0;\r\n  border-top: 0;\r\n}\r\n.diary-thread__reply--personal {\r\n  background: #f8fafc;\r\n}\r\n.patient-record-view .diario-card__author {\r\n  margin: 8px 0 4px;\r\n}\r\n.diary-thread.diary-thread--reading {\r\n  margin: 14px 0 0;\r\n  padding: 0;\r\n  border: 0;\r\n}\r\n.diary-thread--reading > .diary-thread__reply {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  flex-wrap: wrap;\r\n  gap: 8px 16px;\r\n  padding: 10px 0 0;\r\n  border: 0;\r\n  border-top: 1px solid var(--border, #d8e3f1);\r\n  border-radius: 0;\r\n  background: transparent;\r\n}\r\n.diary-thread--reading > .diary-thread__reply::before {\r\n  display: none;\r\n}\r\n.diary-thread__status {\r\n  flex: 1 1 220px;\r\n  min-width: 0;\r\n}\r\n.diary-thread--reading .diary-thread__message {\r\n  margin: 2px 0 0;\r\n  color: #536782;\r\n}\r\n.diary-thread--reading .btn-sm {\r\n  min-height: 40px;\r\n  padding: 6px 14px;\r\n  flex: 0 0 auto;\r\n}\r\n@media (max-width: 600px) {\r\n  .diary-thread {\r\n    margin-left: 0;\r\n    padding-left: 12px;\r\n  }\r\n  .diary-thread__reply {\r\n    padding: 10px;\r\n  }\r\n  .diary-thread__reply::before {\r\n    left: -14px;\r\n    width: 12px;\r\n  }\r\n}\r\n"]],[[13,30]],["BODY",{},[[13,31]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},["NAV",{"class":"teams-sidebar","aria-label":"Navigazione principale"},[[8,32]],["DIV",{"class":"teams-sidebar__nav"},["BUTTON",{"type":"button","class":"teams-sidebar__item","title":"Turno"},[[8,35]],[[8,37]]],[[8,44]],[[8,50]],["BUTTON",{"__playwright_target__":"","type":"button","class":"teams-sidebar__item active","title":"Parametri","aria-current":"page"},[[8,53]],[[8,55]]],[[8,62]],[[8,68]],[[8,74]]],[[8,76]]],["DIV",{"class":"main-area-clean"},["DIV",{"class":"compact-topbar"},["BUTTON",{"type":"button","class":"topbar-hamburger","aria-label":"Apri menu","aria-expanded":"false"},[[8,81]]],["BUTTON",{"type":"button","class":"topbar-back","aria-label":"Indietro: Dashboard","title":"Torna a Dashboard (Alt+←)"},["svg",{"width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","