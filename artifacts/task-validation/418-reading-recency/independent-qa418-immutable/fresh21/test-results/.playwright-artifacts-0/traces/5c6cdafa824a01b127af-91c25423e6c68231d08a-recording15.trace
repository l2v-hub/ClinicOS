{"type":"frame-snapshot","snapshot":{"callId":"call@15292","snapshotName":"input@call@15292","pageId":"page@b0d04129d368ecaa701b8a9f4ab6d246","frameId":"frame@2df4bc428c602a34604ffd251e6e1b00","frameUrl":"http://127.0.0.1:7483/#/operator-dashboard","doctype":"html","html":["HTML",{"lang":"it"},["HEAD",{},[[12,0]],[[12,1]],[[12,2]],[[12,3]],[[12,4]],[[12,5]],[[12,6]],[[12,7]],[[12,8]],[[12,9]],[[12,10]],[[12,11]],[[12,12]],[[12,13]],[[12,15]],[[12,16]],[[12,18]],[[12,20]],[[12,22]],[[12,24]],[[12,26]],[[12,28]],[[9,1]],[[9,3]],[[9,5]],[[9,7]],[[9,9]],[[9,11]],[[9,13]],[[8,1]],[[8,3]],[[8,5]],[[8,7]],[[8,9]],[[8,11]],[[8,13]],[[8,15]],[[7,1]],[[7,3]],[[7,5]],[[7,7]],[[7,9]],[[7,11]],[[7,13]],[[7,15]],[[7,17]],[[7,19]],[[7,21]],[[7,23]],[[7,25]],[[7,27]],[[6,1]],[[6,3]],["STYLE",{},".patient-combobox {\r\n  position: relative;\r\n  min-width: 0;\r\n}\r\n\r\n.patient-combobox__control {\r\n  position: relative;\r\n}\r\n\r\n.patient-combobox__search-icon {\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 12px;\r\n  z-index: 1;\r\n  width: 18px;\r\n  height: 18px;\r\n  color: var(--text-muted);\r\n  pointer-events: none;\r\n  transform: translateY(-50%);\r\n}\r\n\r\n.patient-combobox__search-icon svg,\r\n.patient-combobox__clear svg {\r\n  width: 18px;\r\n  height: 18px;\r\n}\r\n\r\n.patient-combobox .patient-combobox__input {\r\n  min-width: 0;\r\n  width: 100%;\r\n  padding-right: 46px;\r\n  padding-left: 40px;\r\n}\r\n\r\n.patient-combobox__clear {\r\n  position: absolute;\r\n  top: 50%;\r\n  right: 4px;\r\n  display: grid;\r\n  width: 44px;\r\n  height: 44px;\r\n  padding: 0;\r\n  border: 0;\r\n  border-radius: 7px;\r\n  color: var(--text-muted);\r\n  background: transparent;\r\n  cursor: pointer;\r\n  place-items: center;\r\n  transform: translateY(-50%);\r\n}\r\n\r\n.patient-combobox__clear:hover,\r\n.patient-combobox__clear:focus-visible {\r\n  color: var(--blue);\r\n  background: var(--blue-dim);\r\n}\r\n\r\n.patient-combobox__help {\r\n  margin: 5px 0 0;\r\n  color: var(--text-muted);\r\n  font-size: 11.5px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.patient-combobox__selection {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 9px;\r\n  min-width: 0;\r\n  margin-top: 8px;\r\n  padding: 9px 11px;\r\n  border: 1px solid color-mix(in srgb, var(--emerald) 28%, var(--border));\r\n  border-radius: 8px;\r\n  color: var(--text);\r\n  background: var(--emerald-bg);\r\n}\r\n\r\n.patient-combobox__selection-icon {\r\n  display: grid;\r\n  width: 26px;\r\n  height: 26px;\r\n  flex: 0 0 26px;\r\n  border-radius: 50%;\r\n  color: var(--emerald);\r\n  background: var(--surface);\r\n  place-items: center;\r\n}\r\n\r\n.patient-combobox__selection-icon svg {\r\n  width: 15px;\r\n  height: 15px;\r\n}\r\n\r\n.patient-combobox__popup {\r\n  position: absolute;\r\n  top: calc(100% + 6px);\r\n  left: 0;\r\n  right: 0;\r\n  z-index: 250;\r\n  overflow: hidden;\r\n  border: 1px solid var(--border-strong, var(--border));\r\n  border-radius: 9px;\r\n  background: var(--surface);\r\n  box-shadow: 0 12px 30px rgba(20, 39, 72, 0.16);\r\n}\r\n\r\n.patient-combobox__list {\r\n  max-height: min(320px, 40vh);\r\n  margin: 0;\r\n  padding: 4px;\r\n  overflow-y: auto;\r\n  list-style: none;\r\n}\r\n\r\n.patient-combobox__option {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr);\r\n  gap: 12px;\r\n  align-items: center;\r\n  min-height: 52px;\r\n  padding: 8px 10px;\r\n  border-radius: 7px;\r\n  cursor: pointer;\r\n}\r\n\r\n.patient-combobox__option.is-active,\r\n.patient-combobox__option:hover {\r\n  background: var(--blue-dim);\r\n  box-shadow: inset 3px 0 0 var(--blue);\r\n}\r\n\r\n.patient-combobox__option-name {\r\n  overflow: hidden;\r\n  color: var(--text);\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.patient-combobox__option-identity {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-end;\r\n  color: var(--text-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 10.5px;\r\n  line-height: 1.35;\r\n}\r\n\r\n.patient-combobox__option-identity strong {\r\n  color: var(--text);\r\n  font-size: 11px;\r\n}\r\n\r\n.patient-combobox__status {\r\n  margin: 0;\r\n  padding: 13px 14px;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n}\r\n\r\n.patient-combobox__status--error {\r\n  color: var(--red);\r\n}\r\n\r\n@media (max-width: 520px) {\r\n  .patient-combobox__option {\r\n    grid-template-columns: 1fr;\r\n    gap: 3px;\r\n  }\r\n\r\n  .patient-combobox__option-identity {\r\n    align-items: flex-start;\r\n  }\r\n}\r\n"],["STYLE",{},".tdose-list {\r\n  list-style: none;\r\n  margin: 6px 0 0;\r\n  padding: 0;\r\n  display: grid;\r\n  gap: 4px;\r\n  text-align: left;\r\n}\r\n.tdose {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1px;\r\n  padding: 3px 6px;\r\n  border-left: 3px solid var(--blue);\r\n  border-radius: 4px;\r\n  background: var(--surface, #fff);\r\n  font-size: 11.5px;\r\n  line-height: 1.35;\r\n  overflow-wrap: anywhere;\r\n}\r\n.tdose__who {\r\n  font-weight: 650;\r\n  color: var(--text);\r\n}\r\n.tdose__what {\r\n  color: var(--text);\r\n}\r\n.tdose__status {\r\n  font-weight: 600;\r\n  color: #1d4fc4;\r\n}\r\n.tdose--late,\r\n.tdose--missed {\r\n  border-left-color: var(--red);\r\n}\r\n.tdose--late .tdose__status,\r\n.tdose--missed .tdose__status {\r\n  color: #a5202f;\r\n}\r\n.tdose--done {\r\n  border-left-color: #16a37b;\r\n}\r\n.tdose--done .tdose__status {\r\n  color: #0e7a55;\r\n}\r\n.tdose-list__partial {\r\n  margin: 4px 0 0;\r\n  font-size: 11.5px;\r\n  color: var(--text-muted);\r\n}\r\n"],["STYLE",{},".therapy-modal .therapy-modal__body {\r\n  min-height: 0;\r\n  padding-top: 0;\r\n  scroll-padding-block: 160px 16px;\r\n}\r\n.therapy-modal .therapy-patient-group {\r\n  min-width: 0;\r\n  margin-bottom: 18px;\r\n  border: 1px solid var(--border, #dce3ec);\r\n  border-radius: 8px;\r\n  background: var(--surface, #fff);\r\n}\r\n.therapy-modal .therapy-patient-header {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 2;\r\n  margin: 0;\r\n  padding: 12px 16px;\r\n  border-top: 0;\r\n  border-bottom: 2px solid var(--border, #dce3ec);\r\n  border-radius: 7px 7px 0 0;\r\n  background: var(--surface, #fff);\r\n  box-shadow: 0 3px 5px rgb(26 51 87 / 8%);\r\n}\r\n.therapy-modal .patient-identity__name {\r\n  font-size: 18px;\r\n  font-weight: 750;\r\n}\r\n.therapy-modal .therapy-drug-row {\r\n  padding-block: 12px;\r\n  flex-wrap: wrap;\r\n}\r\n.therapy-modal .therapy-drug-row__info {\r\n  min-width: 0;\r\n  flex-basis: 180px;\r\n  overflow-wrap: anywhere;\r\n}\r\n.therapy-modal .therapy-drug-row__actions {\r\n  flex-wrap: wrap;\r\n  min-width: 0;\r\n  max-width: 100%;\r\n}\r\n.therapy-modal button,\r\n.therapy-modal input {\r\n  min-height: 44px;\r\n}\r\n.therapy-modal button {\r\n  white-space: normal;\r\n  overflow-wrap: anywhere;\r\n}\r\n.therapy-modal button:focus-visible,\r\n.therapy-modal input:focus-visible {\r\n  outline: 2px solid var(--blue, #2463eb);\r\n  outline-offset: 3px;\r\n}\r\n.therapy-modal .therapy-modal__footer,\r\n.therapy-modal .therapy-modal__footer > div {\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n@media (max-width: 520px) {\r\n  .therapy-modal .therapy-modal__body {\r\n    padding: 0 8px 8px;\r\n  }\r\n  .therapy-modal .therapy-patient-header,\r\n  .therapy-modal .therapy-drug-row {\r\n    padding-inline: 12px;\r\n  }\r\n  .therapy-modal .therapy-drug-row__actions {\r\n    width: 100%;\r\n  }\r\n  .therapy-modal .therapy-motivi-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Agenda — informazione senza tocchi (UX direct-access, 2026-10-03). Condiviso da agenda\r\n   operatore e multi-operatore: nota sempre visibile, stato in parole (non solo colore), nome\r\n   dell'operatore accanto al pallino, mese senza «+N» (la cella cresce). Testo che va a capo. */\r\n.agt-note-inline {\r\n  white-space: pre-wrap;\r\n  overflow-wrap: anywhere;\r\n  font-size: 13px;\r\n  line-height: 18px;\r\n}\r\n.agt-inline-apt {\r\n  flex-wrap: wrap;\r\n  align-items: flex-start;\r\n  row-gap: 2px;\r\n  height: auto;\r\n}\r\n.agt-inline-apt .agt-week-apt__name,\r\n.agt-inline-apt .agt-month-apt__name {\r\n  white-space: normal;\r\n  overflow: visible;\r\n  text-overflow: clip;\r\n  overflow-wrap: anywhere;\r\n}\r\n.agt-inline-meta {\r\n  flex-basis: 100%;\r\n  min-width: 0;\r\n  font-size: 11px;\r\n  line-height: 15px;\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n}\r\n.agt-inline-meta strong {\r\n  font-weight: 700;\r\n  color: var(--text);\r\n}\r\n/* Mese: la cella mostra tutti gli appuntamenti e cresce in altezza. */\r\n.agt-month-day {\r\n  height: auto;\r\n}\r\n.agt-month-day__apts {\r\n  overflow: visible;\r\n}\r\n"]],[[12,30]],["BODY",{},[[12,31]],["DIV",{"id":"root"},["DIV",{"class":"app-shell app-shell--nav-open"},[[2,0]],["NAV",{"class":"teams-sidebar","aria-label":"Navigazione principale"},[[7,32]],["DIV",{"class":"teams-sidebar__nav"},[[7,38]],[[7,44]],[[7,50]],["BUTTON",{"__playwright_target__":"","type":"button","class":"teams-sidebar__item","title":"Parametri"},[[7,53]],[[7,55]]],[[7,62]],[[7,68]],[[7,74]]],[[7,76]]],[[1,2]]]],[[12,65]],[[12,66]]]],"viewport":{"width":853,"height":1138},"timestamp":71318.447,"wallTime":1792890301922,"collectionTime":1,"resourceOverrides":[],"isMainFrame":true}}
