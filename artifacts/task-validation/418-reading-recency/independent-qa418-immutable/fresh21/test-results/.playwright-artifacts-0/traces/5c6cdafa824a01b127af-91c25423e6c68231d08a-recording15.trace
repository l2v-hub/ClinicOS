{"type":"before","callId":"call@15230","startTime":70702.999,"class":"Route","method":"fulfill","params":{"status":200,"headers":[{"name":"content-type","value":"application/json"},{"name":"content-length","value":"1559"}],"body":"{\"id\":\"QA-418-NURSE\",\"name\":\"Infermiere QA418\",\"roleLabel\":\"Infermiere\",\"appRole\":\"nurse\",\"uiShell\":\"operator\",\"role\":\"operatore\",\"authMode\":\"disabled\",\"temporaryDemo\":false,\"capabilities\":{\"patients.list_page\":{\"allowed\":true,\"effect\":\"ALLOWED\"},\"patients.get\":{\"allowed\":true,\"effect\":\"ALLOWED\"},\"patients.clinical_summary\":{\"allowed\":true,\"effect\":\"ALLOWED\"},\"patients.clinical_overview\":{\"allowed\":true,\"effect\":\"ALLOWED\"},\"appointments.list\":{\"allowed\":true,\"effect\":\"ALLOWED\"},\"consegne.list\":{\"allowed\":true,\"effect\":\"ALLOWED\"},\"notes.list\":{\"allowed\":true,\"effect\":\"ALLOWED\"},\"operators.directory\":{\"allowed\":true,\"effect\":\"ALLOWED\"},\"administration.list_slots\":{\"allowed\":true,\"effect\":\"ALLOWED\"},\"therapy.list\":{\"allowed\":true,\"effect\":\"ALLOWED\"},\"therapy.list_page\":{\"allowed\":true,\"effect\":\"ALLOWED\"},\"clinical_record.get\":{\"allowed\":true,\"effect\":\"ALLOWED\"},\"clinical_record.update\":{\"allowed\":true,\"effect\":\"ALLOWED\"},\"diary.list\":{\"allowed\":true,\"effect\":\"ALLOWED\"},\"parameters.list_readings\":{\"allowed\":true,\"effect\":\"ALLOWED\"},\"narrative.list\":{\"allowed\":true,\"effect\":\"ALLOWED\"},\"narrative.update\":{\"allowed\":true,\"effect\":\"ALLOWED\"},\"documents.list\":{\"allowed\":true,\"effect\":\"ALLOWED\"},\"parameters.list_page\":{\"allowed\":true,\"effect\":\"ALLOWED\"},\"parameters.create_reading\":{\"allowed\":true,\"effect\":\"ALLOWED\"},\"parameters.save_reading\":{\"allowed\":true,\"effect\":\"ALLOWED\"},\"assessments.catalog\":{\"allowed\":true,\"effect\":\"ALLOWED\"},\"assessments.list\":{\"allowed\":true,\"effect\":\"ALLOWED\"},\"assessments.read\":{\"allowed\":true,\"effect\":