-content: space-between;\r\n  gap: 12px;\r\n  align-items: center;\r\n  margin-top: 12px;\r\n}\r\n.parameter-single-entry__actions > span {\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n}\r\n.parameter-single-entry__success {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px 16px;\r\n  margin-top: 12px;\r\n  padding: 10px 12px;\r\n  font-size: 13px;\r\n  color: #216345;\r\n  background: #edf8f2;\r\n  border-radius: 8px;\r\n}\r\n.parameter-workspace-records {\r\n  min-width: 0;\r\n}\r\n.parameter-workspace-records__heading {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  margin-bottom: 12px;\r\n}\r\n.parameter-workspace-period .filter-chips {\r\n  margin: 0;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n.parameter-workspace-period .filter-chip {\r\n  min-height: 36px;\r\n}\r\n.parameter-workspace-period .parameter-trends-range {\r\n  margin-top: 12px;\r\n}\r\n.parameter-workspace-summary {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  padding: 14px 0;\r\n  margin-bottom: 4px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n.parameter-workspace-summary > div {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px 16px;\r\n  align-items: center;\r\n  font-size: 13px;\r\n}\r\n.parameter-workspace-summary span {\r\n  color: var(--text-muted);\r\n}\r\n.parameter-workspace .parameter-workspace-graph-active {\r\n  color: var(--blue);\r\n  background: #eaf1ff;\r\n  border-color: #c6d8fc;\r\n}\r\n.parameter-workspace-list-title {\r\n  font-size: 14px;\r\n  margin: 16px 0 10px;\r\n}\r\n.parameter-workspace .parameter-history-day {\r\n  margin: 14px 0 8px;\r\n}\r\n.parameter-workspace .parameter-history-reading {\r\n  padding: 12px 14px;\r\n}\r\n.parameter-workspace .parameter-trends--inline {\r\n  padding: 14px 0 8px;\r\n}\r\n.parameter-workspace .parameter-trends--inline > .parameter-trend-note {\r\n  margin-top: 10px;\r\n}\r\n.parameter-workspace .parameter-trend-chart {\r\n  margin: 12px 0;\r\n}\r\n.parameter-workspace button:focus-visible,\r\n.parameter-workspace summary:focus-visible {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 3px;\r\n}\r\n@media (max-width: 900px) {\r\n  .parameter-single-entry__fields {\r\n    grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  }\r\n}\r\n@media (max-width: 600px) {\r\n  .parameter-single-entry {\r\n    padding: 14px;\r\n  }\r\n  .parameter-single-entry__heading {\r\n    align-items: start;\r\n  }\r\n  .parameter-single-entry .parameter-entry-clock {\r\n    flex-direction: column;\r\n    align-items: flex-end;\r\n    gap: 4px;\r\n  }\r\n  .parameter-single-entry .parameter-entry-clock > span:last-child {\r\n    text-align: right;\r\n    max-width: 150px;\r\n    font-size: 11px;\r\n  }\r\n  .parameter-single-entry__fields {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n    gap: 12px;\r\n  }\r\n  .parameter-single-entry__actions {\r\n    flex-wrap: wrap;\r\n  }\r\n  .parameter-single-entry__actions button {\r\n    width: 100%;\r\n  }\r\n  .parameter-workspace button,\r\n  .parameter-workspace .form-input,\r\n  .parameter-workspace .filter-chip {\r\n    min-height: 44px;\r\n  }\r\n  .parameter-workspace-summary > div {\r\n    display: grid;\r\n  }\r\n  .parameter-workspace-summary {\r\n    align-items: start;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Unified screen contract for structured data inside the patient record.\r\n   Print forms intentionally keep their dedicated A4 rules from print-forms.css. */\r\n@media screen {\r\n  .patient-record-view {\r\n    --patient-data-radius: 12px;\r\n    --patient-data-header-height: 46px;\r\n    --patient-data-row-height: 46px;\r\n    --patient-data-cell-x: 14px;\r\n    --patient-data-header-bg: var(--surface-raised, #f3f6fb);\r\n    --patient-data-label-bg: var(--surface-raised, #f3f6fb);\r\n    --patient-data-border: var(--border, #e6ebf2);\r\n  }\r\n\r\n  .patient-diary-filters {\r\n    align-self: flex-start;\r\n    max-width: calc(100% - 48px);\r\n    margin: 8px 24px 12px;\r\n    box-sizing: border-box;\r\n  }\r\n\r\n  /* One surface and one header treatment for every clinical section. */\r\n  .patient-record-view :is(.clinical-card, .cts, .cr-profilo-group, .narrative-section) {\r\n    background: var(--surface, #fff);\r\n    border: 1px solid var(--patient-data-border);\r\n    border-radius: var(--patient-data-radius);\r\n    box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04);\r\n    overflow: hidden;\r\n  }\r\n\r\n  .patient-record-view .clinical-card + .clinical-card {\r\n    margin-top: 12px;\r\n  }\r\n\r\n  .patient-record-view :is(.clinical-card__header, .cts__header) {\r\n    width: 100%;\r\n    min-height: var(--patient-data-header-height);\r\n    height: auto;\r\n    padding: 7px var(--patient-data-cell-x);\r\n    background: var(--patient-data-header-bg);\r\n    border: 0;\r\n    border-bottom: 1px solid var(--patient-data-border);\r\n    color: var(--text, #16202e);\r\n  }\r\n\r\n  .patient-record-view .clinical-card__title,\r\n  .patient-record-view .cts__title {\r\n    margin: 0;\r\n    color: var(--text, #16202e);\r\n    font-size: 13px;\r\n    font-weight: 700;\r\n    letter-spacing: 0.01em;\r\n    text-transform: none;\r\n  }\r\n\r\n  .patient-record-view :is(.clinical-card__actions, .cts__header-right) {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 6px;\r\n  }\r\n\r\n  .patient-record-view .clinical-card__edit,\r\n  .patient-record-view .cts__header-right .btn-sm {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    min-height: 32px;\r\n    padding: 5px 10px;\r\n    border: 1px solid #cfd9ea;\r\n    border-radius: 8px;\r\n    background: var(--surface, #fff);\r\n    color: var(--blue, #2f6bed);\r\n    font-size: 12px;\r\n    font-weight: 700;\r\n    line-height: 1;\r\n  }\r\n\r\n  .patient-record-view .clinical-card__edit:hover,\r\n  .patient-record-view .cts__header-right .btn-sm:hover {\r\n    border-color: #9cb8f4;\r\n    background: var(--indigo-bg, #eef3fe);\r\n  }\r\n\r\n  .patient-record-view .clinical-card__content-inner:has(> :is(.cr-form-section, .pic-edit-form)) {\r\n    padding: 0;\r\n  }\r\n\r\n  .patient-record-view .clinical-card .cr-form-section {\r\n    gap: 0;\r\n    padding: 0;\r\n    border: 0;\r\n    border-radius: 0;\r\n    box-shadow: none;\r\n  }\r\n\r\n  .patient-record-view .pic-edit-form {\r\n    gap: 12px;\r\n    padding: 16px;\r\n    background: var(--surface-raised, #f3f6fb);\r\n  }\r\n\r\n  /* Canonical key/value data row used by intake, profile and legacy summaries. */\r\n  .patient-record-view .pic-row {\r\n    display: grid;\r\n    grid-template-columns: minmax(180px, 34%) minmax(0, 1fr);\r\n    align-items: stretch;\r\n    gap: 0;\r\n    min-height: var(--patient-data-row-height);\r\n    padding: 0;\r\n    border-bottom: 1px solid var(--divider, #f0f3f8);\r\n    font-size: 13.5px;\r\n  }\r\n\r\n  .patient-record-view .pic-row:last-child {\r\n    border-bottom: 0;\r\n  }\r\n\r\n  .patient-record-view .pic-row__lbl,\r\n  .patient-record-view .pic-row__val {\r\n    display: flex;\r\n    min-width: 0;\r\n    padding: 10px var(--patient-data-cell-x);\r\n    align-items: center;\r\n  }\r\n\r\n  .patient-record-view .pic-row__lbl {\r\n    background: var(--patient-data-label-bg);\r\n    color: var(--text-muted, #5a6b80);\r\n    font-size: 12.5px;\r\n    font-weight: 600;\r\n  }\r\n\r\n  .patient-record-view .pic-row__val {\r\n    justify-content: flex-end;\r\n    margin: 0;\r\n    color: var(--text, #16202e);\r\n    font-size: 13.5px;\r\n    font-weight: 600;\r\n    text-align: right;\r\n    overflow-wrap: anywhere;\r\n  }\r\n\r\n  .patient-record-view\r\n    .inline-edit-row:is(:hover, :focus-visible)\r\n    > :is(.pic-row__lbl, .pic-row__val) {\r\n    background: var(--indigo-bg, #eef3fe);\r\n  }\r\n\r\n  .patient-record-view .pic-row--danger > :is(.pic-row__lbl, .pic-row__val) {\r\n    background: #fef2f2;\r\n    color: #b42318;\r\n  }\r\n\r\n  .patient-record-view\r\n    .pic-row--danger:is(:hover, :focus-visible)\r\n    > :is(.pic-row__lbl, .pic-row__val) {\r\n    background: #fee4e2;\r\n  }\r\n\r\n  .patient-record-view .pic-row .inline-edit__value {\r\n    align-self: center;\r\n    justify-self: end;\r\n    min-height: 34px;\r\n    margin: 5px 8px;\r\n    padding: 5px 8px;\r\n  }\r\n\r\n  .patient-record-view .pic-row--editing {\r\n    align-items: stretch;\r\n    padding: 0;\r\n    background: var(--surface-raised, #f3f6fb);\r\n  }\r\n\r\n  .patient-record-view .pic-row--editing .inline-edit__control {\r\n    padding: 6px 8px;\r\n  }\r\n\r\n  /* Profile data follows the same label/value hierarchy without nested-card shadows. */\r\n  .patient-record-view .cr-profilo-grid {\r\n    gap: 12px;\r\n  }\r\n\r\n  .patient-record-view .cr-profilo-group {\r\n    padding: 0;\r\n    gap: 0;\r\n  }\r\n\r\n  .patient-record-view .cr-profilo-group__title {\r\n    min-height: 42px;\r\n    margin: 0;\r\n    padding: 12px var(--patient-data-cell-x);\r\n    background: var(--patient-data-header-bg);\r\n    border-bottom: 1px solid var(--patient-data-border);\r\n    color: var(--text, #16202e);\r\n    font-size: 12px;\r\n    font-weight: 700;\r\n    letter-spacing: 0.04em;\r\n  }\r\n\r\n  .patient-record-view .cr-profilo-row {\r\n    display: grid;\r\n    grid-template-columns: minmax(120px, 42%) minmax(0, 1fr);\r\n    align-items: stretch;\r\n    gap: 0;\r\n    min-height: 42px;\r\n    border-bottom: 1px solid var(--divider, #f0f3f8);\r\n    font-size: 13px;\r\n  }\r\n\r\n  .patient-record-view .cr-profilo-row:last-child {\r\n    border-bottom: 0;\r\n  }\r\n\r\n  .patient-record-view .cr-profilo-row > :is(span:first-child, strong) {\r\n    display: flex;\r\n    align-items: center;\r\n    min-width: 0;\r\n    padding: 9px var(--patient-data-cell-x);\r\n  }\r\n\r\n  .patient-record-view .cr-profilo-row > span:first-child {\r\n    background: var(--patient-data-label-bg);\r\n    color: var(--text-muted, #5a6b80);\r\n    font-weight: 600;\r\n  }\r\n\r\n  .patient-record-view .cr-profilo-row > strong {\r\n    justify-content: flex-end;\r\n    color: var(--text, #16202e);\r\n    font-weight: 600;\r\n    text-align: right;\r\n  }\r\n\r\n  /* Narrative and list-like records share the same restrained chrome. */\r\n  .patient-record-view :is(.cr-item-row, .diario-card) {\r\n    border: 1px solid var(--patient-data-border);\r\n    border-radius: var(--patient-data-radius);\r\n    background: var(--surface, #fff);\r\n    box-shadow: none;\r\n  }\r\n\r\n  .patient-record-view .cr-legacy-anamnesi-row {\r\n    display: grid;\r\n    grid-template-columns: minmax(180px, 34%) minmax(0, 1fr);\r\n    gap: 0;\r\n    padding: 0;\r\n    border-bottom: 1px solid var(--divider, #f0f3f8);\r\n  }\r\n\r\n  .patient-record-view .cr-legacy-anamnesi-row__label,\r\n  .patient-record-view .cr-legacy-anamnesi-row__value {\r\n    margin: 0;\r\n    padding: 10px var(--patient-data-cell-x);\r\n  }\r\n\r\n  .patient-record-view .cr-legacy-anamnesi-row__label {\r\n    background: var(--patient-data-label-bg);\r\n    font-size: 12.5px;\r\n    letter-spacing: 0.01em;\r\n    text-transform: none;\r\n  }\r\n\r\n  /* Every semantic and module table receives the same screen-only table contract. */\r\n  .patient-record-view\r\n    :is(\r\n      .clinicos-table,\r\n      .parametri-modulo-table,\r\n      .braden-modulo-table,\r\n      .med-modulo-table,\r\n      .med-followup-table\r\n    ) {\r\n    width: 100%;\r\n    border-collapse: separate;\r\n    border-spacing: 0;\r\n    border: 1px solid var(--patient-data-border);\r\n    border-radius: var(--patient-data-radius);\r\n    background: var(--surface, #fff);\r\n    color: var(--text, #16202e);\r\n    font-family: var(--font-ui);\r\n    font-size: 13px;\r\n    overflow: hidden;\r\n  }\r\n\r\n  .patient-record-view\r\n    :is(\r\n      .clinicos-table,\r\n      .parametri-modulo-table,\r\n      .braden-modulo-table,\r\n      .med-modulo-table,\r\n      .med-followup-table\r\n    )\r\n    thead\r\n    th {\r\n    min-height: 42px;\r\n    padding: 10px var(--patient-data-cell-x);\r\n    background: var(--patient-data-header-bg);\r\n    border: 0;\r\n    border-bottom: 1px solid var(--patient-data-border);\r\n    color: var(--text-muted, #5a6b80);\r\n    font-family: var(--font-ui);\r\n    font-size: 11.5px;\r\n    font-weight: 700;\r\n    letter-spacing: 0.04em;\r\n    line-height: 1.25;\r\n    text-align: left;\r\n    text-transform: uppercase;\r\n  }\r\n\r\n  .patient-record-view\r\n    :is(\r\n      .clinicos-table,\r\n      .parametri-modulo-table,\r\n      .braden-modulo-table,\r\n      .med-modulo-table,\r\n      .med-followup-table\r\n    )\r\n    tbody\r\n    td {\r\n    min-height: var(--patient-data-row-height);\r\n    height: auto;\r\n    padding: 10px var(--patient-data-cell-x);\r\n    border: 0;\r\n    border-bottom: 1px solid var(--divider, #f0f3f8);\r\n    background: var(--surface, #fff);\r\n    color: var(--text, #16202e);\r\n    font-family: var(--font-ui);\r\n    font-size: 13px;\r\n    vertical-align: middle;\r\n  }\r\n\r\n  .patient-record-view\r\n    :is(\r\n      .clinicos-table,\r\n      .parametri-modulo-table,\r\n      .braden-modulo-table,\r\n      .med-modulo-table,\r\n      .med-followup-table\r\n    )\r\n    tbody\r\n    tr:nth-child(even):not(.totale-row)\r\n    > td {\r\n    background: var(--surface-raised, #f3f6fb);\r\n  }\r\n\r\n  .patient-record-view\r\n    :is(\r\n      .clinicos-table,\r\n      .parametri-modulo-table,\r\n      .braden-modulo-table,\r\n      .med-modulo-table,\r\n      .med-followup-table\r\n    )\r\n    tbody\r\n    tr:not(.totale-row):hover\r\n    > td {\r\n    background: var(--indigo-bg, #eef3fe);\r\n  }\r\n\r\n  .patient-record-view\r\n    :is(\r\n      .clinicos-table,\r\n      .parametri-modulo-table,\r\n      .braden-modulo-table,\r\n      .med-modulo-table,\r\n      .med-followup-table\r\n    )\r\n    tbody\r\n    tr:last-child\r\n    > td {\r\n    border-bottom: 0;\r\n  }\r\n\r\n  .patient-record-view .clinicos-table-wrap {\r\n    margin-bottom: 12px;\r\n    border: 0;\r\n    border-radius: var(--patient-data-radius);\r\n    box-shadow: none;\r\n    overflow-x: auto;\r\n    scrollbar-gutter: stable;\r\n  }\r\n\r\n  .patient-record-view :is(.fm, .modulo-content, .clinical-card__content-inner) {\r\n    max-width: 100%;\r\n  }\r\n\r\n  .patient-record-view :is(.fm, .modulo-content) {\r\n    overflow-x: auto;\r\n    scrollbar-gutter: stable;\r\n  }\r\n\r\n  /* Horizontal rails stay available to touch, trackpads and keyboard-focused controls,\r\n     but do not add a second visual hierarchy made of native scrollbar tracks. */\r\n  .patient-record-view\r\n    :is(.top-nav__items, .clinicos-table-wrap, .parametri-grid-wrapper, .fm, .modulo-content) {\r\n    -ms-overflow-style: none;\r\n    scrollbar-width: none;\r\n  }\r\n\r\n  .patient-record-view\r\n    :is(\r\n      .top-nav__items,\r\n      .clinicos-table-wrap,\r\n      .parametri-grid-wrapper,\r\n      .fm,\r\n      .modulo-content\r\n    )::-webkit-scrollbar {\r\n    display: none;\r\n    width: 0;\r\n    height: 0;\r\n  }\r\n\r\n  .patient-record-view\r\n    :is(\r\n      .clinical-card__header,\r\n      .cts__header,\r\n      .clinical-card__edit,\r\n      .inline-edit-row\r\n    ):focus-visible {\r\n    outline: 3px solid color-mix(in srgb, var(--blue, #2f6bed) 30%, transparent);\r\n    outline-offset: -2px;\r\n  }\r\n\r\n  @media (max-width: 768px) {\r\n    .patient-record-view {\r\n      --patient-data-cell-x: 12px;\r\n    }\r\n\r\n    .patient-record-view .pic-row,\r\n    .patient-record-view .cr-profilo-row,\r\n    .patient-record-view .cr-legacy-anamnesi-row {\r\n      grid-template-columns: minmax(0, 1fr);\r\n    }\r\n\r\n    .patient-record-view .pic-row__val,\r\n    .patient-record-view .cr-profilo-row > strong {\r\n      justify-content: flex-start;\r\n      text-align: left;\r\n    }\r\n\r\n    .patient-record-view .pic-row .inline-edit__value {\r\n      justify-self: stretch;\r\n      margin: 5px 8px;\r\n    }\r\n\r\n    .patient-record-view\r\n      :is(.parametri-modulo-table, .braden-modulo-table, .med-modulo-table, .med-followup-table) {\r\n      min-width: 680px;\r\n    }\r\n  }\r\n}\r\n/* Temporal urgency is separate from author role and historical acknowledgement. */\r\n.patient-record-view .diario-card.diario-card--urgent { border-left: 4px solid #b42335; background: #fffafb; }\r\n.patient-record-view .diario-card.diario-card--taken { border-left: 4px solid #8291a6; }\r\n.patient-record-view .cr-alert-band { margin: 16px 0 24px; gap: 12px; }\r\n@media screen {\r\n  .patient-record-view .cr-detail-content { display:flex; flex-direction:column; gap:16px; padding:0; }\r\n  .patient-record-view .chart-part { display:flex; flex:0 0 auto; flex-direction:column; gap:16px; margin:0; padding:0; }\r\n  .patient-record-view .cr-tab-content { display:flex; flex:0 0 auto; flex-direction:column; gap:16px; padding:0; margin:0; }\r\n  .patient-record-view :is(.cr-tab-content, .chart-part) > .cts { margin:0; }\r\n  .patient-record-view .assessment-catalog { margin-inline:0; }\r\n  .patient-record-view .cr-profilo-grid { grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr)); margin-top:0 !important; }\r\n}\r\n.patient-contacts { border-top:1px solid var(--border); margin-top:12px; padding-top:12px; }\r\n.patient-contacts__header { display:flex; align-items:center; justify-content:space-between; gap:12px; }\r\n.patient-contacts h4 { margin:0; }\r\n.patient-contacts dl { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr)); gap:8px 16px; margin:12px 0; }\r\n.patient-contacts dl > div { min-width:0; }\r\n.patient-contacts dt { color:var(--text-muted); font-size:12px; }\r\n.patient-contacts dd { margin:3px 0; overflow-wrap:anywhere; }\r\n.clinical-card__content[hidden] { display:none !important; }\r\n.patient-record-view .narrative-sections { display:flex; flex-direction:column; gap:16px; margin:0; padding:0; }\r\n.patient-record-view .narrative-sections:empty { display:none; }\r\n@media print { .clinical-card__content[hidden] { display:block !important; height:auto !important; } }\r\n.patient-record-view .cr-alert-strip { min-height: 48px; padding: 12px 16px; gap: 12px; border-radius: 12px; line-height: 1.5; }\r\n.patient-record-view .cr-alert-strip--allergie { color: #8f5500; background: #fdf3e2; border: 1px solid #ead0a7; border-left: 4px solid #8f5500; }\r\n.patient-record-view .cr-alert-strip--allergie:hover { background: #fae9cc; }\r\n.patient-record-view .cr-alert-strip--allergie.cr-alert-strip--severe {\r\n  color: #b42335;\r\n  background: #fdecee;\r\n  border-color: #efc3cb;\r\n  border-left-color: #b42335;\r\n}\r\n.patient-record-view .cr-alert-strip--allergie.cr-alert-strip--severe:hover { background: #fbe0e5; }\r\n.patient-record-view .cr-alert-strip > span { overflow-wrap: anywhere; }\r\n.patient-record-view .patient-allergy-strip { margin-bottom: 20px; padding: 12px 16px; background: #fdf3e2; border-color: #ead0a7; color: #8f5500; }\r\n"],["STYLE",{},"/* Compact overview only; full clinical editors and handoff cards keep their layout. */\r\n.patient-record-view .cr-tab-content--overview {\r\n  gap: 12px;\r\n}\r\n\r\n.patient-record-view .cr-overview-section {\r\n  padding: 12px;\r\n}\r\n\r\n.patient-record-view .cr-overview-section__header {\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-riepilogo-grid {\r\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));\r\n  gap: 10px;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-riepilogo-card {\r\n  gap: 4px;\r\n  padding: 10px 12px 4px;\r\n  border-left-width: 3px;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-riepilogo-card__title {\r\n  min-height: 24px;\r\n  grid-template-columns: 16px minmax(0, 1fr) auto;\r\n  gap: 6px;\r\n  font-size: 13px;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-overview-count {\r\n  grid-column: auto;\r\n  justify-self: end;\r\n  min-height: 22px;\r\n  max-width: 130px;\r\n  padding: 2px 6px;\r\n  font-size: 10.5px;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-empty {\r\n  margin: 2px 0;\r\n  font-size: 12.5px;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-overview-action {\r\n  min-height: 44px;\r\n  margin-top: 0;\r\n  padding: 5px 0;\r\n  font-weight: 700;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-compact-item {\r\n  gap: 4px 6px;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-compact-item__main {\r\n  white-space: normal;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-compact-item__sub {\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n/* Keep the complete narrative in the diagnosis dialog, with a bounded overview. */\r\n.patient-record-view .cr-tab-content--overview .cr-riepilogo-card--diagnosi {\r\n  display: grid;\r\n  grid-template-rows: auto minmax(0, 1fr) auto;\r\n  height: 10rem;\r\n}\r\n\r\n.patient-record-view .cr-riepilogo-card--diagnosi .cr-compact-list {\r\n  min-height: 0;\r\n  overflow: hidden;\r\n  gap: 4px;\r\n}\r\n\r\n.patient-record-view .cr-riepilogo-card--diagnosi .cr-compact-item {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) auto auto;\r\n  align-items: start;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.patient-record-view .cr-riepilogo-card--diagnosi .cr-compact-item__main {\r\n  display: -webkit-box;\r\n  -webkit-box-orient: vertical;\r\n  -webkit-line-clamp: 1;\r\n  overflow: hidden;\r\n  line-height: 1.35;\r\n}\r\n\r\n.patient-record-view\r\n  .cr-riepilogo-card--diagnosi\r\n  .cr-compact-item:only-child\r\n  .cr-compact-item__main {\r\n  -webkit-line-clamp: 3;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-compact-item--farmaco {\r\n  grid-template-columns: minmax(0, 1fr) minmax(0, 0.65fr);\r\n  align-items: start;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-compact-item__dose {\r\n  white-space: normal;\r\n  overflow-wrap: anywhere;\r\n  text-align: right;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-compact-item--farmaco .cr-compact-item__sub {\r\n  grid-column: 1 / -1;\r\n}\r\n\r\n.patient-record-view .cr-riepilogo-card--allergie .cr-compact-item {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) auto;\r\n}\r\n\r\n.patient-record-view .cr-riepilogo-card--allergie .cr-compact-item__main {\r\n  grid-column: 1 / -1;\r\n}\r\n\r\n.cr-overview-handoffs {\r\n  display: grid;\r\n  gap: 6px;\r\n  margin: 2px 0;\r\n  padding: 0;\r\n  list-style: none;\r\n}\r\n\r\n.cr-overview-handoff + .cr-overview-handoff {\r\n  padding-top: 6px;\r\n  border-top: 1px solid var(--border, #e3e9f1);\r\n}\r\n\r\n.cr-overview-handoff .consegna-card__top {\r\n  gap: 6px;\r\n  margin: 0;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.cr-overview-handoff__note {\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 2;\r\n  -webkit-box-orient: vertical;\r\n  overflow: hidden;\r\n  overflow-wrap: anywhere;\r\n  margin: 2px 0 0;\r\n  color: var(--text-muted, #65778c);\r\n  font-size: 12.5px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.cr-overview-placement {\r\n  display: grid;\r\n  gap: 3px;\r\n  margin: 2px 0;\r\n  font-size: 12.5px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.cr-overview-placement > div {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 10px;\r\n}\r\n\r\n.cr-overview-placement dt {\r\n  color: var(--text-muted, #65778c);\r\n}\r\n\r\n.cr-overview-placement dd {\r\n  margin: 0;\r\n  font-weight: 500;\r\n  text-align: right;\r\n  overflow-wrap: anywhere;\r\n  min-width: 0;\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  .patient-record-view .cr-overview-section {\r\n    padding: 10px;\r\n  }\r\n\r\n  .patient-record-view .cr-tab-content--overview .cr-riepilogo-grid {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }