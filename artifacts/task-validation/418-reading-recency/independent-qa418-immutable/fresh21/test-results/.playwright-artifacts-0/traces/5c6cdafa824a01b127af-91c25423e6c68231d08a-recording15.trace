{"type":"frame-snapshot","snapshot":{"callId":"call@15456","snapshotName":"after@call@15456","pageId":"page@b0d04129d368ecaa701b8a9f4ab6d246","frameId":"frame@2df4bc428c602a34604ffd251e6e1b00","frameUrl":"http://127.0.0.1:7483/#/parametri-multipaziente","doctype":"html","html":["HTML",{"lang":"it"},["HEAD",{},[[21,0]],[[21,1]],[[21,2]],[[21,3]],[[21,4]],[[21,5]],[[21,6]],[[21,7]],[[21,8]],[[21,9]],[[21,10]],[[21,11]],[[21,12]],[[21,13]],[[21,15]],[[21,16]],[[21,18]],[[21,20]],[[21,22]],[[21,24]],[[21,26]],[[21,28]],[[18,1]],[[18,3]],[[18,5]],[[18,7]],[[18,9]],[[18,11]],[[18,13]],[[17,1]],[[17,3]],[[17,5]],[[17,7]],[[17,9]],[[17,11]],[[17,13]],[[17,15]],[[16,1]],[[16,3]],[[16,5]],[[16,7]],[[16,9]],[[16,11]],[[16,13]],[[16,15]],[[16,17]],[[16,19]],[[16,21]],[[16,23]],[[16,25]],[[16,27]],[[15,1]],[[15,3]],[[9,1]],[[9,3]],[[9,5]],[[9,7]],[[8,1]],[[8,3]],[[8,5]],[[8,7]],[[6,1]],[[6,3]],[[6,5]],[[6,7]],[[6,9]],[[6,11]],[[6,13]],[[6,15]],[[2,1]],[[2,3]],["STYLE",{},".agnos-panel { height: 100dvh; max-width: 100%; }\r\n.agnos-panel > header, .agnos-panel > .agnos-intro,\r\n.agnos-workflow-status, .agnos-composer { flex-shrink: 0; }\r\n.agnos-panel .ai-drawer__body { min-height: 0; overscroll-behavior: contain; padding: 16px 24px; }\r\n/* HMI 1: testata alta come la barra in alto, titolo \"✧ Assistente\" viola, poi la dichiarazione. */\r\n.agnos-panel .ai-drawer__header { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 8px; min-height: 72px; padding: 12px 16px 12px 24px; box-sizing: border-box; }\r\n.agnos-panel .agnos-title { display: flex; align-items: center; gap: 8px; min-width: 0; margin: 0; font: 600 20px/28px var(--ds-font); color: var(--purple, #6c4bd1); }\r\n.agnos-panel .agnos-title svg { width: 20px; height: 20px; flex: none; }\r\n.agnos-intro { padding: 16px 24px 0; }\r\n.agnos-intro p { margin: 0; }\r\n.agnos-intro__text { font: 400 14px/20px var(--ds-font); color: var(--text-muted); }\r\n.agnos-intro .agnos-intro__scope { margin-top: 8px; font: 600 14px/20px var(--ds-font); color: var(--ds-blue-active); }\r\n.agnos-panel .agnos-compose { display: flex; flex-direction: column; align-items: stretch; gap: 8px; padding: 16px 24px; }\r\n.agnos-compose-row { display: flex; align-items: flex-end; gap: 8px; }\r\n.agnos-compose-label { font-size: 13px; font-weight: 650; color: var(--text); }\r\n/* il campo parte da una riga (48px) e cresce col testo o con la dettatura */\r\n.agnos-panel textarea.agnos-input { width: 100%; min-width: 0; min-height: 48px; height: auto; max-height: 150px; flex: auto; field-sizing: content; line-height: 24px; padding-block: 10px; resize: none; }\r\n.agnos-compose-actions { display: flex; align-items: center; justify-content: flex-end; gap: 8px; }\r\n.agnos-compose-help { margin: 0; padding: 0 12px 8px; font-size: 12px; color: var(--text-muted); line-height: 1.4; }\r\n.agnos-compose .agnos-compose-help { padding: 0; }\r\n.agnos-panel .agnos-voice-consent { padding: 0 14px max(8px, env(safe-area-inset-bottom)); }\r\n.agnos-voice-consent .link-btn { font-size: 12px; min-height: 28px; }\r\n.agnos-consent-prompt { padding: 16px; border-top: 1px solid var(--border); background: #f3f7fd; font-size: 13px; line-height: 1.5; }\r\n.agnos-consent-prompt > strong { display: block; font-size: 15px; color: var(--text); }\r\n.agnos-consent-prompt p { margin: 8px 0 12px; }\r\n.agnos-composer { max-height: 65%; overflow-y: auto; overscroll-behavior: contain; }\r\n.agnos-consent-prompt .agnos-compose-actions { flex-wrap: wrap; }\r\n.agnos-workflow-status { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; padding: 10px 14px; background: #eef4ff; border-bottom: 1px solid var(--border); color: #244676; font-size: 13px; line-height: 1.4; }\r\n.agnos-workflow-status > span:not(.agnos-workflow-spinner) { flex: 1 1 220px; }\r\n.agnos-workflow-status[data-phase='error'] { background: #fff7e8; color: #76501c; }\r\n.agnos-workflow-status .link-btn { font-size: 12px; min-height: 32px; }\r\n.agnos-workflow-spinner { width: 14px; height: 14px; flex: 0 0 14px; border: 2px solid #cbdaf2; border-top-color: #316dda; border-radius: 50%; animation: agnos-spin 900ms linear infinite; }\r\n.agnos-transcript-label { align-self: flex-end; font-size: 11px; color: var(--text-muted); }\r\n.agnos-proposed-text { padding: 12px; border: 1px solid var(--border); border-radius: 8px; background: white; }\r\n.agnos-proposed-text p, .agnos-preview .voice-preview__row dd { white-space: pre-wrap; overflow-wrap: anywhere; }\r\n.agnos-proposed-text p { margin: 8px 0 12px; line-height: 1.5; }\r\n.agnos-proposed-text summary { cursor: pointer; color: var(--blue); margin-bottom: 12px; }\r\n.agnos-approval-hint { font-size: 13px; line-height: 1.45; margin: 12px 0 8px; }\r\n.agnos-panel .voice-actions { flex-wrap: wrap; }\r\n.agnos-workflow-dock { position: fixed; bottom: max(52px, env(safe-area-inset-bottom)); right: 12px; z-index: 202; max-width: min(440px, calc(100vw - 24px)); padding: 12px; display: flex; align-items: center; flex-wrap: wrap; gap: 10px; background: white; border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 4px 20px #10284726; font-size: 13px; }\r\n.agnos-workflow-dock span { flex: 1 1 190px; }\r\n@keyframes agnos-spin { to { transform: rotate(360deg); } }\r\n@media (min-width: 1100px) {\r\n  .app-shell:has(.agnos-panel--workspace[aria-hidden='false']) .main-area-clean { margin-right: 420px; }\r\n}\r\n@media (max-width: 1099px) {\r\n  .agnos-panel--workspace { top: auto; bottom: 0; height: 76dvh; border-radius: 16px 16px 0 0; }\r\n}\r\n@media (max-width: 480px) {\r\n  .agnos-panel--workspace { top: 0; height: 100dvh; border-radius: 0; }\r\n  .agnos-panel .agnos-compose { padding: 12px 16px; }\r\n  .agnos-panel .ai-drawer__header { padding-left: 16px; }\r\n  .agnos-intro { padding: 12px 16px 0; }\r\n  .agnos-panel .ai-drawer__body { padding: 12px 16px; }\r\n}\r\n@media (prefers-reduced-motion: reduce) { .agnos-workflow-spinner { animation: none; } }\r\n@media print { .agnos-workflow-dock { display: none !important; } }\r\n"]],[[21,30]],["BODY",{},[[21,31]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},[[7,2]],["DIV",{"class":"main-area-clean"},[[6,23]],["MAIN",{"class":"page-content content-panel"},["DIV",{"class":"par-view"},["DIV",{"class":"par-grid"},["SECTION",{"class":"par-patients","aria-label":"Pazienti"},[[6,25]],["DIV",{"class":"par-search"},[[6,29]],["INPUT",{"__playwright_value_":"","class":"par-search__input","placeholder":"Cerca paziente","aria-label":"Cerca paziente per nome o camera","type":"search","value":"","style":""}]],[[5,2]],[[4,5]]],["SECTION",{"class":"par-form","aria-label":"Rilevazione di Sintetico QA, Caso"},[[6,59]],["FORM",{"class":"parameter-reading-form","aria-label":"Nuova rilevazione"},["DIV",{"class":"parameter-reading-form__layout"},["FIELDSET",{"class":"parameter-reading-form__fields"},[[6,61]],["LABEL",{"for":"_r_8_-fr","class":"parameter-reading-form__field"},[[6,66]],["INPUT",{"__playwright_value_":"","id":"_r_8_-fr","class":"form-input","aria-label":"Nuova rilevazione FR","aria-describedby":"_r_8_-fr-previous","placeholder":"—","inputmode":"numeric","type":"text","value":"","style":""}],[[6,69]]],["LABEL",{"for":"_r_8_-spo2","class":"parameter-reading-form__field"},[[6,75]],["INPUT",{"__playwright_value_":"","id":"_r_8_-spo2","class":"form-input","aria-label":"Nuova rilevazione SpO₂","aria-describedby":"_r_8_-spo2-previous","placeholder":"—","inputmode":"decimal","type":"text","value":"","style":""}],[[6,78]]],[[6,92]],["LABEL",{"for":"_r_8_-pas","class":"parameter-reading-form__field"},[[6,97]],["INPUT",{"__playwright_value_":"","id":"_r_8_-pas","class":"form-input","aria-label":"Nuova rilevazione PA sistolica","aria-describedby":"_r_8_-pas-previous","placeholder":"—","inputmode":"numeric","type":"text","value":"","style":""}],[[6,100]]],["LABEL",{"for":"_r_8_-pad","class":"parameter-reading-form__field"},[[6,106]],["INPUT",{"__playwright_value_":"","id":"