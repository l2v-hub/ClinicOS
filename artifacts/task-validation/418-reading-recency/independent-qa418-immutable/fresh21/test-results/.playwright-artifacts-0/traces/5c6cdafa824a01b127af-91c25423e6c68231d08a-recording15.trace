{"type":"frame-snapshot","snapshot":{"callId":"call@14952","snapshotName":"after@call@14952","pageId":"page@b0d04129d368ecaa701b8a9f4ab6d246","frameId":"frame@2df4bc428c602a34604ffd251e6e1b00","frameUrl":"http://127.0.0.1:7483/#/operator-dashboard","doctype":"html","html":["HTML",{"lang":"it"},["HEAD",{},[[3,0]],[[3,1]],[[3,2]],[[3,3]],[[3,4]],[[3,5]],[[3,6]],[[3,7]],[[3,8]],[[3,9]],[[3,10]],[[3,11]],[[3,12]],[[3,13]],[[3,15]],[[3,16]],[[3,18]],[[3,20]],[[3,22]],[[3,24]],[[3,26]],[[3,28]],["STYLE",{},".dashboard-notification-bar {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 10;\r\n  display: grid;\r\n  grid-template-columns: minmax(210px, 1fr) auto auto;\r\n  align-items: center;\r\n  gap: 12px;\r\n  min-height: 60px;\r\n  margin-bottom: 18px;\r\n  padding: 9px 12px;\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-left: 3px solid var(--blue);\r\n  border-radius: var(--card-radius-sm);\r\n  box-shadow: none;\r\n}\r\n\r\n@media (max-width: 1023px) {\r\n  .dashboard-notification-bar {\r\n    top: var(--topbar-h);\r\n  }\r\n}\r\n\r\n.dashboard-notification-bar--alarm {\r\n  border-left-color: var(--red-border);\r\n}\r\n\r\n.dashboard-notification-bar--warning {\r\n  border-left-color: var(--amber);\r\n}\r\n\r\n.dashboard-notification-bar--clear {\r\n  border-left-color: var(--emerald);\r\n}\r\n\r\n.dashboard-notification-bar--loading {\r\n  border-left-color: var(--text-xmuted);\r\n}\r\n\r\n.dashboard-notification-bar__intro {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  min-width: 0;\r\n}\r\n\r\n.dashboard-notification-bar__icon {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 36px;\r\n  height: 36px;\r\n  flex: 0 0 36px;\r\n  color: var(--red);\r\n  background: var(--red-bg);\r\n  border-radius: 10px;\r\n}\r\n\r\n.dashboard-notification-bar--warning .dashboard-notification-bar__icon {\r\n  color: var(--amber);\r\n  background: var(--amber-bg);\r\n}\r\n\r\n.dashboard-notification-bar--notice .dashboard-notification-bar__icon {\r\n  color: var(--blue);\r\n  background: var(--indigo-bg);\r\n}\r\n\r\n.dashboard-notification-bar--clear .dashboard-notification-bar__icon {\r\n  color: var(--emerald);\r\n  background: var(--emerald-bg);\r\n}\r\n\r\n.dashboard-notification-bar--loading .dashboard-notification-bar__icon {\r\n  color: var(--text-muted);\r\n  background: var(--surface-raised);\r\n}\r\n\r\n.dashboard-notification-bar__icon svg {\r\n  width: 18px;\r\n  height: 18px;\r\n}\r\n\r\n.dashboard-notification-bar__copy {\r\n  display: grid;\r\n  min-width: 0;\r\n  gap: 2px;\r\n}\r\n\r\n.dashboard-notification-bar__copy strong {\r\n  color: var(--text);\r\n  font-size: 13px;\r\n}\r\n\r\n.dashboard-notification-bar__copy > span {\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.dashboard-notification-bar__total {\r\n  /* The count is already present in the title and category badge. */\r\n  display: none;\r\n}\r\n\r\n.dashboard-notification-bar__categories {\r\n  display: flex;\r\n  gap: 6px;\r\n}\r\n\r\n.dashboard-notification-chip,\r\n.dashboard-notification-tab {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  min-height: 40px;\r\n  padding: 0 10px;\r\n  color: var(--text-muted);\r\n  background: var(--surface-raised);\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--radius-sm);\r\n  font-family: var(--font-ui);\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n}\r\n\r\n.dashboard-notification-chip:hover,\r\n.dashboard-notification-tab:hover {\r\n  background: var(--hover);\r\n  border-color: var(--text-xmuted);\r\n}\r\n\r\n.dashboard-notification-chip:focus-visible,\r\n.dashboard-notification-tab:focus-visible {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 2px;\r\n}\r\n\r\n.dashboard-notification-chip strong,\r\n.dashboard-notification-tab strong {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-width: 24px;\r\n  height: 24px;\r\n  padding: 0 6px;\r\n  border-radius: 999px;\r\n  font-size: 11px;\r\n}\r\n\r\n.dashboard-notification-chip--alarm strong,\r\n.dashboard-notification-tab--alarm strong {\r\n  color: var(--red);\r\n  background: var(--red-bg);\r\n}\r\n\r\n.dashboard-notification-chip--warning strong,\r\n.dashboard-notification-tab--warning strong {\r\n  color: var(--amber);\r\n  background: var(--amber-bg);\r\n}\r\n\r\n.dashboard-notification-chip--notice strong,\r\n.dashboard-notification-tab--notice strong {\r\n  color: var(--blue);\r\n  background: var(--indigo-bg);\r\n}\r\n\r\n.dashboard-notifications-modal {\r\n  max-width: 760px;\r\n}\r\n\r\n.dashboard-notifications-modal__header {\r\n  align-items: center;\r\n}\r\n\r\n.dashboard-notifications-modal__body {\r\n  gap: 16px;\r\n}\r\n\r\n.dashboard-notification-tabs {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  gap: 8px;\r\n}\r\n\r\n.dashboard-notification-tab {\r\n  width: 100%;\r\n  min-height: 44px;\r\n  padding: 0 12px;\r\n}\r\n\r\n.dashboard-notification-tab[aria-pressed='true'] {\r\n  color: var(--text);\r\n  background: var(--surface);\r\n  border-color: currentColor;\r\n  box-shadow: var(--shadow-focus);\r\n}\r\n\r\n.dashboard-notification-tab--alarm[aria-pressed='true'] {\r\n  color: var(--red);\r\n}\r\n\r\n.dashboard-notification-tab--warning[aria-pressed='true'] {\r\n  color: var(--amber);\r\n}\r\n\r\n.dashboard-notification-tab--notice[aria-pressed='true'] {\r\n  color: var(--blue);\r\n}\r\n\r\n.dashboard-notification-sections {\r\n  display: grid;\r\n  gap: 12px;\r\n}\r\n\r\n.dashboard-notification-section {\r\n  overflow: hidden;\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-left: 4px solid var(--blue);\r\n  border-radius: var(--card-radius-sm);\r\n}\r\n\r\n.dashboard-notification-section--alarm {\r\n  border-left-color: var(--red);\r\n}\r\n\r\n.dashboard-notification-section--warning {\r\n  border-left-color: var(--amber);\r\n}\r\n\r\n.dashboard-notification-section__header {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  padding: 13px 14px;\r\n  background: var(--surface-raised);\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.dashboard-notification-section__header h3,\r\n.dashboard-notification-section__header p {\r\n  margin: 0;\r\n}\r\n\r\n.dashboard-notification-section__header h3 {\r\n  color: var(--text);\r\n  font-size: 14px;\r\n}\r\n\r\n.dashboard-notification-section__header p {\r\n  margin-top: 3px;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  line-height: 1.45;\r\n}\r\n\r\n.dashboard-notification-section__header > span {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-width: 28px;\r\n  height: 28px;\r\n  padding: 0 8px;\r\n  color: var(--blue);\r\n  background: var(--indigo-bg);\r\n  border-radius: 999px;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n}\r\n\r\n.dashboard-notification-section--alarm .dashboard-notification-section__header > span {\r\n  color: var(--red);\r\n  background: var(--red-bg);\r\n}\r\n\r\n.dashboard-notification-section--warning .dashboard-notification-section__header > span {\r\n  color: var(--amber);\r\n  background: var(--amber-bg);\r\n}\r\n\r\n.dashboard-notification-section__content {\r\n  display: grid;\r\n  gap: 10px;\r\n  padding: 12px 14px 14px;\r\n}\r\n\r\n.dashboard-notification-section__content .anomalie-reparto__lista {\r\n  max-height: 320px;\r\n  overflow-y: auto;\r\n}\r\n\r\n.dashboard-notification-section__action {\r\n  justify-self: start;\r\n  min-height: 44px;\r\n}\r\n\r\n.dashboard-notification-section__message {\r\n  margin: 0;\r\n  color: var(--text-muted);\r\n  font-size: 13px;\r\n  line-height: 1.5;\r\n}\r\n\r\n.dashboard-notification-empty {\r\n  display: grid;\r\n  justify-items: center;\r\n  gap: 5px;\r\n  padding: 32px 20px;\r\n  color: var(--text-muted);\r\n  text-align: center;\r\n  background: var(--surface-raised);\r\n  border: 1px dashed var(--border);\r\n  border-radius: var(--card-radius-sm);\r\n}\r\n\r\n.dashboard-notification-empty > span {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 36px;\r\n  height: 36px;\r\n  color: var(--emerald);\r\n  background: var(--emerald-bg);\r\n  border-radius: 50%;\r\n  font-weight: 700;\r\n}\r\n\r\n.dashboard-notification-empty strong {\r\n  color: var(--text);\r\n  font-size: 14px;\r\n}\r\n\r\n.dashboard-notification-empty p {\r\n  margin: 0;\r\n  font-size: 12px;\r\n}\r\n\r\n.dashboard-notifications-modal__footer > span {\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .dashboard-notification-bar {\r\n    grid-template-columns: minmax(190px, 1fr) auto;\r\n  }\r\n\r\n  .dashboard-notification-bar__categories {\r\n    grid-column: 1 / -1;\r\n    display: grid;\r\n    grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  }\r\n\r\n  .dashboard-notification-chip {\r\n    width: 100%;\r\n  }\r\n}\r\n\r\n@media (max-width: 560px) {\r\n  .dashboard-notification-bar {\r\n    grid-template-columns: minmax(0, 1fr) auto;\r\n    gap: 9px;\r\n    padding: 10px;\r\n  }\r\n\r\n  .dashboard-notification-bar__copy > span {\r\n    white-space: normal;\r\n  }\r\n\r\n  .dashboard-notification-chip,\r\n  .dashboard-notification-tab {\r\n    flex-direction: column;\r\n    gap: 3px;\r\n    min-width: 0;\r\n    height: auto;\r\n    min-height: 52px;\r\n    padding: 6px;\r\n  }\r\n\r\n  .dashboard-notification-tabs {\r\n    gap: 6px;\r\n  }\r\n\r\n  .dashboard-notifications-modal {\r\n    max-height: calc(100vh - 24px);\r\n    border-radius: var(--card-radius-sm);\r\n  }\r\n\r\n  .dashboard-notifications-modal__header,\r\n  .dashboard-notifications-modal__body,\r\n  .dashboard-notifications-modal__footer {\r\n    padding-left: 14px;\r\n    padding-right: 14px;\r\n  }\r\n\r\n  .dashboard-notification-section__header,\r\n  .dashboard-notification-section__content {\r\n    padding-left: 10px;\r\n    padding-right: 10px;\r\n  }\r\n}\r\n\r\n/* Forma compatta (schermata Turno, HMI 1): pulsante 48 nella card \"Adesso\". */\r\n.dashboard-notification-compact {\r\n  height: 48px;\r\n  padding: 0 16px;\r\n  border-radius: 12px;\r\n  border: 0;\r\n  background: transparent;\r\n  color: #1d4fc4;\r\n  font: 600 16px/24px var(--font-ui);\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  white-space: nowrap;\r\n  cursor: pointer;\r\n}\r\n.dashboard-notification-compact:hover {\r\n  background: #eaf1fe;\r\n}\r\n.dashboard-notification-compact:focus-visible {\r\n  outline: 3px solid #245bb5;\r\n  outline-offset: 2px;\r\n}\r\n.dashboard-notification-compact svg {\r\n  width: 20px;\r\n  height: 20px;\r\n}\r\n.dashboard-notification-compact strong {\r\n  min-width: 24px;\r\n  height: 24px;\r\n  padding: 0 6px;\r\n  border-radius: 8px;\r\n  display: inline-grid;\r\n  place-items: center;\r\n  font: 600 14px/20px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n  background: #eaf1fe;\r\n  color: #1d4fc4;\r\n}\r\n.dashboard-notification-compact--alarm strong {\r\n  background: #fdecee;\r\n  color: #b42335;\r\n}\r\n.dashboard-notification-compact--alarm { color: #b42335; background: #fdecee; border: 1px solid #efc3cb; }\r\n.dashboard-notification-compact--alarm:hover { background: #fbdce2; }\r\n.dashboard-notification-compact--warning { color: #8f5500; background: #fdf3e2; border: 1px solid #ead0a7; }\r\n.dashboard-notification-compact--warning:hover { background: #fae9cc; }\r\n.dashboard-notification-compact--loading { color: var(--text-muted); background: var(--surface); }\r\n.dashboard-notification-compact--clear { color: var(--text-muted); }\r\n.dashboard-notification-compact--warning strong {\r\n  background: #fdf3e2;\r\n  color: #8f5500;\r\n}\r\n\r\n/* Annuncio degli allarmi per i lettori di schermo (forma compatta): non visibile. */\r\n.dashboard-notification-live {\r\n  position: absolute;\r\n  width: 1px;\r\n  height: 1px;\r\n  padding: 0;\r\n  margin: -1px;\r\n  overflow: hidden;\r\n  clip: rect(0, 0, 0, 0);\r\n  white-space: nowrap;\r\n  border: 0;\r\n}\r\n"],["STYLE",{},".dashboard-kpi-band {\r\n  display: grid;\r\n  gap: 8px;\r\n  margin-bottom: 18px;\r\n}\r\n\r\n.dashboard-kpi-band--1 {\r\n  grid-template-columns: minmax(0, 1fr);\r\n}\r\n\r\n.dashboard-kpi-band--2 {\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n}\r\n\r\n.dashboard-kpi-band--3 {\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n}\r\n\r\n.dashboard-kpi-band--4 {\r\n  grid-template-columns: repeat(4, minmax(0, 1fr));\r\n}\r\n\r\n.dashboard-kpi-band--5 {\r\n  grid-template-columns: repeat(5, minmax(0, 1fr));\r\n}\r\n\r\n.dashboard-kpi-card {\r\n  position: relative;\r\n  display: grid;\r\n  grid-template-columns: 32px minmax(0, 1fr) 14px;\r\n  grid-template-areas:\r\n    'icon value arrow'\r\n    'label label label'\r\n    'status status status';\r\n  align-items: center;\r\n  gap: 5px 8px;\r\n  min-width: 0;\r\n  min-height: 102px;\r\n  padding: 11px 12px;\r\n  text-align: left;\r\n  color: var(--text);\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 12px;\r\n  box-shadow: 0 1px 2px rgba(25, 45, 75, 0.04);\r\n  cursor: pointer;\r\n  transition:\r\n    border-color 0.14s ease,\r\n    box-shadow 0.14s ease,\r\n    transform 0.14s ease;\r\n}\r\n\r\n.dashboard-kpi-card:hover {\r\n  border-color: color-mix(in srgb, var(--blue) 30%, var(--border));\r\n  box-shadow: var(--shadow-card);\r\n  transform: translateY(-1px);\r\n}\r\n\r\n.dashboard-kpi-card:focus-visible {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 2px;\r\n  border-color: var(--blue);\r\n  box-shadow: var(--shadow-focus);\r\n}\r\n\r\n.dashboard-kpi-card__icon {\r\n  grid-area: icon;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 32px;\r\n  height: 32px;\r\n  color: var(--blue);\r\n  background: var(--indigo-bg);\r\n  border-radius: 9px;\r\n}\r\n\r\n.dashboard-kpi-card__icon svg {\r\n  width: 17px;\r\n  height: 17px;\r\n}\r\n\r\n.dashboard-kpi-card__value {\r\n  grid-area: value;\r\n  min-width: 0;\r\n  color: var(--blue);\r\n  font-size: 26px;\r\n  font-weight: 800;\r\n  line-height: 1;\r\n  letter-spacing: -0.6px;\r\n}\r\n\r\n.dashboard-kpi-card__label {\r\n  grid-area: label;\r\n  overflow: hidden;\r\n  color: var(--text);\r\n  font-size: 12.5px;\r\n  font-weight: 700;\r\n  line-height: 1.25;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.dashboard-kpi-card__status {\r\n  grid-area: status;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  overflow: hidden;\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  line-height: 1.2;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.dashboard-kpi-card__status svg {\r\n  width: 12px;\r\n  height: 12px;\r\n  flex: 0 0 12px;\r\n}\r\n\r\n.dashboard-kpi-card__arrow {\r\n  grid-area: arrow;\r\n  display: inline-flex;\r\n  color: var(--text-xmuted);\r\n}\r\n\r\n.dashboard-kpi-card__arrow svg {\r\n  width: 14px;\r\n  height: 14px;\r\n}\r\n\r\n.dashboard-kpi-card--positive .dashboard-kpi-card__icon {\r\n  color: var(--teal);\r\n  background: var(--emerald-bg);\r\n}\r\n\r\n.dashboard-kpi-card--positive .dashboard-kpi-card__value,\r\n.dashboard-kpi-card--positive .dashboard-kpi-card__status svg {\r\n  color: var(--teal);\r\n}\r\n\r\n.dashboard-kpi-card--critical .dashboard-kpi-card__icon {\r\n  color: var(--red);\r\n  background: var(--red-bg);\r\n}\r\n\r\n.dashboard-kpi-card--critical .dashboard-kpi-card__value {\r\n  color: var(--red);\r\n}\r\n\r\n.dashboard-kpi-card--attention .dashboard-kpi-card__icon {\r\n  color: var(--amber);\r\n  background: var(--amber-bg);\r\n}\r\n\r\n.dashboard-kpi-card--attention .dashboard-kpi-card__value {\r\n  color: var(--amber);\r\n}\r\n\r\n.dashboard-kpi-card--unknown .dashboard-kpi-card__icon {\r\n  color: var(--text-muted);\r\n  background: var(--surface-raised);\r\n}\r\n\r\n.dashboard-kpi-card--unknown .dashboard-kpi-card__value {\r\n  color: var(--text-muted);\r\n}\r\n\r\n@media (max-width: 1040px) {\r\n  .dashboard-kpi-band--4,\r\n  .dashboard-kpi-band--5 {\r\n    grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  }\r\n\r\n  .dashboard-kpi-card__label,\r\n  .dashboard-kpi-card__status {\r\n    white-space: normal;\r\n  }\r\n}\r\n\r\n@media (max-width: 700px) {\r\n  .dashboard-kpi-band,\r\n  .dashboard-kpi-band--3,\r\n  .dashboard-kpi-band--4,\r\n  .dashboard-kpi-band--5 {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n\r\n  .dashboard-kpi-band--3 .dashboard-kpi-card:last-child,\r\n  .dashboard-kpi-band--5 .dashboard-kpi-card:last-child {\r\n    grid-column: 1 / -1;\r\n  }\r\n}\r\n\r\n@media (max-width: 520px) {\r\n  .dashboard-kpi-band {\r\n    gap: 7px;\r\n  }\r\n\r\n  .dashboard-kpi-card {\r\n    min-height: 88px;\r\n    padding: 10px;\r\n  }\r\n\r\n  .dashboard-kpi-card__label,\r\n  .dashboard-kpi-card__status {\r\n    white-space: normal;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Card \"Adesso\" (HMI 1): righe ora · chi/cosa · pulsante; ora rossa se scaduta. */\r\n.adesso-queue__count {\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.adesso-queue { container-type: inline-size; }\r\n.adesso-queue__notice {\r\n  margin: 0;\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px;\r\n  font: 500 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n.adesso-queue__notice--error {\r\n  color: #b42335;\r\n}\r\n.adesso-queue__list {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n.adesso-queue__row {\r\n  display: grid;\r\n  grid-template-columns: 44px minmax(0, 1fr) auto;\r\n  gap: 8px;\r\n  align-items: center;\r\n  padding: 10px 12px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 12px;\r\n  margin-bottom: 8px;\r\n}\r\n.adesso-queue__row--terapia-ritardo,\r\n.adesso-queue__row--consegna-scaduta { border-left: 4px solid #b42335; background: #fffafb; }\r\n.adesso-queue__ora {\r\n  font: 600 14px/20px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--text);\r\n}\r\n.adesso-queue__ora.is-late {\r\n  color: #b42335;\r\n}\r\n.adesso-queue__main {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n  gap: 2px;\r\n}\r\n.adesso-queue__who {\r\n  font: 600 14px/20px var(--font-ui);\r\n  color: var(--text);\r\n  overflow-wrap: anywhere;\r\n}\r\n.adesso-queue__location { font: 400 12px/16px var(--font-ui); color: var(--text-muted); overflow-wrap: anywhere; }\r\n.adesso-queue__time { align-self: flex-start; font: 500 12px/18px var(--font-ui); padding: 2px 6px; border-radius: 6px; background: #eaf1fe; color: #1d4fc4; }\r\n.adesso-queue__what {\r\n  font: 600 14px/20px var(--font-ui);\r\n  color: var(--text);\r\n  overflow-wrap: anywhere;\r\n}\r\n.adesso-queue__time.is-late {\r\n  color: #b42335;\r\n  background: #fdecee;\r\n}\r\n.adesso-queue__empty {\r\n  margin: 0;\r\n  font: 400 16px/24px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n.adesso-queue__more {\r\n  margin: 0;\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding-top: 8px;\r\n  border-top: 1px solid var(--border);\r\n  font: 500 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n@container (max-width: 359px) {\r\n  .adesso-queue__row {\r\n    grid-template-columns: 44px minmax(0, 1fr);\r\n  }\r\n  .adesso-queue__row .ds-btn {\r\n    grid-column: 2;\r\n    justify-self: start;\r\n  }\r\n}\r\n.adesso-queue__foot {\r\n  margin: 0;\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  padding-top: 8px;\r\n  border-top: 1px solid var(--border);\r\n  font: 500 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n"],["STYLE",{},".turno-handovers .turno-card__title > svg {\r\n  width: 22px;\r\n  height: 22px;\r\n  color: var(--text-muted);\r\n  flex: none;\r\n}\r\n.turno-handovers__hint {\r\n  margin: -8px 0 0;\r\n  color: var(--text-muted);\r\n  font-size: 13px;\r\n  line-height: 1.5;\r\n}\r\n.turno-handovers__list {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: grid;\r\n  gap: 12px;\r\n}\r\n.turno-handovers__item {\r\n  border: 1px solid var(--border);\r\n  border-radius: 12px;\r\n  padding: 16px;\r\n  display: grid;\r\n  gap: 8px;\r\n  min-width: 0;\r\n}\r\n.turno-handovers__item.is-urgent {\r\n  border-left: 4px solid #b42335;\r\n}\r\n.turno-handovers__meta,\r\n.turno-handovers__bottom {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n.turno-handovers__meta time,\r\n.turno-handovers__bottom > span {\r\n  font-size: 13px;\r\n  color: var(--text-muted);\r\n}\r\n.turno-handovers__patient {\r\n  font-size: 16px;\r\n  overflow-wrap: anywhere;\r\n}\r\n.turno-handovers__type {\r\n  font-weight: 600;\r\n  font-size: 14px;\r\n}\r\n.turno-handovers__text {\r\n  margin: 0;\r\n  font-size: 14px;\r\n  line-height: 1.6;\r\n  white-space: pre-wrap;\r\n  overflow-wrap: anywhere;\r\n}\r\n.turno-handovers__trace {\r\n  margin: 0;\r\n  font-size: 13px;\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n}\r\n"],["STYLE",{},"/* Avviso anomalie farmaci. Ambra: il rosso in ClinicOS resta agli allarmi clinici. */\r\n\r\n.avviso-anomalie {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  gap: 12px;\r\n  margin: 0 0 16px;\r\n  padding: 12px 14px;\r\n  border: 1px solid rgb(180 120 0 / 40%);\r\n  border-left: 3px solid #c98a00;\r\n  border-radius: 10px;\r\n  background: rgb(255 196 0 / 10%);\r\n}\r\n\r\n.avviso-anomalie--compatto {\r\n  margin-bottom: 12px;\r\n  padding: 9px 12px;\r\n}\r\n\r\n.avviso-anomalie__icona {\r\n  flex: none;\r\n  display: grid;\r\n  place-items: center;\r\n  width: 22px;\r\n  height: 22px;\r\n  border-radius: 50%;\r\n  background: #c98a00;\r\n  color: #fff;\r\n  font-size: 14px;\r\n  font-weight: 700;\r\n  line-height: 1;\r\n}\r\n\r\n.avviso-anomalie__testo {\r\n  flex: 1;\r\n  min-width: 0;\r\n}\r\n\r\n.avviso-anomalie__titolo {\r\n  margin: 0;\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  color: #7a5300;\r\n}\r\n\r\n.avviso-anomalie__ambito {\r\n  font-weight: 500;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.avviso-anomalie__dettaglio {\r\n  margin: 3px 0 0;\r\n  font-size: 12px;\r\n  color: var(--text);\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.avviso-anomalie__parziale {\r\n  margin: 4px 0 0;\r\n  font-size: 11px;\r\n  font-style: italic;\r\n  color: var(--text-muted);\r\n}\r\n\r\n/* Indicatore per riga di elenco: deve leggersi in mezzo a una tabella densa senza urlare. */\r\n.indicatore-anomalie {\r\n  display: inline-block;\r\n  padding: 1px 8px;\r\n  border: 1px solid rgb(180 120 0 / 45%);\r\n  border-radius: 999px;\r\n  background: rgb(255 196 0 / 16%);\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n  white-space: nowrap;\r\n  color: #8a5a00;\r\n}\r\n\r\n/* Variante ambra di `.coverage-alert`, che di base è rossa: i farmaci da correggere non sono\r\n   un'urgenza clinica come una consegna urgente, e non devono averne il peso visivo. */\r\n.coverage-alert--amber {\r\n  align-items: flex-start;\r\n  border-color: rgb(180 120 0 / 40%);\r\n  background: rgb(255 196 0 / 10%);\r\n  color: #7a5300;\r\n}\r\n\r\n.coverage-alert--amber svg {\r\n  color: #c98a00;\r\n}\r\n\r\n/* Riquadro del cruscotto: elenco dei pazienti da bonificare. */\r\n.anomalie-reparto__lista {\r\n  margin: 0;\r\n  padding: 0;\r\n  list-style: none;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n}\r\n\r\n.anomalie-reparto__riga {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 10px;\r\n  padding: 8px 10px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  background: var(--surface);\r\n  cursor: pointer;\r\n  text-align: left;\r\n  width: 100%;\r\n  min-height: 44px;\r\n}\r\n\r\n.anomalie-reparto__riga:hover {\r\n  border-color: #c98a00;\r\n}\r\n\r\n.anomalie-reparto__riga:focus-visible {\r\n  outline: 3px solid #8a5a00;\r\n  outline-offset: 2px;\r\n  border-color: #c98a00;\r\n}\r\n\r\n.anomalie-reparto__riga > .badge,\r\n.anomalie-reparto__riga > .indicatore-anomalie {\r\n  align-self: center;\r\n  flex: 0 0 auto;\r\n  width: max-content;\r\n  max-width: 100%;\r\n}\r\n\r\n.anomalie-reparto__nome {\r\n  display: block;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  color: var(--text);\r\n}\r\n\r\n.anomalie-reparto__contenuto {\r\n  display: grid;\r\n  flex: 1 1 auto;\r\n  gap: 5px;\r\n  min-width: 0;\r\n}\r\n\r\n.anomalie-reparto__farmaci-lista {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 5px;\r\n}\r\n\r\n.anomalie-reparto__farmaco {\r\n  display: inline-flex;\r\n  align-items: baseline;\r\n  gap: 5px;\r\n  padding: 3px 7px;\r\n  border-radius: 6px;\r\n  background: var(--bg);\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  line-height: 1.3;\r\n}\r\n\r\n.anomalie-reparto__farmaco strong {\r\n  color: var(--text);\r\n  font-size: 11px;\r\n}\r\n\r\n.anomalie-reparto__altre-voci {\r\n  align-self: center;\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n}\r\n\r\n@media (max-width: 520px) {\r\n  .anomalie-reparto__riga {\r\n    align-items: stretch;\r\n    display: grid;\r\n    grid-template-columns: minmax(0, 1fr) auto;\r\n  }\r\n\r\n  .anomalie-reparto__farmaci-lista {\r\n    flex-direction: column;\r\n  }\r\n\r\n  .anomalie-reparto__farmaco {\r\n    align-items: flex-start;\r\n    flex-direction: column;\r\n    gap: 1px;\r\n  }\r\n\r\n  .anomalie-reparto__riga > .badge,\r\n  .anomalie-reparto__riga > .indicatore-anomalie {\r\n    align-self: start;\r\n  }\r\n}\r\n\r\n.anomalie-reparto__farmaci {\r\n  display: block;\r\n  min-width: 0;\r\n  margin: 2px 0 0;\r\n  font-size: 11px;\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.anomalie-reparto__vuoto {\r\n  margin: 0;\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n/* La riga di lista e' generica (.anomalie-reparto__riga), ma il suo hover di base e' ambra\r\n   (vedi sopra) — sbagliato dentro un banner rosso di urgenza clinica reale come questo. Un solo\r\n   modificatore per correggere solo l'accento colore, non una classe gemella intera. */\r\n.anomalie-reparto__riga--rosso:hover {\r\n  border-color: var(--red);\r\n}\r\n"],["STYLE",{},"/* Il mio turno uses shared control, typography and spacing tokens. */\r\n\r\n.operator-dashboard.turno {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: var(--ds-layout-gap);\r\n  max-width: none;\r\n  margin: 0;\r\n  width: 100%;\r\n}\r\n\r\n/* Indicatori compatti: etichetta e stato a sinistra, valore a destra. */\r\n.turno .dashboard-kpi-band {\r\n  gap: 12px;\r\n  margin: 0;\r\n}\r\n.turno .dashboard-kpi-card {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) auto;\r\n  grid-template-areas: 'label value' 'status value';\r\n  align-items: center;\r\n  gap: 2px 8px;\r\n  min-height: 64px;\r\n  padding: 12px;\r\n  border-radius: 12px;\r\n  border: 1px solid var(--border);\r\n  background: var(--surface);\r\n  box-shadow: none;\r\n  transform: none;\r\n}\r\n.turno .dashboard-kpi-card:hover {\r\n  border-color: var(--blue);\r\n  box-shadow: none;\r\n  transform: none;\r\n}\r\n.turno .dashboard-kpi-card__icon,\r\n.turno .dashboard-kpi-card__arrow {\r\n  display: none;\r\n}\r\n.turno .dashboard-kpi-card__label {\r\n  order: 1;\r\n  font: 500 13px/18px var(--font-ui);\r\n  color: var(--text-muted);\r\n  white-space: normal;\r\n  overflow: visible;\r\n}\r\n.turno .dashboard-kpi-card__value {\r\n  order: 2;\r\n  font: 600 24px/28px var(--font-ui);\r\n  letter-spacing: 0;\r\n  color: var(--text);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.turno .dashboard-kpi-card--critical .dashboard-kpi-card__value {\r\n  color: #b42335;\r\n}\r\n.turno .dashboard-kpi-card--attention .dashboard-kpi-card__value {\r\n  color: #8f5500;\r\n}\r\n/* la riga di stato resta solo quando spiega perché manca il dato */\r\n.turno .dashboard-kpi-card__status {\r\n  order: 3;\r\n  display: none;\r\n}\r\n.turno .dashboard-kpi-card--unknown .dashboard-kpi-card__status,\r\n.turno .dashboard-kpi-card[data-kpi-id='allergie'] .dashboard-kpi-card__status,\r\n.turno .dashboard-kpi-card[data-unavailable] .dashboard-kpi-card__status {\r\n  display: inline-flex;\r\n  font: 500 12px/16px var(--font-ui);\r\n  color: var(--text-muted);\r\n  white-space: normal;\r\n  overflow: visible;\r\n}\r\n\r\n/* ── Griglia: Adesso (5) · lato destro (6) ─────────────────────────────── */\r\n.turno-grid {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);\r\n  gap: var(--ds-layout-gap);\r\n  align-items: start;\r\n}\r\n.turno-side {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n\r\n/* ── Card comuni ───────────────────────────────────────────────────────── */\r\n.turno-card {\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 16px;\r\n  padding: var(--ds-card-padding);\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.turno-card__head {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px 16px;\r\n  min-height: var(--ds-control-h);\r\n}\r\n.turno-card__title {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  min-width: 0;\r\n}\r\n.turno-h2 {\r\n  margin: 0;\r\n  font: 600 var(--ds-title-font)/24px var(--font-ui);\r\n  color: var(--text);\r\n}\r\n.turno-empty {\r\n  margin: 0;\r\n  font: 400 var(--ds-body-font)/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n\r\n.turno-badge {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  /* I badge portano i nomi (allergene, parametro, rischio): vanno a capo, mai troncati. */\r\n  min-height: 24px;\r\n  padding: 2px 6px;\r\n  border-radius: 8px;\r\n  font: 500 14px/20px var(--font-ui);\r\n  white-space: normal;\r\n  overflow-wrap: anywhere;\r\n  background: #f5f7fb;\r\n  color: var(--text-muted);\r\n}\r\n.turno-badge svg {\r\n  width: 16px;\r\n  height: 16px;\r\n  fill: none;\r\n  stroke: currentColor;\r\n  stroke-width: 2;\r\n  stroke-linecap: round;\r\n  stroke-linejoin: round;\r\n}\r\n.turno-badge--crit {\r\n  background: #fdecee;\r\n  color: #b42335;\r\n}\r\n.turno-badge--warn {\r\n  background: #fdf3e2;\r\n  color: #8f5500;\r\n}\r\n.turno-badge--blue {\r\n  background: #eaf1fe;\r\n  color: #1d4fc4;\r\n}\r\n\r\n.turno-pcard__open:focus-visible,\r\n.turno-appt__who:focus-visible {\r\n  outline: 3px solid #245bb5;\r\n  outline-offset: 2px;\r\n}\r\n\r\n/* ── Prossimi appuntamenti ─────────────────────────────────────────────── */\r\n.turno-appts {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n.turno-appt {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n  min-height: 64px;\r\n  padding: 8px 0;\r\n  border-top: 1px solid var(--border);\r\n}\r\n.turno-appt:first-child {\r\n  border-top: 0;\r\n}\r\n.turno-appt__ora {\r\n  width: 56px;\r\n  flex: none;\r\n  font: 600 16px/24px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.turno-appt__main {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n}\r\n.turno-appt__what {\r\n  font: 600 16px/24px var(--font-ui);\r\n  color: var(--text);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.turno-appt__now {\r\n  font-weight: 500;\r\n  color: #1d4fc4;\r\n}\r\n.turno-appt__who {\r\n  justify-self: start;\r\n  text-align: left;\r\n  padding: 0;\r\n  min-height: 0;\r\n  font: 500 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\nbutton.turno-appt__who:hover {\r\n  color: #1d4fc4;\r\n}\r\n\r\n/* ── Card paziente ─────────────────────────────────────────────────────── */\r\n.turno-pgrid {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  gap: 16px;\r\n}\r\n.turno-pcard {\r\n  position: relative;\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 16px;\r\n  padding: 16px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.turno-pcard:hover {\r\n  border-color: var(--blue);\r\n}\r\n.turno-pcard__top {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.turno-pcard__bed {\r\n  width: 48px;\r\n  height: 48px;\r\n  flex: none;\r\n  border-radius: 12px;\r\n  background: #f5f7fb;\r\n  border: 1px solid var(--border);\r\n  display: grid;\r\n  place-items: center;\r\n  font: 600 var(--ds-title-font)/24px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n  letter-spacing: -0.02em;\r\n  overflow: hidden;\r\n}\r\n.turno-pcard__id {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n}\r\n/* Il nome apre la cartella e con ::after rende cliccabile tutta la card. */\r\n.turno-pcard__open {\r\n  border: 0;\r\n  background: none;\r\n  padding: 0;\r\n  text-align: left;\r\n  font: 600 16px/24px var(--font-ui);\r\n  color: var(--text);\r\n  cursor: pointer;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.turno-pcard__open::after {\r\n  content: '';\r\n  position: absolute;\r\n  inset: 0;\r\n  border-radius: 16px;\r\n}\r\n.turno-pcard__sub {\r\n  font: 500 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n/* Direct access: la riga terapia va a capo (niente ellissi) e ogni dose è un link. */\r\n.turno-pcard__next {\r\n  margin: 0;\r\n  font: 500 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n  white-space: normal;\r\n}\r\n.turno-pcard__next-label {\r\n  font-weight: 600;\r\n}\r\n.turno-pcard__dose {\r\n  display: inline;\r\n  min-height: 0;\r\n  padding: 0;\r\n  border: 0;\r\n  background: none;\r\n  font: inherit;\r\n  color: inherit;\r\n  text-align: left;\r\n  text-decoration: underline;\r\n  text-decoration-thickness: 1px;\r\n  text-underline-offset: 3px;\r\n  cursor: pointer;\r\n}\r\n.turno-pcard__dose:hover,\r\n.turno-pcard__dose:focus-visible {\r\n  text-decoration-thickness: 2px;\r\n}\r\n/* I link interni stanno sopra il link «apri cartella» esteso a tutta la card (::after). */\r\n.turno-pcard__badges > *,\r\n.turno-pcard__dose {\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n.turno-badge--link {\r\n  border: 0;\r\n  font: 500 14px/20px var(--font-ui);\r\n  cursor: pointer;\r\n}\r\n.turno-badge--link:hover,\r\n.turno-badge--link:focus-visible {\r\n  filter: brightness(0.95);\r\n  text-decoration: underline;\r\n  text-underline-offset: 2px;\r\n}\r\n.turno-pcard__badges {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n\r\n/* ── Tablet e telefono ─────────────────────────────────────────────────── */\r\n@media (max-width: 1023px) {\r\n  .turno-grid {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }\r\n}\r\n@media (max-width: 600px) {\r\n  .turno-pgrid {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }\r\n  .turno-card {\r\n    padding: 16px;\r\n  }\r\n}\r\n\r\n.turno-pcard__next.is-late {\r\n  color: #b42335;\r\n}\r\n.turno-empty--error {\r\n  color: #b42335;\r\n}\r\n.turno-appt__ora.is-late,\r\n.turno-appt__late {\r\n  color: #b42335;\r\n}\r\n.turno-appt__late {\r\n  font-weight: 500;\r\n}\r\n.turno-more {\r\n  margin: 0;\r\n  font: 500 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n.dashboard-regime-note {\r\n  margin: 8px 0 16px;\r\n  color: var(--text-muted);\r\n  font-size: 13px;\r\n  line-height: 1.5;\r\n  overflow-wrap: anywhere;\r\n}\r\n"],["STYLE",{},".therapy-deadlines {\r\n  margin-top: 24px;\r\n  overflow: hidden;\r\n  /* le righe si adattano alla larghezza della card, non del viewport: nella dashboard Turno la\r\n     card sta in una colonna e a 768-1200 px il viewport è largo ma la colonna no */\r\n  container: therapy-deadlines / inline-size;\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--card-radius-sm);\r\n}\r\n\r\n.therapy-deadlines__header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  flex-wrap: wrap;\r\n  gap: 12px;\r\n  padding: 16px 18px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.therapy-deadlines__header h2 {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  margin: 0;\r\n  color: var(--text);\r\n  font-size: 17px;\r\n}\r\n\r\n.therapy-deadlines__header svg,\r\n.therapy-deadlines__group-title svg {\r\n  width: 18px;\r\n  height: 18px;\r\n  flex-shrink: 0;\r\n  color: var(--blue);\r\n}\r\n\r\n.therapy-deadlines__header p {\r\n  margin: 5px 0 0;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n}\r\n\r\n.therapy-deadlines__actions {\r\n  display: flex;\r\n  gap: 16px;\r\n}\r\n.therapy-deadlines__actions .link-btn {\r\n  min-height: 44px;\r\n}\r\n.therapy-deadlines__actions svg {\r\n  width: 14px;\r\n  height: 14px;\r\n}\r\n\r\n.therapy-deadlines__group-title {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  margin: 0;\r\n  padding: 14px 18px 5px;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  font-weight: 650;\r\n}\r\n\r\n.therapy-deadlines__group-title > span {\r\n  padding: 2px 7px;\r\n  border-radius: 12px;\r\n  background: var(--surface-raised);\r\n}\r\n\r\n.therapy-deadlines__list {\r\n  list-style: none;\r\n  padding: 0 18px;\r\n  margin: 0;\r\n}\r\n.therapy-deadlines__row {\r\n  display: grid;\r\n  grid-template-columns: 64px minmax(140px, 1fr) minmax(180px, 1.5fr) minmax(85px, auto);\r\n  align-items: center;\r\n  gap: 14px;\r\n  padding: 13px 0;\r\n  border-bottom: 1px solid var(--border);\r\n  font-size: 13px;\r\n}\r\n\r\n.therapy-deadlines__row:last-child {\r\n  border-bottom: none;\r\n}\r\n.therapy-deadlines__row > div {\r\n  display: grid;\r\n  gap: 4px;\r\n  min-width: 0;\r\n}\r\n.therapy-deadlines__row strong {\r\n  font-weight: 650;\r\n  color: var(--text);\r\n}\r\n.therapy-deadlines__row > div > span {\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n}\r\n.therapy-deadlines__time time {\r\n  color: var(--blue);\r\n  font-size: 18px;\r\n  font-weight: 700;\r\n}\r\n.therapy-deadlines__patient .link-btn {\r\n  justify-self: start;\r\n  text-align: left;\r\n  font-weight: 650;\r\n}\r\n.therapy-deadlines__patient,\r\n.therapy-deadlines__prescription {\r\n  overflow-wrap: anywhere;\r\n}\r\n.therapy-deadlines__timing {\r\n  justify-self: end;\r\n  color: var(--blue);\r\n  font-size: 12px;\r\n}\r\n.therapy-deadlines__timing--late {\r\n  color: var(--red);\r\n}\r\n.therapy-deadlines__overdue,\r\n.therapy-deadlines__unscheduled {\r\n  border-top: 1px solid var(--border);\r\n}\r\n.therapy-deadlines__overdue .therapy-deadlines__time time {\r\n  color: var(--text-muted);\r\n}\r\n.therapy-deadlines__message {\r\n  padding: 18px;\r\n  margin: 0;\r\n  font-size: 13px;\r\n  color: var(--text-muted);\r\n}\r\n.therapy-deadlines__message p {\r\n  margin: 0 0 12px;\r\n}\r\n.therapy-deadlines__notice {\r\n  margin: 12px 18px;\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n}\r\n.therapy-deadlines__more summary {\r\n  padding: 12px 18px;\r\n  cursor: pointer;\r\n  color: var(--blue);\r\n  font-size: 12px;\r\n}\r\n.therapy-deadlines button:focus-visible,\r\n.therapy-deadlines summary:focus-visible {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 2px;\r\n}\r\n.therapy-deadlines__footer {\r\n  padding: 11px 18px;\r\n  color: var(--text-muted);\r\n  background: var(--surface-raised);\r\n  border-top: 1px solid var(--border);\r\n  font-size: 11px;\r\n}\r\n\r\n@media (max-width: 760px) {\r\n  .therapy-deadlines__row {\r\n    grid-template-columns: 60px minmax(0, 1fr);\r\n    gap: 8px 12px;\r\n  }\r\n  .therapy-deadlines__time {\r\n    grid-column: 1;\r\n    grid-row: 1 / 3;\r\n    align-self: start;\r\n  }\r\n  .therapy-deadlines__patient,\r\n  .therapy-deadlines__prescription {\r\n    grid-column: 2;\r\n  }\r\n  .therapy-deadlines__timing {\r\n    grid-column: 2;\r\n    justify-self: start;\r\n  }\r\n  .therapy-deadlines__patient .link-btn {\r\n    min-height: 32px;\r\n  }\r\n}\r\n\r\n/* stessa disposizione compatta quando è la card a essere stretta */\r\n@container therapy-deadlines (max-width: 600px) {\r\n  .therapy-deadlines__row {\r\n    grid-template-columns: 60px minmax(0, 1fr);\r\n    gap: 8px 12px;\r\n  }\r\n  .therapy-deadlines__time {\r\n    grid-column: 1;\r\n    grid-row: 1 / 3;\r\n    align-self: start;\r\n  }\r\n  .therapy-deadlines__patient,\r\n  .therapy-deadlines__prescription {\r\n    grid-column: 2;\r\n  }\r\n  .therapy-deadlines__timing {\r\n    grid-column: 2;\r\n    justify-self: start;\r\n  }\r\n  .therapy-deadlines__patient .link-btn {\r\n    min-height: 32px;\r\n  }\r\n}\r\n\r\n@media (max-width: 420px) {\r\n  .therapy-deadlines__header {\r\n    padding: 12px;\r\n  }\r\n  .therapy-deadlines__list {\r\n    padding: 0 12px;\r\n  }\r\n  .therapy-deadlines__group-title {\r\n    padding-left: 12px;\r\n    padding-right: 12px;\r\n  }\r\n}\r\n"]],[[3,30]],["BODY",{},[[3,31]],["DIV",{"id":"root"},["DIV",{"class":"login-screen"},["DIV",{"class":"login-box"},[[3,38]],[[2,1]],["SECTION",{"class":"login-sim","aria-labelledby":"login-sim-title"},[[2,6]],["UL",{"class":"login-sim__list"},["LI",{},["BUTTON",{"__playwright_target__":"","type":"button","class":"login-sim__item","disabled":""},[[1,1]],[[1,6]]]]]],["P",{"class":"login-note"},"Verifica accesso…"]]]],[[3,65]],[[3,66]]]],"viewport":{"width":853,"height":1138},"timestamp":70689.529,"wallTime":1792890301293,"collectionTime":1,"resourceOverrides":[],"isMainFrame":true}}
