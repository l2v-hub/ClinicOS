ition: relative;\r\n  flex-shrink: 0;\r\n  border-radius: 12px;\r\n  overflow: hidden;\r\n  background: #101828;\r\n}\r\n.camera-capture__viewfinder .camera-capture__video {\r\n  display: block;\r\n  position: absolute;\r\n  inset: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  max-height: none;\r\n  object-fit: fill;\r\n  border-radius: 0;\r\n}\r\n.document-scan-frame {\r\n  position: absolute;\r\n  inset: 0;\r\n  overflow: hidden;\r\n}\r\n.document-scan-frame__window {\r\n  position: absolute;\r\n  box-sizing: border-box;\r\n  border: 2px solid #fff;\r\n  box-shadow: 0 0 0 100vmax #07142999;\r\n  pointer-events: none;\r\n}\r\n.document-scan-frame__corner {\r\n  position: absolute;\r\n  width: 44px;\r\n  height: 44px;\r\n  padding: 0;\r\n  transform: translate(-50%, -50%);\r\n  background: none;\r\n  border: 0;\r\n  touch-action: none;\r\n  cursor: move;\r\n}\r\n.document-scan-frame__corner span {\r\n  display: block;\r\n  margin: auto;\r\n  width: 20px;\r\n  height: 20px;\r\n  border: 3px solid #fff;\r\n  background: var(--blue, #2f6bed);\r\n  border-radius: 6px;\r\n  box-shadow: 0 1px 6px #0008;\r\n}\r\n.document-scan-frame__corner:focus-visible {\r\n  outline: 3px solid #a5eaff;\r\n  outline-offset: -5px;\r\n  border-radius: 10px;\r\n}\r\n.camera-capture__reset {\r\n  min-height: 44px;\r\n}\r\n.camera-capture__error {\r\n  color: #873d37;\r\n  font-size: 13px;\r\n}\r\n@media (max-width: 600px) {\r\n  .modal-card.camera-capture {\r\n    width: calc(100vw - 16px);\r\n    max-width: calc(100vw - 16px);\r\n    max-height: calc(100dvh - 16px);\r\n    margin: 8px 0;\r\n    padding: 14px;\r\n  }\r\n  .camera-capture__actions {\r\n    width: 100%;\r\n  }\r\n  .camera-capture__actions button {\r\n    flex: 1;\r\n  }\r\n}\r\n"],["STYLE",{},".document-pdf-preview {\r\n  display: flex;\r\n  flex: 1;\r\n  min-height: 0;\r\n  flex-direction: column;\r\n}\r\n.document-pdf-preview__toolbar {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: