{"type":"frame-snapshot","snapshot":{"callId":"call@1836","snapshotName":"before@call@1836","pageId":"page@9a9c8066cef4eb34886e4a1910924870","frameId":"frame@1f5ddcd3b97027bd930e9564246967fa","frameUrl":"http://127.0.0.1:7483/#/dettaglio-paziente/QA-418-INDEPENDENT/parametri","doctype":"html","html":["HTML",{"lang":"it"},["HEAD",{},[[35,0]],[[35,1]],[[35,2]],[[35,3]],[[35,4]],[[35,5]],[[35,6]],[[35,7]],[[35,8]],[[35,9]],[[35,10]],[[35,11]],[[35,12]],[[35,13]],[[35,15]],[[35,16]],[[35,18]],[[35,20]],[[35,22]],[[35,24]],[[35,26]],[[35,28]],[[30,1]],[[30,3]],[[30,5]],[[30,7]],[[30,9]],[[30,11]],[[30,13]],[[30,15]],[[30,17]],[[30,19]],[[30,21]],[[30,23]],[[30,25]],[[30,27]],[[30,29]],[[30,31]],[[30,33]],[[30,35]],[[30,37]],[[30,39]],[[30,41]],[[30,43]],[[30,45]],[[30,47]],[[30,49]],[[30,51]],[[30,53]],[[30,55]],[[30,57]],[[30,59]],[[30,61]],[[30,63]],[[30,65]],[[30,67]],[[30,69]],[[23,1]],[[23,3]],[[23,5]],[[23,7]],[[23,9]],[[23,11]],[[23,13]],[[23,15]],[[23,17]],[[23,19]],[[23,21]],[[20,1]],[[15,1]],[[15,3]],["STYLE",{},".agnos-panel { height: 100dvh; max-width: 100%; }\r\n.agnos-panel > header, .agnos-panel > .agnos-intro,\r\n.agnos-workflow-status, .agnos-composer { flex-shrink: 0; }\r\n.agnos-panel .ai-drawer__body { min-height: 0; overscroll-behavior: contain; padding: 16px 24px; }\r\n/* HMI 1: testata alta come la barra in alto, titolo \"✧ Assistente\" viola, poi la dichiarazione. */\r\n.agnos-panel .ai-drawer__header { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 8px; min-height: 72px; padding: 12px 16px 12px 24px; box-sizing: border-box; }\r\n.agnos-panel .agnos-title { display: flex; align-items: center; gap: 8px; min-width: 0; margin: 0; font: 600 20px/28px var(--ds-font); color: var(--purple, #6c4bd1); }\r\n.agnos-panel .agnos-title svg { width: 20px; height: 20px; flex: none; }\r\n.agnos-intro { padding: 16px 24px 0; }\r\n.agnos-intro p { margin: 0; }\r\n.agnos-intro__text { font: 400 14px/20px var(--ds-font); color: var(--text-muted); }\r\n.agnos-intro .agnos-intro__scope { margin-top: 8px; font: 600 14px/20px var(--ds-font); color: var(--ds-blue-active); }\r\n.agnos-panel .agnos-compose { display: flex; flex-direction: column; align-items: stretch; gap: 8px; padding: 16px 24px; }\r\n.agnos-compose-row { display: flex; align-items: flex-end; gap: 8px; }\r\n.agnos-compose-label { font-size: 13px; font-weight: 650; color: var(--text); }\r\n/* il campo parte da una riga (48px) e cresce col testo o con la dettatura */\r\n.agnos-panel textarea.agnos-input { width: 100%; min-width: 0; min-height: 48px; height: auto; max-height: 150px; flex: auto; field-sizing: content; line-height: 24px; padding-block: 10px; resize: none; }\r\n.agnos-compose-actions { display: flex; align-items: center; justify-content: flex-end; gap: 8px; }\r\n.agnos-compose-help { margin: 0; padding: 0 12px 8px; font-size: 12px; color: var(--text-muted); line-height: 1.4; }\r\n.agnos-compose .agnos-compose-help { padding: 0; }\r\n.agnos-panel .agnos-voice-consent { padding: 0 14px max(8px, env(safe-area-inset-bottom)); }\r\n.agnos-voice-consent .link-btn { font-size: 12px; min-height: 28px; }\r\n.agnos-consent-prompt { padding: 16px; border-top: 1px solid var(--border); background: #f3f7fd; font-size: 13px; line-height: 1.5; }\r\n.agnos-consent-prompt > strong { display: block; font-size: 15px; color: var(--text); }\r\n.agnos-consent-prompt p { margin: 8px 0 12px; }\r\n.agnos-composer { max-height: 65%; overflow-y: auto; overscroll-behavior: contain; }\r\n.agnos-consent-prompt .agnos-compose-actions { flex-wrap: wrap; }\r\n.agnos-workflow-status { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; padding: 10px 14px; background: #eef4ff; border-bottom: 1px solid var(--border); color: #244676; font-size: 13px; line-height: 1.4; }\r\n.agnos-workflow-status > span:not(.agnos-workflow-spinner) { flex: 1 1 220px; }\r\n.agnos-workflow-status[data-phase='error'] { background: #fff7e8; color: #76501c; }\r\n.agnos-workflow-status .link-btn { font-size: 12px; min-height: 32px; }\r\n.agnos-workflow-spinner { width: 14px; height: 14px; flex: 0 0 14px; border: 2px solid #cbdaf2; border-top-color: #316dda; border-radius: 50%; animation: agnos-spin 900ms linear infinite; }\r\n.agnos-transcript-label { align-self: flex-end; font-size: 11px; color: var(--text-muted); }\r\n.agnos-proposed-text { padding: 12px; border: 1px solid var(--border); border-radius: 8px; background: white; }\r\n.agnos-proposed-text p, .agnos-preview .voice-preview__row dd { white-space: pre-wrap; overflow-wrap: anywhere; }\r\n.agnos-proposed-text p { margin: 8px 0 12px; line-height: 1.5; }\r\n.agnos-proposed-text summary { cursor: pointer; color: var(--blue); margin-bottom: 12px; }\r\n.agnos-approval-hint { font-size: 13px; line-height: 1.45; margin: 12px 0 8px; }\r\n.agnos-panel .voice-actions { flex-wrap: wrap; }\r\n.agnos-workflow-dock { position: fixed; bottom: max(52px, env(safe-area-inset-bottom)); right: 12px; z-index: 202; max-width: min(440px, calc(100vw - 24px)); padding: 12px; display: flex; align-items: center; flex-wrap: wrap; gap: 10px; background: white; border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 4px 20px #10284726; font-size: 13px; }\r\n.agnos-workflow-dock span { flex: 1 1 190px; }\r\n@keyframes agnos-spin { to { transform: rotate(360deg); } }\r\n@media (min-width: 1100px) {\r\n  .app-shell:has(.agnos-panel--workspace[aria-hidden='false']) .main-area-clean { margin-right: 420px; }\r\n}\r\n@media (max-width: 1099px) {\r\n  .agnos-panel--workspace { top: auto; bottom: 0; height: 76dvh; border-radius: 16px 16px 0 0; }\r\n}\r\n@media (max-width: 480px) {\r\n  .agnos-panel--workspace { top: 0; height: 100dvh; border-radius: 0; }\r\n  .agnos-panel .agnos-compose { padding: 12px 16px; }\r\n  .agnos-panel .ai-drawer__header { padding-left: 16px; }\r\n  .agnos-intro { padding: 12px 16px 0; }\r\n  .agnos-panel .ai-drawer__body { padding: 12px 16px; }\r\n}\r\n@media (prefers-reduced-motion: reduce) { .agnos-workflow-spinner { animation: none; } }\r\n@media print { .agnos-workflow-dock { display: none !important; } }\r\n"]],[[35,30]],["BODY",{},[[35,31]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},[[24,2]],["DIV",{"class":"main-area-clean"},[[17,1]],["MAIN",{"class":"page-content content-panel"},["DIV",{"class":"patient-record-view"},[[15,9]],[[20,56]],["DIV",{"class":"cr-detail-layout cr-detail-layout--no-sidebar"},["DIV",{"id":"patient-tab-panel","role":"tabpanel","aria-labelledby":"patient-section-parametri","tabindex":"0","class":"cr-detail-content tab-panel-transition"},["DIV",{"class":"chart-part","data-chart-part":"parametri"},["DIV",{"class":"patient-vital-signs parameter-workspace","id":"vital-panel"},["SECTION",{"class":"parameter-single-entry","aria-label":"Registra parametri del paziente"},[[15,19]],["FORM",{"class":"parameter-reading-form","aria-label":"Nuova rilevazione"},["DIV",{"class":"parameter-reading-form__layout"},["FIELDSET",{"class":"parameter-reading-form__fields"},[[15,21]],[[6,0]],["LABEL",{"for":"_r_j_-spo2","class":"parameter-reading-form__field"},[[15,35]],[[15,36]],[[14,4]]],[[14,8]],[[14,11]],[[14,14]],[[14,17]],[[14,20]],[[14,23]],[[14,26]],[[15,121]],[[15,126]]],[[15,169]]]]],[[14,36]]]],[[20,78]]]]]]]]],[[35,65]],[[35,66]]]],"viewport":{"width":1150,"height":1004},"timestamp":9647.923,"wallTime":1792890302268,"collectionTime":1,"resourceOverrides":[],"isMainFrame":true}}
