x;\r\n}\r\n\r\n.table-filters__results {\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  white-space: nowrap;\r\n}\r\n\r\n.table-filters__clear {\r\n  min-height: var(--touch-target);\r\n  padding: 6px 10px;\r\n  color: var(--blue);\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  font: inherit;\r\n  font-size: 11px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n}\r\n\r\n.table-filters__clear:hover {\r\n  border-color: var(--blue);\r\n  background: var(--blue-glow);\r\n}\r\n\r\n.table-filters__panel {\r\n  padding: 14px;\r\n  background: var(--surface);\r\n  border-top: 1px solid var(--divider);\r\n}\r\n\r\n.table-filters__grid {\r\n  display: grid;\r\n  gap: 12px;\r\n}\r\n\r\n.table-filters__grid--1 {\r\n  grid-template-columns: minmax(0, 1fr);\r\n}\r\n\r\n.table-filters__grid--2 {\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n}\r\n\r\n.table-filters__grid--3 {\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n}\r\n\r\n.table-filters__grid--4 {\r\n  grid-template-columns: repeat(4, minmax(0, 1fr));\r\n}\r\n\r\n.table-filters__field {\r\n  min-width: 0;\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n\r\n.table-filters__field label {\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  font-weight: 750;\r\n  letter-spacing: 0.45px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.table-filters__field :is(input, select) {\r\n  width: 100%;\r\n  min-width: 0;\r\n  min-height: var(--touch-target);\r\n  padding: 0 11px;\r\n  color: var(--text);\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  font: inherit;\r\n  font-size: var(--ds-field-font);\r\n}\r\n\r\n.table-filters__field :is(input, select):hover {\r\n  border-color: var(--text-xmuted);\r\n}\r\n\r\n.table-filters__field :is(input, select):focus {\r\n  border-color: var(--blue);\r\n  box-shadow: var(--shadow-focus);\r\n}\r\n\r\n.table-filters__field input::placeh