netti-legacy summary {\r\n  cursor: pointer;\r\n  min-height: 44px;\r\n}\r\n.tinetti-legacy table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n}\r\n.tinetti-legacy th,\r\n.tinetti-legacy td {\r\n  text-align: left;\r\n  padding: 6px;\r\n  border-bottom: 1px solid var(--border);\r\n  overflow-wrap: anywhere;\r\n}\r\n@media (max-width: 600px) {\r\n  .tinetti-form .tinetti-options label {\r\n    flex-basis: 100%;\r\n  }\r\n}\r\n@media print {\r\n  html:has(.tinetti-legacy[data-print-id]),\r\n  body:has(.tinetti-legacy[data-print-id]),\r\n  body:has(.tinetti-legacy[data-print-id]) *:has(.tinetti-legacy[data-print-id]) {\r\n    display: block !important;\r\n    position: static !important;\r\n    width: auto !important;\r\n    height: auto !important;\r\n    min-height: 0 !important;\r\n    max-height: none !important;\r\n    overflow: visible !important;\r\n    contain: none !important;\r\n    transform: none !important;\r\n    margin: 0 !important;\r\n  }\r\n  body:has(.tinetti-legacy[data-print-id])\r\n    *:not(.tinetti-legacy):not(.tinetti-legacy *):not(:has(.tinetti-legacy[data-print-id])) {\r\n    display: none !important;\r\n  }\r\n  body:has(.tinetti-legacy[data-print-id]) .assessment-workspace > :not(.tinetti-legacy) {\r\n    display: none !important;\r\n  }\r\n  .tinetti-legacy[data-print-id] > :not(details),\r\n  .tinetti-legacy[data-print-id] details:not([data-print-selected]) {\r\n    display: none !important;\r\n  }\r\n  .tinetti-legacy details[data-print-selected] {\r\n    display: block !important;\r\n    border: 0;\r\n  }\r\n  .tinetti-legacy details[data-print-selected] > summary {\r\n    display: none;\r\n  }\r\n  .tinetti-legacy tr {\r\n    break-inside: avoid;\r\n  }\r\n}\r\n"]],[[88,30]],[[1,15]]],"viewport":{"width":1150,"height":1004},"timestamp":10328.612,"wallTime":1792890422924,"collectionTime":2,"resourceOverrides":[],"isMainFrame":true}}
