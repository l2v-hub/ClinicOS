er;\r\n  transform: translateY(-50%);\r\n}\r\n\r\n.patient-combobox__clear:hover,\r\n.patient-combobox__clear:focus-visible {\r\n  color: var(--blue);\r\n  background: var(--blue-dim);\r\n}\r\n\r\n.patient-combobox__help {\r\n  margin: 5px 0 0;\r\n  color: var(--text-muted);\r\n  font-size: 11.5px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.patient-combobox__selection {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 9px;\r\n  min-width: 0;\r\n  margin-top: 8px;\r\n  padding: 9px 11px;\r\n  border: 1px solid color-mix(in srgb, var(--emerald) 28%, var(--border));\r\n  border-radius: 8px;\r\n  color: var(--text);\r\n  background: var(--emerald-bg);\r\n}\r\n\r\n.patient-combobox__selection-icon {\r\n  display: grid;\r\n  width: 26px;\r\n  height: 26px;\r\n  flex: 0 0 26px;\r\n  border-radius: 50%;\r\n  color: var(--emerald);\r\n  background: var(--surface);\r\n  place-items: center;\r\n}\r\n\r\n.patient-combobox__selection-icon svg {\r\n  width: 15px;\r\n  height: 15px;\r\n}\r\n\r\n.patient-combobox__popup {\r\n  position: absolute;\r\n  top: calc(100% + 6px);\r\n  left: 0;\r\n  right: 0;\r\n  z-index: 250;\r\n  overflow: hidden;\r\n  border: 1px solid var(--border-strong, var(--border));\r\n  border-radius: 9px;\r\n  background: var(--surface);\r\n  box-shadow: 0 12px 30px rgba(20, 39, 72, 0.16);\r\n}\r\n\r\n.patient-combobox__list {\r\n  max-height: min(320px, 40vh);\r\n  margin: 0;\r\n  padding: 4px;\r\n  overflow-y: auto;\r\n  list-style: none;\r\n}\r\n\r\n.patient-combobox__option {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr);\r\n  gap: 12px;\r\n  align-items: center;\r\n  min-height: 52px;\r\n  padding: 8px 10px;\r\n  border-radius: 7px;\r\n  cursor: pointer;\r\n}\r\n\r\n.patient-combobox__option.is-active,\r\n.patient-combobox__option:hover {\r\n  background: var(--blue-dim);\r\n  box-shadow: inset 3px 0 0 var(--blue);\r\n}\r\n\r\n.patient-combobox__option-name {\r\n  overflow: hidden;\r\n  color: var(--text);\r\n  font-size: 13px;\r\n  font-