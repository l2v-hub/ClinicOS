{"type":"frame-snapshot","snapshot":{"callId":"call@1732","snapshotName":"after@call@1732","pageId":"page@9a9c8066cef4eb34886e4a1910924870","frameId":"frame@1f5ddcd3b97027bd930e9564246967fa","frameUrl":"http://127.0.0.1:7483/#/dettaglio-paziente/QA-418-INDEPENDENT","doctype":"html","html":["HTML",{"lang":"it"},["HEAD",{},[[15,0]],[[15,1]],[[15,2]],[[15,3]],[[15,4]],[[15,5]],[[15,6]],[[15,7]],[[15,8]],[[15,9]],[[15,10]],[[15,11]],[[15,12]],[[15,13]],[[15,15]],[[15,16]],[[15,18]],[[15,20]],[[15,22]],[[15,24]],[[15,26]],[[15,28]],[[10,1]],[[10,3]],[[10,5]],[[10,7]],[[10,9]],[[10,11]],[[10,13]],[[10,15]],[[10,17]],[[10,19]],[[10,21]],[[10,23]],[[10,25]],[[10,27]],[[10,29]],[[10,31]],[[10,33]],[[10,35]],[[10,37]],[[10,39]],[[10,41]],[[10,43]],[[10,45]],[[10,47]],[[10,49]],[[10,51]],[[10,53]],[[10,55]],[[10,57]],[[10,59]],[[10,61]],[[10,63]],[[10,65]],[[10,67]],[[10,69]],[[3,1]],[[3,3]],[[3,5]],[[3,7]],[[3,9]],[[3,11]],[[3,13]],[[3,15]],[[3,17]],[[3,19]],[[3,21]],["STYLE",{},"/* Parametri vitali — HMI 1 (artifacts/hmi-parity/proto/parametri.png). */\r\n.par-view {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.par-grid {\r\n  display: grid;\r\n  grid-template-columns: 240px minmax(0, 1fr);\r\n  grid-template-areas: 'list form';\r\n  gap: 24px;\r\n  align-items: start;\r\n}\r\n.par-patients {\r\n  grid-area: list;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  min-width: 0;\r\n}\r\n.par-form {\r\n  grid-area: form;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.par-side {\r\n  grid-area: side;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.par-eyebrow {\r\n  font: 600 14px/20px var(--font-ui);\r\n  letter-spacing: 0.06em;\r\n  text-transform: uppercase;\r\n  color: var(--text-muted);\r\n}\r\n.par-cap {\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n  min-width: 0;\r\n}\r\n\r\n.par-pad__key:focus-visible,\r\n.par-pick__main:focus-visible {\r\n  outline: 3px solid #245bb5;\r\n  outline-offset: 2px;\r\n}\r\n\r\n/* Colonna pazienti */\r\n.par-search {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n.par-search__ico {\r\n  position: absolute;\r\n  left: 14px;\r\n  display: grid;\r\n  color: var(--text-muted);\r\n}\r\n.par-search__ico svg {\r\n  width: 18px;\r\n  height: 18px;\r\n}\r\n.par-search__input {\r\n  width: 100%;\r\n  height: 48px;\r\n  padding: 0 44px;\r\n  border-radius: 12px;\r\n  border: 2px solid var(--border);\r\n  background: var(--surface);\r\n  font: 400 16px/24px var(--font-ui);\r\n  color: var(--text);\r\n}\r\n.par-search__clear {\r\n  position: absolute;\r\n  right: 4px;\r\n  width: 40px;\r\n  height: 40px;\r\n  border: 0;\r\n  background: none;\r\n  display: grid;\r\n  place-items: center;\r\n  color: var(--text-muted);\r\n  cursor: pointer;\r\n}\r\n.par-patients__tools {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n}\r\n.par-plist {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n.par-pick {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding-right: 8px;\r\n  border-radius: 12px;\r\n  background: var(--surface);\r\n  border: 2px solid transparent;\r\n}\r\n.par-pick--selected {\r\n  border-color: var(--blue);\r\n  background: #eaf1fe;\r\n}\r\n.par-pick__main {\r\n  flex: 1;\r\n  min-width: 0;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n  padding: 8px;\r\n  border: 0;\r\n  background: none;\r\n  text-align: left;\r\n  cursor: pointer;\r\n  border-radius: 10px;\r\n}\r\n.par-pick__bed {\r\n  width: 48px;\r\n  height: 48px;\r\n  flex: none;\r\n  border-radius: 12px;\r\n  background: #f5f7fb;\r\n  border: 1px solid var(--border);\r\n  display: grid;\r\n  place-items: center;\r\n  font: 600 18px/24px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--text);\r\n}\r\n.par-pick__text {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n}\r\n.par-pick__name {\r\n  font: 600 16px/24px var(--font-ui);\r\n  color: var(--text);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.par-pick .par-cap {\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n.par-pick__draft {\r\n  color: #8a5300;\r\n  font-weight: 600;\r\n}\r\n.par-pick .turno-pcard__news2 {\r\n  flex: none;\r\n}\r\n.par-more {\r\n  align-self: flex-start;\r\n  min-height: 48px;\r\n}\r\n\r\n/* Paziente scelto */\r\n.par-form__head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n}\r\n.par-form__who {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n}\r\n.par-form__name {\r\n  margin: 0;\r\n  font: 600 20px/28px var(--font-ui);\r\n  color: var(--text);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.par-cards {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  gap: 16px;\r\n}\r\n.par-card {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  padding: 16px;\r\n  border-radius: 16px;\r\n  background: var(--surface);\r\n  border: 2px solid var(--border);\r\n  cursor: text;\r\n  min-width: 0;\r\n  margin: 0;\r\n}\r\n.par-card--active {\r\n  border-color: var(--blue);\r\n}\r\n.par-card__label {\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n.par-card__value {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: 8px;\r\n  min-width: 0;\r\n}\r\n/* Il campo è la card: niente riquadro del campo globale (form-controls.css). */\r\n.par-view .par-card input.par-card__input {\r\n  --control-bg: transparent;\r\n  --control-border: transparent;\r\n  box-shadow: none;\r\n  /* Il campo cresce col valore: l'unità resta accanto, come nel prototipo. */\r\n  field-sizing: content;\r\n  width: auto;\r\n  min-width: 2ch;\r\n  max-width: 100%;\r\n  flex: 0 1 auto;\r\n  height: 40px;\r\n  border: 0;\r\n  padding: 0;\r\n  background: none;\r\n  font: 600 28px/36px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--text);\r\n}\r\n.par-view .par-card input.par-card__input:focus {\r\n  outline: none;\r\n}\r\n.par-card__input::placeholder {\r\n  color: var(--text);\r\n}\r\n.par-card__unit {\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n  white-space: nowrap;\r\n}\r\n.par-choice,\r\n.par-field {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  margin: 0;\r\n}\r\n.par-choice__label {\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n\r\n.par-extra {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  gap: 16px;\r\n}\r\n.par-text {\r\n  min-height: 48px;\r\n  width: 100%;\r\n}\r\n\r\n/* Tastierino e salvataggio */\r\n.par-pad {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, 1fr);\r\n  gap: 8px;\r\n}\r\n.par-pad__key {\r\n  height: 48px;\r\n  border-radius: 12px;\r\n  border: 2px solid var(--border);\r\n  background: var(--surface);\r\n  color: var(--text);\r\n  font: 600 20px/28px var(--font-ui);\r\n  cursor: pointer;\r\n}\r\n.par-pad__key:active:not(:disabled) {\r\n  background: #eaf1fe;\r\n}\r\n\r\n.par-pad__key:disabled {\r\n  opacity: 0.45;\r\n  cursor: not-allowed;\r\n}\r\n.par-news2 {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  padding: 16px;\r\n  border-radius: 16px;\r\n  background: #eaf1fe;\r\n  color: #1d4fc4;\r\n}\r\n.par-news2__title {\r\n  font: 600 14px/20px var(--font-ui);\r\n}\r\n.par-news2__score {\r\n  font: 700 28px/36px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.par-news2__text {\r\n  font: 400 16px/24px var(--font-ui);\r\n}\r\n.par-news2--ok {\r\n  background: #e6f6ef;\r\n  color: #0e7a55;\r\n}\r\n.par-news2--low {\r\n  background: #eaf1fe;\r\n  color: #1d4fc4;\r\n}\r\n.par-news2--single,\r\n.par-news2--medium {\r\n  background: var(--amber-bg);\r\n  color: #8a5300;\r\n}\r\n.par-news2--high {\r\n  background: #fdecee;\r\n  color: #b3261e;\r\n}\r\n.par-result {\r\n  margin: 0;\r\n  color: #0e7a55;\r\n  font: 600 14px/20px var(--font-ui);\r\n}\r\n.par-error {\r\n  color: #b3261e;\r\n  font: 400 14px/20px var(--font-ui);\r\n}\r\n\r\n/* Tablet: pazienti a sinistra, tastierino sotto il modulo. */\r\n@media (max-width: 1099px) {\r\n  .par-grid {\r\n    grid-template-columns: 240px minmax(0, 1fr);\r\n    grid-template-areas: 'list form';\r\n  }\r\n}\r\n/* Telefono: una colonna; l'elenco pazienti scorre in un riquadro. */\r\n@media (max-width: 699px) {\r\n  .par-grid {\r\n    grid-template-columns: minmax(0, 1fr);\r\n    grid-template-areas: 'list' 'form';\r\n  }\r\n  .par-plist {\r\n    max-height: 40vh;\r\n    overflow-y: auto;\r\n  }\r\n  .par-cards,\r\n  .par-extra {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }\r\n  .par-cards {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n  /* Sul telefono c'è già la tastiera numerica di sistema (inputMode). */\r\n  .par-pad {\r\n    display: none;\r\n  }\r\n}\r\n/* Schermi larghi: tastierino, NEWS2 e Salva restano a vista mentre si scorre il modulo. */\r\n@media (min-width: 1100px) {\r\n  .par-side {\r\n    position: sticky;\r\n    top: 16px;\r\n  }\r\n}\r\n\r\n/* QA: il nome non si tronca (omonimi, stessa camera). Va a capo su più righe se serve. */\r\n.par-pick__name,\r\n.par-pick .par-cap {\r\n  white-space: normal;\r\n  overflow: visible;\r\n  text-overflow: clip;\r\n  overflow-wrap: anywhere;\r\n}\r\n.par-pick__main {\r\n  align-items: flex-start;\r\n}\r\n.par-pick { display:grid; grid-template-columns:minmax(0,1fr); padding:8px; gap:4px; }\r\n.par-pick__main { width:100%; padding:0; gap:10px; }\r\n.par-pick__text { flex:1; min-width:0; }\r\n.par-pick__bed { width:32px; height:32px; border-radius:8px; font-size:14px; }\r\n.par-pick__name { font-size:14px; line-height:20px; overflow-wrap:normal; word-break:normal; }\r\n.par-pick .par-cap { font-size:12px; line-height:18px; overflow-wrap:normal; }\r\n.par-pick .turno-pcard__news2 { justify-self:start; max-width:100%; margin-left:42px; font-size:12px; line-height:18px; }\r\n@media (max-width: 1099px) {\r\n  .par-grid {\r\n    grid-template-columns: 240px minmax(0, 1fr);\r\n  }\r\n}\r\n@media (max-width: 699px) {\r\n  .par-grid {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }\r\n}\r\n.par-outside {\r\n  margin: 0;\r\n  padding: 8px 12px;\r\n  border-radius: 12px;\r\n  background: var(--amber-bg);\r\n  color: #8a5300;\r\n  font: 600 14px/20px var(--font-ui);\r\n}\r\n\r\n/* Un solo pulsante per cancellare la ricerca (quello della pagina). */\r\n.par-search__input::-webkit-search-cancel-button {\r\n  display: none;\r\n}\r\n\r\n/* Azioni della colonna laterale a tutta larghezza (solo layout). */\r\n.par-wide {\r\n  width: 100%;\r\n}\r\n"]],[[15,30]],["BODY",{},[[15,31]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},[[4,2]],["DIV",{"class":"main-area-clean"},["DIV",{"class":"compact-topbar"},[[10,124]],[[2,0]],["DIV",{"class":"topbar-title"},["DIV",{"class":"page-header__titles patient-topbar-title"},["DIV",{"class":"patient-topbar-title__row"},["H1",{"class":"page-header__title"},"Sintetico QA, Caso"]],["P",{"class":"page-header__subtitle"},"Posto letto non disponibile · 56 anni · nata il 01/01/1970"]]],[[10,136]],[[10,152]]],["MAIN",{"class":"page-content content-panel"},["DIV",{"class":"patient-record-view"},["DIV",{"class":"chart-sections no-print"},["NAV",{"class":"top-nav top-nav--level2 top-nav--chips","role":"tablist","aria-label":"Sezioni della cartella"},["SPAN",{"class":"top-nav__context-label","aria-hidden":"true"},"Sezioni"],["DIV",{"class":"top-nav__items"},["BUTTON",{"__playwright_target__":"","type":"button","role":"tab","id":"patient-section-panoramica","aria-selected":"true","aria-controls":"patient-tab-pa