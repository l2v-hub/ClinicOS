ch:focus-visible,\r\n.operator-editor__custom-color:focus-within {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 2px;\r\n}\r\n\r\n.operator-editor__custom-color {\r\n  min-height: 40px;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 7px;\r\n  padding-left: 4px;\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n}\r\n\r\n.operator-editor__custom-color input {\r\n  width: 40px;\r\n  height: 40px;\r\n  padding: 4px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  background: var(--surface);\r\n  cursor: pointer;\r\n}\r\n\r\n.operator-editor__notes textarea {\r\n  min-height: 72px;\r\n}\r\n\r\n.op-management .operator-editor__actions {\r\n  min-height: 62px;\r\n  align-items: center;\r\n  margin: 0;\r\n  padding: 9px 16px;\r\n  background: var(--surface-raised);\r\n  border-top: 1px solid var(--border);\r\n}\r\n\r\n.operator-editor__required-note {\r\n  margin-right: auto;\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n}\r\n\r\n.operator-editor__required-note > span {\r\n  color: var(--red);\r\n  font-weight: 700;\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .op-management .cts .clinicos-table-wrap {\r\n    display: none;\r\n  }\r\n\r\n  .operator-editor__grid {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n\r\n  .operator-editor__field--span-2,\r\n  .operator-editor__field--span-3 {\r\n    grid-column: span 1;\r\n  }\r\n\r\n  .operator-editor__optional-content {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n\r\n@media (max-width: 520px) {\r\n  .op-management .operator-editor__header {\r\n    padding: 12px;\r\n  }\r\n\r\n  .operator-editor__intro {\r\n    max-width: 30ch;\r\n  }\r\n\r\n  .operator-editor__body {\r\n    padding: 0 12px;\r\n  }\r\n\r\n  .operator-editor__grid {\r\n    grid-template-columns: 1fr;\r\n    gap: 10px;\r\n  }\r\n\r\n  .op-management .operator-editor__actions {\r\n    flex-wrap: wrap;\r\n    padding: 10px 12px;\r\n 