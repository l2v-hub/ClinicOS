{"type":"frame-snapshot","snapshot":{"callId":"call@10444","snapshotName":"input@call@10444","pageId":"page@860c4d357369f4813ba2eae98ffce6ac","frameId":"frame@6aaedef12524a6259a91b70b25ac2617","frameUrl":"http://127.0.0.1:7483/#/pazienti","doctype":"html","html":["HTML",{"lang":"it"},["HEAD",{},[[12,0]],[[12,1]],[[12,2]],[[12,3]],[[12,4]],[[12,5]],[[12,6]],[[12,7]],[[12,8]],[[12,9]],[[12,10]],[[12,11]],[[12,12]],[[12,13]],[[12,15]],[[12,16]],[[12,18]],[[12,20]],[[12,22]],[[12,24]],[[12,26]],[[12,28]],[[9,1]],[[9,3]],[[9,5]],[[9,7]],[[9,9]],[[9,11]],[[9,13]],[[9,15]],[[9,17]],[[9,19]],[[9,21]],[[9,23]],[[9,25]],[[9,27]],[[9,29]],[[8,1]],[[8,3]],[[8,5]],[[8,7]],[[8,9]],[[8,11]],[[8,13]],[[8,15]],[[8,17]],[[8,19]],[[8,21]],[[8,23]],[[8,25]],[[8,27]],[[6,1]],[[6,3]],["STYLE",{},".patient-combobox {\r\n  position: relative;\r\n  min-width: 0;\r\n}\r\n\r\n.patient-combobox__control {\r\n  position: relative;\r\n}\r\n\r\n.patient-combobox__search-icon {\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 12px;\r\n  z-index: 1;\r\n  width: 18px;\r\n  height: 18px;\r\n  color: var(--text-muted);\r\n  pointer-events: none;\r\n  transform: translateY(-50%);\r\n}\r\n\r\n.patient-combobox__search-icon svg,\r\n.patient-combobox__clear svg {\r\n  width: 18px;\r\n  height: 18px;\r\n}\r\n\r\n.patient-combobox .patient-combobox__input {\r\n  min-width: 0;\r\n  width: 100%;\r\n  padding-right: 46px;\r\n  padding-left: 40px;\r\n}\r\n\r\n.patient-combobox__clear {\r\n  position: absolute;\r\n  top: 50%;\r\n  right: 4px;\r\n  display: grid;\r\n  width: 44px;\r\n  height: 44px;\r\n  padding: 0;\r\n  border: 0;\r\n  border-radius: 7px;\r\n  color: var(--text-muted);\r\n  background: transparent;\r\n  cursor: pointer;\r\n  place-items: center;\r\n  transform: translateY(-50%);\r\n}\r\n\r\n.patient-combobox__clear:hover,\r\n.patient-combobox__clear:focus-visible {\r\n  color: var(--blue);\r\n  background: var(--blue-dim);\r\n}\r\n\r\n.patient-combobox__help {\r\n  margin: 5px 0 0;\r\n  color: var(--text-muted);\r\n  font-size: 11.5px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.patient-combobox__selection {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 9px;\r\n  min-width: 0;\r\n  margin-top: 8px;\r\n  padding: 9px 11px;\r\n  border: 1px solid color-mix(in srgb, var(--emerald) 28%, var(--border));\r\n  border-radius: 8px;\r\n  color: var(--text);\r\n  background: var(--emerald-bg);\r\n}\r\n\r\n.patient-combobox__selection-icon {\r\n  display: grid;\r\n  width: 26px;\r\n  height: 26px;\r\n  flex: 0 0 26px;\r\n  border-radius: 50%;\r\n  color: var(--emerald);\r\n  background: var(--surface);\r\n  place-items: center;\r\n}\r\n\r\n.patient-combobox__selection-icon svg {\r\n  width: 15px;\r\n  height: 15px;\r\n}\r\n\r\n.patient-combobox__popup {\r\n  position: absolute;\r\n  top: calc(100% + 6px);\r\n  left: 0;\r\n  right: 0;\r\n  z-index: 250;\r\n  overflow: hidden;\r\n  border: 1px solid var(--border-strong, var(--border));\r\n  border-radius: 9px;\r\n  background: var(--surface);\r\n  box-shadow: 0 12px 30px rgba(20, 39, 72, 0.16);\r\n}\r\n\r\n.patient-combobox__list {\r\n  max-height: min(320px, 40vh);\r\n  margin: 0;\r\n  padding: 4px;\r\n  overflow-y: auto;\r\n  list-style: none;\r\n}\r\n\r\n.patient-combobox__option {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr);\r\n  gap: 12px;\r\n  align-items: center;\r\n  min-height: 52px;\r\n  padding: 8px 10px;\r\n  border-radius: 7px;\r\n  cursor: pointer;\r\n}\r\n\r\n.patient-combobox__option.is-active,\r\n.patient-combobox__option:hover {\r\n  background: var(--blue-dim);\r\n  box-shadow: inset 3px 0 0 var(--blue);\r\n}\r\n\r\n.patient-combobox__option-name {\r\n  overflow: hidden;\r\n  color: var(--text);\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.patient-combobox__option-identity {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-end;\r\n  color: var(--text-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 10.5px;\r\n  line-height: 1.35;\r\n}\r\n\r\n.patient-combobox__option-identity strong {\r\n  color: var(--text);\r\n  font-size: 11px;\r\n}\r\n\r\n.patient-combobox__status {\r\n  margin: 0;\r\n  padding: 13px 14px;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n}\r\n\r\n.patient-combobox__status--error {\r\n  color: var(--red);\r\n}\r\n\r\n@media (max-width: 520px) {\r\n  .patient-combobox__option {\r\n    grid-template-columns: 1fr;\r\n    gap: 3px;\r\n  }\r\n\r\n  .patient-combobox__option-identity {\r\n    align-items: flex-start;\r\n  }\r\n}\r\n"],["STYLE",{},".tdose-list {\r\n  list-style: none;\r\n  margin: 6px 0 0;\r\n  padding: 0;\r\n  display: grid;\r\n  gap: 4px;\r\n  text-align: left;\r\n}\r\n.tdose {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1px;\r\n  padding: 3px 6px;\r\n  border-left: 3px solid var(--blue);\r\n  border-radius: 4px;\r\n  background: var(--surface, #fff);\r\n  font-size: 11.5px;\r\n  line-height: 1.35;\r\n  overflow-wrap: anywhere;\r\n}\r\n.tdose__who {\r\n  font-weight: 650;\r\n  color: var(--text);\r\n}\r\n.tdose__what {\r\n  color: var(--text);\r\n}\r\n.tdose__status {\r\n  font-weight: 600;\r\n  color: #1d4fc4;\r\n}\r\n.tdose--late,\r\n.tdose--missed {\r\n  border-left-color: var(--red);\r\n}\r\n.tdose--late .tdose__status,\r\n.tdose--missed .tdose__status {\r\n  color: #a5202f;\r\n}\r\n.tdose--done {\r\n  border-left-color: #16a37b;\r\n}\r\n.tdose--done .tdose__status {\r\n  color: #0e7a55;\r\n}\r\n.tdose-list__partial {\r\n  margin: 4px 0 0;\r\n  font-size: 11.5px;\r\n  color: var(--text-muted);\r\n}\r\n"],["STYLE",{},".therapy-modal .therapy-modal__body {\r\n  min-height: 0;\r\n  padding-top: 0;\r\n  scroll-padding-block: 160px 16px;\r\n}\r\n.therapy-modal .therapy-patient-group {\r\n  min-width: 0;\r\n  margin-bottom: 18px;\r\n  border: 1px solid var(--border, #dce3ec);\r\n  border-radius: 8px;\r\n  background: var(--surface, #fff);\r\n}\r\n.therapy-modal .therapy-patient-header {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 2;\r\n  margin: 0;\r\n  padding: 12px 16px;\r\n  border-top: 0;\r\n  border-bottom: 2px solid var(--border, #dce3ec);\r\n  border-radius: 7px 7px 0 0;\r\n  background: var(--surface, #fff);\r\n  box-shadow: 0 3px 5px rgb(26 51 87 / 8%);\r\n}\r\n.therapy-modal .patient-identity__name {\r\n  font-size: 18px;\r\n  font-weight: 750;\r\n}\r\n.therapy-modal .therapy-drug-row {\r\n  padding-block: 12px;\r\n  flex-wrap: wrap;\r\n}\r\n.therapy-modal .therapy-drug-row__info {\r\n  min-width: 0;\r\n  flex-basis: 180px;\r\n  overflow-wrap: anywhere;\r\n}\r\n.therapy-modal .therapy-drug-row__actions {\r\n  flex-wrap: wrap;\r\n  min-width: 0;\r\n  max-width: 100%;\r\n}\r\n.therapy-modal button,\r\n.therapy-modal input {\r\n  min-height: 44px;\r\n}\r\n.therapy-modal button {\r\n  white-space: normal;\r\n  overflow-wrap: anywhere;\r\n}\r\n.therapy-modal button:focus-visible,\r\n.therapy-modal input:focus-visible {\r\n  outline: 2px solid var(--blue, #2463eb);\r\n  outline-offset: 3px;\r\n}\r\n.therapy-modal .therapy-modal__footer,\r\n.therapy-modal .therapy-modal__footer > div {\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n@media (max-width: 520px) {\r\n  .therapy-modal .therapy-modal__body {\r\n    padding: 0 8px 8px;\r\n  }\r\n  .therapy-modal .therapy-patient-header,\r\n  .therapy-modal .therapy-drug-row {\r\n    padding-inline: 12px;\r\n  }\r\n  .therapy-modal .therapy-drug-row__actions {\r\n    width: 100%;\r\n  }\r\n  .therapy-modal .therapy-motivi-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Agenda — informazione senza tocchi (UX direct-access, 2026-10-03). Condiviso da agenda\r\n   operatore e multi-operatore: nota sempre visibile, stato in parole (non solo colore), nome\r\n   dell'operatore accanto al pallino, mese senza «+N» (la cella cresce). Testo che va a capo. */\r\n.agt-note-inline {\r\n  white-space: pre-wrap;\r\n  overflow-wrap: anywhere;\r\n  font-size: 13px;\r\n  line-height: 18px;\r\n}\r\n.agt-inline-apt {\r\n  flex-wrap: wrap;\r\n  align-items: flex-start;\r\n  row-gap: 2px;\r\n  height: auto;\r\n}\r\n.agt-inline-apt .agt-week-apt__name,\r\n.agt-inline-apt .agt-month-apt__name {\r\n  white-space: normal;\r\n  overflow: visible;\r\n  text-overflow: clip;\r\n  overflow-wrap: anywhere;\r\n}\r\n.agt-inline-meta {\r\n  flex-basis: 100%;\r\n  min-width: 0;\r\n  font-size: 11px;\r\n  line-height: 15px;\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n}\r\n.agt-inline-meta strong {\r\n  font-weight: 700;\r\n  color: var(--text);\r\n}\r\n/* Mese: la cella mostra tutti gli appuntamenti e cresce in altezza. */\r\n.agt-month-day {\r\n  height: auto;\r\n}\r\n.agt-month-day__apts {\r\n  overflow: visible;\r\n}\r\n"],["STYLE",{},".consegne-page .handover-editor {\r\n  max-width: 1040px;\r\n  margin: 0 auto 20px;\r\n  padding: 0;\r\n  overflow: visible;\r\n  border-radius: 9px;\r\n  box-shadow: 0 1px 4px rgba(20, 39, 72, 0.08);\r\n}\r\n\r\n.handover-editor__header {\r\n  min-height: 68px;\r\n  margin: 0;\r\n  padding: 13px 16px;\r\n  align-items: flex-start;\r\n  border-bottom: 1px solid var(--border);\r\n  border-radius: 9px 9px 0 0;\r\n  background: var(--surface-raised);\r\n}\r\n\r\n.handover-editor__eyebrow,\r\n.handover-editor__section > legend {\r\n  color: var(--text-xmuted);\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  letter-spacing: 0.65px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.handover-editor__eyebrow {\r\n  display: block;\r\n  margin-bottom: 2px;\r\n}\r\n\r\n.handover-editor__intro {\r\n  margin: 3px 0 0;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.handover-editor__body {\r\n  padding: 0 16px;\r\n}\r\n\r\n.handover-editor__section {\r\n  min-width: 0;\r\n  margin: 0;\r\n  padding: 14px 0 16px;\r\n  border: 0;\r\n  border-bottom: 1px solid var(--divider);\r\n}\r\n\r\n.handover-editor__section--last {\r\n  border-bottom: 0;\r\n}\r\n\r\n.handover-editor__section > legend {\r\n  width: 100%;\r\n  padding: 0 0 9px;\r\n}\r\n\r\n.handover-editor__grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(12, minmax(0, 1fr));\r\n  gap: 12px;\r\n}\r\n\r\n.handover-editor__field--patient {\r\n  grid-column: span 7;\r\n  min-width: 0;\r\n}\r\n\r\n.handover-editor__field--assignee {\r\n  grid-column: span 5;\r\n}\r\n\r\n.handover-editor__field--third {\r\n  grid-column: span 3;\r\n}\r\n\r\n.handover-editor .form-field,\r\n.handover-editor .form-input,\r\n.handover-editor .form-select {\r\n  min-width: 0;\r\n}\r\n\r\n.handover-editor .form-input,\r\n.handover-editor .form-select {\r\n  width: 100%;\r\n}\r\n\r\n.handover-editor__optional-label {\r\n  color: var(--text-muted);\r\n  font-size: 10px;\r\n  font-weight: 500;\r\n  text-transform: none;\r\n}\r\n\r\n.handover-editor__notes {\r\n  min-height: 86px;\r\n  resize: vertical;\r\n}\r\n\r\n.handover-editor__counter {\r\n  display: block;\r\n  margin-top: 4px;\r\n  color: var(--text-xmuted);\r\n  font-size: 10.5px;\r\n  text-align: right;\r\n}\r\n\r\n.handover-editor__actions {\r\n  min-height: 62px;\r\n  align-items: center;\r\n  margin: 0;\r\n  padding: 9px 16px;\r\n  border-top: 1px solid var(--border);\r\n  border-radius: 0 0 9px 9px;\r\n  background: var(--surface-raised);\r\n}\r\n\r\n.handover-editor__required-note,\r\n.handover-editor__error {\r\n  margin: 0 auto 0 0;\r\n  font-size: 11px;\r\n}\r\n\r\n.handover-editor__required-note {\r\n  color: var(--text-muted);\r\n}\r\n\r\n.handover-editor__required-note > span {\r\n  color: var(--red);\r\n  font-weight: 700;\r\n}\r\n\r\n.handover-editor__error {\r\n  color: var(--red);\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .handover-editor__grid {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n\r\n  .handover-editor__field--patient {\r\n    grid-column: 1 / -1;\r\n  }\r\n\r\n  .handover-editor__field--assignee,\r\n  .handover-editor__field--third {\r\n    grid-column: span 1;\r\n  }\r\n}\r\n\r\n@media (max-width: 639px) {\r\n  .handover-editor__header,\r\n  .handover-editor__body,\r\n  .handover-editor__actions {\r\n    padding-right: 12px;\r\n    padding-left: 12px;\r\n  }\r\n\r\n  .handover-editor__intro {\r\n    max-width: 34ch;\r\n  }\r\n\r\n  .handover-editor__grid {\r\n    grid-template-columns: minmax(0, 1fr);\r\n    gap: 10px;\r\n  }\r\n\r\n  .handover-editor__field--patient,\r\n  .handover-editor__field--assignee,\r\n  .handover-editor__field--third {\r\n    grid-column: 1;\r\n  }\r\n\r\n  .handover-editor__actions {\r\n    flex-wrap: wrap;\r\n  }\r\n\r\n  .handover-editor__required-note,\r\n  .handover-editor__error {\r\n    width: 100%;\r\n  }\r\n\r\n  .handover-editor__actions .btn-secondary,\r\n  .handover-editor__actions .btn-success {\r\n    min-height: 44px;\r\n    flex: 1;\r\n    justify-content: center;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Diario terapia: pannello \"Valida terapia\" dentro il modulo di nuova voce del diario.\r\n   Solo layout e superfici del pannello: l'aspetto dei controlli (ds-btn, ds-badge, ds-link) lo\r\n   decide design-system.css. */\r\n\r\n.diary-therapy {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n  padding: 16px;\r\n  border: 2px solid var(--border, #e6ebf2);\r\n  border-radius: 16px;\r\n  background: var(--surface, #fff);\r\n}\r\n\r\n.diary-therapy__head h3 {\r\n  margin: 0 0 4px;\r\n  font-size: 1rem;\r\n  font-weight: 600;\r\n  color: var(--text-primary, #16202e);\r\n}\r\n.diary-therapy__head p {\r\n  margin: 0;\r\n}\r\n\r\n.diary-therapy__source {\r\n  margin: 0;\r\n  min-width: 0;\r\n}\r\n.diary-therapy__source blockquote {\r\n  margin: 4px 0 0;\r\n  padding: 12px 16px;\r\n  border-left: 4px solid var(--blue, #2f6bed);\r\n  border-radius: 8px;\r\n  background: var(--bg, #eef1f6);\r\n  color: var(--text-primary, #16202e);\r\n  white-space: pre-wrap;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.diary-therapy__notices {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  margin: 0;\r\n  padding: 0;\r\n  list-style: none;\r\n}\r\n.diary-therapy__notices li {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px;\r\n  min-width: 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.diary-therapy__intent {\r\n  padding: 12px 16px;\r\n  border-radius: 12px;\r\n  background: var(--amber-bg, #fdf3e2);\r\n  color: var(--text-primary, #16202e);\r\n}\r\n.diary-therapy__intent p {\r\n  margin: 0;\r\n}\r\n.diary-therapy__intent p + p {\r\n  margin-top: 4px;\r\n}\r\n\r\n.diary-therapy__alert {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px 12px;\r\n  padding: 8px 12px;\r\n  border-radius: 8px;\r\n  background: var(--red-bg, #fdecee);\r\n  color: var(--red, #d93a4a);\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.diary-therapy__actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  justify-content: flex-end;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n.diary-therapy__blockers {\r\n  flex: 1 1 100%;\r\n  margin: 0;\r\n  padding-left: 20px;\r\n  color: var(--text-secondary, #5a6b80);\r\n  font-size: 0.875rem;\r\n}\r\n\r\n/* Riga \"Terapia aggiunta: FARMACO — apri\" nella card della voce */\r\n.diario-card__therapy {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 4px 8px;\r\n  margin-top: 8px;\r\n  min-width: 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n/* Il modulo della voce ha tre azioni: su schermi stretti vanno a capo invece di uscire */\r\n.cr-inline-form__actions.diario-form__actions {\r\n  flex-wrap: wrap;\r\n}\r\n\r\n@media (max-width: 600px) {\r\n  .diary-therapy {\r\n    padding: 12px;\r\n  }\r\n  .diary-therapy__actions > button {\r\n    flex: 1 1 auto;\r\n  }\r\n}\r\n\r\n/* Campi che l'interprete non ha letto dal testo: da compilare a mano. */\r\n.diary-therapy__unread {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px;\r\n  font-size: 14px;\r\n}\r\n"],["STYLE",{},"/* UX2 W8 — urgenze del diario: evidenza della voce che CHI legge può prendere in carico\r\n   («Ho capito», components/shared/UrgencyNotice). Rosso solo per l'allerta clinica attiva. */\r\n.diario-card--to-see {\r\n  box-shadow:\r\n    0 0 0 2px rgba(217, 58, 74, 0.18),\r\n    var(--shadow-card);\r\n}\r\n.diario-to-see {\r\n  margin: 0 0 12px;\r\n  font: 600 14px/20px var(--font-ui);\r\n  color: var(--red);\r\n}\r\n.diario-ack-error { margin: 0 0 12px; padding: 12px 16px; border: 1px solid #efc3cb; border-radius: 12px; background: #fdecee; color: #b42335; font-size: 14px; line-height: 1.5; }\r\n"],["STYLE",{},".diary-thread {\r\n  margin: 14px 0 0 12px;\r\n  padding: 0 0 0 16px;\r\n  border-left: 2px solid #cdd8e8;\r\n  display: grid;\r\n  gap: 10px;\r\n  min-width: 0;\r\n}\r\n.diary-thread__reply {\r\n  position: relative;\r\n  padding: 12px 14px;\r\n  border: 1px solid #d8e3f1;\r\n  border-radius: 0 12px 12px 12px;\r\n  background: #f4f8fd;\r\n  color: #263e5e;\r\n  font-size: 13px;\r\n  line-height: 1.5;\r\n  overflow-wrap: anywhere;\r\n}\r\n.diary-thread__reply::before {\r\n  content: '';\r\n  position: absolute;\r\n  left: -18px;\r\n  top: 18px;\r\n  width: 16px;\r\n  border-top: 2px solid #cdd8e8;\r\n}\r\n.diary-thread__head {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: baseline;\r\n  gap: 4px 12px;\r\n}\r\n.diary-thread__head time {\r\n  color: #536782;\r\n  font-size: 12px;\r\n}\r\n.diary-thread__message {\r\n  margin: 5px 0;\r\n}\r\n.diary-thread__reply small {\r\n  display: block;\r\n  color: #536782;\r\n  font-size: 12px;\r\n}\r\n.diary-thread--active > .diary-thread__reply {\r\n  border-color: #efc3cb;\r\n  background: #fff7f8;\r\n}\r\n.diary-thread--active > .diary-thread__reply > strong {\r\n  color: #b42335;\r\n}\r\n.diary-thread .urgency-notice {\r\n  margin-top: 6px;\r\n  padding-top: 0;\r\n  border-top: 0;\r\n}\r\n.diary-thread__reply--personal {\r\n  background: #f8fafc;\r\n}\r\n.patient-record-view .diario-card__author {\r\n  margin: 8px 0 4px;\r\n}\r\n.diary-thread.diary-thread--reading {\r\n  margin: 14px 0 0;\r\n  padding: 0;\r\n  border: 0;\r\n}\r\n.diary-thread--reading > .diary-thread__reply {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  flex-wrap: wrap;\r\n  gap: 8px 16px;\r\n  padding: 10px 0 0;\r\n  border: 0;\r\n  border-top: 1px solid var(--border, #d8e3f1);\r\n  border-radius: 0;\r\n  background: transparent;\r\n}\r\n.diary-thread--reading > .diary-thread__reply::before {\r\n  display: none;\r\n}\r\n.diary-thread__status {\r\n  flex: 1 1 220px;\r\n  min-width: 0;\r\n}\r\n.diary-thread--reading .diary-thread__message {\r\n  margin: 2px 0 0;\r\n  color: #536782;\r\n}\r\n.diary-thread--reading .btn-sm {\r\n  min-height: 40px;\r\n  padding: 6px 14px;\r\n  flex: 0 0 auto;\r\n}\r\n@media (max-width: 600px) {\r\n  .diary-thread {\r\n    margin-left: 0;\r\n    padding-left: 12px;\r\n  }\r\n  .diary-thread__reply {\r\n    padding: 10px;\r\n  }\r\n  .diary-thread__reply::before {\r\n    left: -14px;\r\n    width: 12px;\r\n  }\r\n}\r\n"]],[[12,30]],["BODY",{},[[12,31]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},[[1,2]],["DIV",{"class":"main-area-clean"},["DIV",{"class":"compact-topbar"},[[7,53]],[[2,6]],["DIV",{"class":"topbar-title"},["DIV",{"class":"page-header__titles"},["H1",{"class":"page-header__title"},"Pazienti"],["P",{"class":"page-header__subtitle"},"1 caricati su 1"]]],[[7,65]],[[7,81]]],["MAIN",{"class":"page-content content-panel"},["DIV",{"class":"patient-list-view"},["SECTION",{"class":"plist-card plist-list","aria-label":"Elenco pazienti"},["DIV",{"class":"plist-toolbar"},["DIV",{"class":"search-wrap plist-search"},["SPAN",{"class":"search-wrap__ico"},["svg",{"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.75","stroke-linecap":"round","stroke-linejoin":"round"},["circle",{"cx":"11","cy":"11","r":"8"}],["line",{"x1":"21","y1":"21","x2":"16.65","y2":"16.65"}]]],["INPUT",{"__playwright_value_":"","class":"search-input","placeholder":"Cerca per nome o codice fisc