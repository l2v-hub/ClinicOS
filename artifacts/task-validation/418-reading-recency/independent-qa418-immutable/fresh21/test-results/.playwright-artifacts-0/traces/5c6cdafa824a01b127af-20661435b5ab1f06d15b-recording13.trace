{"type":"frame-snapshot","snapshot":{"callId":"call@13960","snapshotName":"before@call@13960","pageId":"page@b29f5b5d79833fb934bc98c47f8bc8bb","frameId":"frame@34c11205ad5e37d2b7ed2eca58bc00ef","frameUrl":"http://127.0.0.1:7483/#/parametri-multipaziente","doctype":"html","html":["HTML",{"lang":"it"},["HEAD",{},[[53,0]],[[53,1]],[[53,2]],[[53,3]],[[53,4]],[[53,5]],[[53,6]],[[53,7]],[[53,8]],[[53,9]],[[53,10]],[[53,11]],[[53,12]],[[53,13]],[[53,15]],[[53,16]],[[53,18]],[[53,20]],[[53,22]],[[53,24]],[[53,26]],[[53,28]],[[50,1]],[[50,3]],[[50,5]],[[50,7]],[[50,9]],[[50,11]],[[50,13]],[[50,15]],[[50,17]],[[50,19]],[[50,21]],[[50,23]],[[50,25]],[[50,27]],[[50,29]],[[48,1]],[[48,3]],[[48,5]],[[48,7]],[[48,9]],[[48,11]],[[48,13]],[[48,15]],[[48,17]],[[48,19]],[[48,21]],[[48,23]],[[48,25]],[[48,27]],[[46,1]],[[46,3]],[[41,1]],[[41,3]],[[41,5]],[[41,7]],[[41,9]],[[27,1]],[[27,3]],[[27,5]],[[27,7]],[[11,1]],[[11,3]],[[11,5]],[[11,7]],["STYLE",{},"/* Agenda operatore — HMI 1 (artifacts/hmi-parity/proto/agenda.png). Solo `.agt-view--hmi`:\r\n   le classes agt- sono condivise con l'agenda multi-operatore dell'admin. */\r\n.agt-view--hmi .agt-day-card {\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 16px;\r\n  padding: 24px;\r\n  min-width: 0;\r\n}\r\n.agt-view--hmi .agt-day-card__head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  flex-wrap: wrap;\r\n  padding-bottom: 16px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n.agt-view--hmi .agt-day-card__title {\r\n  margin: 0;\r\n  font: 600 20px/28px var(--font-ui);\r\n  color: var(--text);\r\n}\r\n.agt-view--hmi .agt-day-card__title::first-letter {\r\n  text-transform: uppercase;\r\n}\r\n\r\n.agt-view--hmi .agt-day-wrap {\r\n  overflow: visible;\r\n}\r\n.agt-view--hmi .agt-slot,\r\n.agt-view--hmi .agt-slot--hour,\r\n.agt-view--hmi .agt-slot--half {\r\n  min-height: 56px;\r\n  align-items: center;\r\n  gap: 16px;\r\n  border-bottom: 1px solid var(--border);\r\n  padding: 8px 0;\r\n}\r\n.agt-view--hmi .agt-slot__time {\r\n  width: 72px;\r\n  font: 600 16px/24px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--text);\r\n  align-self: center;\r\n  padding: 0;\r\n}\r\n/* Fascia libera: vuota come nel prototipo, \"+ Disponibile\" al passaggio o al fuoco. */\r\n.agt-view--hmi .agt-free-slot {\r\n  opacity: 0;\r\n  transition: opacity 0.15s;\r\n}\r\n.agt-view--hmi .agt-slot--free:hover .agt-free-slot,\r\n.agt-view--hmi .agt-slot--free:focus-visible .agt-free-slot {\r\n  opacity: 1;\r\n}\r\n.agt-view--hmi .agt-slot--free:focus-visible {\r\n  outline: 3px solid #245bb5;\r\n  outline-offset: -3px;\r\n  border-radius: 8px;\r\n}\r\n.agt-view--hmi .agt-apt-card {\r\n  flex: 1;\r\n  min-width: 0;\r\n  border: 0;\r\n  border-radius: 8px;\r\n  padding: 8px 16px;\r\n  background: #eaf1fe;\r\n}\r\n.agt-view--hmi .agt-apt-card--in_corso,\r\n.agt-view--hmi .agt-apt-card--urgent {\r\n  background: #fdf3e2;\r\n}\r\n.agt-view--hmi .agt-apt-card--completato {\r\n  background: #e6f6ef;\r\n}\r\n.agt-view--hmi .agt-apt-card--annullato {\r\n  background: #eef1f6;\r\n}\r\n.agt-view--hmi .agt-apt-card__row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.agt-view--hmi .agt-apt-card__title {\r\n  font: 600 16px/24px var(--font-ui);\r\n  color: #1d4fc4;\r\n  white-space: nowrap;\r\n}\r\n.agt-view--hmi .agt-apt-card--annullato .agt-apt-card__title {\r\n  color: var(--text-muted);\r\n  text-decoration: line-through;\r\n}\r\n.agt-view--hmi .agt-apt-card__detail {\r\n  flex: 1;\r\n  min-width: 0;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: #1d4fc4;\r\n  overflow: hidden;\r\n  white-space: nowrap;\r\n}\r\n.agt-view--hmi .agt-apt-card__detail .agt-apt-card__patient {\r\n  font: inherit;\r\n  color: inherit;\r\n  padding: 0;\r\n  min-height: 0;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n.agt-view--hmi .agt-apt-card__badges {\r\n  margin-left: auto;\r\n  flex: none;\r\n}\r\n@media (max-width: 600px) {\r\n  .agt-view--hmi .agt-day-card {\r\n    padding: 16px;\r\n  }\r\n  .agt-view--hmi .agt-slot__time {\r\n    width: 52px;\r\n  }\r\n  .agt-view--hmi .agt-apt-card__row {\r\n    flex-wrap: wrap;\r\n    gap: 4px 12px;\r\n  }\r\n  .agt-view--hmi .agt-apt-card__detail {\r\n    order: 3;\r\n    flex-basis: 100%;\r\n  }\r\n}\r\n/* Allineamento al prototipo sopra gli stili storici dell'agenda (app-additions.css). */\r\n.agt-view--hmi .agt-filter-row {\r\n  background: transparent;\r\n  border: 0;\r\n  padding: 0 0 16px;\r\n}\r\n.agt-view--hmi .agt-slot--free,\r\n.agt-view--hmi .agt-slot--half.agt-slot--free {\r\n  background: transparent;\r\n}\r\n.agt-view--hmi .agt-slot--free:hover,\r\n.agt-view--hmi .agt-slot--free:focus-visible {\r\n  background: #f5f7fb;\r\n}\r\n.agt-view--hmi .agt-slot__time,\r\n.agt-view--hmi .agt-slot--half .agt-slot__time {\r\n  padding: 0;\r\n}\r\n.agt-view--hmi .agt-apt-card {\r\n  min-height: 0;\r\n  align-self: center;\r\n  box-shadow: none;\r\n  border-left: 0;\r\n  gap: 8px;\r\n}\r\n.agt-view--hmi .agt-apt-card__detail {\r\n  flex: 0 1 auto;\r\n}\r\n.agt-view--hmi .agt-apt-card__detail .agt-meta-sep {\r\n  color: inherit;\r\n}\r\n.agt-view--hmi .agt-day-wrap,\r\n.agt-view--hmi .agt-slot {\r\n  background: transparent;\r\n  border-left: 0;\r\n}\r\n/* Sottotitolo nell'intestazione: va a capo (settimana/data sempre leggibili, niente «…»). */\r\n.topbar-title .agt-page-subtitle {\r\n  flex-wrap: wrap;\r\n  row-gap: 0;\r\n  column-gap: 6px;\r\n  white-space: normal;\r\n}\r\n.topbar-title .agt-page-subtitle > * {\r\n  flex: 0 1 auto;\r\n  min-width: 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n.agt-view--hmi .agt-day-card__heading {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n}\r\n.agt-view--hmi .agt-day-card__op {\r\n  display: none;\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n@media (max-width: 600px) {\r\n  /* Sul telefono l'intestazione mostra solo la data (a capo se non entra); l'operatore\r\n     passa nella card del giorno. */\r\n  .topbar-title .agt-page-subtitle .agt-op-chip,\r\n  .topbar-title .agt-page-subtitle .agt-page-subtitle__separator,\r\n  .topbar-title .agt-page-subtitle .agt-header__date ~ span {\r\n    display: none;\r\n  }\r\n  .topbar-title .agt-page-subtitle .agt-header__date {\r\n    flex: 0 1 auto;\r\n    min-width: 0;\r\n  }\r\n  .agt-view--hmi .agt-day-card__op {\r\n    display: block;\r\n  }\r\n}\r\n"]],[[53,30]],["BODY",{},[[53,31]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},[[42,2]],["DIV",{"class":"main-area-clean"},[[12,3]],["MAIN",{"class":"page-content content-panel"},["DIV",{"class":"par-view"},["DIV",{"class":"par-grid"},[[39,6]],["SECTION",{"class":"par-form","aria-label":"Rilevazione di Sintetico QA, Caso"},[[41,53]],["FORM",{"class":"parameter-reading-form","aria-label":"Nuova rilevazione"},["DIV",{"class":"parameter-reading-form__layout"},["FIELDSET",{"class":"parameter-reading-form__fields"},[[41,55]],[[10,1]],[[8,1]],[[6,1]],[[4,1]],[[2,1]],["LABEL",{"for":"_r_8_-fc","class":"parameter-reading-form__field"},[[41,109]],["INPUT",{"__playwright_value_":"","id":"_r_8_-fc","class":"form-input","aria-label":"Nuova rilevazione FC","aria-describedby":"_r_8_-fc-previous","placeholder":"—","inputmode":"decimal","type":"text","value":""}],[[41,112]]],[[26,1]],[[24,1]],[[14,0]],[[20,1]],[[18,1]]],[[16,1]]]]]],[[41,213]]]]]]],[[53,65]],[[53,66]]]],"viewport":{"width":1150,"height":1004},"timestamp":65567.804,"wallTime":1792890422730,"collectionTime":1,"resourceOverrides":[],"isMainFrame":true}}
