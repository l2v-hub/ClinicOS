ns: 1fr;\r\n    gap: 10px;\r\n  }\r\n}\r\n"],["STYLE",{},".op-management .operator-editor {\r\n  padding: 0;\r\n  overflow: hidden;\r\n  border-radius: 8px;\r\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);\r\n}\r\n\r\n.op-management .operator-editor__header {\r\n  min-height: 64px;\r\n  margin: 0;\r\n  padding: 12px 16px;\r\n  align-items: flex-start;\r\n  background: var(--surface-raised);\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.operator-editor__heading {\r\n  min-width: 0;\r\n}\r\n\r\n.operator-editor__eyebrow,\r\n.operator-editor__section > legend,\r\n.operator-editor__color-field > legend {\r\n  color: var(--text-xmuted);\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  letter-spacing: 0.65px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.operator-editor__eyebrow {\r\n  display: block;\r\n  margin-bottom: 2px;\r\n}\r\n\r\n.op-management .operator-editor .op-form-panel__title {\r\n  font-size: 16px;\r\n  line-height: 1.25;\r\n}\r\n\r\n.operator-editor__intro {\r\n  margin: 3px 0 0;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.operator-editor__close {\r\n  flex-shrink: 0;\r\n}\r\n\r\n.operator-editor__body {\r\n  padding: 0 16px;\r\n}\r\n\r\n.operator-editor__section {\r\n  min-width: 0;\r\n  margin: 0;\r\n  padding: 13px 0 15px;\r\n  border: 0;\r\n  border-bottom: 1px solid var(--divider);\r\n}\r\n\r\n.operator-editor__section > legend {\r\n  width: 100%;\r\n  margin: 0;\r\n  padding: 0 0 9px;\r\n}\r\n\r\n.operator-editor__grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(6, minmax(0, 1fr));\r\n  gap: 12px;\r\n}\r\n\r\n.operator-editor__field--span-2 {\r\n  grid-column: span 2;\r\n}\r\n\r\n.operator-editor__field--span-3 {\r\n  grid-column: span 3;\r\n}\r\n\r\n.operator-editor .form-field,\r\n.operator-editor .form-input,\r\n.operator-editor .form-select {\r\n  min-width: 0;\r\n}\r\n\r\n.operator-editor .form-input,\r\n.operator-editor .form-select {\r\n  width: 100%;\r\n}\r\n\r\n.operator-e