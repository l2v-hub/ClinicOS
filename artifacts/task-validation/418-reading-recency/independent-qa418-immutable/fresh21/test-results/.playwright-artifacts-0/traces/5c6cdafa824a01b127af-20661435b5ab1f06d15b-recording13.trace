(--blue-glow);\r\n  border-radius: 8px;\r\n}\r\n\r\n.table-filters__icon svg {\r\n  width: 17px;\r\n  height: 17px;\r\n}\r\n\r\n.table-filters__toggle-copy {\r\n  min-width: 0;\r\n  display: grid;\r\n  gap: 1px;\r\n}\r\n\r\n.table-filters__title {\r\n  color: var(--text);\r\n  font-size: 12px;\r\n  font-weight: 750;\r\n}\r\n\r\n.table-filters__hint {\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  font-weight: 500;\r\n}\r\n\r\n.table-filters__active-badge {\r\n  min-width: 22px;\r\n  height: 22px;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 0 6px;\r\n  color: #fff;\r\n  background: var(--blue);\r\n  border-radius: 999px;\r\n  font-size: 11px;\r\n  font-weight: 750;\r\n}\r\n\r\n.table-filters__chevron {\r\n  width: 16px;\r\n  height: 16px;\r\n  display: inline-flex;\r\n  color: var(--text-muted);\r\n  transition: transform 0.16s ease;\r\n}\r\n\r\n.table-filters__chevron svg {\r\n  width: 16px;\r\n  height: 16px;\r\n}\r\n\r\n.table-filters.is-open .table-filters__chevron {\r\n  transform: rotate(180deg);\r\n}\r\n\r\n.table-filters__summary {\r\n  flex-shrink: 0;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n}\r\n\r\n.table-filters__results {\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  white-space: nowrap;\r\n}\r\n\r\n.table-filters__clear {\r\n  min-height: var(--touch-target);\r\n  padding: 6px 10px;\r\n  color: var(--blue);\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  font: inherit;\r\n  font-size: 11px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n}\r\n\r\n.table-filters__clear:hover {\r\n  border-color: var(--blue);\r\n  background: var(--blue-glow);\r\n}\r\n\r\n.table-filters__panel {\r\n  padding: 14px;\r\n  background: var(--surface);\r\n  border-top: 1px solid var(--divider);\r\n}\r\n\r\n.table-filters__grid {\r\n  display: grid;\r\n  gap: 12px;\r\n}\r\n\r\n.table-filters__grid-