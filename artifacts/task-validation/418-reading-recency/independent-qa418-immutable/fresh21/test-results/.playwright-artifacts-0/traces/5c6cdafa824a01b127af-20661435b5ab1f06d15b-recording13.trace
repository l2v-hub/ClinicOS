{"type":"frame-snapshot","snapshot":{"callId":"call@13896","snapshotName":"after@call@13896","pageId":"page@b29f5b5d79833fb934bc98c47f8bc8bb","frameId":"frame@34c11205ad5e37d2b7ed2eca58bc00ef","frameUrl":"http://127.0.0.1:7483/#/parametri-multipaziente","doctype":"html","html":["HTML",{"lang":"it"},["HEAD",{},[[26,0]],[[26,1]],[[26,2]],[[26,3]],[[26,4]],[[26,5]],[[26,6]],[[26,7]],[[26,8]],[[26,9]],[[26,10]],[[26,11]],[[26,12]],[[26,13]],[[26,15]],[[26,16]],[[26,18]],[[26,20]],[[26,22]],[[26,24]],[[26,26]],[[26,28]],[[23,1]],[[23,3]],[[23,5]],[[23,7]],[[23,9]],[[23,11]],[[23,13]],[[23,15]],[[23,17]],[[23,19]],[[23,21]],[[23,23]],[[23,25]],[[23,27]],[[23,29]],[[21,1]],[[21,3]],[[21,5]],[[21,7]],[[21,9]],[[21,11]],[[21,13]],[[21,15]],[[21,17]],[[21,19]],[[21,21]],[[21,23]],[[21,25]],[[21,27]],[[19,1]],[[19,3]],[[14,1]],[[14,3]],[[14,5]],[[14,7]],[[14,9]],["STYLE",{},".consegne-page .handover-editor {\r\n  max-width: 1040px;\r\n  margin: 0 auto 20px;\r\n  padding: 0;\r\n  overflow: visible;\r\n  border-radius: 9px;\r\n  box-shadow: 0 1px 4px rgba(20, 39, 72, 0.08);\r\n}\r\n\r\n.handover-editor__header {\r\n  min-height: 68px;\r\n  margin: 0;\r\n  padding: 13px 16px;\r\n  align-items: flex-start;\r\n  border-bottom: 1px solid var(--border);\r\n  border-radius: 9px 9px 0 0;\r\n  background: var(--surface-raised);\r\n}\r\n\r\n.handover-editor__eyebrow,\r\n.handover-editor__section > legend {\r\n  color: var(--text-xmuted);\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  letter-spacing: 0.65px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.handover-editor__eyebrow {\r\n  display: block;\r\n  margin-bottom: 2px;\r\n}\r\n\r\n.handover-editor__intro {\r\n  margin: 3px 0 0;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.handover-editor__body {\r\n  padding: 0 16px;\r\n}\r\n\r\n.handover-editor__section {\r\n  min-width: 0;\r\n  margin: 0;\r\n  padding: 14px 0 16px;\r\n  border: 0;\r\n  border-bottom: 1px solid var(--divider);\r\n}\r\n\r\n.handover-editor__section--last {\r\n  border-bottom: 0;\r\n}\r\n\r\n.handover-editor__section > legend {\r\n  width: 100%;\r\n  padding: 0 0 9px;\r\n}\r\n\r\n.handover-editor__grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(12, minmax(0, 1fr));\r\n  gap: 12px;\r\n}\r\n\r\n.handover-editor__field--patient {\r\n  grid-column: span 7;\r\n  min-width: 0;\r\n}\r\n\r\n.handover-editor__field--assignee {\r\n  grid-column: span 5;\r\n}\r\n\r\n.handover-editor__field--third {\r\n  grid-column: span 3;\r\n}\r\n\r\n.handover-editor .form-field,\r\n.handover-editor .form-input,\r\n.handover-editor .form-select {\r\n  min-width: 0;\r\n}\r\n\r\n.handover-editor .form-input,\r\n.handover-editor .form-select {\r\n  width: 100%;\r\n}\r\n\r\n.handover-editor__optional-label {\r\n  color: var(--text-muted);\r\n  font-size: 10px;\r\n  font-weight: 500;\r\n  text-transform: none;\r\n}\r\n\r\n.handover-editor__notes {\r\n  min-height: 86px;\r\n  resize: vertical;\r\n}\r\n\r\n.handover-editor__counter {\r\n  display: block;\r\n  margin-top: 4px;\r\n  color: var(--text-xmuted);\r\n  font-size: 10.5px;\r\n  text-align: right;\r\n}\r\n\r\n.handover-editor__actions {\r\n  min-height: 62px;\r\n  align-items: center;\r\n  margin: 0;\r\n  padding: 9px 16px;\r\n  border-top: 1px solid var(--border);\r\n  border-radius: 0 0 9px 9px;\r\n  background: var(--surface-raised);\r\n}\r\n\r\n.handover-editor__required-note,\r\n.handover-editor__error {\r\n  margin: 0 auto 0 0;\r\n  font-size: 11px;\r\n}\r\n\r\n.handover-editor__required-note {\r\n  color: var(--text-muted);\r\n}\r\n\r\n.handover-editor__required-note > span {\r\n  color: var(--red);\r\n  font-weight: 700;\r\n}\r\n\r\n.handover-editor__error {\r\n  color: var(--red);\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .handover-editor__grid {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n\r\n  .handover-editor__field--patient {\r\n    grid-column: 1 / -1;\r\n  }\r\n\r\n  .handover-editor__field--assignee,\r\n  .handover-editor__field--third {\r\n    grid-column: span 1;\r\n  }\r\n}\r\n\r\n@media (max-width: 639px) {\r\n  .handover-editor__header,\r\n  .handover-editor__body,\r\n  .handover-editor__actions {\r\n    padding-right: 12px;\r\n    padding-left: 12px;\r\n  }\r\n\r\n  .handover-editor__intro {\r\n    max-width: 34ch;\r\n  }\r\n\r\n  .handover-editor__grid {\r\n    grid-template-columns: minmax(0, 1fr);\r\n    gap: 10px;\r\n  }\r\n\r\n  .handover-editor__field--patient,\r\n  .handover-editor__field--assignee,\r\n  .handover-editor__field--third {\r\n    grid-column: 1;\r\n  }\r\n\r\n  .handover-editor__actions {\r\n    flex-wrap: wrap;\r\n  }\r\n\r\n  .handover-editor__required-note,\r\n  .handover-editor__error {\r\n    width: 100%;\r\n  }\r\n\r\n  .handover-editor__actions .btn-secondary,\r\n  .handover-editor__actions .btn-success {\r\n    min-height: 44px;\r\n    flex: 1;\r\n    justify-content: center;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Diario terapia: pannello \"Valida terapia\" dentro il modulo di nuova voce del diario.\r\n   Solo layout e superfici del pannello: l'aspetto dei controlli (ds-btn, ds-badge, ds-link) lo\r\n   decide design-system.css. */\r\n\r\n.diary-therapy {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n  padding: 16px;\r\n  border: 2px solid var(--border, #e6ebf2);\r\n  border-radius: 16px;\r\n  background: var(--surface, #fff);\r\n}\r\n\r\n.diary-therapy__head h3 {\r\n  margin: 0 0 4px;\r\n  font-size: 1rem;\r\n  font-weight: 600;\r\n  color: var(--text-primary, #16202e);\r\n}\r\n.diary-therapy__head p {\r\n  margin: 0;\r\n}\r\n\r\n.diary-therapy__source {\r\n  margin: 0;\r\n  min-width: 0;\r\n}\r\n.diary-therapy__source blockquote {\r\n  margin: 4px 0 0;\r\n  padding: 12px 16px;\r\n  border-left: 4px solid var(--blue, #2f6bed);\r\n  border-radius: 8px;\r\n  background: var(--bg, #eef1f6);\r\n  color: var(--text-primary, #16202e);\r\n  white-space: pre-wrap;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.diary-therapy__notices {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  margin: 0;\r\n  padding: 0;\r\n  list-style: none;\r\n}\r\n.diary-therapy__notices li {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px;\r\n  min-width: 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.diary-therapy__intent {\r\n  padding: 12px 16px;\r\n  border-radius: 12px;\r\n  background: var(--amber-bg, #fdf3e2);\r\n  color: var(--text-primary, #16202e);\r\n}\r\n.diary-therapy__intent p {\r\n  margin: 0;\r\n}\r\n.diary-therapy__intent p + p {\r\n  margin-top: 4px;\r\n}\r\n\r\n.diary-therapy__alert {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px 12px;\r\n  padding: 8px 12px;\r\n  border-radius: 8px;\r\n  background: var(--red-bg, #fdecee);\r\n  color: var(--red, #d93a4a);\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.diary-therapy__actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  justify-content: flex-end;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n.diary-therapy__blockers {\r\n  flex: 1 1 100%;\r\n  margin: 0;\r\n  padding-left: 20px;\r\n  color: var(--text-secondary, #5a6b80);\r\n  font-size: 0.875rem;\r\n}\r\n\r\n/* Riga \"Terapia aggiunta: FARMACO — apri\" nella card della voce */\r\n.diario-card__therapy {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 4px 8px;\r\n  margin-top: 8px;\r\n  min-width: 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n/* Il modulo della voce ha tre azioni: su schermi stretti vanno a capo invece di uscire */\r\n.cr-inline-form__actions.diario-form__actions {\r\n  flex-wrap: wrap;\r\n}\r\n\r\n@media (max-width: 600px) {\r\n  .diary-therapy {\r\n    padding: 12px;\r\n  }\r\n  .diary-therapy__actions > button {\r\n    flex: 1 1 auto;\r\n  }\r\n}\r\n\r\n/* Campi che l'interprete non ha letto dal testo: da compilare a mano. */\r\n.diary-therapy__unread {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px;\r\n  font-size: 14px;\r\n}\r\n"],["STYLE",{},"/* UX2 W8 — urgenze del diario: evidenza della voce che CHI legge può prendere in carico\r\n   («Ho capito», components/shared/UrgencyNotice). Rosso solo per l'allerta clinica attiva. */\r\n.diario-card--to-see {\r\n  box-shadow:\r\n    0 0 0 2px rgba(217, 58, 74, 0.18),\r\n    var(--shadow-card);\r\n}\r\n.diario-to-see {\r\n  margin: 0 0 12px;\r\n  font: 600 14px/20px var(--font-ui);\r\n  color: var(--red);\r\n}\r\n.diario-ack-error { margin: 0 0 12px; padding: 12px 16px; border: 1px solid #efc3cb; border-radius: 12px; background: #fdecee; color: #b42335; font-size: 14px; line-height: 1.5; }\r\n"],["STYLE",{},".diary-thread {\r\n  margin: 14px 0 0 12px;\r\n  padding: 0 0 0 16px;\r\n  border-left: 2px solid #cdd8e8;\r\n  display: grid;\r\n  gap: 10px;\r\n  min-width: 0;\r\n}\r\n.diary-thread__reply {\r\n  position: relative;\r\n  padding: 12px 14px;\r\n  border: 1px solid #d8e3f1;\r\n  border-radius: 0 12px 12px 12px;\r\n  background: #f4f8fd;\r\n  color: #263e5e;\r\n  font-size: 13px;\r\n  line-height: 1.5;\r\n  overflow-wrap: anywhere;\r\n}\r\n.diary-thread__reply::before {\r\n  content: '';\r\n  position: absolute;\r\n  left: -18px;\r\n  top: 18px;\r\n  width: 16px;\r\n  border-top: 2px solid #cdd8e8;\r\n}\r\n.diary-thread__head {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: baseline;\r\n  gap: 4px 12px;\r\n}\r\n.diary-thread__head time {\r\n  color: #536782;\r\n  font-size: 12px;\r\n}\r\n.diary-thread__message {\r\n  margin: 5px 0;\r\n}\r\n.diary-thread__reply small {\r\n  display: block;\r\n  color: #536782;\r\n  font-size: 12px;\r\n}\r\n.diary-thread--active > .diary-thread__reply {\r\n  border-color: #efc3cb;\r\n  background: #fff7f8;\r\n}\r\n.diary-thread--active > .diary-thread__reply > strong {\r\n  color: #b42335;\r\n}\r\n.diary-thread .urgency-notice {\r\n  margin-top: 6px;\r\n  padding-top: 0;\r\n  border-top: 0;\r\n}\r\n.diary-thread__reply--personal {\r\n  background: #f8fafc;\r\n}\r\n.patient-record-view .diario-card__author {\r\n  margin: 8px 0 4px;\r\n}\r\n.diary-thread.diary-thread--reading {\r\n  margin: 14px 0 0;\r\n  padding: 0;\r\n  border: 0;\r\n}\r\n.diary-thread--reading > .diary-thread__reply {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  flex-wrap: wrap;\r\n  gap: 8px 16px;\r\n  padding: 10px 0 0;\r\n  border: 0;\r\n  border-top: 1px solid var(--border, #d8e3f1);\r\n  border-radius: 0;\r\n  background: transparent;\r\n}\r\n.diary-thread--reading > .diary-thread__reply::before {\r\n  display: none;\r\n}\r\n.diary-thread__status {\r\n  flex: 1 1 220px;\r\n  min-width: 0;\r\n}\r\n.diary-thread--reading .diary-thread__message {\r\n  margin: 2px 0 0;\r\n  color: #536782;\r\n}\r\n.diary-thread--reading .btn-sm {\r\n  min-height: 40px;\r\n  padding: 6px 14px;\r\n  flex: 0 0 auto;\r\n}\r\n@media (max-width: 600px) {\r\n  .diary-thread {\r\n    margin-left: 0;\r\n    padding-left: 12px;\r\n  }\r\n  .diary-thread__reply {\r\n    padding: 10px;\r\n  }\r\n  .diary-thread__reply::before {\r\n    left: -14px;\r\n    width: 12px;\r\n  }\r\n}\r\n"]],[[26,30]],["BODY",{},[[26,31]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},[[15,2]],["DIV",{"class":"main-area-clean"},[[14,17]],["MAIN",{"class":"page-content content-panel"},["DIV",{"class":"par-view"},["DIV",{"class":"par-grid"},[[12,6]],["SECTION",{"class":"par-form","aria-label":"Rilevazione di Sintetico QA, Caso"},[[14,53]],["FORM",{"class":"parameter-reading-form","aria-label":"Nuova rilevazione"},["DIV",{"class":"parameter-reading-form__layout"},["FIELDSET",{"class":"parameter-reading-form__fields"},[[14,55]],[[11,1]],[[9,1]],[[7,1]],[[5,1]],[[3,1]],[[1,1]],["LABEL",{"for":"_r_8_-temperatura","class":"parameter-reading-form__field"},[[14,118]],["INPUT",{"__playwright_value_":"","__playwright_target__":"","id":"_r_8_-temperatura","class":"form-input","aria-label":"Nuova rilevazione TC","aria-describedby":"_r_8_-temperatura-previous","placeholder":"—","i