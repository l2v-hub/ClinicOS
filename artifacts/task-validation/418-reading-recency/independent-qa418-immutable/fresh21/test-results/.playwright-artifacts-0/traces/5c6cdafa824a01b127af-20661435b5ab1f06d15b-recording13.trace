{"type":"frame-snapshot","snapshot":{"callId":"call@13440","snapshotName":"after@call@13440","pageId":"page@b29f5b5d79833fb934bc98c47f8bc8bb","frameId":"frame@34c11205ad5e37d2b7ed2eca58bc00ef","frameUrl":"http://127.0.0.1:7483/#/operator-dashboard","doctype":"html","html":["HTML",{"lang":"it"},["HEAD",{},[[3,0]],[[3,1]],[[3,2]],[[3,3]],[[3,4]],[[3,5]],[[3,6]],[[3,7]],[[3,8]],[[3,9]],[[3,10]],[[3,11]],[[3,12]],[[3,13]],[[3,15]],[[3,16]],[[3,18]],[[3,20]],[[3,22]],[[3,24]],[[3,26]],[[3,28]],["STYLE",{},".dashboard-notification-bar {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 10;\r\n  display: grid;\r\n  grid-template-columns: minmax(210px, 1fr) auto auto;\r\n  align-items: center;\r\n  gap: 12px;\r\n  min-height: 60px;\r\n  margin-bottom: 18px;\r\n  padding: 9px 12px;\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-left: 3px solid var(--blue);\r\n  border-radius: var(--card-radius-sm);\r\n  box-shadow: none;\r\n}\r\n\r\n@media (max-width: 1023px) {\r\n  .dashboard-notification-bar {\r\n    top: var(--topbar-h);\r\n  }\r\n}\r\n\r\n.dashboard-notification-bar--alarm {\r\n  border-left-color: var(--red-border);\r\n}\r\n\r\n.dashboard-notification-bar--warning {\r\n  border-left-color: var(--amber);\r\n}\r\n\r\n.dashboard-notification-bar--clear {\r\n  border-left-color: var(--emerald);\r\n}\r\n\r\n.dashboard-notification-bar--loading {\r\n  border-left-color: var(--text-xmuted);\r\n}\r\n\r\n.dashboard-notification-bar__intro {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  min-width: 0;\r\n}\r\n\r\n.dashboard-notification-bar__icon {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 36px;\r\n  height: 36px;\r\n  flex: 0 0 36px;\r\n  color: var(--red);\r\n  background: var(--red-bg);\r\n  border-radius: 10px;\r\n}\r\n\r\n.dashboard-notification-bar--warning .dashboard-notification-bar__icon {\r\n  color: var(--amber);\r\n  background: var(--amber-bg);\r\n}\r\n\r\n.dashboard-notification-bar--notice .dashboard-notification-bar__icon {\r\n  color: var(--blue);\r\n  background: var(--indigo-bg);\r\n}\r\n\r\n.dashboard-notification-bar--clear .dashboard-notification-bar__icon {\r\n  color: var(--emerald);\r\n  background: var(--emerald-bg);\r\n}\r\n\r\n.dashboard-notification-bar--loading .dashboard-notification-bar__icon {\r\n  color: var(--text-muted);\r\n  background: var(--surface-raised);\r\n}\r\n\r\n.dashboard-notification-bar__icon svg {\r\n  width: 18px;\r\n  height: 18px;\r\n}\r\n\r\n.dashboard-notification-bar__copy {\r\n  display: grid;\r\n  min-width: 0;\r\n  gap: 2px;\r\n}\r\n\r\n.dashboard-notification-bar__copy strong {\r\n  color: var(--text);\r\n  font-size: 13px;\r\n}\r\n\r\n.dashboard-notification-bar__copy > span {\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.dashboard-notification-bar__total {\r\n  /* The count is already present in the title and category badge. */\r\n  display: none;\r\n}\r\n\r\n.dashboard-notification-bar__categories {\r\n  display: flex;\r\n  gap: 6px;\r\n}\r\n\r\n.dashboard-notification-chip,\r\n.dashboard-notification-tab {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  min-height: 40px;\r\n  padding: 0 10px;\r\n  color: var(--text-muted);\r\n  background: var(--surface-raised);\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--radius-sm);\r\n  font-family: var(--font-ui);\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n}\r\n\r\n.dashboard-notification-chip:hover,\r\n.dashboard-notification-tab:hover {\r\n  background: var(--hover);\r\n  border-color: var(--text-xmuted);\r\n}\r\n\r\n.dashboard-notification-chip:focus-visible,\r\n.dashboard-notification-tab:focus-visible {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 2px;\r\n}\r\n\r\n.dashboard-notification-chip strong,\r\n.dashboard-notification-tab strong {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-width: 24px;\r\n  height: 24px;\r\n  padding: 0 6px;\r\n  border-radius: 999px;\r\n  font-size: 11px;\r\n}\r\n\r\n.dashboard-notification-chip--alarm strong,\r\n.dashboard-notification-tab--alarm strong {\r\n  color: var(--red);\r\n  background: var(--red-bg);\r\n}\r\n\r\n.dashboard-notification-chip--warning strong,\r\n.dashboard-notification-tab--warning strong {\r\n  color: var(--amber);\r\n  background: var(--amber-bg);\r\n}\r\n\r\n.dashboard-notification-chip--notice strong,\r\n.dashboard-notification-tab--notice strong {\r\n  color: var(--blue);\r\n  background: var(--indigo-bg);\r\n}\r\n\r\n.dashboard-notifications-modal {\r\n  max-width: 760px;\r\n}\r\n\r\n.dashboard-notifications-modal__header {\r\n  align-items: center;\r\n}\r\n\r\n.dashboard-notifications-modal__body {\r\n  gap: 16px;\r\n}\r\n\r\n.dashboard-notification-tabs {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  gap: 8px;\r\n}\r\n\r\n.dashboard-notification-tab {\r\n  width: 100%;\r\n  min-height: 44px;\r\n  padding: 0 12px;\r\n}\r\n\r\n.dashboard-notification-tab[aria-pressed='true'] {\r\n  color: var(--text);\r\n  background: var(--surface);\r\n  border-color: currentColor;\r\n  box-shadow: var(--shadow-focus);\r\n}\r\n\r\n.dashboard-notification-tab--alarm[aria-pressed='true'] {\r\n  color: var(--red);\r\n}\r\n\r\n.dashboard-notification-tab--warning[aria-pressed='true'] {\r\n  color: var(--amber);\r\n}\r\n\r\n.dashboard-notification-tab--notice[aria-pressed='true'] {\r\n  color: var(--blue);\r\n}\r\n\r\n.dashboard-notification-sections {\r\n  display: grid;\r\n  gap: 12px;\r\n}\r\n\r\n.dashboard-notification-section {\r\n  overflow: hidden;\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-left: 4px solid var(--blue);\r\n  border-radius: var(--card-radius-sm);\r\n}\r\n\r\n.dashboard-notification-section--alarm {\r\n  border-left-color: var(--red);\r\n}\r\n\r\n.dashboard-notification-section--warning {\r\n  border-left-color: var(--amber);\r\n}\r\n\r\n.dashboard-notification-section__header {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  padding: 13px 14px;\r\n  background: var(--surface-raised);\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.dashboard-notification-section__header h3,\r\n.dashboard-notification-section__header p {\r\n  margin: 0;\r\n}\r\n\r\n.dashboard-notification-section__header h3 {\r\n  color: var(--text);\r\n  font-size: 14px;\r\n}\r\n\r\n.dashboard-notification-section__header p {\r\n  margin-top: 3px;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  line-height: 1.45;\r\n}\r\n\r\n.dashboard-notification-section__header > span {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-width: 28px;\r\n  height: 28px;\r\n  padding: 0 8px;\r\n  color: var(--blue);\r\n  background: var(--indigo-bg);\r\n  border-radius: 999px;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n}\r\n\r\n.dashboard-notification-section--alarm .dashboard-notification-section__header > span {\r\n  color: var(--red);\r\n  background: var(--red-bg);\r\n}\r\n\r\n.dashboard-notification-section--warning .dashboard-notification-section__header > span {\r\n  color: var(--amber);\r\n  background: var(--amber-bg);\r\n}\r\n\r\n.dashboard-notification-section__content {\r\n  display: grid;\r\n  gap: 10px;\r\n  padding: 12px 14px 14px;\r\n}\r\n\r\n.dashboard-notification-section__content .anomalie-reparto__lista {\r\n  max-height: 320px;\r\n  overflow-y: auto;\r\n}\r\n\r\n.dashboard-notification-section__action {\r\n  justify-self: start;\r\n  min-height: 44px;\r\n}\r\n\r\n.dashboard-notification-section__message {\r\n  margin: 0;\r\n  color: var(--text-muted);\r\n  font-size: 13px;\r\n  line-height: 1.5;\r\n}\r\n\r\n.dashboard-notification-empty {\r\n  display: grid;\r\n  justify-items: center;\r\n  gap: 5px;\r\n  padding: 32px 20px;\r\n  color: var(--text-muted);\r\n  text-align: center;\r\n  background: var(--surface-raised);\r\n  border: 1px dashed var(--border);\r\n  border-radius: var(--card-radius-sm);\r\n}\r\n\r\n.dashboard-notification-empty > span {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 36px;\r\n  height: 36px;\r\n  color: var(--emerald);\r\n  background: var(--emerald-bg);\r\n  border-radius: 50%;\r\n  font-weight: 700;\r\n}\r\n\r\n.dashboard-notification-empty strong {\r\n  color: var(--text);\r\n  font-size: 14px;\r\n}\r\n\r\n.dashboard-notification-empty p {\r\n  margin: 0;\r\n  font-size: 12px;\r\n}\r\n\r\n.dashboard-notifications-modal__footer > span {\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .dashboard-notification-bar {\r\n    grid-template-columns: minmax(190px, 1fr) auto;\r\n  }\r\n\r\n  .dashboard-notification-bar__categories {\r\n    grid-column: 1 / -1;\r\n    display: grid;\r\n    grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  }\r\n\r\n  .dashboard-notification-chip {\r\n    width: 100%;\r\n  }\r\n}\r\n\r\n@media (max-width: 560px) {\r\n  .dashboard-notification-bar {\r\n    grid-template-columns: minmax(0, 1fr) auto;\r\n    gap: 9px;\r\n    padding: 10px;\r\n  }\r\n\r\n  .dashboard-notification-bar__copy > span {\r\n    white-space: normal;\r\n  }\r\n\r\n  .dashboard-notification-chip,\r\n  .dashboard-notification-tab {\r\n    flex-direction: column;\r\n    gap: 3px;\r\n    min-width: 0;\r\n    height: auto;\r\n    min-height: 52px;\r\n    padding: 6px;\r\n  }\r\n\r\n  .dashboard-notification-tabs {\r\n    gap: 6px;\r\n  }\r\n\r\n  .dashboard-notifications-modal {\r\n    max-height: calc(100vh - 24px);\r\n    border-radius: var(--card-radius-sm);\r\n  }\r\n\r\n  .dashboard-notifications-modal__header,\r\n  .dashboard-notifications-modal__body,\r\n  .dashboard-notifications-modal__footer {\r\n    padding-left: 14px;\r\n    padding-right: 14px;\r\n  }\r\n\r\n  .dashboard-notification-section__header,\r\n  .dashboard-notification-section__content {\r\n    padding-left: 10px;\r\n    padding-right: 10px;\r\n  }\r\n}\r\n\r\n/* Forma compatta (schermata Turno, HMI 1): pulsante 48 nella card \"Adesso\". */\r\n.dashboard-notification-compact {\r\n  height: 48px;\r\n  padding: 0 16px;\r\n  border-radius: 12px;\r\n  border: 0;\r\n  background: transparent;\r\n  color: #1d4fc4;\r\n  font: 600 16px/24px var(--font-ui);\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  white-space: nowrap;\r\n  cursor: pointer;\r\n}\r\n.dashboard-notification-compact:hover {\r\n  background: #eaf1fe;\r\n}\r\n.dashboard-notification-compact:focus-visible {\r\n  outline: 3px solid #245bb5;\r\n  outline-offset: 2px;\r\n}\r\n.dashboard-notification-compact svg {\r\n  width: 20px;\r\n  height: 20px;\r\n}\r\n.dashboard-notification-compact strong {\r\n  min-width: 24px;\r\n  height: 24px;\r\n  padding: 0 6px;\r\n  border-radius: 8px;\r\n  display: inline-grid;\r\n  place-items: center;\r\n  font: 600 14px/20px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n  background: #eaf1fe;\r\n  color: #1d4fc4;\r\n}\r\n.dashboard-notification-compact--alarm strong {\r\n  background: #fdecee;\r\n  color: #b42335;\r\n}\r\n.dashboard-notification-compact--alarm { color: #b42335; background: #fdecee; border: 1px solid #efc3cb; }\r\n.dashboard-notification-compact--alarm:hover { background: #fbdce2; }\r\n.dashboard-notification-compact--warning { color: #8f5500; background: #fdf3e2; border: 1px solid #ead0a7; }\r\n.dashboard-notification-compact--warning:hover { background: #fae9cc; }\r\n.dashboard-notification-compact--loading { color: var(--text-muted); background: var(--surface); }\r\n.dashboard-notification-compact--clear { color: var(--text-muted); }\r\n.dashboard-notification-compact--warning strong {\r\n  background: #fdf3e2;\r\n  color: #8f5500;\r\n}\r\n\r\n/* Annuncio degli allarmi per i lettori di schermo (forma compatta): non visibile. */\r\n.dashboard-notification-live {\r\n  position: absolute;\r\n  width: 1px;\r\n  height: 1px;\r\n  padding: 0;\r\n  margin: -1px;\r\n  overflow: hidden;\r\n  clip: rect(0, 0, 0, 0);\r\n  white-space: nowrap;\r\n  border: 0;\r\n}\r\n"],["STYLE",{},".dashboard-kpi-band {\r\n  display: grid;\r\n  gap: 8px;\r\n  margin-bottom: 18px;\r\n}\r\n\r\n.dashboard-kpi-band--1 {\r\n  grid-template-columns: minmax(0, 1fr);\r\n}\r\n\r\n.dashboard-kpi-band--2 {\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n}\r\n\r\n.dashboard-kpi-band--3 {\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n}\r\n\r\n.dashboard-kpi-band--4 {\r\n  grid-template-columns: repeat(4, minmax(0, 1fr));\r\n}\r\n\r\n.dashboard-kpi-band--5 {\r\n  grid-template-columns: repeat(5, minmax(0, 1fr));\r\n}\r\n\r\n.dashboard-kpi-card {\r\n  position: relative;\r\n  display: grid;\r\n  grid-template-columns: 32px minmax(0, 1fr) 14px;\r\n  grid-template-areas:\r\n    'icon value arrow'\r\n    'label label label'\r\n    'status status status';\r\n  align-items: center;\r\n  gap: 5px 8px;\r\n  min-width: 0;\r\n  min-height: 102px;\r\n  padding: 11px 12px;\r\n  text-align: left;\r\n  color: var(--text);\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 12px;\r\n  box-shadow: 0 1px 2px rgba(25, 45, 75, 0.04);\r\n  cursor: pointer;\r\n  transition:\r\n    border-color 0.14s ease,\r\n    box-shadow 0.14s ease,\r\n    transform 0.14s ease;\r\n}\r\n\r\n.dashboard-kpi-card:hover {\r\n  border-color: color-mix(in srgb, var(--blue) 30%, var(--border));\r\n  box-shadow: var(--shadow-card);\r\n  transform: translateY(-1px);\r\n}\r\n\r\n.dashboard-kpi-card:focus-visible {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 2px;\r\n  border-color: var(--blue);\r\n  box-shadow: var(--shadow-focus);\r\n}\r\n\r\n.dashboard-kpi-card__icon {\r\n  grid-area: icon;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 32px;\r\n  height: 32px;\r\n  color: var(--blue);\r\n  background: var(--indigo-bg);\r\n  border-radius: 9px;\r\n}\r\n\r\n.dashboard-kpi-card__icon svg {\r\n  width: 17px;\r\n  height: 17px;\r\n}\r\n\r\n.dashboard-kpi-card__value {\r\n  grid-area: value;\r\n  min-width: 0;\r\n  color: var(--blue);\r\n  font-size: 26px;\r\n  font-weight: 800;\r\n  line-height: 1;\r\n  letter-spacing: -0.6px;\r\n}\r\n\r\n.dashboard-kpi-card__label {\r\n  grid-area: label;\r\n  overflow: hidden;\r\n  color: var(--text);\r\n  font-size: 12.5px;\r\n  font-weight: 700;\r\n  line-height: 1.25;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.dashboard-kpi-card__status {\r\n  grid-area: status;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  overflow: hidden;\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  line-height: 1.2;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.dashboard-kpi-card__status svg {\r\n  width: 12px;\r\n  height: 12px;\r\n  flex: 0 0 12px;\r\n}\r\n\r\n.dashboard-kpi-card__arrow {\r\n  grid-area: arrow;\r\n  display: inline-flex;\r\n  color: var(--text-xmuted);\r\n}\r\n\r\n.dashboard-kpi-card__arrow svg {\r\n  width: 14px;\r\n  height: 14px;\r\n}\r\n\r\n.dashboard-kpi-card--positive .dashboard-kpi-card__icon {\r\n  color: var(--teal);\r\n  background: var(--emerald-bg);\r\n}\r\n\r\n.dashboard-kpi-card--positive .dashboard-kpi-card__value,\r\n.dashboard-kpi-card--positive .dashboard-kpi-card__status svg {\r\n  color: var(--teal);\r\n}\r\n\r\n.dashboard-kpi-card--critical .dashboard-kpi-card__icon {\r\n  color: var(--red);\r\n  background: var(--red-bg);\r\n}\r\n\r\n.dashboard-kpi-card--critical .dashboard-kpi-card__value {\r\n  color: var(--red);\r\n}\r\n\r\n.dashboard-kpi-card--attention .dashboard-kpi-card__icon {\r\n  color: var(--amber);\r\n  background: var(--amber-bg);\r\n}\r\n\r\n.dashboard-kpi-card--attention .dashboard-kpi-card__value {\r\n  color: var(--amber);\r\n}\r\n\r\n.dashboard-kpi-card--unknown .dashboard-kpi-card__icon {\r\n  color: var(--text-muted);\r\n  background: var(--surface-raised);\r\n}\r\n\r\n.dashboard-kpi-card--unknown .dashboard-kpi-card__value {\r\n  color: var(--text-muted);\r\n}\r\n\r\n@media (max-width: 1040px) {\r\n  .dashboard-kpi-band--4,\r\n  .dashboard-kpi-band--5 {\r\n    grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  }\r\n\r\n  .dashboard-kpi-card__label,\r\n  .dashboard-kpi-card__status {\r\n    white-space: normal;\r\n  }\r\n}\r\n\r\n@media (max-width: 700px) {\r\n  .dashboard-kpi-band,\r\n  .dashboard-kpi-band--3,\r\n  .dashboard-kpi-band--4,\r\n  .dashboard-kpi-band--5 {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n\r\n  .dashboard-kpi-band--3 .dashboard-kpi-card:last-child,\r\n  .dashboard-kpi-band--5 .dashboard-kpi-card:last-child {\r\n    grid-column: 1 / -1;\r\n  }\r\n}\r\n\r\n@media (max-width: 520px) {\r\n  .dashboard-kpi-band {\r\n    gap: 7px;\r\n  }\r\n\r\n  .dashboard-kpi-card {\r\n    min-height: 88px;\r\n    padding: 10px;\r\n  }\r\n\r\n  .dashboard-kpi-card__label,\r\n  .dashboard-kpi-card__status {\r\n    white-space: normal;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Card \"Adesso\" (HMI 1): righe ora · chi/cosa · pulsante; ora rossa se scaduta. */\r\n.adesso-queue__count {\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.adesso-queue { container-type: inline-size; }\r\n.adesso-queue__notice {\r\n  margin: 0;\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px;\r\n  font: 500 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n.adesso-queue__notice--error {\r\n  color: #b42335;\r\n}\r\n.adesso-queue__list {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n.adesso-queue__row {\r\n  display: grid;\r\n  grid-template-columns: 44px minmax(0, 1fr) auto;\r\n  gap: 8px;\r\n  align-items: center;\r\n  padding: 10px 12px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 12px;\r\n  margin-bottom: 8px;\r\n}\r\n.adesso-queue__row--terapia-ritardo,\r\n.adesso-queue__row--consegna-scaduta { border-left: 4px solid #b42335; background: #fffafb; }\r\n.adesso-queue__ora {\r\n  font: 600 14px/20px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--text);\r\n}\r\n.adesso-queue__ora.is-late {\r\n  color: #b42335;\r\n}\r\n.adesso-queue__main {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n  gap: 2px;\r\n}\r\n.adesso-queue__who {\r\n  font: 600 14px/20px var(--font-ui);\r\n  color: var(--text);\r\n  overflow-wrap: anywhere;\r\n}\r\n.adesso-queue__location { font: 400 12px/16px var(--font-ui); color: var(--text-muted); overflow-wrap: anywhere; }\r\n.adesso-queue__time { align-self: flex-start; font: 500 12px/18px var(--font-ui); padding: 2px 6px; border-radius: 6px; background: #eaf1fe; color: #1d4fc4; }\r\n.adesso-queue__what {\r\n  font: 600 14px/20px var(--font-ui);\r\n  color: var(--text);\r\n  overflow-wrap: anywhere;\r\n}\r\n.adesso-queue__time.is-late {\r\n  color: #b42335;\r\n  background: #fdecee;\r\n}\r\n.adesso-queue__empty {\r\n  margin: 0;\r\n  font: 400 16px/24px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n.adesso-queue__more {\r\n  margin: 0;\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding-top: 8px;\r\n  border-top: 1px solid var(--border);\r\n  font: 500 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n@container (max-width: 359px) {\r\n  .adesso-queue__row {\r\n    grid-template-columns: 44px minmax(0, 1fr);\r\n  }\r\n  .adesso-queue__row .ds-btn {\r\n    grid-column: 2;\r\n    justify-self: start;\r\n  }\r\n}\r\n.adesso-queue__foot {\r\n  margin: 0;\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  padding-top: 8px;\r\n  border-top: 1px solid var(--border);\r\n  font: 500 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n"],["STYLE",{},".turno-handovers .turno-card__title > svg {\r\n  width: 22px;\r\n  height: 22px;\r\n  color: var(--text-muted);\r\n  flex: none;\r\n}\r\n.turno-handovers__hint {\r\n  margin: -8px 0 0;\r\n  color: var(--text-muted);\r\n  font-size: 13px;\r\n  line-height: 1.5;\r\n}\r\n.turno-handovers__list {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: grid;\r\n  gap: 12px;\r\n}\r\n.turno-handovers__item {\r\n  border: 1px solid var(--border);\r\n  border-radius: 12px;\r\n  padding: 16px;\r\n  display: grid;\r\n  gap: 8px;\r\n  min-width: 0;\r\n}\r\n.turno-handovers__item.is-urgent {\r\n  border-left: 4px solid #b42335;\r\n}\r\n.turno-handovers__meta,\r\n.turno-handovers__bottom {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n.turno-handovers__meta time,\r\n.turno-handovers__bottom > span {\r\n  font-size: 13px;\r\n  color: var(--text-muted);\r\n}\r\n.turno-handovers__patient {\r\n  font-size: 16px;\r\n  overflow-wrap: anywhere;\r\n}\r\n.turno-handovers__type {\r\n  font-weight: 600;\r\n  font-size: 14px;\r\n}\r\n.turno-handovers__text {\r\n  margin: 0;\r\n  font-size: 14px;\r\n  line-height: 1.6;\r\n  white-space: pre-wrap;\r\n  overflow-wrap: anywhere;\r\n}\r\n.turno-handovers__trace {\r\n  margin: 0;\r\n  font-size: 13px;\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n}\r\n"],["STYLE",{},"/* Avviso anomalie farmaci. Ambra: il rosso in ClinicOS resta agli allarmi clinici. */\r\n\r\n.avviso-anomalie {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  gap: 12px;\r\n  margin: 0 0 16px;\r\n  padding: 12px 14px;\r\n  border: 1px solid rgb(180 120 0 / 40%);\r\n  border-left: 3px solid #c98a00;\r\n  border-radius: 10px;\r\n  background: rgb(255 196 0 / 10%);\r\n}\r\n\r\n.avviso-anomalie--compatto {\r\n  margin-bottom: 12px;\r\n  padding: 9px 12px;\r\n}\r\n\r\n.avviso-anomalie__icona {\r\n  flex: none;\r\n  display: grid;\r\n  place-items: center;\r\n  width: 22px;\r\n  height: 22px;\r\n  border-radius: 50%;\r\n  background: #c98a00;\r\n  color: #fff;\r\n  font-size: 14px;\r\n  font-weight: 700;\r\n  line-height: 1;\r\n}\r\n\r\n.avviso-anomalie__testo {\r\n  flex: 1;\r\n  min-width: 0;\r\n}\r\n\r\n.avviso-anomalie__titolo {\r\n  margin: 0;\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  color: #7a5300;\r\n}\r\n\r\n.avviso-anomalie__ambito {\r\n  font-weight: 500;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.avviso-anomalie__dettaglio {\r\n  margin: 3px 0 0;\r\n  font-size: 12px;\r\n  color: var(--text);\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.avviso-anomalie__parziale {\r\n  margin: 4px 0 0;\r\n  font-size: 11px;\r\n  font-style: italic;\r\n  color: var(--text-muted);\r\n}\r\n\r\n/* Indicatore per riga di elenco: deve leggersi in mezzo a una tabella densa senza urlare. */\r\n.indicatore-anomalie {\r\n  display: inline-block;\r\n  padding: 1px 8px;\r\n  border: 1px solid rgb(180 120 0 / 45%);\r\n  border-radius: 999px;\r\n  background: rgb(255 196 0 / 16%);\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n  white-space: nowrap;\r\n  color: #8a5a00;\r\n}\r\n\r\n/* Variante ambra di `.coverage-alert`, che di base è rossa: i farmaci da correggere non sono\r\n   un'urgenza clinica come una consegna urgente, e non devono averne il peso visivo. */\r\n.coverage-alert--amber {\r\n  align-items: flex-start;\r\n  border-color: rgb(180 120 0 / 40%);\r\n  background: rgb(255 196 0 / 10%);\r\n  color: #7a5300;\r\n}\r\n\r\n.coverage-alert--amber svg {\r\n  color: #c98a00;\r\n}\r\n\r\n/* Riquadro del cruscotto: elenco dei pazienti da bonificare. */\r\n.anomalie-reparto__lista {\r\n  margin: 0;\r\n  padding: 0;\r\n  list-style: none;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n}\r\n\r\n.anomalie-reparto__riga {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 10px;\r\n  padding: 8px 10px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  background: var(--surface);\r\n  cursor: pointer;\r\n  text-align: left;\r\n  width: 100%;\r\n  min-height: 44px;\r\n}\r\n\r\n.anomalie-reparto__riga:hover {\r\n  border-color: #c98a00;\r\n}\r\n\r\n.anomalie-reparto__riga:focus-visible {\r\n  outline: 3px solid #8a5a00;\r\n  outline-offset: 2px;\r\n  border-color: #c98a00;\r\n}\r\n\r\n.anomalie-reparto__riga > .badge,\r\n.anomalie-reparto__riga > .indicatore-anomalie {\r\n  align-self: center;\r\n  flex: 0 0 auto;\r\n  width: max-content;\r\n  max-width: 100%;\r\n}\r\n\r\n.anomalie-reparto__nome {\r\n  display: block;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  color: var(--text);\r\n}\r\n\r\n.anomalie-reparto__contenuto {\r\n  display: grid;\r\n  flex: 1 1 auto;\r\n  gap: 5px;\r\n  min-width: 0;\r\n}\r\n\r\n.anomalie-reparto__farmaci-lista {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 5px;\r\n}\r\n\r\n.anomalie-reparto__farmaco {\r\n  display: inline-flex;\r\n  align-items: baseline;\r\n  gap: 5px;\r\n  padding: 3px 7px;\r\n  border-radius: 6px;\r\n  background: var(--bg);\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  line-height: 1.3;\r\n}\r\n\r\n.anomalie-reparto__farmaco strong {\r\n  color: var(--text);\r\n  font-size: 11px;\r\n}\r\n\r\n.anomalie-reparto__altre-voci {\r\n  align-self: center;\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n}\r\n\r\n@media (max-width: 520px) {\r\n  .anomalie-reparto__riga {\r\n    align-items: stretch;\r\n    display: grid;\r\n    grid-template-columns: minmax(0, 1fr) auto;\r\n  }\r\n\r\n  .anomalie-reparto__farmaci-lista {\r\n    flex-direction: column;\r\n  }\r\n\r\n  .anomalie-reparto__farmaco {\r\n    align-items: flex-start;\r\n    flex-direction: column;\r\n    gap: 1px;\r\n  }\r\n\r\n  .anomalie-reparto__riga > .badge,\r\n  .anomalie-reparto__riga > .indicatore-anomalie {\r\n    align-self: start;\r\n  }\r\n}\r\n\r\n.anomalie-reparto__farmaci {\r\n  display: block;\r\n  min-width: 0;\r\n  margin: 2px 0 0;\r\n  font-size: 11px;\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.anomalie-reparto__vuoto {\r\n  margin: 0;\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n/* La riga di lista e' generica (.anomalie-reparto__riga), ma il suo hover di base e' ambra\r\n   (vedi sopra) — sbagliato dentro un banner rosso di urgenza clinica reale come questo. Un solo\r\n   modificatore per correggere solo l'accento colore, non una classe gemella intera. */\r\n.anomalie-reparto__riga--rosso:hover {\r\n  border-color: var(--red);\r\n}\r\n"],["STYLE",{},"/* Il mio turno uses shared control, typography and spacing tokens. */\r\n\r\n.operator-dashboard.turno {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: var(--ds-layout-gap);\r\n  max-width: none;\r\n  margin: 0;\r\n  width: 100%;\r\n}\r\n\r\n/* Indicatori compatti: etichetta e stato a sinistra, valore a destra. */\r\n.turno .dashboard-kpi-band {\r\n  gap: 12px;\r\n  margin: 0;\r\n}\r\n.turno .dashboard-kpi-card {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) auto;\r\n  grid-template-areas: 'label value' 'status value';\r\n  align-items: center;\r\n  gap: 2px 8px;\r\n  min-height: 64px;\r\n  padding: 12px;\r\n  border-radius: 12px;\r\n  border: 1px solid var(--border);\r\n  background: var(--surface);\r\n  box-shadow: none;\r\n  transform: none;\r\n}\r\n.turno .dashboard-kpi-card:hover {\r\n  border-color: var(--blue);\r\n  box-shadow: none;\r\n  transform: none;\r\n}\r\n.turno .dashboard-kpi-card__icon,\r\n.turno .dashboard-kpi-card__arrow {\r\n  display: none;\r\n}\r\n.turno .dashboard-kpi-card__label {\r\n  order: 1;\r\n  font: 500 13px/18px var(--font-ui);\r\n  color: var(--text-muted);\r\n  white-space: normal;\r\n  overflow: visible;\r\n}\r\n.turno .dashboard-kpi-card__value {\r\n  order: 2;\r\n  font: 600 24px/28px var(--font-ui);\r\n  letter-spacing: 0;\r\n  color: var(--text);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.turno .dashboard-kpi-card--critical .dashboard-kpi-card__value {\r\n  color: #b42335;\r\n}\r\n.turno .dashboard-kpi-card--attention .dashboard-kpi-card__value {\r\n  color: #8f5500;\r\n}\r\n/* la riga di stato resta solo quando spiega perché manca il dato */\r\n.turno .dashboard-kpi-card__status {\r\n  order: 3;\r\n  display: none;\r\n}\r\n.turno .dashboard-kpi-card--unknown .dashboard-kpi-card__status,\r\n.turno .dashboard-kpi-card[data-kpi-id='allergie'] .dashboard-kpi-card__status,\r\n.turno .dashboard-kpi-card[data-unavailable] .dashboard-kpi-card__status {\r\n  display: inline-flex;\r\n  font: 500 12px/16px var(--font-ui);\r\n  color: var(--text-muted);\r\n  white-space: normal;\r\n  overflow: visible;\r\n}\r\n\r\n/* ── Griglia: Adesso (5) · lato destro (6) ─────────────────────────────── */\r\n.turno-grid {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);\r\n  gap: var(--ds-layout-gap);\r\n  align-items: start;\r\n}\r\n.turno-side {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n\r\n/* ── Card comuni ───────────────────────────────────────────────────────── */\r\n.turno-card {\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 16px;\r\n  padding: var(--ds-card-padding);\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.turno-card__head {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px 16px;\r\n  min-height: var(--ds-control-h);\r\n}\r\n.turno-card__title {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  min-width: 0;\r\n}\r\n.turno-h2 {\r\n  margin: 0;\r\n  font: 600 var(--ds-title-font)/24px var(--font-ui);\r\n  color: var(--text);\r\n}\r\n.turno-empty {\r\n  margin: 0;\r\n  font: 400 var(--ds-body-font)/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n\r\n.turno-badge {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  /* I badge portano i nomi (allergene, parametro, rischio): vanno a capo, mai troncati. */\r\n  min-height: 24px;\r\n  padding: 2px 6px;\r\n  border-radius: 8px;\r\n  font: 500 14px/20px var(--font-ui);\r\n  white-space: normal;\r\n  overflow-wrap: anywhere;\r\n  background: #f5f7fb;\r\n  color: var(--text-muted);\r\n}\r\n.turno-badge svg {\r\n  width: 16px;\r\n  height: 16px;\r\n  fill: none;\r\n  stroke: currentColor;\r\n  stroke-width: 2;\r\n  stroke-linecap: round;\r\n  stroke-linejoin: round;\r\n}\r\n.turno-badge--crit {\r\n  background: #fdecee;\r\n  color: #b42335;\r\n}\r\n.turno-badge--warn {\r\n  background: #fdf3e2;\r\n  color: #8f5500;\r\n}\r\n.turno-badge--blue {\r\n  background: #eaf1fe;\r\n  color: #1d4fc4;\r\n}\r\n\r\n.turno-pcard__open:focus-visible,\r\n.turno-appt__who:focus-visible {\r\n  outline: 3px solid #245bb5;\r\n  outline-offset: 2px;\r\n}\r\n\r\n/* ── Prossimi appuntamenti ─────────────────────────────────────────────── */\r\n.turno-appts {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n.turno-appt {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n  min-height: 64px;\r\n  padding: 8px 0;\r\n  border-top: 1px solid var(--border);\r\n}\r\n.turno-appt:first-child {\r\n  border-top: 0;\r\n}\r\n.turno-appt__ora {\r\n  width: 56px;\r\n  flex: none;\r\n  font: 600 16px/24px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.turno-appt__main {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n}\r\n.turno-appt__what {\r\n  font: 600 16px/24px var(--font-ui);\r\n  color: var(--text);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.turno-appt__now {\r\n  font-weight: 500;\r\n  color: #1d4fc4;\r\n}\r\n.turno-appt__who {\r\n  justify-self: start;\r\n  text-align: left;\r\n  padding: 0;\r\n  min-height: 0;\r\n  font: 500 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\nbutton.turno-appt__who:hover {\r\n  color: #1d4fc4;\r\n}\r\n\r\n/* ── Card paziente ─────────────────────────────────────────────────────── */\r\n.turno-pgrid {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  gap: 16px;\r\n}\r\n.turno-pcard {\r\n  position: relative;\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 16px;\r\n  padding: 16px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.turno-pcard:hover {\r\n  border-color: var(--blue);\r\n}\r\n.turno-pcard__top {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.turno-pcard__bed {\r\n  width: 48px;\r\n  height: 48px;\r\n  flex: none;\r\n  border-radius: 12px;\r\n  background: #f5f7fb;\r\n  border: 1px solid var(--border);\r\n  display: grid;\r\n  place-items: center;\r\n  font: 600 var(--ds-title-font)/24px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n  letter-spacing: -0.02em;\r\n  overflow: hidden;\r\n}\r\n.turno-pcard__id {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n}\r\n/* Il nome apre la cartella e con ::after rende cliccabile tutta la card. */\r\n.turno-pcard__open {\r\n  border: 0;\r\n  background: none;\r\n  padding: 0;\r\n  text-align: left;\r\n  font: 600 16px/24px var(--font-ui);\r\n  color: var(--text);\r\n  cursor: pointer;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.turno-pcard__open::after {\r\n  content: '';\r\n  position: absolute;\r\n  inset: 0;\r\n  border-radius: 16px;\r\n}\r\n.turno-pcard__sub {\r\n  font: 500 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n/* Direct access: la riga terapia va a capo (niente ellissi) e ogni dose è un link. */\r\n.turno-pcard__next {\r\n  margin: 0;\r\n  font: 500 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n  white-space: normal;\r\n}\r\n.turno-pcard__next-label {\r\n  font-weight: 600;\r\n}\r\n.turno-pcard__dose {\r\n  display: inline;\r\n  min-height: 0;\r\n  padding: 0;\r\n  border: 0;\r\n  background: none;\r\n  font: inherit;\r\n  color: inherit;\r\n  text-align: left;\r\n  text-decoration: underline;\r\n  text-decoration-thickness: 1px;\r\n  text-underline-offset: 3px;\r\n  cursor: pointer;\r\n}\r\n.turno-pcard__dose:hover,\r\n.turno-pcard__dose:focus-visible {\r\n  text-decoration-thickness: 2px;\r\n}\r\n/* I link interni stanno sopra il link «apri cartella» esteso a tutta la card (::after). */\r\n.turno-pcard__badges > *,\r\n.turno-pcard__dose {\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n.turno-badge--link {\r\n  border: 0;\r\n  font: 500 14px/20px var(--font-ui);\r\n  cursor: pointer;\r\n}\r\n.turno-badge--link:hover,\r\n.turno-badge--link:focus-visible {\r\n  filter: brightness(0.95);\r\n  text-decoration: underline;\r\n  text-underline-offset: 2px;\r\n}\r\n.turno-pcard__badges {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n\r\n/* ── Tablet e telefono ─────────────────────────────────────────────────── */\r\n@media (max-width: 1023px) {\r\n  .turno-grid {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }\r\n}\r\n@media (max-width: 600px) {\r\n  .turno-pgrid {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }\r\n  .turno-card {\r\n    padding: 16px;\r\n  }\r\n}\r\n\r\n.turno-pcard__next.is-late {\r\n  color: #b42335;\r\n}\r\n.turno-empty--error {\r\n  color: #b42335;\r\n}\r\n.turno-appt__ora.is-late,\r\n.turno-appt__late {\r\n  color: #b42335;\r\n}\r\n.turno-appt__late {\r\n  font-weight: 500;\r\n}\r\n.turno-more {\r\n  margin: 0;\r\n  font: 500 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n.dashboard-regime-note {\r\n  margin: 8px 0 16px;\r\n  color: var(--text-muted);\r\n  font-size: 13px;\r\n  line-height: 1.5;\r\n  overflow-wrap: anywhere;\r\n}\r\n"],["STYLE",{},".therapy-deadlines {\r\n  margin-top: 24px;\r\n  overflow: hidden;\r\n  /* le righe si adattano alla larghezza della card, non del viewport: nella dashboard Turno la\r\n     card sta in una colonna e a 768-1200 px il viewport è largo ma la colonna no */\r\n  container: therapy-deadlines / inline-size;\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--card-radius-sm);\r\n}\r\n\r\n.therapy-deadlines__header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  flex-wrap: wrap;\r\n  gap: 12px;\r\n  padding: 16px 18px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.therapy-deadlines__header h2 {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  margin: 0;\r\n  color: var(--text);\r\n  font-size: 17px;\r\n}\r\n\r\n.therapy-deadlines__header svg,\r\n.therapy-deadlines__group-title svg {\r\n  width: 18px;\r\n  height: 18px;\r\n  flex-shrink: 0;\r\n  color: var(--blue);\r\n}\r\n\r\n.therapy-deadlines__header p {\r\n  margin: 5px 0 0;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n}\r\n\r\n.therapy-deadlines__actions {\r\n  display: flex;\r\n  gap: 16px;\r\n}\r\n.therapy-deadlines__actions .link-btn {\r\n  min-height: 44px;\r\n}\r\n.therapy-deadlines__actions svg {\r\n  width: 14px;\r\n  height: 14px;\r\n}\r\n\r\n.therapy-deadlines__group-title {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  margin: 0;\r\n  padding: 14px 18px 5px;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  font-weight: 650;\r\n}\r\n\r\n.therapy-deadlines__group-title > span {\r\n  padding: 2px 7px;\r\n  border-radius: 12px;\r\n  background: var(--surface-raised);\r\n}\r\n\r\n.therapy-deadlines__list {\r\n  list-style: none;\r\n  padding: 0 18px;\r\n  margin: 0;\r\n}\r\n.therapy-deadlines__row {\r\n  display: grid;\r\n  grid-template-columns: 64px minmax(140px, 1fr) minmax(180px, 1.5fr) minmax(85px, auto);\r\n  align-items: center;\r\n  gap: 14px;\r\n  padding: 13px 0;\r\n  border-bottom: 1px solid var(--border);\r\n  font-size: 13px;\r\n}\r\n\r\n.therapy-deadlines__row:last-child {\r\n  border-bottom: none;\r\n}\r\n.therapy-deadlines__row > div {\r\n  display: grid;\r\n  gap: 4px;\r\n  min-width: 0;\r\n}\r\n.therapy-deadlines__row strong {\r\n  font-weight: 650;\r\n  color: var(--text);\r\n}\r\n.therapy-deadlines__row > div > span {\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n}\r\n.therapy-deadlines__time time {\r\n  color: var(--blue);\r\n  font-size: 18px;\r\n  font-weight: 700;\r\n}\r\n.therapy-deadlines__patient .link-btn {\r\n  justify-self: start;\r\n  text-align: left;\r\n  font-weight: 650;\r\n}\r\n.therapy-deadlines__patient,\r\n.therapy-deadlines__prescription {\r\n  overflow-wrap: anywhere;\r\n}\r\n.therapy-deadlines__timing {\r\n  justify-self: end;\r\n  color: var(--blue);\r\n  font-size: 12px;\r\n}\r\n.therapy-deadlines__timing--late {\r\n  color: var(--red);\r\n}\r\n.therapy-deadlines__overdue,\r\n.therapy-deadlines__unscheduled {\r\n  border-top: 1px solid var(--border);\r\n}\r\n.therapy-deadlines__overdue .therapy-deadlines__time time {\r\n  color: var(--text-muted);\r\n}\r\n.therapy-deadlines__message {\r\n  padding: 18px;\r\n  margin: 0;\r\n  font-size: 13px;\r\n  color: var(--text-muted);\r\n}\r\n.therapy-deadlines__message p {\r\n  margin: 0 0 12px;\r\n}\r\n.therapy-deadlines__notice {\r\n  margin: 12px 18px;\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n}\r\n.therapy-deadlines__more summary {\r\n  padding: 12px 18px;\r\n  cursor: pointer;\r\n  color: var(--blue);\r\n  font-size: 12px;\r\n}\r\n.therapy-deadlines button:focus-visible,\r\n.therapy-deadlines summary:focus-visible {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 2px;\r\n}\r\n.therapy-deadlines__footer {\r\n  padding: 11px 18px;\r\n  color: var(--text-muted);\r\n  background: var(--surface-raised);\r\n  border-top: 1px solid var(--border);\r\n  font-size: 11px;\r\n}\r\n\r\n@media (max-width: 760px) {\r\n  .therapy-deadlines__row {\r\n    grid-template-columns: 60px minmax(0, 1fr);\r\n    gap: 8px 12px;\r\n  }\r\n  .therapy-deadlines__time {\r\n    grid-column: 1;\r\n    grid-row: 1 / 3;\r\n    align-self: start;\r\n  }\r\n  .therapy-deadlines__patient,\r\n  .therapy-deadlines__prescription {\r\n    grid-column: 2;\r\n  }\r\n  .therapy-deadlines__timing {\r\n    grid-column: 2;\r\n    justify-self: start;\r\n  }\r\n  .therapy-deadlines__patient .link-btn {\r\n    min-height: 32px;\r\n  }\r\n}\r\n\r\n/* stessa disposizione compatta quando è la card a essere stretta */\r\n@container therapy-deadlines (max-width: 600px) {\r\n  .therapy-deadlines__row {\r\n    grid-template-columns: 60px minmax(0, 1fr);\r\n    gap: 8px 12px;\r\n  }\r\n  .therapy-deadlines__time {\r\n    grid-column: 1;\r\n    grid-row: 1 / 3;\r\n    align-self: start;\r\n  }\r\n  .therapy-deadlines__patient,\r\n  .therapy-deadlines__prescription {\r\n    grid-column: 2;\r\n  }\r\n  .therapy-deadlines__timing {\r\n    grid-column: 2;\r\n    justify-self: start;\r\n  }\r\n  .therapy-deadlines__patient .link-btn {\r\n    min-height: 32px;\r\n  }\r\n}\r\n\r\n@media (max-width: 420px) {\r\n  .therapy-deadlines__header {\r\n    padding: 12px;\r\n  }\r\n  .therapy-deadlines__list {\r\n    padding: 0 12px;\r\n  }\r\n  .therapy-deadlines__group-title {\r\n    padding-left: 12px;\r\n    padding-right: 12px;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Scelta \"Nuovo paziente\": due opzioni grandi, documenti (rapido) prima di a mano. */\r\n.new-patient-chooser {\r\n  width: min(520px, 92vw);\r\n  max-width: 520px;\r\n  padding: 24px;\r\n  overflow-y: auto;\r\n}\r\n.new-patient-chooser__head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n}\r\n.new-patient-chooser__title {\r\n  margin: 0;\r\n  font-size: 18px;\r\n  font-weight: 700;\r\n  color: var(--text);\r\n}\r\n\r\n.new-patient-chooser__desc {\r\n  margin: 8px 0 16px;\r\n  font-size: 14px;\r\n  color: var(--text-muted);\r\n}\r\n.new-patient-chooser__options {\r\n  display: grid;\r\n  gap: 16px;\r\n}\r\n.new-patient-chooser__option {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  gap: 16px;\r\n  min-height: 88px;\r\n  padding: 16px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 14px;\r\n  background: var(--surface);\r\n  color: var(--text);\r\n  text-align: left;\r\n  font: inherit;\r\n  cursor: pointer;\r\n}\r\n.new-patient-chooser__option:hover:not(:disabled) {\r\n  border-color: var(--blue);\r\n}\r\n.new-patient-chooser__option--primary {\r\n  border-color: var(--blue);\r\n  background: var(--blue-bg, #e8f0fe);\r\n}\r\n.new-patient-chooser__option:disabled {\r\n  cursor: not-allowed;\r\n  border-color: var(--border);\r\n  background: var(--surface-raised, #f5f7fa);\r\n}\r\n.new-patient-chooser__option:disabled .new-patient-chooser__icon {\r\n  background: var(--border);\r\n  color: var(--text-muted);\r\n}\r\n.new-patient-chooser__option:focus-visible {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 2px;\r\n}\r\n.new-patient-chooser__icon {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  flex-shrink: 0;\r\n  width: 48px;\r\n  height: 48px;\r\n  border-radius: 12px;\r\n  background: var(--blue);\r\n  color: #fff;\r\n}\r\n.new-patient-chooser__option:not(.new-patient-chooser__option--primary) .new-patient-chooser__icon {\r\n  background: var(--blue-bg, #e8f0fe);\r\n  color: var(--blue);\r\n}\r\n.new-patient-chooser__icon svg {\r\n  width: 24px;\r\n  height: 24px;\r\n}\r\n.new-patient-chooser__text {\r\n  display: grid;\r\n  gap: 4px;\r\n  min-width: 0;\r\n  font-size: 14px;\r\n  line-height: 1.45;\r\n  color: var(--text-muted);\r\n}\r\n.new-patient-chooser__text strong {\r\n  font-size: 16px;\r\n  color: var(--text);\r\n}\r\n.new-patient-chooser__status {\r\n  font-style: normal;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  color: var(--blue);\r\n}\r\n.new-patient-chooser__status--off {\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n}\r\n@media (max-width: 480px) {\r\n  .new-patient-chooser {\r\n    padding: 16px;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Nuovo ingresso — HMI 1 (artifacts/hmi-parity/proto/ingresso-start.png). Token del design system. */\r\n.nps {\r\n  outline: none;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 24px;\r\n  min-width: 0;\r\n}\r\n.nps__top {\r\n  display: flex;\r\n  justify-content: flex-start;\r\n}\r\n.nps__options {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  gap: 16px;\r\n}\r\n/* Card di scelta: componente dichiarato del design system (grande superficie cliccabile). */\r\n.nps-option {\r\n  box-sizing: border-box;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-start;\r\n  gap: 12px;\r\n  min-height: 240px;\r\n  padding: 24px;\r\n  border: var(--ds-border-w) solid var(--ds-border);\r\n  border-radius: var(--ds-card-radius);\r\n  background: var(--ds-surface);\r\n  color: var(--ds-text);\r\n  text-align: left;\r\n  cursor: pointer;\r\n  font: inherit;\r\n}\r\n.nps-option:hover:not(:disabled) {\r\n  border-color: var(--ds-blue);\r\n}\r\n.nps-option:focus-visible {\r\n  outline: var(--ds-focus);\r\n  outline-offset: 2px;\r\n}\r\n.nps-option:disabled {\r\n  cursor: not-allowed;\r\n  background: var(--ds-surface-2);\r\n}\r\n/* Disabilitata: attenuati icona e testi, non il motivo (va letto). */\r\n.nps-option:disabled .nps-option__icon,\r\n.nps-option:disabled .nps-option__title,\r\n.nps-option:disabled .nps-option__text {\r\n  opacity: 0.6;\r\n}\r\n.nps-option__icon {\r\n  width: 48px;\r\n  height: 48px;\r\n  border-radius: var(--ds-radius);\r\n  background: var(--ds-blue-tint);\r\n  color: var(--ds-blue-active);\r\n  display: grid;\r\n  place-items: center;\r\n}\r\n.nps-option__icon svg {\r\n  width: 24px;\r\n  height: 24px;\r\n}\r\n.nps-option__title {\r\n  font: 600 20px/28px var(--ds-font);\r\n}\r\n.nps-option__text {\r\n  font: 400 16px/24px var(--ds-font);\r\n  color: var(--ds-text);\r\n}\r\n.nps-option__status {\r\n  margin-top: auto;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 6px 12px;\r\n  border-radius: var(--ds-radius);\r\n  background: color-mix(in srgb, var(--purple) 12%, white);\r\n  color: color-mix(in srgb, var(--purple) 80%, black);\r\n  font: 600 14px/20px var(--ds-font);\r\n}\r\n.nps-option__status svg {\r\n  width: 16px;\r\n  height: 16px;\r\n}\r\n.nps-option__status--off {\r\n  background: var(--ds-surface);\r\n  color: var(--ds-text);\r\n}\r\n.nps__how {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n}\r\n.nps__how h2 {\r\n  margin: 0;\r\n}\r\n.nps__how-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  gap: 24px;\r\n}\r\n.nps__how-title {\r\n  margin: 0 0 4px;\r\n  font: 600 16px/24px var(--ds-font);\r\n  color: var(--ds-text);\r\n}\r\n.nps__how-text {\r\n  margin: 0;\r\n  font: 400 16px/24px var(--ds-font);\r\n  color: var(--ds-text);\r\n}\r\n@media (max-width: 1023px) {\r\n  .nps__options,\r\n  .nps__how-grid {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }\r\n  .nps-option {\r\n    min-height: 0;\r\n  }\r\n}\r\n"],["STYLE",{},".patient-identity {\r\n  display: grid;\r\n  min-width: 0;\r\n  gap: 3px;\r\n  text-align: left;\r\n  line-height: 1.4;\r\n  white-space: normal;\r\n  overflow-wrap: anywhere;\r\n}\r\n.patient-identity .patient-identity__name,\r\n.patient-identity__name {\r\n  color: var(--text, #1a3357);\r\n  font-size: 15px;\r\n  font-weight: 750;\r\n  overflow-wrap: anywhere;\r\n  white-space: normal;\r\n}\r\n.patient-identity__identifier {\r\n  color: var(--text, #1a3357);\r\n  font-family: var(--font-mono, monospace);\r\n  font-size: 12px;\r\n  overflow-wrap: anywhere;\r\n  white-space: normal;\r\n}\r\n.patient-identity .patient-identity__location {\r\n  color: var(--text, #1a3357);\r\n  font-size: 12px;\r\n  font-weight: 550;\r\n}\r\n.patient-identity .patient-identity__context,\r\n.patient-identity .patient-identity__incomplete {\r\n  color: var(--text-muted, #526174);\r\n  font-size: 11px;\r\n  font-weight: 400;\r\n}\r\n.consegna-card__patient > .patient-identity {\r\n  flex: 1;\r\n}\r\n.consegna-card__patient {\r\n  flex-wrap: wrap;\r\n}\r\n.consegna-card__patient > .consegna-paziente {\r\n  min-height: 44px;\r\n  white-space: normal;\r\n}\r\n.consegna-card__patient > .consegna-paziente:focus-visible {\r\n  outline: 2px solid var(--blue, #2463eb);\r\n  outline-offset: 3px;\r\n}\r\n"],["STYLE",{},".reading-recency {\r\n  display: grid;\r\n  gap: 2px;\r\n  min-width: 0;\r\n  max-width: 100%;\r\n  color: var(--text);\r\n  font-size: 14px;\r\n  font-weight: 500;\r\n  line-height: 1.5;\r\n  overflow-wrap: anywhere;\r\n  white-space: normal;\r\n}\r\n.vt__trend.vt__comparison {\r\n  display: grid;\r\n  align-items: start;\r\n  overflow-wrap: anywhere;\r\n}\r\n"],["STYLE",{},"/* NEWS2: il badge (testata, lista, turno, storico) è il ds-badge canonico di design-system.css;\r\n   qui il contenitore (lista, turno) e lo storico. Rosso solo per rischio clinico (medio/alto). */\r\n\r\n/* contenitore del badge: resta cliccabile sopra il collegamento della card del turno; nella\r\n   colonna della lista si accorcia (…) invece di uscire dalla cella */\r\n.turno-pcard__news2 {\r\n  position: relative;\r\n  z-index: 1;\r\n  display: inline-flex;\r\n  max-width: 100%;\r\n  min-width: 0;\r\n}\r\n.turno-pcard__news2:empty {\r\n  display: none;\r\n}\r\n\r\n.modal-box.news2-dialog,\r\n.news2-dialog {\r\n  /* La tabella ha nove colonne: più larga della finestra standard. */\r\n  max-width: none;\r\n  width: min(960px, calc(100vw - 32px));\r\n  padding: 20px 24px;\r\n  box-sizing: border-box;\r\n  max-height: calc(100vh - 48px);\r\n  overflow: auto;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 14px;\r\n}\r\n.news2-dialog__head {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n}\r\n.news2-dialog__title {\r\n  margin: 0;\r\n  font-size: 20px;\r\n}\r\n.news2-dialog__sub {\r\n  margin: 2px 0 0;\r\n  color: var(--text-muted);\r\n}\r\n.news2-dialog__now {\r\n  margin: 0;\r\n  padding: 10px 12px;\r\n  border-radius: var(--radius-sm);\r\n  background: var(--surface-raised);\r\n}\r\n.news2-dialog__now--medium,\r\n.news2-dialog__now--high {\r\n  background: var(--red-bg);\r\n  color: var(--red);\r\n}\r\n.news2-dialog__now--single {\r\n  background: var(--amber-bg);\r\n  color: var(--amber);\r\n}\r\n.news2-dialog__now--ok {\r\n  background: var(--emerald-bg);\r\n  color: var(--emerald);\r\n}\r\n.news2-dialog__stale {\r\n  display: block;\r\n  margin-top: 6px;\r\n  font-weight: 600;\r\n  color: var(--text);\r\n}\r\n.news2-dialog__error {\r\n  margin: 0;\r\n  padding: 12px;\r\n  border-radius: var(--radius-sm);\r\n  border: 1px solid var(--border);\r\n  background: var(--surface-raised);\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  align-items: flex-start;\r\n}\r\n.news2-dialog__error p {\r\n  margin: 0;\r\n}\r\n.news2-dialog__note,\r\n.news2-dialog__empty {\r\n  margin: 0;\r\n  font-size: 12.5px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.news2-chart {\r\n  margin: 0;\r\n}\r\n.news2-chart svg {\r\n  width: 100%;\r\n  height: auto;\r\n  display: block;\r\n}\r\n.news2-chart__band--ok {\r\n  fill: var(--emerald-bg);\r\n}\r\n.news2-chart__band--low {\r\n  fill: var(--surface-raised);\r\n}\r\n.news2-chart__band--medium {\r\n  fill: var(--red-bg);\r\n  fill-opacity: 0.55;\r\n}\r\n.news2-chart__band--high {\r\n  fill: var(--red-bg);\r\n}\r\n.news2-chart__line {\r\n  stroke: var(--text-muted);\r\n  stroke-width: 2;\r\n}\r\n.news2-chart__dot {\r\n  fill: var(--blue);\r\n  stroke: var(--surface);\r\n  stroke-width: 2;\r\n}\r\n.news2-chart__dot--ok {\r\n  fill: var(--emerald);\r\n}\r\n.news2-chart__dot--single {\r\n  fill: var(--amber);\r\n}\r\n.news2-chart__dot--medium,\r\n.news2-chart__dot--high {\r\n  fill: var(--red);\r\n}\r\n.news2-chart__axis {\r\n  fill: var(--text-muted);\r\n  font-size: 11px;\r\n  font-family: var(--font-ui);\r\n}\r\n.news2-chart__legend {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 12px;\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n}\r\n.news2-chart__key::before {\r\n  content: '';\r\n  display: inline-block;\r\n  width: 10px;\r\n  height: 10px;\r\n  margin-right: 6px;\r\n  border-radius: 3px;\r\n  vertical-align: -1px;\r\n}\r\n.news2-chart__key--low::before {\r\n  background: var(--surface-raised);\r\n  border: 1px solid var(--border);\r\n}\r\n.news2-chart__key--medium::before {\r\n  background: var(--red-bg);\r\n  border: 1px solid var(--red-border);\r\n}\r\n.news2-chart__key--high::before {\r\n  background: var(--red-bg);\r\n  border: 1px solid var(--red);\r\n}\r\n\r\n.news2-table-wrap {\r\n  overflow-x: auto;\r\n}\r\n.news2-table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n  font-size: 13px;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.news2-table th,\r\n.news2-table td {\r\n  padding: 8px 8px;\r\n  border-bottom: 1px solid var(--border);\r\n  text-align: left;\r\n  vertical-align: middle;\r\n  white-space: nowrap;\r\n}\r\n.news2-table thead th {\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n  font-weight: 700;\r\n}\r\n.news2-table tbody th small {\r\n  display: block;\r\n  font-weight: 400;\r\n  color: var(--text-muted);\r\n}\r\n.news2-table__row--incomplete td,\r\n.news2-table__row--incomplete th {\r\n  color: var(--text-muted);\r\n}\r\n.news2-table__missing {\r\n  font-size: 12px;\r\n  white-space: normal;\r\n}\r\n.news2-part {\r\n  margin-left: 4px;\r\n  padding: 0 5px;\r\n  border-radius: 6px;\r\n  font-size: 11px;\r\n  font-weight: 700;\r\n}\r\n/* Sotto-punteggi: +1/+2 neutri, +3 in ambra (singolo parametro critico). Il rosso resta al\r\n   totale ≥ 5. */\r\n.news2-part--mid {\r\n  background: var(--surface-raised);\r\n  color: var(--text-muted);\r\n}\r\n.news2-part--high {\r\n  background: var(--amber-bg);\r\n  color: var(--amber);\r\n}\r\n\r\n/* ── Panoramica (HMI 1): tessere dei parametri e del NEWS2, come il prototipo ── */\r\n.vitals {\r\n  display: grid;\r\n  grid-template-columns: repeat(6, minmax(0, 1fr));\r\n  grid-auto-rows: 1fr;\r\n  gap: 12px;\r\n  align-items: stretch;\r\n}\r\n.vt {\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 12px;\r\n  padding: 12px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-start;\r\n  gap: 4px;\r\n  min-width: 0;\r\n  width: 100%;\r\n  text-align: left;\r\n  font: inherit;\r\n  color: var(--text);\r\n}\r\n.vt--warn {\r\n  background: #fdf3e2;\r\n  border-color: transparent;\r\n}\r\n.vt--crit {\r\n  background: #fdecee;\r\n  border-color: transparent;\r\n}\r\n.vt__label {\r\n  font: 500 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n.vt__value {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: 4px;\r\n  font: 600 22px/28px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n  flex-wrap: wrap;\r\n  overflow-wrap: anywhere;\r\n}\r\n.vt__value small {\r\n  font: 500 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n.vt--warn .vt__value {\r\n  color: #8f5500;\r\n}\r\n.vt--crit .vt__value {\r\n  color: #b42335;\r\n}\r\n.vt__value--muted {\r\n  font: 600 20px/28px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n.vt__trend {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  font: 500 14px/20px var(--font-ui);\r\n  min-height: 20px;\r\n  color: var(--text-muted);\r\n}\r\n.vt__trend svg {\r\n  width: 16px;\r\n  height: 16px;\r\n  flex: none;\r\n  fill: none;\r\n  stroke: currentColor;\r\n  stroke-width: 2;\r\n  stroke-linecap: round;\r\n  stroke-linejoin: round;\r\n}\r\n.vt--news2 {\r\n  cursor: pointer;\r\n}\r\n.vt--news2:hover {\r\n  border-color: var(--blue);\r\n}\r\n.vt--news2:focus-visible {\r\n  outline: 3px solid #245bb5;\r\n  outline-offset: 2px;\r\n}\r\n.vitals-note {\r\n  margin: 0;\r\n  font: 500 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n.vitals-note--error {\r\n  color: #b42335;\r\n}\r\n@media (max-width: 1100px) {\r\n  .vitals {\r\n    grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  }\r\n}\r\n@media (max-width: 560px) {\r\n  .vitals {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n}\r\n\r\n/* ── UX direct-access (2026-10-03) ──────────────────────────────────────────────────────────────\r\n   Tessera NEWS2: la parte superiore apre lo storico, «Rileva ora» (F10) apre l'inserimento dei\r\n   parametri; «Non calcolabile» va a capo invece di essere tagliato. */\r\n.vt--news2 {\r\n  cursor: default;\r\n}\r\n.vt--news2:hover {\r\n  border-color: var(--border);\r\n}\r\n.vt--news2.vt--warn:hover,\r\n.vt--news2.vt--crit:hover {\r\n  border-color: transparent;\r\n}\r\n.vt__open {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-start;\r\n  gap: 4px;\r\n  width: 100%;\r\n  min-width: 0;\r\n  padding: 0;\r\n  border: 0;\r\n  background: none;\r\n  font: inherit;\r\n  color: inherit;\r\n  text-align: left;\r\n  cursor: pointer;\r\n}\r\n.vt__open:hover .vt__label {\r\n  color: var(--blue);\r\n}\r\n.vt__open:focus-visible {\r\n  outline: 3px solid #245bb5;\r\n  outline-offset: 4px;\r\n  border-radius: 8px;\r\n}\r\n.vt--news2 .vt__value--muted {\r\n  white-space: normal;\r\n  overflow-wrap: anywhere;\r\n}\r\n.vt--news2 .vt__trend {\r\n  flex-wrap: wrap;\r\n}\r\n.vt__record {\r\n  margin-top: 8px;\r\n  min-height: 44px;\r\n  align-self: stretch;\r\n  justify-content: center;\r\n}\r\n/* Chip compatto (colonne strette): ora e «da aggiornare» in chiaro, il testo va a capo. */\r\n.news2-chip--compact {\r\n  white-space: normal;\r\n  height: auto;\r\n  min-height: 28px;\r\n  text-align: left;\r\n}\r\n.news2-chip--compact .ds-badge__text {\r\n  white-space: normal;\r\n  overflow: visible;\r\n  text-overflow: clip;\r\n}\r\n.vitals-summary {\r\n  display: grid;\r\n  gap: 12px;\r\n}\r\n.vitals-summary__head {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  gap: 12px;\r\n  flex-wrap: wrap;\r\n}\r\n.vitals-summary__head h2 {\r\n  margin: 0;\r\n  font: 600 16px/24px var(--font-ui);\r\n}\r\n.vitals-summary__actions {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n}\r\n.vitals-summary__status {\r\n  margin: 0;\r\n  font-size: 13px;\r\n  line-height: 1.5;\r\n  color: var(--text-muted);\r\n}\r\n.vitals-summary__status--crit {\r\n  color: #b42335;\r\n}\r\n.vitals-summary__status--warn {\r\n  color: #8f5500;\r\n}\r\n.vitals-dialog {\r\n  padding: 24px;\r\n  width: min(900px, calc(100vw - 32px));\r\n  display: grid;\r\n  gap: 20px;\r\n  overflow-y: auto;\r\n}\r\n.vitals--expanded {\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n}\r\n.vitals--expanded .vt {\r\n  padding: 20px;\r\n}\r\n.vitals--expanded .vt__value {\r\n  font-size: 28px;\r\n  line-height: 36px;\r\n}\r\n@media (max-width: 560px) {\r\n  .vitals--expanded {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n  .vitals-dialog {\r\n    padding: 16px;\r\n  }\r\n}\r\n"],["STYLE",{},".plist-regime-controls {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 12px 20px;\r\n  padding: 12px 16px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n.plist-regime-field {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  font-weight: 600;\r\n  font-size: 13px;\r\n  flex: 0 1 220px;\r\n  min-width: 0;\r\n}\r\n.plist-regime-field .form-input { width: 100%; }\r\n.plist-regime-summary {\r\n  flex: 1 1 280px;\r\n  min-width: 0;\r\n  align-self: center;\r\n  color: var(--text-muted);\r\n  font-size: 13px;\r\n  overflow-wrap: anywhere;\r\n}\r\n.plist-regime-summary p { margin: 3px 0; }\r\n@media (max-width: 680px) {\r\n  .plist-regime-field, .plist-regime-summary { flex-basis: 100%; }\r\n}\r\n"],["STYLE",{},".roster-order {\r\n  margin-block: 12px;\r\n  padding: 12px 16px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: var(--surface);\r\n}\r\n.roster-order__controls {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: end;\r\n  gap: 10px;\r\n}\r\n.roster-order label {\r\n  display: grid;\r\n  gap: 4px;\r\n  font-size: 12px;\r\n}\r\n.roster-order select,\r\n.roster-order button {\r\n  min-height: 44px;\r\n}\r\n.roster-order button {\r\n  white-space: normal;\r\n}\r\n.roster-order button:focus-visible,\r\n.roster-order select:focus-visible {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 2px;\r\n}\r\n.roster-order__status {\r\n  margin: 8px 0 0;\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n}\r\n.roster-order__error {\r\n  margin-top: 8px;\r\n  color: var(--red);\r\n  font-size: 13px;\r\n}\r\n.roster-defaults {\r\n  margin-bottom: 16px;\r\n}\r\n.roster-defaults summary {\r\n  cursor: pointer;\r\n  min-height: 44px;\r\n  padding-block: 12px;\r\n}\r\n.roster-defaults__row {\r\n  border-top: 1px solid var(--border);\r\n  padding-block: 12px;\r\n}\r\n.roster-defaults__row h4 {\r\n  margin: 0 0 8px;\r\n  overflow-wrap: anywhere;\r\n}\r\n@media (max-width: 520px) {\r\n  .roster-order__controls > label {\r\n    flex: 1 1 140px;\r\n  }\r\n  .roster-order {\r\n    padding: 10px;\r\n  }\r\n}\r\n"],["STYLE",{},".patient-roster-wrap {\r\n  overflow: hidden;\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--operational-table-radius);\r\n  box-shadow: var(--shadow-card);\r\n}\r\n\r\n.patient-roster-status {\r\n  margin-bottom: 10px;\r\n  padding: 9px 12px;\r\n  color: var(--blue);\r\n  font-size: 12px;\r\n  font-weight: 650;\r\n  background: var(--indigo-bg);\r\n  border: 1px solid color-mix(in srgb, var(--blue) 22%, var(--border));\r\n  border-radius: 10px;\r\n}\r\n\r\n.patient-roster-status--warning {\r\n  color: var(--amber-dark, #8a5700);\r\n  background: var(--amber-bg);\r\n  border-color: color-mix(in srgb, var(--amber) 35%, var(--border));\r\n}\r\n\r\n.patient-roster {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n  table-layout: fixed;\r\n}\r\n\r\n.patient-roster > caption.sr-only {\r\n  position: absolute;\r\n  width: 1px;\r\n  height: 1px;\r\n  padding: 0;\r\n  margin: -1px;\r\n  overflow: hidden;\r\n  clip: rect(0, 0, 0, 0);\r\n  white-space: nowrap;\r\n  border: 0;\r\n}\r\n\r\n.patient-roster th {\r\n  height: var(--operational-table-header-h);\r\n  padding: 0 var(--operational-table-cell-px);\r\n  color: var(--text-muted);\r\n  background: var(--surface-raised);\r\n  border-bottom: 1px solid var(--border);\r\n  font-size: var(--operational-table-header-fs);\r\n  font-weight: 750;\r\n  letter-spacing: 0.35px;\r\n  text-align: left;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.patient-roster th:nth-child(1) {\r\n  width: 25%;\r\n}\r\n\r\n/* intestazione ordinabile: ds-sort canonico (design-system.css) */\r\n.patient-roster-order {\r\n  margin-bottom: 10px;\r\n}\r\n.patient-roster-order__status {\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n}\r\n.patient-roster-order__mobile {\r\n  display: none;\r\n}\r\n\r\n.patient-roster th:nth-child(2) {\r\n  width: 19%;\r\n}\r\n\r\n.patient-roster th:nth-child(3) {\r\n  width: 15%;\r\n}\r\n\r\n.patient-roster th:nth-child(4) {\r\n  width: auto;\r\n}\r\n\r\n.patient-roster th:nth-child(5) {\r\n  width: 116px;\r\n}\r\n\r\n.patient-roster td {\r\n  min-height: var(--operational-table-row-min-h);\r\n  padding: 12px var(--operational-table-cell-px);\r\n  border-bottom: 1px solid var(--divider);\r\n  vertical-align: middle;\r\n}\r\n\r\n.patient-roster tbody tr:last-child td {\r\n  border-bottom: 0;\r\n}\r\n\r\n.patient-roster tbody tr {\r\n  cursor: pointer;\r\n  transition: background 0.14s ease;\r\n}\r\n\r\n.patient-roster tbody tr:hover {\r\n  background: color-mix(in srgb, var(--blue) 4%, var(--surface));\r\n}\r\n\r\n.patient-roster tbody tr:focus-visible {\r\n  background: color-mix(in srgb, var(--blue) 8%, var(--surface));\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: -2px;\r\n}\r\n\r\n.patient-roster tbody tr:active {\r\n  background: color-mix(in srgb, var(--blue) 11%, var(--surface));\r\n}\r\n\r\n.patient-roster tbody tr:has(.patient-roster__empty) {\r\n  cursor: default;\r\n}\r\n\r\n.patient-roster__identity {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 11px;\r\n  width: 100%;\r\n  min-height: 44px;\r\n  padding: 0;\r\n  color: var(--text);\r\n  font: inherit;\r\n  text-align: left;\r\n  background: transparent;\r\n  border: 0;\r\n}\r\n\r\n.patient-roster__identity > span:last-child {\r\n  min-width: 0;\r\n}\r\n\r\n.patient-roster__identity strong,\r\n.patient-roster__identity small {\r\n  display: block;\r\n}\r\n\r\n.patient-roster__identity strong {\r\n  font-size: 14px;\r\n  font-weight: 750;\r\n  overflow-wrap: anywhere;\r\n  white-space: normal;\r\n}\r\n\r\n.patient-roster__identity small {\r\n  margin-top: 4px;\r\n  color: var(--text-muted);\r\n  font-size: 11.5px;\r\n  font-weight: 500;\r\n  white-space: nowrap;\r\n}\r\n\r\n.patient-roster__avatar,\r\n.patient-card__avatar {\r\n  display: inline-flex;\r\n  flex: 0 0 40px;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 40px;\r\n  height: 40px;\r\n  color: var(--blue);\r\n  font-size: 13px;\r\n  font-weight: 800;\r\n  background: var(--indigo-bg);\r\n  border-radius: 11px;\r\n}\r\n\r\n.patient-fiscal-code {\r\n  display: inline-block;\r\n  max-width: 100%;\r\n  color: var(--text);\r\n  font-family: var(--font-mono);\r\n  font-size: 12px;\r\n  font-weight: 650;\r\n  letter-spacing: 0.25px;\r\n  white-space: nowrap;\r\n}\r\n\r\n.patient-fiscal-code--missing {\r\n  color: var(--amber-dark, #8a5700);\r\n  font-family: var(--font-ui);\r\n  font-size: 11.5px;\r\n  font-weight: 650;\r\n  white-space: normal;\r\n}\r\n\r\n.patient-signals {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 5px;\r\n  align-items: center;\r\n}\r\n\r\n.patient-signals .alert-chip,\r\n.patient-signals .indicatore-anomalie,\r\n.patient-signal {\r\n  min-height: 24px;\r\n  padding: 3px 8px;\r\n  font-size: 10.5px;\r\n  line-height: 1.15;\r\n}\r\n\r\n.patient-signal {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  color: var(--blue);\r\n  font-weight: 750;\r\n  background: var(--indigo-bg);\r\n  border-radius: 999px;\r\n}\r\n\r\n.patient-signal--warning {\r\n  color: var(--amber-dark, #8a5700);\r\n  background: var(--amber-bg);\r\n}\r\n\r\n.patient-signals__empty {\r\n  color: var(--text-muted);\r\n  font-size: 11.5px;\r\n}\r\n\r\n.patient-roster__action-heading,\r\n.patient-roster__actions {\r\n  text-align: right !important;\r\n}\r\n\r\n.patient-roster__actions {\r\n  padding-inline: 8px !important;\r\n  white-space: nowrap;\r\n}\r\n\r\n/* apri/elimina: ds-icon-btn canonici (design-system.css) */\r\n\r\n.patient-roster__empty {\r\n  height: 88px;\r\n  color: var(--text-muted);\r\n  text-align: center;\r\n}\r\n\r\n.patient-card-grid {\r\n  display: none;\r\n}\r\n\r\n@media (max-width: 1023px) {\r\n  .patient-list-view .toolbar .filter-chips {\r\n    max-width: 100%;\r\n  }\r\n\r\n  .patient-list-view .toolbar .search-wrap {\r\n    flex-basis: 100%;\r\n    max-width: none;\r\n  }\r\n\r\n  .patient-roster-order__mobile {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    gap: 8px;\r\n    align-items: center;\r\n    margin-bottom: 8px;\r\n  }\r\n\r\n  .patient-roster-order__mobile label {\r\n    font-size: 12px;\r\n    color: var(--text-muted);\r\n  }\r\n  .patient-roster-order__mobile select {\r\n    flex: 1;\r\n    min-width: 125px;\r\n    width: auto;\r\n    min-height: 44px;\r\n  }\r\n  .patient-roster-order__mobile button {\r\n    min-height: 44px;\r\n  }\r\n\r\n  .patient-roster-wrap {\r\n    display: none;\r\n  }\r\n\r\n  .patient-card-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n    gap: 10px;\r\n  }\r\n\r\n  .patient-card-grid__state {\r\n    grid-column: 1 / -1;\r\n    min-height: 88px;\r\n    padding: 32px 20px;\r\n    color: var(--text-muted);\r\n    text-align: center;\r\n    background: var(--surface);\r\n    border: 1px solid var(--border);\r\n    border-radius: 12px;\r\n    box-shadow: var(--shadow-card);\r\n  }\r\n\r\n  .patient-card {\r\n    min-width: 0;\r\n    padding: 14px;\r\n    background: var(--surface);\r\n    border: 1px solid var(--border);\r\n    border-radius: 12px;\r\n    box-shadow: var(--shadow-card);\r\n  }\r\n\r\n  .patient-card__head {\r\n    display: grid;\r\n    grid-template-columns: 40px minmax(0, 1fr) auto;\r\n    gap: 10px;\r\n    align-items: center;\r\n  }\r\n\r\n  .patient-card__identity {\r\n    min-width: 0;\r\n  }\r\n\r\n  .patient-card__identity strong,\r\n  .patient-card__identity span {\r\n    display: block;\r\n  }\r\n\r\n  .patient-card__identity strong {\r\n    color: var(--text);\r\n    font-size: 14px;\r\n    overflow-wrap: anywhere;\r\n    white-space: normal;\r\n  }\r\n\r\n  .patient-card__identity span {\r\n    margin-top: 3px;\r\n    color: var(--text-muted);\r\n    font-size: 11px;\r\n  }\r\n\r\n  .patient-card__fiscal {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    align-items: baseline;\r\n    justify-content: space-between;\r\n    gap: 5px 12px;\r\n    margin-top: 13px;\r\n    padding: 10px 0;\r\n    border-block: 1px solid var(--divider);\r\n  }\r\n\r\n  .patient-card__fiscal > span:first-child {\r\n    color: var(--text-muted);\r\n    font-size: 11px;\r\n    font-weight: 650;\r\n  }\r\n\r\n  .patient-card__context {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    gap: 8px;\r\n    align-items: center;\r\n    margin-top: 11px;\r\n  }\r\n\r\n  .patient-card__delete {\r\n    margin-top: 9px;\r\n  }\r\n}\r\n\r\n@media (max-width: 680px) {\r\n  .patient-card-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n\r\n/* ═══ HMI 1 · lista pazienti come il prototipo ═════════════════════════════\r\n   Card bianche raggio 16 padding 24; controlli 48 (bordo 2, raggio 12); righe ≥ 72 con il\r\n   riquadro 48 della camera; intestazioni in didascalia grigia 14/500, non maiuscole. */\r\n.patient-list-view {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 24px;\r\n}\r\n.plist-card {\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 16px;\r\n  padding: 24px;\r\n  min-width: 0;\r\n}\r\n.plist-new {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n  flex-wrap: wrap;\r\n}\r\n.plist-new__ico {\r\n  width: 48px;\r\n  height: 48px;\r\n  flex: none;\r\n  border-radius: 12px;\r\n  background: var(--blue);\r\n  color: #fff;\r\n  display: grid;\r\n  place-items: center;\r\n}\r\n.plist-new__ico svg {\r\n  width: 24px;\r\n  height: 24px;\r\n  fill: none;\r\n  stroke: currentColor;\r\n  stroke-width: 2;\r\n  stroke-linecap: round;\r\n  stroke-linejoin: round;\r\n}\r\n.plist-new__text {\r\n  flex: 1 1 280px;\r\n  min-width: 0;\r\n}\r\n.plist-new__text h2 {\r\n  margin: 0;\r\n  font: 600 20px/28px var(--font-ui);\r\n  color: var(--text);\r\n}\r\n.plist-new__text p {\r\n  margin: 0;\r\n  font: 500 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n.plist-new__actions {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.plist-new .ai-import-btn {\r\n  height: 48px;\r\n  border-radius: 12px;\r\n  font: 600 16px/24px var(--font-ui);\r\n}\r\n\r\n.plist-list {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n}\r\n.plist-toolbar {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 16px;\r\n}\r\n.plist-search {\r\n  flex: 1 1 280px;\r\n  min-width: 0;\r\n  max-width: none;\r\n}\r\n.plist-search .search-input {\r\n  height: 48px;\r\n  border-radius: 12px;\r\n  border: 2px solid #b9c4d4;\r\n  background: #f5f7fb;\r\n  font: 400 16px/24px var(--font-ui);\r\n}\r\n.plist-search .search-input:focus {\r\n  border-color: var(--blue);\r\n  box-shadow: 0 0 0 3px #eaf1fe;\r\n  outline: none;\r\n}\r\n.plist-views {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n\r\n.plist-filters {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  padding: 16px;\r\n  border-radius: 12px;\r\n  background: #f5f7fb;\r\n}\r\n\r\n/* tabella senza cornice propria: vive dentro la card */\r\n.plist-list .patient-roster-wrap {\r\n  border: 0;\r\n  border-radius: 0;\r\n  box-shadow: none;\r\n}\r\n.plist-list .patient-roster th {\r\n  height: 40px;\r\n  padding: 0 16px;\r\n  background: transparent;\r\n  font: 500 14px/20px var(--font-ui);\r\n  letter-spacing: 0;\r\n  text-transform: none;\r\n  color: var(--text-muted);\r\n}\r\n.plist-list .patient-roster th:nth-child(1) {\r\n  width: 36%;\r\n}\r\n.plist-list .patient-roster th:nth-child(2) {\r\n  width: 15%;\r\n}\r\n.plist-list .patient-roster th:nth-child(3) {\r\n  width: 15%;\r\n}\r\n.plist-list .patient-roster td {\r\n  height: 72px;\r\n  padding: 8px 16px;\r\n  border-bottom: 0;\r\n  border-top: 1px solid var(--border);\r\n}\r\n.patient-roster__bed {\r\n  width: 48px;\r\n  height: 48px;\r\n  flex: none;\r\n  border-radius: 12px;\r\n  background: #f5f7fb;\r\n  border: 1px solid var(--border);\r\n  display: grid;\r\n  place-items: center;\r\n  font: 600 18px/24px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--text);\r\n}\r\n.patient-roster__who {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n}\r\n.patient-roster__who .patient-identity__name {\r\n  font: 600 16px/24px var(--font-ui);\r\n}\r\n.patient-roster__meta {\r\n  font: 500 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.patient-roster__meta .patient-identity__identifier {\r\n  font: inherit;\r\n  color: inherit;\r\n}\r\n/* la camera è nel riquadro e il letto accanto all'età: la riga \"Camera · Letto\" non si ripete */\r\n/* la riga \"Camera · Letto\" non si ripete; la provenienza e la data del posto letto restano */\r\n.plist-list .patient-roster__who .patient-identity__location {\r\n  display: none;\r\n}\r\n.plist-list .patient-roster__who .patient-identity__context {\r\n  font: 500 12px/16px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n.plist-sr {\r\n  position: absolute;\r\n  width: 1px;\r\n  height: 1px;\r\n  margin: -1px;\r\n  overflow: hidden;\r\n  clip: rect(0, 0, 0, 0);\r\n  white-space: nowrap;\r\n}\r\n/* ricovero e segnalazioni come i badge del prototipo: 32 px, raggio 8, 14/500 */\r\n.plist-list .stato-pill,\r\n.plist-list .patient-signal,\r\n.plist-list .patient-signals .alert-chip,\r\n.plist-list .patient-signals .indicatore-anomalie {\r\n  height: 32px;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  padding: 0 8px;\r\n  border-radius: 8px;\r\n  border: 0;\r\n  font: 500 14px/20px var(--font-ui);\r\n  letter-spacing: 0;\r\n  text-transform: none;\r\n  white-space: nowrap;\r\n}\r\n.plist-list .patient-roster th:nth-child(1) {\r\n  width: 40%;\r\n}\r\n.patient-roster__meta {\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n/* Con \"Filtri e ordine\" aperto il selettore dell'ordinamento è visibile a tutte le larghezze:\r\n   permette di ordinare anche per le colonne che non hanno un'intestazione (codice fiscale). */\r\n.plist-list:has(.plist-filters) .patient-roster-order__mobile {\r\n  display: flex;\r\n  gap: 8px;\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n/* colonne: più spazio alle segnalazioni, così i badge stanno su una riga e la riga resta bassa */\r\n.plist-list .patient-roster th:nth-child(1) {\r\n  width: 32%;\r\n}\r\n.plist-list .patient-roster th:nth-child(2) {\r\n  width: 13%;\r\n}\r\n/* NEWS2: il badge con punteggio e ora (\"NEWS2 10 · 19:29\") sta nella colonna */\r\n.plist-list .patient-roster th:nth-child(3) {\r\n  width: 17%;\r\n}\r\n/* azioni: un pulsante icona da 48px, due se l'eliminazione di test è attiva */\r\n.plist-list .patient-roster th:nth-child(5) {\r\n  width: 80px;\r\n}\r\n.plist-list .patient-roster:has(.patient-roster__delete) th:nth-child(5) {\r\n  width: 136px;\r\n}\r\n.plist-list .patient-signals {\r\n  flex-wrap: wrap;\r\n  gap: 4px;\r\n}\r\n.plist-search {\r\n  flex: 2 1 400px;\r\n}\r\n.plist-note {\r\n  margin: 0;\r\n  font: 500 14px/20px var(--font-ui);\r\n  color: #8f5500;\r\n}\r\n\r\n/* ricerca e viste sulla stessa riga, come il prototipo */\r\n.plist-search {\r\n  flex: 1 1 320px;\r\n}\r\n.plist-list .patient-roster__meta {\r\n  display: block;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n/* Direct access: ogni segnalazione della riga è un link alla parte della cartella che la spiega. */\r\n.patient-signal-link {\r\n  border: 0;\r\n  font-family: inherit;\r\n  cursor: pointer;\r\n  white-space: normal;\r\n  text-align: left;\r\n}\r\n.patient-signal-link:hover,\r\n.patient-signal-link:focus-visible {\r\n  text-decoration: underline;\r\n  text-underline-offset: 2px;\r\n}\r\n.patient-signal-link:focus-visible {\r\n  outline: 3px solid var(--blue);\r\n  outline-offset: 2px;\r\n}\r\n.patient-signals .indicatore-anomalie.patient-signal--anomalie {\r\n  white-space: normal;\r\n  border-style: solid;\r\n}\r\n.plist-list .patient-signals .patient-signal--anomalie {\r\n  height: auto;\r\n  min-height: 32px;\r\n}\r\n"]],[[3,30]],["BODY",{},[[3,31]],["DIV",{"id":"root"},["DIV",{"class":"login-screen"},["DIV",{"class":"login-box"},[[3,38]],[[2,1]],["SECTION",{"class":"login-sim","aria-labelledby":"login-sim-title"},[[2,6]],["UL",{"class":"login-sim__list"},["LI",{},["BUTTON",{"__playwright_target__":"","type":"button","class":"login-sim__item","disabled":""},[[1,1]],[[1,6]]]]]],["P",{"class":"login-note"},"Verifica accesso…"]]]],[[3,65]],[[3,66]]]],"viewport":{"width":1150,"height":1004},"timestamp":64392.379,"wallTime":1792890301570,"collectionTime":1,"resourceOverrides":[],"isMainFrame":true}}
