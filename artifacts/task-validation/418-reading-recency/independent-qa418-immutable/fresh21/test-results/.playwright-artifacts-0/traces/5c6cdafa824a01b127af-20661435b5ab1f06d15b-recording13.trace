  background: #fff;\r\n}\r\n.clinical-note-editor__options {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));\r\n  gap: 14px;\r\n}\r\n.clinical-note-editor__options > div {\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n.clinical-note-editor__content {\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n.clinical-note-editor__options select {\r\n  width: 100%;\r\n  min-width: 0;\r\n}\r\n.diario-history-filters {\r\n  display: flex;\r\n  align-items: end;\r\n  flex-wrap: wrap;\r\n  gap: 10px;\r\n  margin-bottom: 10px;\r\n}\r\n.diario-history-filters label {\r\n  display: grid;\r\n  gap: 4px;\r\n  font-size: 0.85rem;\r\n}\r\n.diario-history-filters input {\r\n  max-width: 170px;\r\n}\r\n.am-support-note {\r\n  margin: 0;\r\n  padding: 8px 20px;\r\n  font-size: 0.8rem;\r\n  background: var(--info-light, #edf3ff);\r\n  color: var(--text-secondary);\r\n}\r\n"],["STYLE",{},".handover-workspace {\r\n  min-width: 0;\r\n}\r\n.handover-workspace :is(button, input, select) {\r\n  min-height: var(--ds-control-h);\r\n}\r\n.handover-workspace :is(button, input, select, textarea, a):focus-visible {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 3px;\r\n}\r\n.handover-rounds__layout {\r\n  display: grid;\r\n  grid-template-columns: 272px minmax(0, 1fr);\r\n  gap: 24px;\r\n  align-items: start;\r\n}\r\n.handover-rounds__list,\r\n.handover-rounds__filters {\r\n  display: grid;\r\n  gap: 12px;\r\n  min-width: 0;\r\n}\r\n.handover-rounds__filters label {\r\n  display: grid;\r\n  gap: 5px;\r\n  min-width: 0;\r\n}\r\n.handover-rounds__filters input {\r\n  width: 100%;\r\n  min-width: 0;\r\n  font-size: 14px;\r\n  background: #fff;\r\n}\r\n.handover-rounds__list > .ds-link {\r\n  justify-self: start;\r\n}\r\n.ho-eyebrow {\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.06em;\r\n  color: var(--text-muted);\r\n  text-transform: uppercase;\r\n}\r\n.ho-label {\r\n  font-size: 13px;\r\n  color: var(--text-secondary);\r\n}\r\n.handover-rounds__roster {\r\n  display: grid;\r\n  gap: 5px;\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 0;\r\n  min-width: 0;\r\n}\r\n.handover-rounds__patient {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) auto;\r\n  align-items: center;\r\n  min-width: 0;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  background: var(--surface, #fff);\r\n  overflow-wrap: anywhere;\r\n}\r\n.handover-rounds__patient.is-selected {\r\n  border-color: var(--blue);\r\n  background: #edf3ff;\r\n  box-shadow: inset 3px 0 var(--blue);\r\n}\r\n.handover-rounds__select {\r\n  display: flex;\r\n  gap: 6px;\r\n  width: 100%;\r\n  min-width: 0;\r\n  text-align: left;\r\n  border: 0;\r\n  border-radius: 8px;\r\n  background: transparent;\r\n  padding: 6px;\r\n  cursor: pointer;\r\n  color: inherit;\r\n}\r\n.ho-bed {\r\n  display: grid;\r\n  place-items: center;\r\n  flex: 0 0 28px;\r\n  height: 28px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 7px;\r\n  background: #f5f8fc;\r\n  font-size: 13px;\r\n}\r\n.ho-who {\r\n  flex: 1;\r\n  min-width: 0;\r\n}\r\n.handover-rounds__patient .patient-identity {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1px;\r\n  min-width: 0;\r\n}\r\n.handover-rounds__patient .patient-identity__name {\r\n  font-size: 13px;\r\n  line-height: 18px;\r\n  white-space: normal;\r\n  overflow-wrap: anywhere;\r\n}\r\n.handover-rounds__patient\r\n  :is(.patient-identity__identifier, .patient-identity__location, .patient-identity__context) {\r\n  font-size: 11px;\r\n  line-height: 1.4;\r\n}\r\n.handover-rounds__patient > .handover-rounds__diary:not(#ds) {\r\n  --ds-icon-size: 16px;\r\n  display: inline-flex;\r\n  justify-content: center;\r\n  margin: 0 8px 0 0;\r\n  padding: 0;\r\n  align-items: center;\r\n  width: 32px;\r\n  min-width: 32px;\r\n  height: 32px;\r\n  min-height: 32px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 7px;\r\n  color: var(--blue);\r\n  background: var(--surface, #fff);\r\n  text-decoration: none;\r\n}\r\n.handover-rounds__diary svg {\r\n  width: 16px;\r\n  height: 16px;\r\n}\r\n@media (pointer: coarse) {\r\n  .handover-rounds__patient > .handover-rounds__diary:not(#ds) {\r\n    width: 40px;\r\n    min-width: 40px;\r\n    height: 40px;\r\n    min-height: 40px;\r\n  }\r\n}\r\n.handover-rounds__badges {\r\n  display: flex;\r\n  gap: 6px;\r\n  flex-wrap: wrap;\r\n  font-size: 11px;\r\n  margin-top: 5px;\r\n}\r\n.handover-rounds__badges:empty {\r\n  display: none;\r\n}\r\n.handover-rounds__badges > span,\r\n.handover-rounds__draft-chip {\r\n  background: #fff1d9;\r\n  color: #815105;\r\n  border-radius: 6px;\r\n  padding: 2px 6px;\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n}\r\n.handover-rounds__detail {\r\n  min-width: 0;\r\n}\r\n.handover-rounds__patient-heading {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  background: #fff;\r\n  border: 1px solid var(--border);\r\n  border-radius: 14px 14px 0 0;\r\n  padding: 18px 20px;\r\n}\r\n.handover-rounds__patient-heading .patient-identity {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  min-width: 0;\r\n}\r\n.handover-rounds__patient-heading .patient-identity .patient-identity__name {\r\n  font-size: 20px;\r\n  line-height: 1.35;\r\n  overflow-wrap: anywhere;\r\n}\r\n.handover-rounds__patient-heading :is(.patient-identity__identifier, .patient-identity__location) {\r\n  font-size: 12px;\r\n}\r\n.handover-rounds__patient-heading > a:not(#ds) {\r\n  flex: 0 0 auto;\r\n  font-size: 13px;\r\n}\r\n.handover-rounds__tabs {\r\n  display: flex;\r\n  gap: 8px;\r\n  padding: 0 16px;\r\n  margin-bottom: 18px;\r\n  border: 1px solid var(--border);\r\n  border-top: 0;\r\n  border-radius: 0 0 14px 14px;\r\n  background: #fff;\r\n}\r\n.handover-rounds__tabs button {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding: 12px 8px;\r\n  border: 0;\r\n  border-bottom: 3px solid transparent;\r\n  border-radius: 0;\r\n  background: transparent;\r\n  color: var(--text-secondary);\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n}\r\n.handover-rounds__tabs button[aria-selected='true'] {\r\n  color: var(--blue);\r\n  border-bottom-color: var(--blue);\r\n}\r\n.handover-rounds__history > .cr-tab-content {\r\n  padding: 0;\r\n  overflow: visible;\r\n}\r\n.handover-rounds__history .cts {\r\n  margin: 0;\r\n  box-shadow: none;\r\n}\r\n.handover-rounds__history .cts__header {\r\n  padding: 12px 16px;\r\n  background: #fff;\r\n}\r\n.handover-rounds__history .cts__title {\r\n  font-size: 15px;\r\n  letter-spacing: 0;\r\n  text-transform: none;\r\n}\r\n.handover-rounds__history .cts__body {\r\n  padding: 16px;\r\n}\r\n.handover-rounds__history .diario-history-filters {\r\n  padding: 12px;\r\n  background: #f7f9fc;\r\n  border-radius: 10px;\r\n  gap: 10px;\r\n}\r\n.handover-rounds__history .diario-history-filters input {\r\n  background: #fff;\r\n  min-height: var(--ds-control-h);\r\n  font-size: var(--ds-field-font);\r\n}\r\n.handover-rounds__history .diario-history-filters button:not(#ds) {\r\n  min-height: var(--ds-control-h);\r\n  padding: 0 var(--ds-control-px);\r\n  font-size: var(--ds-control-font);\r\n}\r\n.handover-rounds__history .diario-cards {\r\n  gap: 12px;\r\n  margin-top: 14px;\r\n}\r\n.handover-rounds__history .diario-card {\r\n  background: #fff;\r\n  padding: 16px;\r\n  border-radius: 10px;\r\n  border-left-width: 3px;\r\n}\r\n.handover-rounds__history .diario-card__head {\r\n  gap: 6px;\r\n  flex-wrap: wrap;\r\n}\r\n.handover-rounds__history .diario-card__author {\r\n  margin: 10px 0 4px;\r\n  font-size: 12px;\r\n  font-weight: 500;\r\n}\r\n.handover-rounds__history .diario-card__title {\r\n  font-size: 15px;\r\n  margin-bottom: 6px;\r\n}\r\n.handover-rounds__history .diario-card__content {\r\n  color: var(--text, #17263b);\r\n  font-size: 14px;\r\n  line-height: 1.65;\r\n}\r\n.handover-rounds__history .diario-card__time {\r\n  font-size: 11px;\r\n}\r\n.handover-rounds__composer {\r\n  border: 1px solid var(--border);\r\n  border-radius: 14px;\r\n  background: #fff;\r\n  padding: 20px;\r\n}\r\n.ho-card-head {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n}\r\n.ho-card-head h3 {\r\n  margin: 0;\r\n  font-size: 18px;\r\n}\r\n.ho-cap {\r\n  font-size: 12px;\r\n  color: var(--text-secondary);\r\n}\r\n.handover-rounds__composer-identity {\r\n  padding-block: 12px;\r\n  border-bottom: 1px solid var(--border);\r\n  margin-bottom: 16px;\r\n  overflow-wrap: anywhere;\r\n}\r\n.handover-rounds__composer .clinical-note-editor select {\r\n  background: #fff;\r\n  font-size: 14px;\r\n}\r\n.handover-rounds__actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  justify-content: flex-end;\r\n  align-items: center;\r\n  gap: 10px;\r\n  margin-top: 20px;\r\n  padding-top: 16px;\r\n  border-top: 1px solid var(--border);\r\n}\r\n.handover-rounds__actions button:not(#ds) {\r\n  font-size: 14px;\r\n  padding: 10px 14px;\r\n}\r\n.handover-rounds__actions .link-btn {\r\n  margin-right: auto;\r\n}\r\n.handover-workspace__memory {\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n  margin-top: 16px;\r\n}\r\n.ho-sr {\r\n  position: absolute;\r\n  width: 1px;\r\n  height: 1px;\r\n  overflow: hidden;\r\n  clip: rect(0 0 0 0);\r\n  white-space: nowrap;\r\n}\r\n@media (min-width: 801px) {\r\n  .handover-rounds__list {\r\n    position: sticky;\r\n    top: 16px;\r\n  }\r\n  .handover-rounds__roster {\r\n    max-height: max(240px, calc(100dvh - 350px));\r\n    overflow-y: auto;\r\n    padding: 2px;\r\n    scrollbar-gutter: stable;\r\n  }\r\n}\r\n@media (max-width: 1023px) and (min-width: 801px) {\r\n  .handover-rounds__layout {\r\n    grid-template-columns: 240px minmax(0, 1fr);\r\n    gap: 16px;\r\n  }\r\n}\r\n@media (max-width: 800px) {\r\n  .handover-rounds__layout {\r\n    grid-template-columns: minmax(0, 1fr);\r\n    gap: 20px;\r\n  }\r\n  .handover-rounds__filters {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n  .handover-rounds__roster {\r\n    max-height: 230px;\r\n    overflow-y: auto;\r\n    padding: 2px;\r\n  }\r\n  .handover-rounds__patient-heading {\r\n    padding: 14px;\r\n  }\r\n  .handover-rounds__patient-heading .patient-identity .patient-identity__name {\r\n    font-size: 18px;\r\n  }\r\n  .handover-rounds__patient-heading > a:not(#ds) {\r\n    font-size: 12px;\r\n  }\r\n  .handover-rounds__composer {\r\n    padding: 16px;\r\n  }\r\n  .handover-rounds__history .cts__body,\r\n  .handover-rounds__history .diario-card {\r\n    padding: 12px;\r\n  }\r\n}\r\n@media (max-width: 440px) {\r\n  .handover-rounds__patient-heading {\r\n    align-items: flex-start;\r\n    flex-direction: column;\r\n  }\r\n  .handover-rounds__tabs {\r\n    padding-inline: 10px;\r\n    gap: 4px;\r\n  }\r\n  .handover-rounds__tabs button {\r\n    font-size: 13px;\r\n    gap: 5px;\r\n  }\r\n  .handover-rounds__history .diario-history-filters label {\r\n    flex: 1 1 110px;\r\n    min-width: 0;\r\n  }\r\n  .handover-rounds__history .diario-history-filters input {\r\n    width: 100%;\r\n    max-width: 100%;\r\n  }\r\n  .handover-rounds__actions {\r\n    gap: 8px;\r\n  }\r\n}\r\n"],["STYLE",{},".assessment-catalog { display: grid; gap: 18px; --ds-control-h: 44px; }\r\n/* Keep the catalog on the same left axis as the patient TopNav. */\r\n@media screen { .assessment-catalog { margin-inline: 24px; } }\r\n@media screen and (max-width: 900px) { .assessment-catalog { margin-inline: 16px; } }\r\n@media screen and (max-width: 600px) { .assessment-catalog { margin-inline: 12px; } }\r\n.assessment-catalog h2, .assessment-catalog h3, .assessment-catalog h4, .assessment-catalog p { margin: 0; }\r\n.assessment-catalog h3 { margin-bottom: 10px; }\r\n.assessment-catalog-list { display: grid; gap: 8px; }\r\n.assessment-catalog-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 12px; border: 1px solid var(--border-color, #d8e0e8); border-radius: 10px; background: var(--surface, #fff); }\r\n.assessment-catalog-row > div:first-child { min-width: 0; display: grid; gap: 5px; overflow-wrap: anywhere; }\r\n.assessment-catalog-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; max-width: 100%; }\r\n.assessment-catalog-purpose { color: var(--text-secondary, #526170); font-size: .9rem; }\r\n.assessment-catalog-action { white-space: normal; }\r\n.assessment-catalog-action:focus-visible { outline: 3px solid var(--primary, #2563eb); outline-offset: 3px; }\r\n.assessment-catalog-secondary { font-size: .85rem; color: var(--text-muted, #526170); }\r\n.patient-module-return { align-self: flex-start; width: fit-content; max-width: 100%; margin-bottom: 12px; }\r\n.nrs-legacy { display: grid; gap: 12px; }\r\n.nrs-legacy details { padding: 12px; border: 1px solid var(--border-color, #d8e0e8); border-radius: 8px; }\r\n.nrs-legacy summary { cursor: pointer; overflow-wrap: anywhere; }\r\n.nrs-legacy pre { white-space: pre-wrap; overflow-wrap: anywhere; font: inherit; }\r\n.nrs-legacy dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }\r\n.nrs-legacy dd { margin: 4px 0 0; overflow-wrap: anywhere; }\r\n.nrs-legacy-note { white-space: pre-wrap; overflow-wrap: anywhere; }\r\n.nrs-print-surface { display: none; }\r\n.assessment-catalog-icon { width:40px; height:40px; min-width:40px; min-height:40px; padding:0; display:grid; place-items:center; font-size:24px; }\r\n.assessment-draft-chip { padding:2px 8px; border-radius:20px; width:fit-content; background:var(--amber-bg,#fdf3e2); color:#8a5300; font-size:12px; }\r\n@media (max-width: 900px) { .assessment-catalog-row { align-items:flex-start; flex-direction:column; } .assessment-catalog-actions { display:flex; } }\r\n@media (max-width: 768px) {\r\n  .assessment-catalog > button, .assessment-catalog .assessment-catalog-actions button, .patient-module-return {\r\n    min-width: 44px;\r\n    min-height: 44px;\r\n    max-width: 100%;\r\n    white-space: normal;\r\n  }\r\n}\r\n@media print {\r\n  .nrs-legacy .no-print { display: none !important; }\r\n  body[data-nrs-print] > *:not(.nrs-print-surface) { display: none !important; }\r\n  body[data-nrs-print] > .nrs-print-surface { display: block !important; padding: 12mm; }\r\n  .nrs-legacy details { break-inside: avoid; }\r\n}\r\n"],["STYLE",{},"/* Navigazione condivisa (un solo componente). Nella cartella paziente è una barra unica di sezioni\r\n   (level2 + top-nav--section-grid, con etichette di gruppo); level3 resta per le sotto-navigazioni\r\n   interne di altre pagine (es. Terapia Farmacologica). */\r\n\r\n.top-nav {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  min-width: 0;\r\n  margin-inline: 24px;\r\n  box-sizing: border-box;\r\n  font-family: inherit;\r\n}\r\n\r\n.top-nav__context-label {\r\n  flex: 0 0 auto;\r\n  min-width: max-content;\r\n  padding-right: 14px;\r\n  border-right: 1px solid var(--border, #d8e0ea);\r\n  color: #52667d;\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  line-height: 1.2;\r\n  letter-spacing: 0.07em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.top-nav__items {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  min-width: 0;\r\n  overflow-x: auto;\r\n  overscroll-behavior-inline: contain;\r\n  scrollbar-width: thin;\r\n  scrollbar-color: #c2cedd transparent;\r\n}\r\n\r\n.top-nav__item {\r\n  position: relative;\r\n  display: inline-flex;\r\n  flex: 0 0 auto;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 7px;\r\n  min-height: 44px;\r\n  padding: 9px 14px;\r\n  border: 1px solid transparent;\r\n  border-radius: 8px;\r\n  color: #40546b;\r\n  background: transparent;\r\n  font: inherit;\r\n  font-size: 14px;\r\n  font-weight: 700;\r\n  white-space: nowrap;\r\n  cursor: pointer;\r\n  transition:\r\n    color 0.15s ease-out,\r\n    background 0.15s ease-out,\r\n    border-color 0.15s ease-out,\r\n    box-shadow 0.15s ease-out;\r\n}\r\n\r\n.top-nav__item:hover {\r\n  color: #17345f;\r\n  background: #edf3fb;\r\n  border-color: #d4dfed;\r\n}\r\n\r\n.top-nav__item:focus-visible {\r\n  outline: 3px solid rgba(47, 107, 237, 0.3);\r\n  outline-offset: 2px;\r\n  z-index: 1;\r\n}\r\n\r\n/* L2 — strong, stable primary tab rail. */\r\n.top-nav--level2 {\r\n  min-height: 58px;\r\n  margin-top: 12px;\r\n  padding: 7px 9px;\r\n  border: 1px solid #d8e0ea;\r\n  border-radius: 12px;\r\n  background: var(--surface, #fff);\r\n  box-shadow: 0 1px 3px rgba(16, 32, 54, 0.07);\r\n}\r\n\r\n.top-nav--level2 .top-nav__item.is-active {\r\n  color: #fff;\r\n  background: #1f5bd8;\r\n  border-color: #1f5bd8;\r\n  box-shadow: 0 2px 5px rgba(31, 91, 216, 0.25);\r\n}\r\n\r\n/* L3 — flat contextual navigation, visibly subordinate to L2. */\r\n.top-nav--level3 {\r\n  min-height: 50px;\r\n  margin-top: 6px;\r\n  padding-inline: 10px;\r\n  border-bottom: 1px solid #dbe3ed;\r\n  background: transparent;\r\n}\r\n\r\n.top-nav--level3 .top-nav__items {\r\n  gap: 15px;\r\n}\r\n\r\n.top-nav--level3 .top-nav__item {\r\n  min-height: 44px;\r\n  padding: 8px 2px 7px;\r\n  border: 0;\r\n  border-radius: 0;\r\n  color: #52667d;\r\n  background: transparent;\r\n  font-size: 13px;\r\n  font-weight: 650;\r\n}\r\n\r\n.top-nav--level3 .top-nav__item::after {\r\n  content: '';\r\n  position: absolute;\r\n  right: 0;\r\n  bottom: 0;\r\n  left: 0;\r\n  height: 3px;\r\n  border-radius: 999px 999px 0 0;\r\n  background: transparent;\r\n}\r\n\r\n.top-nav--level3 .top-nav__item:hover {\r\n  color: #174fae;\r\n  background: transparent;\r\n}\r\n\r\n.top-nav--level3 .top-nav__item.is-active {\r\n  color: #174fae;\r\n  font-weight: 800;\r\n}\r\n\r\n.top-nav--level3 .top-nav__item.is-active::after {\r\n  background: #2f6bed;\r\n}\r\n\r\n/* Patient-record section rail: content-sized tabs wrap without horizontal scrolling.\r\n   Keep destinations compact even when an area contains only a few short labels. */\r\n.top-nav--section-grid {\r\n  min-height: 52px;\r\n  margin-top: 8px;\r\n  padding: 6px 8px;\r\n  border: 1px solid #d8e0ea;\r\n  border-radius: 10px;\r\n  background: var(--surface, #fff);\r\n  box-shadow: 0 1px 2px rgba(16, 32, 54, 0.05);\r\n}\r\n\r\n.top-nav--section-grid .top-nav__items {\r\n  flex: 1 1 100%;\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: stretch;\r\n  gap: 4px 8px;\r\n  overflow: visible;\r\n  width: 100%;\r\n  padding: 0;\r\n}\r\n\r\n.top-nav--section-grid .top-nav__item {\r\n  width: auto;\r\n  max-width: 100%;\r\n  min-width: 0;\r\n  min-height: 44px;\r\n  padding: 8px 12px;\r\n  border-radius: 7px;\r\n  line-height: 1.25;\r\n  white-space: normal;\r\n  text-wrap: balance;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.top-nav--section-grid .top-nav__item:hover {\r\n  background: #f3f6fb;\r\n}\r\n\r\n.top-nav--section-grid .top-nav__item.is-active {\r\n  background: #eef4ff;\r\n}\r\n\r\n.top-nav--section-grid .top-nav__item::after {\r\n  right: 8px;\r\n  bottom: 2px;\r\n  left: 8px;\r\n}\r\n\r\n.top-nav__badge {\r\n  min-width: 20px;\r\n  padding: 2px 6px;\r\n  border-radius: 999px;\r\n  color: #285cae;\r\n  background: #e4edfb;\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  line-height: 1.35;\r\n  text-align: center;\r\n}\r\n\r\n.top-nav--level2 .top-nav__item.is-active .top-nav__badge {\r\n  /* Sfondo scuro: contrasto ≥ 4,5:1 anche per il testo piccolo del badge (WCAG AA). */\r\n  color: #fff;\r\n  background: #143f99;\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .top-nav {\r\n    align-items: stretch;\r\n    flex-direction: column;\r\n    gap: 5px;\r\n    margin-inline: 16px;\r\n  }\r\n\r\n  .top-nav__context-label {\r\n    padding: 1px 2px 5px;\r\n    border-right: 0;\r\n    border-bottom: 1px solid #d8e0ea;\r\n  }\r\n\r\n  .top-nav__items {\r\n    padding-bottom: 2px;\r\n  }\r\n\r\n  .top-nav--level2 {\r\n    padding: 7px;\r\n  }\r\n\r\n  .top-nav--level3 {\r\n    padding-inline: 4px;\r\n  }\r\n\r\n  .top-nav--section-grid {\r\n    flex-direction: row;\r\n    margin-inline: 16px;\r\n    padding: 6px;\r\n  }\r\n}\r\n\r\n@media (max-width: 600px) {\r\n  .top-nav {\r\n    margin-inline: 12px;\r\n  }\r\n\r\n  .top-nav--section-grid {\r\n    margin-inline: 12px;\r\n  }\r\n\r\n  .top-nav--level2 .top-nav__item,\r\n  .top-nav--level3 .top-nav__item {\r\n    font-size: 13px;\r\n  }\r\n}\r\n\r\n/* Etichette e separatori di gruppo nella barra a un livello della cartella: solo visivi. */\r\n.top-nav__group-label {\r\n  align-self: center;\r\n  padding: 0 2px 0 10px;\r\n  color: var(--text-muted, #5a6b80);\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  letter-spacing: 0.06em;\r\n  text-transform: uppercase;\r\n  white-space: nowrap;\r\n}\r\n.top-nav__group-label:first-child {\r\n  padding-left: 4px;\r\n}\r\n.top-nav__group-sep {\r\n  align-self: stretch;\r\n  width: 1px;\r\n  margin: 8px 4px;\r\n  background: var(--border, #e6ebf2);\r\n}\r\n\r\n/* Barra unica della cartella (primo livello + griglia): va a capo, allineata a sinistra, etichetta\r\n   sopra e pillola blu piena per la sezione attiva. Sul telefono una riga sola che scorre dentro la\r\n   barra, così la navigazione non spinge il contenuto fuori dallo schermo. */\r\n.top-nav--level2.top-nav--section-grid {\r\n  flex-wrap: wrap;\r\n  align-items: flex-start;\r\n  row-gap: 4px;\r\n}\r\n.top-nav--level2.top-nav--section-grid .top-nav__context-label {\r\n  /* Sul tablet ogni riga conta: le etichette di gruppo bastano a orientarsi. */\r\n  display: none;\r\n}\r\n.top-nav--level2.top-nav--section-grid .top-nav__item {\r\n  padding: 8px 8px;\r\n}\r\n.top-nav--level2.top-nav--section-grid .top-nav__group-sep {\r\n  margin: 8px 2px;\r\n}\r\n.top-nav--level2.top-nav--section-grid .top-nav__group-label {\r\n  padding-left: 6px;\r\n}\r\n.top-nav--level2.top-nav--section-grid .top-nav__items {\r\n  gap: 4px 4px;\r\n}\r\n.top-nav--level2.top-nav--section-grid .top-nav__items {\r\n  justify-content: flex-start;\r\n}\r\n.top-nav--level2.top-nav--section-grid .top-nav__item.is-active,\r\n.top-nav--level2.top-nav--section-grid .top-nav__item.is-active:hover {\r\n  color: #fff;\r\n  background: #1f5bd8;\r\n  border-color: #1f5bd8;\r\n}\r\n@media (max-width: 600px) {\r\n  .top-nav--level2.top-nav--section-grid .top-nav__items {\r\n    flex-wrap: nowrap;\r\n    overflow-x: auto;\r\n    scrollbar-width: thin;\r\n  }\r\n  .top-nav--level2.top-nav--section-grid .top-nav__item {\r\n    flex: 0 0 auto;\r\n    white-space: nowrap;\r\n  }\r\n}\r\n\r\n/* ── HMI 1: sezioni della cartella a chip (prototipo) ─────────────────────────\r\n   Chip 48 px, bordo 2 px, raggio 12; attiva = fondo azzurro, bordo blu, testo blu semibold.\r\n   Nessuna etichetta di contesto: le chip parlano da sole. */\r\n.top-nav--chips {\r\n  flex: 1 1 auto;\r\n  min-height: 0;\r\n  margin: 0;\r\n  padding: 0;\r\n  border: 0;\r\n  border-radius: 0;\r\n  background: transparent;\r\n  box-shadow: none;\r\n}\r\n.top-nav--chips .top-nav__context-label {\r\n  display: none;\r\n}\r\n.top-nav--chips .top-nav__items {\r\n  gap: 8px;\r\n  overflow-x: auto;\r\n  padding: 0;\r\n}\r\n.top-nav--chips .top-nav__item {\r\n  height: 48px;\r\n  min-height: 48px;\r\n  padding: 0 16px;\r\n  border: 2px solid var(--border, #e1e7f0);\r\n  border-radius: 12px;\r\n  background: var(--surface, #fff);\r\n  color: var(--text, #16202e);\r\n  font: 400 16px/24px var(--font-ui);\r\n  box-shadow: none;\r\n}\r\n.top-nav--chips .top-nav__item:hover {\r\n  background: var(--surface, #fff);\r\n  border-color: var(--blue, #2f6bed);\r\n  color: var(--text, #16202e);\r\n}\r\n.top-nav--chips .top-nav__item.is-active {\r\n  background: #eaf1fe;\r\n  border-color: var(--blue, #2f6bed);\r\n  color: #1d4fc4;\r\n  font-weight: 600;\r\n  box-shadow: none;\r\n}\r\n.top-nav--chips .top-nav__item.is-active .top-nav__badge {\r\n  color: #1d4fc4;\r\n  background: #fff;\r\n}\r\n.top-nav--chips .top-nav__item:focus-visible {\r\n  outline: 3px solid #245bb5;\r\n  outline-offset: 2px;\r\n}\r\n@media (max-width: 900px) {\r\n  .top-nav--chips {\r\n    flex-direction: row;\r\n    margin: 0;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Direct access: the item a navigation landed on (handover, diary entry, allergy table) is\r\n   outlined in medical blue for a few seconds, so the eye finds it without searching. */\r\n.chart-focus-item {\r\n  outline: 3px solid var(--blue, #2f6bed);\r\n  outline-offset: 3px;\r\n  border-radius: 10px;\r\n  box-shadow: 0 0 0 6px color-mix(in srgb, var(--blue, #2f6bed) 14%, transparent);\r\n  transition:\r\n    outline-color 0.4s ease,\r\n    box-shadow 0.4s ease;\r\n  scroll-margin: 96px;\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  .chart-focus-item {\r\n    transition: none;\r\n  }\r\n}\r\n"],["STYLE",{},".diagnosis-description {\r\n  min-width: 0;\r\n}\r\n\r\ntextarea.diagnosis-description__input {\r\n  width: 100%;\r\n  min-height: 200px;\r\n  line-height: 1.65;\r\n  resize: vertical;\r\n}\r\n\r\n.diagnosis-preview {\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--radius-sm);\r\n  background: var(--surface);\r\n  padding: 10px 12px;\r\n}\r\n\r\n.diagnosis-preview summary {\r\n  cursor: pointer;\r\n  color: var(--text);\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n}\r\n\r\n.diagnosis-preview[open] summary {\r\n  margin-bottom: 12px;\r\n}\r\n\r\n.diagnosis-text {\r\n  color: var(--text);\r\n  font-size: 14px;\r\n  font-weight: 400;\r\n  line-height: 1.65;\r\n  min-width: 0;\r\n  overflow-wrap: anywhere;\r\n  white-space: pre-wrap;\r\n}\r\n\r\n.diagnosis-text > * {\r\n  margin: 0 0 12px;\r\n}\r\n\r\n.diagnosis-text > :last-child {\r\n  margin-bottom: 0;\r\n}\r\n\r\n.diagnosis-text h4 {\r\n  color: var(--text);\r\n  font-size: 14px;\r\n  font-weight: 700;\r\n  line-height: inherit;\r\n}\r\n\r\n.diagnosis-text ul {\r\n  list-style: none;\r\n  padding-left: 8px;\r\n}\r\n\r\n.diagnosis-text li {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: 8px;\r\n  margin-bottom: 6px;\r\n}\r\n\r\n.diagnosis-text__marker {\r\n  flex-shrink: 0;\r\n}\r\n\r\n.diagnosis-notes {\r\n  border-top: 1px solid var(--border);\r\n  padding-top: 10px;\r\n  margin-top: 8px;\r\n}\r\n\r\n.diagnosis-notes > .form-label {\r\n  display: block;\r\n  margin-bottom: 6px;\r\n}\r\n\r\n.diagnosis-error {\r\n  margin: 0;\r\n  color: var(--text);\r\n  font-size: 13px;\r\n}\r\n\r\n@media (max-width: 480px) {\r\n  .diagnosis-item {\r\n    flex-direction: column;\r\n    align-items: stretch;\r\n  }\r\n\r\n  .diagnosis-item > .cr-item-row__actions {\r\n    order: -1;\r\n    align-self: flex-end;\r\n    padding-top: 0;\r\n  }\r\n}\r\n"],["STYLE",{},".parameter-entry-clock {\r\n  display: grid;\r\n  grid-template-columns: auto 1fr;\r\n  column-gap: 20px;\r\n  align-items: center;\r\n  margin: 0 0 20px;\r\n  padding: 18px 22px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 12px;\r\n  background: var(--surface);\r\n}\r\n.parameter-entry-clock > span {\r\n  color: var(--text-muted);\r\n  font-size: 14px;\r\n}\r\n.parameter-entry-clock time {\r\n  grid-row: 1 / 3;\r\n  grid-column: 1;\r\n  font-size: clamp(36px, 5vw, 54px);\r\n  font-weight: 750;\r\n  line-height: 1.1;\r\n  color: var(--blue);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.parameter-entry-clock > span:first-child {\r\n  grid-column: 2;\r\n  font-weight: 650;\r\n  color: var(--text);\r\n}\r\n.parameter-entry-patient {\r\n  border: 0;\r\n  background: transparent;\r\n  padding: 0;\r\n  text-align: left;\r\n  font: inherit;\r\n  min-height: 44px;\r\n  white-space: normal;\r\n}\r\n.parameter-entry-patient:focus-visible {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 3px;\r\n}\r\n.parameter-entry-patient__text {\r\n  display: grid;\r\n  min-width: 0;\r\n  gap: 3px;\r\n}\r\n.parameter-entry-last {\r\n  font-size: 11px;\r\n  color: var(--blue);\r\n}\r\n.parameter-entry-result {\r\n  grid-column: 1 / -1;\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 12px;\r\n  font-size: 13px;\r\n  color: var(--text);\r\n  padding: 6px 0;\r\n}\r\n.parameter-entry-row .qe-row__note-btn svg {\r\n  width: 15px;\r\n  height: 15px;\r\n}\r\n.parameter-entry-row .qe-row__note-btn {\r\n  gap: 5px;\r\n  padding-inline: 8px;\r\n}\r\n.parameter-note-count {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-width: 19px;\r\n  height: 19px;\r\n  padding-inline: 4px;\r\n  border-radius: 10px;\r\n  background: var(--blue);\r\n  color: #fff;\r\n  font-size: 11px;\r\n  font-weight: 700;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.parameter-note-count--draft {\r\n  background: var(--text-muted);\r\n}\r\n.parameter-note-summary {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  margin-bottom: 8px;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n}\r\n.parameter-note-label {\r\n  display: grid;\r\n  gap: 6px;\r\n  font-size: 13px;\r\n}\r\n.parameter-entry-help {\r\n  color: var(--text-muted);\r\n  font-size: 13px;\r\n  line-height: 1.5;\r\n  margin: 16px 0;\r\n}\r\n.parameter-entry-progress {\r\n  color: var(--text-muted);\r\n  font-size: 13px;\r\n}\r\n.parameter-history {\r\n  min-width: 0;\r\n}\r\n.parameter-history-toolbar {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 12px;\r\n  align-items: end;\r\n  margin: 20px 0;\r\n}\r\n.parameter-history-toolbar > div {\r\n  flex: 1 1 240px;\r\n}\r\n.parameter-history-toolbar h3 {\r\n  margin: 0 0 6px;\r\n  font-size: 17px;\r\n}\r\n.parameter-history-toolbar p {\r\n  margin: 0;\r\n  color: var(--text-muted);\r\n  font-size: 13px;\r\n}\r\n.parameter-history-toolbar label {\r\n  display: grid;\r\n  gap: 5px;\r\n  font-size: 12px;\r\n}\r\n.parameter-history-error {\r\n  color: var(--red);\r\n  padding: 12px;\r\n  background: var(--surface);\r\n}\r\n.parameter-history-list {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 0;\r\n}\r\n.parameter-history-day {\r\n  font-size: 14px;\r\n  margin: 22px 0 10px;\r\n  color: var(--text-muted);\r\n}\r\n.parameter-history-reading {\r\n  display: grid;\r\n  grid-template-columns: 135px minmax(0, 1fr);\r\n  gap: 14px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  padding: 16px;\r\n  margin-bottom: 10px;\r\n  background: var(--surface);\r\n}\r\n.parameter-history-stamp {\r\n  display: grid;\r\n  align-content: start;\r\n  gap: 5px;\r\n  overflow-wrap: anywhere;\r\n}\r\n.parameter-history-stamp time {\r\n  font-size: 24px;\r\n  color: var(--blue);\r\n  font-weight: 750;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.parameter-history-stamp span {\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n}\r\n.parameter-history-reading dl {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 14px 24px;\r\n  margin: 0;\r\n}\r\n.parameter-history-reading dt {\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n  margin-bottom: 5px;\r\n}\r\n.parameter-history-reading dd {\r\n  margin: 0;\r\n  font-size: 17px;\r\n  font-weight: 650;\r\n  overflow-wrap: anywhere;\r\n}\r\n.parameter-history-reading dd small {\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n  font-weight: 400;\r\n}\r\n.parameter-history-note {\r\n  grid-column: 1 / -1;\r\n  margin: 0;\r\n  border-top: 1px solid var(--border);\r\n  padding-top: 12px;\r\n  white-space: pre-wrap;\r\n  overflow-wrap: anywhere;\r\n  font-size: 14px;\r\n}\r\n.parameter-month-scroll {\r\n  max-width: 100%;\r\n  overflow-x: auto;\r\n  margin-top: 16px;\r\n}\r\n.parameter-month-table {\r\n  min-width: 660px;\r\n}\r\n.parameter-month-table caption {\r\n  text-align: left;\r\n  color: var(--text-muted);\r\n  font-size: 13px;\r\n  padding: 0 0 12px;\r\n}\r\n.parameter-month-table th,\r\n.parameter-month-table td {\r\n  vertical-align: top;\r\n}\r\n.parameter-month-table th[scope='row'] {\r\n  white-space: nowrap;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.parameter-month-table dl {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px 14px;\r\n  margin: 0;\r\n}\r\n.parameter-month-table dl > div {\r\n  display: flex;\r\n  gap: 5px;\r\n  white-space: nowrap;\r\n}\r\n.parameter-month-table dt {\r\n  color: var(--text-muted);\r\n}\r\n.parameter-month-table dd {\r\n  margin: 0;\r\n  font-weight: 600;\r\n}\r\n.parameter-month-note {\r\n  white-space: pre-wrap;\r\n  overflow-wrap: anywhere;\r\n  min-width: 120px;\r\n  max-width: 320px;\r\n}\r\n.parameter-history-legacy {\r\n  margin: 24px 0;\r\n  padding: 16px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: var(--surface);\r\n  font-size: 13px;\r\n}\r\n.parameter-history-legacy summary {\r\n  cursor: pointer;\r\n  font-weight: 650;\r\n}\r\n.parameter-history-legacy ul {\r\n  padding-left: 18px;\r\n}\r\n.parameter-history-legacy li {\r\n  padding: 10px 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n.parameter-history-legacy li p {\r\n  white-space: pre-wrap;\r\n  margin: 6px 0;\r\n}\r\n@media (max-width: 768px) {\r\n  .parameter-entry-clock {\r\n    padding: 16px;\r\n    column-gap: 14px;\r\n  }\r\n  .parameter-entry-clock > span {\r\n    font-size: 12px;\r\n  }\r\n  .parameter-entry-progress {\r\n    width: 100%;\r\n  }\r\n  .parameter-entry-row .qe-row__input {\r\n    min-height: 44px;\r\n  }\r\n  .parameter-history-reading {\r\n    grid-template-columns: 1fr;\r\n    padding: 14px;\r\n    gap: 16px;\r\n  }\r\n  .parameter-history-stamp {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 12px;\r\n  }\r\n  .parameter-history-toolbar .form-input {\r\n    min-height: 44px;\r\n    max-width: 100%;\r\n  }\r\n  .parameter-history-toolbar button {\r\n    min-height: 44px;\r\n  }\r\n}\r\n"],["STYLE",{},".parameter-trends {\r\n  min-width: 0;\r\n  padding: 18px 0;\r\n}\r\n.parameter-trends-heading {\r\n  display: flex;\r\n  align-items: start;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n}\r\n.parameter-trends-heading h3 {\r\n  margin: 0 0 6px;\r\n  font-size: 18px;\r\n}\r\n.parameter-trends-heading p,\r\n.parameter-trend-note,\r\n.parameter-trends-source {\r\n  color: var(--text-muted);\r\n  font-size: 13px;\r\n  line-height: 1.55;\r\n  margin: 0;\r\n}\r\n.parameter-trends-controls {\r\n  padding: 20px 0 16px;\r\n  display: grid;\r\n  gap: 16px;\r\n}\r\n.parameter-trends .filter-chips {\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n  margin: 0;\r\n}\r\n.parameter-trends .filter-chip {\r\n  min-height: 36px;\r\n}\r\n.parameter-trends .filter-chip:focus-visible,\r\n.parameter-trends .filter-chip:focus-within {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 3px;\r\n}\r\n.parameter-trends-range {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 10px;\r\n  align-items: end;\r\n}\r\n.parameter-trends-range label {\r\n  display: grid;\r\n  gap: 5px;\r\n  font-size: 12px;\r\n  min-width: 0;\r\n}\r\n.parameter-trends-range .form-input {\r\n  min-width: 0;\r\n  width: 158px;\r\n  max-width: 100%;\r\n}\r\n.parameter-trends-range > span {\r\n  padding: 8px 0;\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n}\r\n.parameter-trends-range > p {\r\n  flex-basis: 100%;\r\n}\r\n.parameter-trends-selection {\r\n  padding: 0;\r\n  border: 0;\r\n  margin: 0;\r\n  min-width: 0;\r\n}\r\n.parameter-trends-selection legend {\r\n  margin-bottom: 8px;\r\n  font-size: 12px;\r\n  font-weight: 650;\r\n  color: var(--text-muted);\r\n}\r\n.parameter-trends-selection label {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 7px;\r\n  cursor: pointer;\r\n}\r\n.parameter-trends-selection input {\r\n  accent-color: var(--blue);\r\n  width: 15px;\r\n  height: 15px;\r\n  margin: 0;\r\n}\r\n.parameter-trends-selection__name {\r\n  font-size: 11px;\r\n  font-weight: 400;\r\n}\r\n.parameter-trends-summary {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  border-top: 1px solid var(--border);\r\n  padding: 14px 0 10px;\r\n  font-size: 13px;\r\n}\r\n.parameter-trends-summary > span {\r\n  color: var(--text-muted);\r\n}\r\n.parameter-trend-chart {\r\n  min-width: 0;\r\n  margin: 14px 0;\r\n  border: 1px solid var(--border);\r\n  border-radius: 12px;\r\n  padding: 12px 16px 4px;\r\n  background: var(--surface);\r\n}\r\n.parameter-trend-lane + .parameter-trend-lane {\r\n  border-top: 1px solid var(--border);\r\n  padding-top: 12px;\r\n}\r\n.parameter-trend-lane__heading {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 6px 12px;\r\n}\r\n.parameter-trend-lane h4 {\r\n  margin: 0;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  font-size: 13px;\r\n}\r\n.parameter-trend-lane h4 > span {\r\n  width: 7px;\r\n  height: 7px;\r\n  border-radius: 50%;\r\n  background: var(--trend-color);\r\n}\r\n.parameter-trend-lane h4 small {\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  font-weight: 400;\r\n}\r\n.parameter-trend-legend {\r\n  display: inline-flex;\r\n  gap: 14px;\r\n  font-size: 11px;\r\n  color: var(--text-muted);\r\n}\r\n.parameter-trend-legend span {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 5px;\r\n}\r\n.parameter-trend-legend span::before {\r\n  content: '';\r\n  width: 16px;\r\n  border-top: 2px solid var(--trend-color);\r\n}\r\n.parameter-trend-legend span + span::before {\r\n  border-top-style: dashed;\r\n}\r\n.parameter-trend-plot {\r\n  max-width: 100%;\r\n  display: block;\r\n  overflow: visible;\r\n}\r\n.parameter-trend-plot text {\r\n  font-family: inherit;\r\n  font-size: 11px;\r\n  fill: var(--text-muted);\r\n}\r\n.parameter-trend-grid {\r\n  stroke: var(--border);\r\n  stroke-width: 1;\r\n}\r\n.parameter-trend-grid--time {\r\n  stroke-dasharray: 3 4;\r\n}\r\n.parameter-trend-point {\r\n  cursor: pointer;\r\n  outline: none;\r\n}\r\n.parameter-trend-point:focus-visible .parameter-trend-hit,\r\n.parameter-trend-point.is-selected .parameter-trend-hit {\r\n  stroke: var(--trend-color);\r\n  stroke-width: 2;\r\n  fill: var(--surface);\r\n  fill-opacity: 0.6;\r\n}\r\n.parameter-trend-dot:hover {\r\n  stroke-width: 4;\r\n}\r\n.parameter-trend-dot {\r\n  cursor: pointer;\r\n}\r\n.parameter-trend-axis-label {\r\n  margin: 2px 0 8px;\r\n  text-align: center;\r\n  font-size: 11px;\r\n  color: var(--text-muted);\r\n}\r\n.parameter-trend-lane__empty {\r\n  margin: 12px 0 18px;\r\n  font-size: 13px;\r\n  color: var(--text-muted);\r\n}\r\n.parameter-trend-detail {\r\n  margin: 0 0 14px;\r\n  padding: 12px 14px;\r\n  border: 1px solid var(--border);\r\n  border-left: 3px solid var(--trend-color);\r\n  border-radius: 8px;\r\n  background: var(--bg);\r\n  font-size: 13px;\r\n}\r\n.parameter-trend-detail__title {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n}\r\n.parameter-trend-detail ul {\r\n  list-style: none;\r\n  margin: 8px 0 0;\r\n  padding: 0;\r\n  max-height: 230px;\r\n  overflow-y: auto;\r\n}\r\n.parameter-trend-detail li {\r\n  display: flex;\r\n  align-items: baseline;\r\n  flex-wrap: wrap;\r\n  gap: 5px 20px;\r\n  padding: 5px 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n.parameter-trend-detail li > strong {\r\n  font-size: 18px;\r\n}\r\n.parameter-trend-detail li > span,\r\n.parameter-trend-detail small {\r\n  color: var(--text-muted);\r\n  font-weight: 400;\r\n  font-size: 12px;\r\n}\r\n.parameter-trends-source {\r\n  margin-top: 20px;\r\n  padding-top: 12px;\r\n  border-top: 1px solid var(--border);\r\n}\r\n.parameter-trends-error {\r\n  color: var(--red);\r\n  font-size: 13px;\r\n}\r\n@media (max-width: 600px) {\r\n  .parameter-trends-heading {\r\n    flex-wrap: wrap;\r\n  }\r\n  .parameter-trends .filter-chip,\r\n  .parameter-trends button,\r\n  .parameter-trends .form-input {\r\n    min-height: 44px;\r\n  }\r\n  .parameter-trends-selection__name {\r\n    display: none;\r\n  }\r\n  .parameter-trends-range label {\r\n    flex: 1 1 110px;\r\n  }\r\n  .parameter-trends-range .form-input {\r\n    width: 100%;\r\n  }\r\n  .parameter-trend-chart {\r\n    padding: 12px 6px 4px;\r\n  }\r\n  .parameter-trend-detail {\r\n    padding: 10px;\r\n  }\r\n  .parameter-trend-detail__title {\r\n    align-items: start;\r\n  }\r\n  .parameter-trend-detail li {\r\n    display: grid;\r\n  }\r\n}\r\n"],["STYLE",{},".parameter-reading-form {\r\n  container-type: inline-size;\r\n  min-width: 0;\r\n}\r\n.parameter-reading-form__layout {\r\n  display: grid;\r\n  gap: 20px;\r\n}\r\n.parameter-reading-form__fields {\r\n  border: 0;\r\n  margin: 0;\r\n  padding: 0;\r\n  min-width: 0;\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), 1fr));\r\n  gap: 14px;\r\n  align-content: start;\r\n}\r\n.parameter-reading-form__field {\r\n  display: grid;\r\n  min-width: 0;\r\n  gap: 5px;\r\n  align-content: start;\r\n}\r\n.parameter-reading-form__field > span {\r\n  font-weight: 600;\r\n}\r\n.parameter-reading-form__field small,\r\n.parameter-reading-form__tools > small,\r\n.parameter-reading-form__help {\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  line-height: 1.5;\r\n}\r\n.parameter-reading-form__field .form-input {\r\n  width: 100%;\r\n  min-width: 0;\r\n  box-sizing: border-box;\r\n}\r\n.parameter-reading-form__field--note {\r\n  grid-column: 1 / -1;\r\n}\r\n.parameter-reading-form__previous {\r\n  overflow-wrap: anywhere;\r\n}\r\n.parameter-reading-form__field small.parameter-reading-form__previous {\r\n  color: var(--text);\r\n  font-size: 14px;\r\n  font-weight: 500;\r\n  white-space: normal;\r\n}\r\n.parameter-reading-form__tools {\r\n  display: grid;\r\n  gap: 10px;\r\n  align-content: start;\r\n  min-width: 0;\r\n}\r\n.parameter-reading-form__pad {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  gap: 8px;\r\n}\r\n.parameter-reading-form__pad .ds-btn {\r\n  min-width: 0;\r\n}\r\n.parameter-reading-form__news2 p,\r\n.parameter-reading-form__help {\r\n  margin: 5px 0 0;\r\n}\r\n@container (min-width: 700px) {\r\n  .parameter-reading-form__layout {\r\n    grid-template-columns: minmax(0, 1fr) 220px;\r\n  }\r\n}\r\n"],["STYLE",{},".parameter-workspace {\r\n  min-width: 0;\r\n  padding-top: 12px;\r\n}\r\n.parameter-single-entry {\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 12px;\r\n  padding: 16px;\r\n  margin-bottom: 20px;\r\n}\r\n.parameter-single-entry__heading {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  margin-bottom: 14px;\r\n}\r\n.parameter-single-entry h3,\r\n.parameter-workspace-records__heading h3 {\r\n  font-size: 16px;\r\n  margin: 0;\r\n}\r\n.parameter-single-entry .parameter-entry-clock {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 4px 10px;\r\n  margin: 0;\r\n  padding: 0;\r\n  border: 0;\r\n  justify-content: flex-end;\r\n}\r\n.parameter-single-entry .parameter-entry-clock time {\r\n  font-size: 26px;\r\n}\r\n.parameter-single-entry .parameter-entry-clock > span:first-child {\r\n  display: none;\r\n}\r\n.parameter-single-entry .parameter-entry-clock > span:last-child {\r\n  font-size: 12px;\r\n  max-width: 200px;\r\n}\r\n.parameter-single-entry__fields {\r\n  display: grid;\r\n  grid-template-columns: repeat(6, minmax(0, 1fr));\r\n  gap: 12px;\r\n  border: 0;\r\n  padding: 0;\r\n  margin: 0;\r\n  min-width: 0;\r\n}\r\n.parameter-single-entry__fields label {\r\n  display: grid;\r\n  gap: 6px;\r\n  min-width: 0;\r\n}\r\n.parameter-single-entry__fields label > span {\r\n  font-size: 12px;\r\n  font-weight: 650;\r\n}\r\n.parameter-single-entry__fields small {\r\n  font-weight: 400;\r\n  color: var(--text-muted);\r\n}\r\n.parameter-single-entry .form-input {\r\n  width: 100%;\r\n  min-width: 0;\r\n}\r\n.parameter-single-entry__notes {\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n  margin-top: 12px;\r\n}\r\n.parameter-single-entry summary {\r\n  cursor: pointer;\r\n  width: fit-content;\r\n}\r\n.parameter-single-entry__notes textarea {\r\n  margin-top: 8px;\r\n  resize: vertical;\r\n}\r\n.parameter-single-entry__actions {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  align-items: center;\r\n  margin-top: 12px;\r\n}\r\n.parameter-single-entry__actions > span {\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n}\r\n.parameter-single-entry__success {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px 16px;\r\n  margin-top: 12px;\r\n  padding: 10px 12px;\r\n  font-size: 13px;\r\n  color: #216345;\r\n  background: #edf8f2;\r\n  border-radius: 8px;\r\n}\r\n.parameter-workspace-records {\r\n  min-width: 0;\r\n}\r\n.parameter-workspace-records__heading {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  margin-bottom: 12px;\r\n}\r\n.parameter-workspace-period .filter-chips {\r\n  margin: 0;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n.parameter-workspace-period .filter-chip {\r\n  min-height: 36px;\r\n}\r\n.parameter-workspace-period .parameter-trends-range {\r\n  margin-top: 12px;\r\n}\r\n.parameter-workspace-summary {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  padding: 14px 0;\r\n  margin-bottom: 4px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n.parameter-workspace-summary > div {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px 16px;\r\n  align-items: center;\r\n  font-size: 13px;\r\n}\r\n.parameter-workspace-summary span {\r\n  color: var(--text-muted);\r\n}\r\n.parameter-workspace .parameter-workspace-graph-active {\r\n  color: var(--blue);\r\n  background: #eaf1ff;\r\n  border-color: #c6d8fc;\r\n}\r\n.parameter-workspace-list-title {\r\n  font-size: 14px;\r\n  margin: 16px 0 10px;\r\n}\r\n.parameter-workspace .parameter-history-day {\r\n  margin: 14px 0 8px;\r\n}\r\n.parameter-workspace .parameter-history-reading {\r\n  padding: 12px 14px;\r\n}\r\n.parameter-workspace .parameter-trends--inline {\r\n  padding: 14px 0 8px;\r\n}\r\n.parameter-workspace .parameter-trends--inline > .parameter-trend-note {\r\n  margin-top: 10px;\r\n}\r\n.parameter-workspace .parameter-trend-chart {\r\n  margin: 12px 0;\r\n}\r\n.parameter-workspace button:focus-visible,\r\n.parameter-workspace summary:focus-visible {\r\n  outline: 2px solid var(--blue);\r\n  outline-offset: 3px;\r\n}\r\n@media (max-width: 900px) {\r\n  .parameter-single-entry__fields {\r\n    grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  }\r\n}\r\n@media (max-width: 600px) {\r\n  .parameter-single-entry {\r\n    padding: 14px;\r\n  }\r\n  .parameter-single-entry__heading {\r\n    align-items: start;\r\n  }\r\n  .parameter-single-entry .parameter-entry-clock {\r\n    flex-direction: column;\r\n    align-items: flex-end;\r\n    gap: 4px;\r\n  }\r\n  .parameter-single-entry .parameter-entry-clock > span:last-child {\r\n    text-align: right;\r\n    max-width: 150px;\r\n    font-size: 11px;\r\n  }\r\n  .parameter-single-entry__fields {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n    gap: 12px;\r\n  }\r\n  .parameter-single-entry__actions {\r\n    flex-wrap: wrap;\r\n  }\r\n  .parameter-single-entry__actions button {\r\n    width: 100%;\r\n  }\r\n  .parameter-workspace button,\r\n  .parameter-workspace .form-input,\r\n  .parameter-workspace .filter-chip {\r\n    min-height: 44px;\r\n  }\r\n  .parameter-workspace-summary > div {\r\n    display: grid;\r\n  }\r\n  .parameter-workspace-summary {\r\n    align-items: start;\r\n  }\r\n}\r\n"],["STYLE",{},"/* Unified screen contract for structured data inside the patient record.\r\n   Print forms intentionally keep their dedicated A4 rules from print-forms.css. */\r\n@media screen {\r\n  .patient-record-view {\r\n    --patient-data-radius: 12px;\r\n    --patient-data-header-height: 46px;\r\n    --patient-data-row-height: 46px;\r\n    --patient-data-cell-x: 14px;\r\n    --patient-data-header-bg: var(--surface-raised, #f3f6fb);\r\n    --patient-data-label-bg: var(--surface-raised, #f3f6fb);\r\n    --patient-data-border: var(--border, #e6ebf2);\r\n  }\r\n\r\n  .patient-diary-filters {\r\n    align-self: flex-start;\r\n    max-width: calc(100% - 48px);\r\n    margin: 8px 24px 12px;\r\n    box-sizing: border-box;\r\n  }\r\n\r\n  /* One surface and one header treatment for every clinical section. */\r\n  .patient-record-view :is(.clinical-card, .cts, .cr-profilo-group, .narrative-section) {\r\n    background: var(--surface, #fff);\r\n    border: 1px solid var(--patient-data-border);\r\n    border-radius: var(--patient-data-radius);\r\n    box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04);\r\n    overflow: hidden;\r\n  }\r\n\r\n  .patient-record-view .clinical-card + .clinical-card {\r\n    margin-top: 12px;\r\n  }\r\n\r\n  .patient-record-view :is(.clinical-card__header, .cts__header) {\r\n    width: 100%;\r\n    min-height: var(--patient-data-header-height);\r\n    height: auto;\r\n    padding: 7px var(--patient-data-cell-x);\r\n    background: var(--patient-data-header-bg);\r\n    border: 0;\r\n    border-bottom: 1px solid var(--patient-data-border);\r\n    color: var(--text, #16202e);\r\n  }\r\n\r\n  .patient-record-view .clinical-card__title,\r\n  .patient-record-view .cts__title {\r\n    margin: 0;\r\n    color: var(--text, #16202e);\r\n    font-size: 13px;\r\n    font-weight: 700;\r\n    letter-spacing: 0.01em;\r\n    text-transform: none;\r\n  }\r\n\r\n  .patient-record-view :is(.clinical-card__actions, .cts__header-right) {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 6px;\r\n  }\r\n\r\n  .patient-record-view .clinical-card__edit,\r\n  .patient-record-view .cts__header-right .btn-sm {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    min-height: 32px;\r\n    padding: 5px 10px;\r\n    border: 1px solid #cfd9ea;\r\n    border-radius: 8px;\r\n    background: var(--surface, #fff);\r\n    color: var(--blue, #2f6bed);\r\n    font-size: 12px;\r\n    font-weight: 700;\r\n    line-height: 1;\r\n  }\r\n\r\n  .patient-record-view .clinical-card__edit:hover,\r\n  .patient-record-view .cts__header-right .btn-sm:hover {\r\n    border-color: #9cb8f4;\r\n    background: var(--indigo-bg, #eef3fe);\r\n  }\r\n\r\n  .patient-record-view .clinical-card__content-inner:has(> :is(.cr-form-section, .pic-edit-form)) {\r\n    padding: 0;\r\n  }\r\n\r\n  .patient-record-view .clinical-card .cr-form-section {\r\n    gap: 0;\r\n    padding: 0;\r\n    border: 0;\r\n    border-radius: 0;\r\n    box-shadow: none;\r\n  }\r\n\r\n  .patient-record-view .pic-edit-form {\r\n    gap: 12px;\r\n    padding: 16px;\r\n    background: var(--surface-raised, #f3f6fb);\r\n  }\r\n\r\n  /* Canonical key/value data row used by intake, profile and legacy summaries. */\r\n  .patient-record-view .pic-row {\r\n    display: grid;\r\n    grid-template-columns: minmax(180px, 34%) minmax(0, 1fr);\r\n    align-items: stretch;\r\n    gap: 0;\r\n    min-height: var(--patient-data-row-height);\r\n    padding: 0;\r\n    border-bottom: 1px solid var(--divider, #f0f3f8);\r\n    font-size: 13.5px;\r\n  }\r\n\r\n  .patient-record-view .pic-row:last-child {\r\n    border-bottom: 0;\r\n  }\r\n\r\n  .patient-record-view .pic-row__lbl,\r\n  .patient-record-view .pic-row__val {\r\n    display: flex;\r\n    min-width: 0;\r\n    padding: 10px var(--patient-data-cell-x);\r\n    align-items: center;\r\n  }\r\n\r\n  .patient-record-view .pic-row__lbl {\r\n    background: var(--patient-data-label-bg);\r\n    color: var(--text-muted, #5a6b80);\r\n    font-size: 12.5px;\r\n    font-weight: 600;\r\n  }\r\n\r\n  .patient-record-view .pic-row__val {\r\n    justify-content: flex-end;\r\n    margin: 0;\r\n    color: var(--text, #16202e);\r\n    font-size: 13.5px;\r\n    font-weight: 600;\r\n    text-align: right;\r\n    overflow-wrap: anywhere;\r\n  }\r\n\r\n  .patient-record-view\r\n    .inline-edit-row:is(:hover, :focus-visible)\r\n    > :is(.pic-row__lbl, .pic-row__val) {\r\n    background: var(--indigo-bg, #eef3fe);\r\n  }\r\n\r\n  .patient-record-view .pic-row--danger > :is(.pic-row__lbl, .pic-row__val) {\r\n    background: #fef2f2;\r\n    color: #b42318;\r\n  }\r\n\r\n  .patient-record-view\r\n    .pic-row--danger:is(:hover, :focus-visible)\r\n    > :is(.pic-row__lbl, .pic-row__val) {\r\n    background: #fee4e2;\r\n  }\r\n\r\n  .patient-record-view .pic-row .inline-edit__value {\r\n    align-self: center;\r\n    justify-self: end;\r\n    min-height: 34px;\r\n    margin: 5px 8px;\r\n    padding: 5px 8px;\r\n  }\r\n\r\n  .patient-record-view .pic-row--editing {\r\n    align-items: stretch;\r\n    padding: 0;\r\n    background: var(--surface-raised, #f3f6fb);\r\n  }\r\n\r\n  .patient-record-view .pic-row--editing .inline-edit__control {\r\n    padding: 6px 8px;\r\n  }\r\n\r\n  /* Profile data follows the same label/value hierarchy without nested-card shadows. */\r\n  .patient-record-view .cr-profilo-grid {\r\n    gap: 12px;\r\n  }\r\n\r\n  .patient-record-view .cr-profilo-group {\r\n    padding: 0;\r\n    gap: 0;\r\n  }\r\n\r\n  .patient-record-view .cr-profilo-group__title {\r\n    min-height: 42px;\r\n    margin: 0;\r\n    padding: 12px var(--patient-data-cell-x);\r\n    background: var(--patient-data-header-bg);\r\n    border-bottom: 1px solid var(--patient-data-border);\r\n    color: var(--text, #16202e);\r\n    font-size: 12px;\r\n    font-weight: 700;\r\n    letter-spacing: 0.04em;\r\n  }\r\n\r\n  .patient-record-view .cr-profilo-row {\r\n    display: grid;\r\n    grid-template-columns: minmax(120px, 42%) minmax(0, 1fr);\r\n    align-items: stretch;\r\n    gap: 0;\r\n    min-height: 42px;\r\n    border-bottom: 1px solid var(--divider, #f0f3f8);\r\n    font-size: 13px;\r\n  }\r\n\r\n  .patient-record-view .cr-profilo-row:last-child {\r\n    border-bottom: 0;\r\n  }\r\n\r\n  .patient-record-view .cr-profilo-row > :is(span:first-child, strong) {\r\n    display: flex;\r\n    align-items: center;\r\n    min-width: 0;\r\n    padding: 9px var(--patient-data-cell-x);\r\n  }\r\n\r\n  .patient-record-view .cr-profilo-row > span:first-child {\r\n    background: var(--patient-data-label-bg);\r\n    color: var(--text-muted, #5a6b80);\r\n    font-weight: 600;\r\n  }\r\n\r\n  .patient-record-view .cr-profilo-row > strong {\r\n    justify-content: flex-end;\r\n    color: var(--text, #16202e);\r\n    font-weight: 600;\r\n    text-align: right;\r\n  }\r\n\r\n  /* Narrative and list-like records share the same restrained chrome. */\r\n  .patient-record-view :is(.cr-item-row, .diario-card) {\r\n    border: 1px solid var(--patient-data-border);\r\n    border-radius: var(--patient-data-radius);\r\n    background: var(--surface, #fff);\r\n    box-shadow: none;\r\n  }\r\n\r\n  .patient-record-view .cr-legacy-anamnesi-row {\r\n    display: grid;\r\n    grid-template-columns: minmax(180px, 34%) minmax(0, 1fr);\r\n    gap: 0;\r\n    padding: 0;\r\n    border-bottom: 1px solid var(--divider, #f0f3f8);\r\n  }\r\n\r\n  .patient-record-view .cr-legacy-anamnesi-row__label,\r\n  .patient-record-view .cr-legacy-anamnesi-row__value {\r\n    margin: 0;\r\n    padding: 10px var(--patient-data-cell-x);\r\n  }\r\n\r\n  .patient-record-view .cr-legacy-anamnesi-row__label {\r\n    background: var(--patient-data-label-bg);\r\n    font-size: 12.5px;\r\n    letter-spacing: 0.01em;\r\n    text-transform: none;\r\n  }\r\n\r\n  /* Every semantic and module table receives the same screen-only table contract. */\r\n  .patient-record-view\r\n    :is(\r\n      .clinicos-table,\r\n      .parametri-modulo-table,\r\n      .braden-modulo-table,\r\n      .med-modulo-table,\r\n      .med-followup-table\r\n    ) {\r\n    width: 100%;\r\n    border-collapse: separate;\r\n    border-spacing: 0;\r\n    border: 1px solid var(--patient-data-border);\r\n    border-radius: var(--patient-data-radius);\r\n    background: var(--surface, #fff);\r\n    color: var(--text, #16202e);\r\n    font-family: var(--font-ui);\r\n    font-size: 13px;\r\n    overflow: hidden;\r\n  }\r\n\r\n  .patient-record-view\r\n    :is(\r\n      .clinicos-table,\r\n      .parametri-modulo-table,\r\n      .braden-modulo-table,\r\n      .med-modulo-table,\r\n      .med-followup-table\r\n    )\r\n    thead\r\n    th {\r\n    min-height: 42px;\r\n    padding: 10px var(--patient-data-cell-x);\r\n    background: var(--patient-data-header-bg);\r\n    border: 0;\r\n    border-bottom: 1px solid var(--patient-data-border);\r\n    color: var(--text-muted, #5a6b80);\r\n    font-family: var(--font-ui);\r\n    font-size: 11.5px;\r\n    font-weight: 700;\r\n    letter-spacing: 0.04em;\r\n    line-height: 1.25;\r\n    text-align: left;\r\n    text-transform: uppercase;\r\n  }\r\n\r\n  .patient-record-view\r\n    :is(\r\n      .clinicos-table,\r\n      .parametri-modulo-table,\r\n      .braden-modulo-table,\r\n      .med-modulo-table,\r\n      .med-followup-table\r\n    )\r\n    tbody\r\n    td {\r\n    min-height: var(--patient-data-row-height);\r\n    height: auto;\r\n    padding: 10px var(--patient-data-cell-x);\r\n    border: 0;\r\n    border-bottom: 1px solid var(--divider, #f0f3f8);\r\n    background: var(--surface, #fff);\r\n    color: var(--text, #16202e);\r\n    font-family: var(--font-ui);\r\n    font-size: 13px;\r\n    vertical-align: middle;\r\n  }\r\n\r\n  .patient-record-view\r\n    :is(\r\n      .clinicos-table,\r\n      .parametri-modulo-table,\r\n      .braden-modulo-table,\r\n      .med-modulo-table,\r\n      .med-followup-table\r\n    )\r\n    tbody\r\n    tr:nth-child(even):not(.totale-row)\r\n    > td {\r\n    background: var(--surface-raised, #f3f6fb);\r\n  }\r\n\r\n  .patient-record-view\r\n    :is(\r\n      .clinicos-table,\r\n      .parametri-modulo-table,\r\n      .braden-modulo-table,\r\n      .med-modulo-table,\r\n      .med-followup-table\r\n    )\r\n    tbody\r\n    tr:not(.totale-row):hover\r\n    > td {\r\n    background: var(--indigo-bg, #eef3fe);\r\n  }\r\n\r\n  .patient-record-view\r\n    :is(\r\n      .clinicos-table,\r\n      .parametri-modulo-table,\r\n      .braden-modulo-table,\r\n      .med-modulo-table,\r\n      .med-followup-table\r\n    )\r\n    tbody\r\n    tr:last-child\r\n    > td {\r\n    border-bottom: 0;\r\n  }\r\n\r\n  .patient-record-view .clinicos-table-wrap {\r\n    margin-bottom: 12px;\r\n    border: 0;\r\n    border-radius: var(--patient-data-radius);\r\n    box-shadow: none;\r\n    overflow-x: auto;\r\n    scrollbar-gutter: stable;\r\n  }\r\n\r\n  .patient-record-view :is(.fm, .modulo-content, .clinical-card__content-inner) {\r\n    max-width: 100%;\r\n  }\r\n\r\n  .patient-record-view :is(.fm, .modulo-content) {\r\n    overflow-x: auto;\r\n    scrollbar-gutter: stable;\r\n  }\r\n\r\n  /* Horizontal rails stay available to touch, trackpads and keyboard-focused controls,\r\n     but do not add a second visual hierarchy made of native scrollbar tracks. */\r\n  .patient-record-view\r\n    :is(.top-nav__items, .clinicos-table-wrap, .parametri-grid-wrapper, .fm, .modulo-content) {\r\n    -ms-overflow-style: none;\r\n    scrollbar-width: none;\r\n  }\r\n\r\n  .patient-record-view\r\n    :is(\r\n      .top-nav__items,\r\n      .clinicos-table-wrap,\r\n      .parametri-grid-wrapper,\r\n      .fm,\r\n      .modulo-content\r\n    )::-webkit-scrollbar {\r\n    display: none;\r\n    width: 0;\r\n    height: 0;\r\n  }\r\n\r\n  .patient-record-view\r\n    :is(\r\n      .clinical-card__header,\r\n      .cts__header,\r\n      .clinical-card__edit,\r\n      .inline-edit-row\r\n    ):focus-visible {\r\n    outline: 3px solid color-mix(in srgb, var(--blue, #2f6bed) 30%, transparent);\r\n    outline-offset: -2px;\r\n  }\r\n\r\n  @media (max-width: 768px) {\r\n    .patient-record-view {\r\n      --patient-data-cell-x: 12px;\r\n    }\r\n\r\n    .patient-record-view .pic-row,\r\n    .patient-record-view .cr-profilo-row,\r\n    .patient-record-view .cr-legacy-anamnesi-row {\r\n      grid-template-columns: minmax(0, 1fr);\r\n    }\r\n\r\n    .patient-record-view .pic-row__val,\r\n    .patient-record-view .cr-profilo-row > strong {\r\n      justify-content: flex-start;\r\n      text-align: left;\r\n    }\r\n\r\n    .patient-record-view .pic-row .inline-edit__value {\r\n      justify-self: stretch;\r\n      margin: 5px 8px;\r\n    }\r\n\r\n    .patient-record-view\r\n      :is(.parametri-modulo-table, .braden-modulo-table, .med-modulo-table, .med-followup-table) {\r\n      min-width: 680px;\r\n    }\r\n  }\r\n}\r\n/* Temporal urgency is separate from author role and historical acknowledgement. */\r\n.patient-record-view .diario-card.diario-card--urgent { border-left: 4px solid #b42335; background: #fffafb; }\r\n.patient-record-view .diario-card.diario-card--taken { border-left: 4px solid #8291a6; }\r\n.patient-record-view .cr-alert-band { margin: 16px 0 24px; gap: 12px; }\r\n@media screen {\r\n  .patient-record-view .cr-detail-content { display:flex; flex-direction:column; gap:16px; padding:0; }\r\n  .patient-record-view .chart-part { display:flex; flex:0 0 auto; flex-direction:column; gap:16px; margin:0; padding:0; }\r\n  .patient-record-view .cr-tab-content { display:flex; flex:0 0 auto; flex-direction:column; gap:16px; padding:0; margin:0; }\r\n  .patient-record-view :is(.cr-tab-content, .chart-part) > .cts { margin:0; }\r\n  .patient-record-view .assessment-catalog { margin-inline:0; }\r\n  .patient-record-view .cr-profilo-grid { grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr)); margin-top:0 !important; }\r\n}\r\n.patient-contacts { border-top:1px solid var(--border); margin-top:12px; padding-top:12px; }\r\n.patient-contacts__header { display:flex; align-items:center; justify-content:space-between; gap:12px; }\r\n.patient-contacts h4 { margin:0; }\r\n.patient-contacts dl { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr)); gap:8px 16px; margin:12px 0; }\r\n.patient-contacts dl > div { min-width:0; }\r\n.patient-contacts dt { color:var(--text-muted); font-size:12px; }\r\n.patient-contacts dd { margin:3px 0; overflow-wrap:anywhere; }\r\n.clinical-card__content[hidden] { display:none !important; }\r\n.patient-record-view .narrative-sections { display:flex; flex-direction:column; gap:16px; margin:0; padding:0; }\r\n.patient-record-view .narrative-sections:empty { display:none; }\r\n@media print { .clinical-card__content[hidden] { display:block !important; height:auto !important; } }\r\n.patient-record-view .cr-alert-strip { min-height: 48px; padding: 12px 16px; gap: 12px; border-radius: 12px; line-height: 1.5; }\r\n.patient-record-view .cr-alert-strip--allergie { color: #8f5500; background: #fdf3e2; border: 1px solid #ead0a7; border-left: 4px solid #8f5500; }\r\n.patient-record-view .cr-alert-strip--allergie:hover { background: #fae9cc; }\r\n.patient-record-view .cr-alert-strip--allergie.cr-alert-strip--severe {\r\n  color: #b42335;\r\n  background: #fdecee;\r\n  border-color: #efc3cb;\r\n  border-left-color: #b42335;\r\n}\r\n.patient-record-view .cr-alert-strip--allergie.cr-alert-strip--severe:hover { background: #fbe0e5; }\r\n.patient-record-view .cr-alert-strip > span { overflow-wrap: anywhere; }\r\n.patient-record-view .patient-allergy-strip { margin-bottom: 20px; padding: 12px 16px; background: #fdf3e2; border-color: #ead0a7; color: #8f5500; }\r\n"],["STYLE",{},"/* Compact overview only; full clinical editors and handoff cards keep their layout. */\r\n.patient-record-view .cr-tab-content--overview {\r\n  gap: 12px;\r\n}\r\n\r\n.patient-record-view .cr-overview-section {\r\n  padding: 12px;\r\n}\r\n\r\n.patient-record-view .cr-overview-section__header {\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-riepilogo-grid {\r\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));\r\n  gap: 10px;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-riepilogo-card {\r\n  gap: 4px;\r\n  padding: 10px 12px 4px;\r\n  border-left-width: 3px;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-riepilogo-card__title {\r\n  min-height: 24px;\r\n  grid-template-columns: 16px minmax(0, 1fr) auto;\r\n  gap: 6px;\r\n  font-size: 13px;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-overview-count {\r\n  grid-column: auto;\r\n  justify-self: end;\r\n  min-height: 22px;\r\n  max-width: 130px;\r\n  padding: 2px 6px;\r\n  font-size: 10.5px;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-empty {\r\n  margin: 2px 0;\r\n  font-size: 12.5px;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-overview-action {\r\n  min-height: 44px;\r\n  margin-top: 0;\r\n  padding: 5px 0;\r\n  font-weight: 700;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-compact-item {\r\n  gap: 4px 6px;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-compact-item__main {\r\n  white-space: normal;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-compact-item__sub {\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n/* Keep the complete narrative in the diagnosis dialog, with a bounded overview. */\r\n.patient-record-view .cr-tab-content--overview .cr-riepilogo-card--diagnosi {\r\n  display: grid;\r\n  grid-template-rows: auto minmax(0, 1fr) auto;\r\n  height: 10rem;\r\n}\r\n\r\n.patient-record-view .cr-riepilogo-card--diagnosi .cr-compact-list {\r\n  min-height: 0;\r\n  overflow: hidden;\r\n  gap: 4px;\r\n}\r\n\r\n.patient-record-view .cr-riepilogo-card--diagnosi .cr-compact-item {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) auto auto;\r\n  align-items: start;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.patient-record-view .cr-riepilogo-card--diagnosi .cr-compact-item__main {\r\n  display: -webkit-box;\r\n  -webkit-box-orient: vertical;\r\n  -webkit-line-clamp: 1;\r\n  overflow: hidden;\r\n  line-height: 1.35;\r\n}\r\n\r\n.patient-record-view\r\n  .cr-riepilogo-card--diagnosi\r\n  .cr-compact-item:only-child\r\n  .cr-compact-item__main {\r\n  -webkit-line-clamp: 3;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-compact-item--farmaco {\r\n  grid-template-columns: minmax(0, 1fr) minmax(0, 0.65fr);\r\n  align-items: start;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-compact-item__dose {\r\n  white-space: normal;\r\n  overflow-wrap: anywhere;\r\n  text-align: right;\r\n}\r\n\r\n.patient-record-view .cr-tab-content--overview .cr-compact-item--farmaco .cr-compact-item__sub {\r\n  grid-column: 1 / -1;\r\n}\r\n\r\n.patient-record-view .cr-riepilogo-card--allergie .cr-compact-item {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) auto;\r\n}\r\n\r\n.patient-record-view .cr-riepilogo-card--allergie .cr-compact-item__main {\r\n  grid-column: 1 / -1;\r\n}\r\n\r\n.cr-overview-handoffs {\r\n  display: grid;\r\n  gap: 6px;\r\n  margin: 2px 0;\r\n  padding: 0;\r\n  list-style: none;\r\n}\r\n\r\n.cr-overview-handoff + .cr-overview-handoff {\r\n  padding-top: 6px;\r\n  border-top: 1px solid var(--border, #e3e9f1);\r\n}\r\n\r\n.cr-overview-handoff .consegna-card__top {\r\n  gap: 6px;\r\n  margin: 0;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.cr-overview-handoff__note {\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 2;\r\n  -webkit-box-orient: vertical;\r\n  overflow: hidden;\r\n  overflow-wrap: anywhere;\r\n  margin: 2px 0 0;\r\n  color: var(--text-muted, #65778c);\r\n  font-size: 12.5px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.cr-overview-placement {\r\n  display: grid;\r\n  gap: 3px;\r\n  margin: 2px 0;\r\n  font-size: 12.5px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.cr-overview-placement > div {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 10px;\r\n}\r\n\r\n.cr-overview-placement dt {\r\n  color: var(--text-muted, #65778c);\r\n}\r\n\r\n.cr-overview-placement dd {\r\n  margin: 0;\r\n  font-weight: 500;\r\n  text-align: right;\r\n  overflow-wrap: anywhere;\r\n  min-width: 0;\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  .patient-record-view .cr-overview-section {\r\n    padding: 10px;\r\n  }\r\n\r\n  .patient-record-view .cr-tab-content--overview .cr-riepilogo-grid {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }\r\n\r\n  .patient-record-view .cr-tab-content--overview .cr-overview-count {\r\n    max-width: 104px;\r\n  }\r\n}\r\n"],["STYLE",{},"/* UX2 W8 — stato dell'urgenza su una nota (diario / consegna). Rosso solo per l'urgenza ATTIVA\r\n   (allerta clinica); la traccia «presa in carico» è testo muted, sempre visibile. */\r\n.urgency-notice {\r\n  display: flex;\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n  gap: 8px 12px;\r\n  margin-top: 12px;\r\n  padding-top: 10px;\r\n  border-top: 1px solid var(--divider, var(--border));\r\n}\r\n.urgency-notice__text {\r\n  flex: 1 1 200px;\r\n  min-width: 0;\r\n  font-size: 13px;\r\n  line-height: 20px;\r\n  color: var(--text-muted);\r\n  overflow-wrap: anywhere;\r\n}\r\n.urgency-notice--active .urgency-notice__text {\r\n  font-weight: 600;\r\n  color: var(--red);\r\n}\r\n.urgency-notice__btn {\r\n  min-height: 44px;\r\n  margin-left: auto;\r\n}\r\n"]],[[5,30]],["BODY",{},[[5,31]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},["NAV",{"class":"teams-sidebar","aria-label":"Navigazione principale"},["DIV",{"class":"teams-sidebar__brand"},["SPAN",{"class":"teams-sidebar__brand-dot","aria-hidden":"true"},["svg",{"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","aria-hidden":"true"},["path",{"d":"M9 3h6v6h6v6h-6v6H9v-6H3V9h6z"}]]]],["DIV",{"class":"teams-sidebar__nav"},["BUTTON",{"type":"button","class":"teams-sidebar__item active","title":"Turno","aria-current":"page"},["SPAN",{"class":"teams-sidebar__item-icon"},["svg",{"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","aria-hidden":"true"},["path",{"d":"M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"}]]],["SPAN",{"class":"teams-sidebar__item-label"},"Turno"]],["BUTTON",{"type":"button","class":"teams-sidebar__item","title":"Pazienti"},["SPAN",{"class":"teams-sidebar__item-icon"},["svg",{"viewBox