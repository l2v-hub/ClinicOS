{"type":"frame-snapshot","snapshot":{"callId":"call@13780","snapshotName":"after@call@13780","pageId":"page@b29f5b5d79833fb934bc98c47f8bc8bb","frameId":"frame@34c11205ad5e37d2b7ed2eca58bc00ef","frameUrl":"http://127.0.0.1:7483/#/parametri-multipaziente","doctype":"html","html":["HTML",{"lang":"it"},["HEAD",{},[[12,0]],[[12,1]],[[12,2]],[[12,3]],[[12,4]],[[12,5]],[[12,6]],[[12,7]],[[12,8]],[[12,9]],[[12,10]],[[12,11]],[[12,12]],[[12,13]],[[12,15]],[[12,16]],[[12,18]],[[12,20]],[[12,22]],[[12,24]],[[12,26]],[[12,28]],[[9,1]],[[9,3]],[[9,5]],[[9,7]],[[9,9]],[[9,11]],[[9,13]],[[9,15]],[[9,17]],[[9,19]],[[9,21]],[[9,23]],[[9,25]],[[9,27]],[[9,29]],[[7,1]],[[7,3]],[[7,5]],[[7,7]],[[7,9]],[[7,11]],[[7,13]],[[7,15]],[[7,17]],[[7,19]],[[7,21]],[[7,23]],[[7,25]],[[7,27]],[[5,1]],[[5,3]],["STYLE",{},"/* Parametri vitali — HMI 1 (artifacts/hmi-parity/proto/parametri.png). */\r\n.par-view {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.par-grid {\r\n  display: grid;\r\n  grid-template-columns: 240px minmax(0, 1fr);\r\n  grid-template-areas: 'list form';\r\n  gap: 24px;\r\n  align-items: start;\r\n}\r\n.par-patients {\r\n  grid-area: list;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  min-width: 0;\r\n}\r\n.par-form {\r\n  grid-area: form;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.par-side {\r\n  grid-area: side;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  min-width: 0;\r\n}\r\n.par-eyebrow {\r\n  font: 600 14px/20px var(--font-ui);\r\n  letter-spacing: 0.06em;\r\n  text-transform: uppercase;\r\n  color: var(--text-muted);\r\n}\r\n.par-cap {\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n  min-width: 0;\r\n}\r\n\r\n.par-pad__key:focus-visible,\r\n.par-pick__main:focus-visible {\r\n  outline: 3px solid #245bb5;\r\n  outline-offset: 2px;\r\n}\r\n\r\n/* Colonna pazienti */\r\n.par-search {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n.par-search__ico {\r\n  position: absolute;\r\n  left: 14px;\r\n  display: grid;\r\n  color: var(--text-muted);\r\n}\r\n.par-search__ico svg {\r\n  width: 18px;\r\n  height: 18px;\r\n}\r\n.par-search__input {\r\n  width: 100%;\r\n  height: 48px;\r\n  padding: 0 44px;\r\n  border-radius: 12px;\r\n  border: 2px solid var(--border);\r\n  background: var(--surface);\r\n  font: 400 16px/24px var(--font-ui);\r\n  color: var(--text);\r\n}\r\n.par-search__clear {\r\n  position: absolute;\r\n  right: 4px;\r\n  width: 40px;\r\n  height: 40px;\r\n  border: 0;\r\n  background: none;\r\n  display: grid;\r\n  place-items: center;\r\n  color: var(--text-muted);\r\n  cursor: pointer;\r\n}\r\n.par-patients__tools {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n}\r\n.par-plist {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n.par-pick {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding-right: 8px;\r\n  border-radius: 12px;\r\n  background: var(--surface);\r\n  border: 2px solid transparent;\r\n}\r\n.par-pick--selected {\r\n  border-color: var(--blue);\r\n  background: #eaf1fe;\r\n}\r\n.par-pick__main {\r\n  flex: 1;\r\n  min-width: 0;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n  padding: 8px;\r\n  border: 0;\r\n  background: none;\r\n  text-align: left;\r\n  cursor: pointer;\r\n  border-radius: 10px;\r\n}\r\n.par-pick__bed {\r\n  width: 48px;\r\n  height: 48px;\r\n  flex: none;\r\n  border-radius: 12px;\r\n  background: #f5f7fb;\r\n  border: 1px solid var(--border);\r\n  display: grid;\r\n  place-items: center;\r\n  font: 600 18px/24px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--text);\r\n}\r\n.par-pick__text {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n}\r\n.par-pick__name {\r\n  font: 600 16px/24px var(--font-ui);\r\n  color: var(--text);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.par-pick .par-cap {\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n.par-pick__draft {\r\n  color: #8a5300;\r\n  font-weight: 600;\r\n}\r\n.par-pick .turno-pcard__news2 {\r\n  flex: none;\r\n}\r\n.par-more {\r\n  align-self: flex-start;\r\n  min-height: 48px;\r\n}\r\n\r\n/* Paziente scelto */\r\n.par-form__head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n}\r\n.par-form__who {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n}\r\n.par-form__name {\r\n  margin: 0;\r\n  font: 600 20px/28px var(--font-ui);\r\n  color: var(--text);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.par-cards {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  gap: 16px;\r\n}\r\n.par-card {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  padding: 16px;\r\n  border-radius: 16px;\r\n  background: var(--surface);\r\n  border: 2px solid var(--border);\r\n  cursor: text;\r\n  min-width: 0;\r\n  margin: 0;\r\n}\r\n.par-card--active {\r\n  border-color: var(--blue);\r\n}\r\n.par-card__label {\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n.par-card__value {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: 8px;\r\n  min-width: 0;\r\n}\r\n/* Il campo è la card: niente riquadro del campo globale (form-controls.css). */\r\n.par-view .par-card input.par-card__input {\r\n  --control-bg: transparent;\r\n  --control-border: transparent;\r\n  box-shadow: none;\r\n  /* Il campo cresce col valore: l'unità resta accanto, come nel prototipo. */\r\n  field-sizing: content;\r\n  width: auto;\r\n  min-width: 2ch;\r\n  max-width: 100%;\r\n  flex: 0 1 auto;\r\n  height: 40px;\r\n  border: 0;\r\n  padding: 0;\r\n  background: none;\r\n  font: 600 28px/36px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--text);\r\n}\r\n.par-view .par-card input.par-card__input:focus {\r\n  outline: none;\r\n}\r\n.par-card__input::placeholder {\r\n  color: var(--text);\r\n}\r\n.par-card__unit {\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n  white-space: nowrap;\r\n}\r\n.par-choice,\r\n.par-field {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  margin: 0;\r\n}\r\n.par-choice__label {\r\n  font: 400 14px/20px var(--font-ui);\r\n  color: var(--text-muted);\r\n}\r\n\r\n.par-extra {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  gap: 16px;\r\n}\r\n.par-text {\r\n  min-height: 48px;\r\n  width: 100%;\r\n}\r\n\r\n/* Tastierino e salvataggio */\r\n.par-pad {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, 1fr);\r\n  gap: 8px;\r\n}\r\n.par-pad__key {\r\n  height: 48px;\r\n  border-radius: 12px;\r\n  border: 2px solid var(--border);\r\n  background: var(--surface);\r\n  color: var(--text);\r\n  font: 600 20px/28px var(--font-ui);\r\n  cursor: pointer;\r\n}\r\n.par-pad__key:active:not(:disabled) {\r\n  background: #eaf1fe;\r\n}\r\n\r\n.par-pad__key:disabled {\r\n  opacity: 0.45;\r\n  cursor: not-allowed;\r\n}\r\n.par-news2 {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  padding: 16px;\r\n  border-radius: 16px;\r\n  background: #eaf1fe;\r\n  color: #1d4fc4;\r\n}\r\n.par-news2__title {\r\n  font: 600 14px/20px var(--font-ui);\r\n}\r\n.par-news2__score {\r\n  font: 700 28px/36px var(--font-ui);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.par-news2__text {\r\n  font: 400 16px/24px var(--font-ui);\r\n}\r\n.par-news2--ok {\r\n  background: #e6f6ef;\r\n  color: #0e7a55;\r\n}\r\n.par-news2--low {\r\n  background: #eaf1fe;\r\n  color: #1d4fc4;\r\n}\r\n.par-news2--single,\r\n.par-news2--medium {\r\n  background: var(--amber-bg);\r\n  color: #8a5300;\r\n}\r\n.par-news2--high {\r\n  background: #fdecee;\r\n  color: #b3261e;\r\n}\r\n.par-result {\r\n  margin: 0;\r\n  color: #0e7a55;\r\n  font: 600 14px/20px var(--font-ui);\r\n}\r\n.par-error {\r\n  color: #b3261e;\r\n  font: 400 14px/20px var(--font-ui);\r\n}\r\n\r\n/* Tablet: pazienti a sinistra, tastierino sotto il modulo. */\r\n@media (max-width: 1099px) {\r\n  .par-grid {\r\n    grid-template-columns: 240px minmax(0, 1fr);\r\n    grid-template-areas: 'list form';\r\n  }\r\n}\r\n/* Telefono: una colonna; l'elenco pazienti scorre in un riquadro. */\r\n@media (max-width: 699px) {\r\n  .par-grid {\r\n    grid-template-columns: minmax(0, 1fr);\r\n    grid-template-areas: 'list' 'form';\r\n  }\r\n  .par-plist {\r\n    max-height: 40vh;\r\n    overflow-y: auto;\r\n  }\r\n  .par-cards,\r\n  .par-extra {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }\r\n  .par-cards {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n  /* Sul telefono c'è già la tastiera numerica di sistema (inputMode). */\r\n  .par-pad {\r\n    display: none;\r\n  }\r\n}\r\n/* Schermi larghi: tastierino, NEWS2 e Salva restano a vista mentre si scorre il modulo. */\r\n@media (min-width: 1100px) {\r\n  .par-side {\r\n    position: sticky;\r\n    top: 16px;\r\n  }\r\n}\r\n\r\n/* QA: il nome non si tronca (omonimi, stessa camera). Va a capo su più righe se serve. */\r\n.par-pick__name,\r\n.par-pick .par-cap {\r\n  white-space: normal;\r\n  overflow: visible;\r\n  text-overflow: clip;\r\n  overflow-wrap: anywhere;\r\n}\r\n.par-pick__main {\r\n  align-items: flex-start;\r\n}\r\n.par-pick { display:grid; grid-template-columns:minmax(0,1fr); padding:8px; gap:4px; }\r\n.par-pick__main { width:100%; padding:0; gap:10px; }\r\n.par-pick__text { flex:1; min-width:0; }\r\n.par-pick__bed { width:32px; height:32px; border-radius:8px; font-size:14px; }\r\n.par-pick__name { font-size:14px; line-height:20px; overflow-wrap:normal; word-break:normal; }\r\n.par-pick .par-cap { font-size:12px; line-height:18px; overflow-wrap:normal; }\r\n.par-pick .turno-pcard__news2 { justify-self:start; max-width:100%; margin-left:42px; font-size:12px; line-height:18px; }\r\n@media (max-width: 1099px) {\r\n  .par-grid {\r\n    grid-template-columns: 240px minmax(0, 1fr);\r\n  }\r\n}\r\n@media (max-width: 699px) {\r\n  .par-grid {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }\r\n}\r\n.par-outside {\r\n  margin: 0;\r\n  padding: 8px 12px;\r\n  border-radius: 12px;\r\n  background: var(--amber-bg);\r\n  color: #8a5300;\r\n  font: 600 14px/20px var(--font-ui);\r\n}\r\n\r\n/* Un solo pulsante per cancellare la ricerca (quello della pagina). */\r\n.par-search__input::-webkit-search-cancel-button {\r\n  display: none;\r\n}\r\n\r\n/* Azioni della colonna laterale a tutta larghezza (solo layout). */\r\n.par-wide {\r\n  width: 100%;\r\n}\r\n"],["STYLE",{},".patient-combobox {\r\n  position: relative;\r\n  min-width: 0;\r\n}\r\n\r\n.patient-combobox__control {\r\n  position: relative;\r\n}\r\n\r\n.patient-combobox__search-icon {\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 12px;\r\n  z-index: 1;\r\n  width: 18px;\r\n  height: 18px;\r\n  color: var(--text-muted);\r\n  pointer-events: none;\r\n  transform: translateY(-50%);\r\n}\r\n\r\n.patient-combobox__search-icon svg,\r\n.patient-combobox__clear svg {\r\n  width: 18px;\r\n  height: 18px;\r\n}\r\n\r\n.patient-combobox .patient-combobox__input {\r\n  min-width: 0;\r\n  width: 100%;\r\n  padding-right: 46px;\r\n  padding-left: 40px;\r\n}\r\n\r\n.patient-combobox__clear {\r\n  position: absolute;\r\n  top: 50%;\r\n  right: 4px;\r\n  display: grid;\r\n  width: 44px;\r\n  height: 44px;\r\n  padding: 0;\r\n  border: 0;\r\n  border-radius: 7px;\r\n  color: var(--text-muted);\r\n  background: transparent;\r\n  cursor: pointer;\r\n  place-items: center;\r\n  transform: translateY(-50%);\r\n}\r\n\r\n.patient-combobox__clear:hover,\r\n.patient-combobox__clear:focus-visible {\r\n  color: var(--blue);\r\n  background: var(--blue-dim);\r\n}\r\n\r\n.patient-combobox__help {\r\n  margin: 5px 0 0;\r\n  color: var(--text-muted);\r\n  font-size: 11.5px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.patient-combobox__selection {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 9px;\r\n  min-width: 0;\r\n  margin-top: 8px;\r\n  padding: 9px 11px;\r\n  border: 1px solid color-mix(in srgb, var(--emerald) 28%, var(--border));\r\n  border-radius: 8px;\r\n  color: var(--text);\r\n  background: var(--emerald-bg);\r\n}\r\n\r\n.patient-combobox__selection-icon {\r\n  display: grid;\r\n  width: 26px;\r\n  height: 26px;\r\n  flex: 0 0 26px;\r\n  border-radius: 50%;\r\n  color: var(--emerald);\r\n  background: var(--surface);\r\n  place-items: center;\r\n}\r\n\r\n.patient-combobox__selection-icon svg {\r\n  width: 15px;\r\n  height: 15px;\r\n}\r\n\r\n.patient-combobox__popup {\r\n  position: absolute;\r\n  top: calc(100% + 6px);\r\n  left: 0;\r\n  right: 0;\r\n  z-index: 250;\r\n  overflow: hidden;\r\n  border: 1px solid var(--border-strong, var(--border));\r\n  border-radius: 9px;\r\n  background: var(--surface);\r\n  box-shadow: 0 12px 30px rgba(20, 39, 72, 0.16);\r\n}\r\n\r\n.patient-combobox__list {\r\n  max-height: min(320px, 40vh);\r\n  margin: 0;\r\n  padding: 4px;\r\n  overflow-y: auto;\r\n  list-style: none;\r\n}\r\n\r\n.patient-combobox__option {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr);\r\n  gap: 12px;\r\n  align-items: center;\r\n  min-height: 52px;\r\n  padding: 8px 10px;\r\n  border-radius: 7px;\r\n  cursor: pointer;\r\n}\r\n\r\n.patient-combobox__option.is-active,\r\n.patient-combobox__option:hover {\r\n  background: var(--blue-dim);\r\n  box-shadow: inset 3px 0 0 var(--blue);\r\n}\r\n\r\n.patient-combobox__option-name {\r\n  overflow: hidden;\r\n  color: var(--text);\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.patient-combobox__option-identity {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-end;\r\n  color: var(--text-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 10.5px;\r\n  line-height: 1.35;\r\n}\r\n\r\n.patient-combobox__option-identity strong {\r\n  color: var(--text);\r\n  font-size: 11px;\r\n}\r\n\r\n.patient-combobox__status {\r\n  margin: 0;\r\n  padding: 13px 14px;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n}\r\n\r\n.patient-combobox__status--error {\r\n  color: var(--red);\r\n}\r\n\r\n@media (max-width: 520px) {\r\n  .patient-combobox__option {\r\n    grid-template-columns: 1fr;\r\n    gap: 3px;\r\n  }\r\n\r\n  .patient-combobox__option-identity {\r\n    align-items: flex-start;\r\n  }\r\n}\r\n"],["STYLE",{},".tdose-list {\r\n  list-style: none;\r\n  margin: 6px 0 0;\r\n  padding: 0;\r\n  display: grid;\r\n  gap: 4px;\r\n  text-align: left;\r\n}\r\n.tdose {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1px;\r\n  padding: 3px 6px;\r\n  border-left: 3px solid var(--blue);\r\n  border-radius: 4px;\r\n  background: var(--surface, #fff);\r\n  font-size: 11.5px;\r\n  line-height: 1.35;\r\n  overflow-wrap: anywhere;\r\n}\r\n.tdose__who {\r\n  font-weight: 650;\r\n  color: var(--text);\r\n}\r\n.tdose__what {\r\n  color: var(--text);\r\n}\r\n.tdose__status {\r\n  font-weight: 600;\r\n  color: #1d4fc4;\r\n}\r\n.tdose--late,\r\n.tdose--missed {\r\n  border-left-color: var(--red);\r\n}\r\n.tdose--late .tdose__status,\r\n.tdose--missed .tdose__status {\r\n  color: #a5202f;\r\n}\r\n.tdose--done {\r\n  border-left-color: #16a37b;\r\n}\r\n.tdose--done .tdose__status {\r\n  color: #0e7a55;\r\n}\r\n.tdose-list__partial {\r\n  margin: 4px 0 0;\r\n  font-size: 11.5px;\r\n  color: var(--text-muted);\r\n}\r\n"],["STYLE",{},".therapy-modal .therapy-modal__body {\r\n  min-height: 0;\r\n  padding-top: 0;\r\n  scroll-padding-block: 160px 16px;\r\n}\r\n.therapy-modal .therapy-patient-group {\r\n  min-width: 0;\r\n  margin-bottom: 18px;\r\n  border: 1px solid var(--border, #dce3ec);\r\n  border-radius: 8px;\r\n  background: var(--surface, #fff);\r\n}\r\n.ther