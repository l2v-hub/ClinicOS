  code: 'ERR_ASSERTION'
  name: 'AssertionError'
  expected:
  actual: |-
    name: Codex bug pipeline
    
    on:
      issues:
        types: [labeled]
      issue_comment:
        types: [created]
      pull_request_target:
        types: [labeled, synchronize, reopened, ready_for_review]
      pull_request_review:
        types: [submitted]
      pull_request_review_comment:
        types: [created]
      workflow_run:
        workflows: [Bug pipeline regression gate, Frontend Secret Scan, AI Import E2E Gate, Claude cloud review]
        types: [completed]
      workflow_dispatch:
      schedule:
        - cron: '*/15 * * * *'
    
    permissions:
      contents: write
      issues: write
      pull-requests: write
      actions: read
      checks: read
    
    jobs:
      process:
        # Suppress wake-ups caused by the pipeline's own status comments and reviews.
        if: >-
          github.repository == 'l2v-hub/ClinicOS' &&
          (github.event_name != 'issues' || contains(fromJSON('["codex-run","codex-review-ready"]'), github.event.label.name)) &&
          (github.event_name != 'pull_request_target' ||
            (github.event.pull_request.head.repo.full_name == github.repository &&
              (github.event.action != 'labeled' || github.event.label.name == 'codex-review-ready'))) &&
          (github.event_name != 'workflow_run' || github.event.workflow_run.head_repository.full_name == github.repository) &&
          !((github.event_name == 'issue_comment' && startsWith(github.event.comment.body, '<!-- codex-bug-pipeline:')) ||
            (github.event_name == 'pull_request_review' && startsWith(github.event.review.body, '<!-- codex-bug-pipeline:')) ||
            (github.event_name == 'pull_request_review_comment' && startsWith(github.event.comment.body, '<!-- codex-bug-pipeline:')))
        # Evaluate the event filter before entering concurrency. Irrelevant label
        # events must not replace the one pending controller wake-up.
        concurrency:
          group: codex-bug-pipeline-${{ github.repository }}
          cancel-in-progress: false
        runs-on: ubuntu-22.04
        timeout-minutes: 180
        steps:
          # Always execute the trusted default branch. Never check out a user-controlled issue/PR ref.
          - name: Checkout trusted default branch
            uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
            with:
              ref: ${{ github.event.repository.default_branch }}
              persist-credentials: false
    
          - name: Set up Node 22
            uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
            with:
              node-version: 22
    
          # Install repository dependencies outside the secret-bearing controller step.
          - name: Install repository dependencies
            env:
              HUSKY: 0
            run: npm ci --ignore-scripts --no-audit --no-fund
    
          - name: Set up local mock AI runtime dependencies
            uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
            with:
              python-version: '3.12'
    
          - name: Install local validation tools
            env:
              PLAYWRIGHT_BROWSERS_PATH: ${{ runner.temp }}/clinicos-verification-browsers
            run: |
              bash scripts/quality-gate/install-verification-tools.sh
              python -m pip install -r clinicos-ai-runtime/requirements.txt
              node node_modules/playwright/cli.js install --with-deps chromium
    
          # Install only the pinned CLIs outside the checkout. Their install scripts materialize
          # the platform binaries and run before any credentials enter the job environment.
          - name: Install model CLIs
            run: >-
              npm install --prefix "$RUNNER_TEMP/bug-pipeline-tools"
              --no-audit --no-fund --no-save
              @openai/codex@0.159.2
    
          - name: Run serialized issue and review controller
            env:
              PLAYWRIGHT_BROWSERS_PATH: ${{ runner.temp }}/clinicos-verification-browsers
              GH_TOKEN: ${{ secrets.CLINICOS_BOT_TOKEN || github.token }}
              CODEX_API_KEY: ${{ secrets.OPENAI_API_KEY }}
              # Claude runs in the user's external subscription harness, never with Actions tokens.
              BUG_PIPELINE_REVIEW_MODE: external
              CODEX_PLANNER_MODEL: ${{ vars.CODEX_PLANNER_MODEL || 'gpt-6.1-sol' }}
              CODEX_EXECUTOR_MODEL: ${{ vars.CODEX_EXECUTOR_MODEL || 'auto' }}
              CODEX_SMALL_EXECUTOR_MODEL: ${{ vars.CODEX_SMALL_EXECUTOR_MODEL || 'gpt-6-luna' }}
              # Only new intake gets bounded ticket graphs. Existing plans remain frozen.
              CLINICOS_WORK_ITEM_DELEGATION: ${{ vars.CLINICOS_WORK_ITEM_DELEGATION || 'adaptive' }}
              CLINICOS_WORK_ITEM_PARALLEL: ${{ vars.CLINICOS_WORK_ITEM_PARALLEL || '2' }}
              CODEX_CLI_PATH: ${{ runner.temp }}/bug-pipeline-tools/node_modules/.bin/codex
            run: node agent-team/src/bug-pipeline/cli.mjs
    
          - name: Upload bounded pipeline diagnostic and retained failed code
            if: always()
            uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
            with:
              name: codex-bug-pipeline-diagnostic-${{ github.run_id }}
              path: |
                agent-team/.runtime/bug-pipeline/diagnostic.json
                agent-team/.runtime/bug-pipeline/verification/
                agent-team/.runtime/bug-pipeline/failed-code/
              if-no-files-found: ignore
              retention-days: 14
    
  operator: 'match'
  stack: |-
    TestContext.<anonymous> (file:///workspace/clinicos-autonomy-complete-20261028/agent-team/tests/bug-pipeline/workflow-intake.test.mjs:15:10)
