+export function voiceTransport(
+  status: RuntimeSttStatus,
+  env: NodeJS.ProcessEnv = process.env,
+): 'webrtc' | 'server' {
+  return (env.VOICE_STT_TRANSPORT || '').trim().toLowerCase() !== 'server' &&
+    status.realtime.enabled
+    ? 'webrtc'
+    : 'server';
 }
