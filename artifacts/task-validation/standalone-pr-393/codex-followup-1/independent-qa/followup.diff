+  const keys = ['AI_RUNTIME_URL', 'AI_RUNTIME_SERVICE_TOKEN', 'VOICE_STT_TRANSPORT'] as const;
+  const prior = Object.fromEntries(keys.map((key) => [key, process.env[key]]));
