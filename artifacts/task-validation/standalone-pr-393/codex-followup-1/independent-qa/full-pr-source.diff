+# exists for this adapter yet, so the dispatcher refuses activation (including explicit opt-in).
+SERVER_SESSION_DURATION_ENFORCED = False
+MAX_SESSION_SECONDS = 60
+CLIENT_SECRET_SECONDS = 60
+
+
+@dataclass(frozen=True)
+class RealtimeConfig:
+    endpoint: str
+    api_key: str = field(repr=False)
+    model: str
+    language: str = "it"
+
+
+def realtime_config(env: Mapping[str, str] | None = None, *, model: str | None = None) -> RealtimeConfig | None:
+    e = os.environ if env is None else env
+    endpoint = (e.get("AZURE_OPENAI_REALTIME_ENDPOINT") or e.get("AZURE_OPENAI_ENDPOINT") or "").strip().rstrip("/")
+    key = (e.get("AZURE_OPENAI_API_KEY") or "").strip()
+    model = (model or e.get("STT_REALTIME_MODEL") or "").strip()
+    if not endpoint or not key or not model:
+        return None
+    try:
+        parts = urlsplit(endpoint)
+        port = parts.port
+    except ValueError as ex:
+        raise SttError("not_configured", "Endpoint STT realtime non valido", 503) from ex
+    # Trusted configuration still cannot forward a service credential to an insecure or malformed URL.
+    if (parts.scheme != "https" or not parts.hostname or parts.username or parts.password
+            or parts.path not in ("", "/") or parts.query or parts.fragment or port not in (None, 443)):
+        raise SttError("not_configured", "Endpoint STT realtime non valido", 503)
+    if len(model) > 200 or any(c in model for c in "\r\n\x00"):
+        raise SttError("not_configured", "Modello STT realtime non valido", 503)
+    return RealtimeConfig(endpoint, key, model)
+
+
+def session_config(cfg: RealtimeConfig) -> dict:
+    return {"type": "transcription", "audio": {"input": {
+        "format": {"type": "audio/pcm", "rate": 24000},
+        "transcription": {"model": cfg.model, "languages": [cfg.language]},
+        "turn_detection": None,
+    }}}
+
+
+class _NoRedirect(urllib.request.HTTPRedirectHandler):
+    def redirect_request(self, req, fp, code, msg, headers, newurl):
+        return None
+
+
+def _http(req: urllib.request.Request, timeout: float) -> bytes:
+    try:
+        with urllib.request.build_opener(_NoRedirect).open(req, timeout=timeout) as response:
+            raw = response.read(MAX_RESPONSE_BYTES + 1)
+        if len(raw) > MAX_RESPONSE_BYTES:
+            raise SttError("provider_error", "Risposta STT realtime troppo grande", 502)
+        return raw
+    except urllib.error.HTTPError as ex:
+        # Never echo provider body: it may contain request values or credentials.
+        kind, code = ("auth_failed", 503) if ex.code in (401, 403) else (
+            ("rate_limited", 503) if ex.code == 429 else ("provider_error", 502))
+        raise SttError(kind, "Richiesta STT realtime rifiutata", code) from ex
+    except TimeoutError as ex:
+        raise SttError("timeout", "STT realtime timeout", 504) from ex
+    except urllib.error.URLError as ex:
+        raise SttError("unavailable", "STT realtime non raggiungibile", 503) from ex
+
+
+def negotiate_call(cfg: RealtimeConfig, offer: str, timeout: float = 12.0) -> dict:
+    from .realtime import validate_sdp
+
+    validate_sdp(offer)
+    deadline = time.monotonic() + timeout
+    remaining = lambda: max(0.05, deadline - time.monotonic())
+    req = urllib.request.Request(f"{cfg.endpoint}/openai/v1/realtime/client_secrets", method="POST",
+                                 data=json.dumps({"session": session_config(cfg),
+                                                  "expires_after": {"anchor": "created_at", "seconds": CLIENT_SECRET_SECONDS}}).encode(),
+                                 headers={"api-key": cfg.api_key, "Content-Type": "application/json"})
+    try:
+        grant = json.loads(_http(req, min(5.0, remaining())).decode("utf-8"))
+    except (ValueError, UnicodeDecodeError) as ex:
+        raise SttError("provider_error", "Risposta STT realtime non valida", 502) from ex
+    token = grant.get("value") if isinstance(grant, dict) else None
+    if not isinstance(token, str) or not token or len(token) > 8192 or "\r" in token or "\n" in token:
+        raise SttError("provider_error", "Token sessione STT assente o non valido", 502)
+    if time.monotonic() >= deadline:
+        raise SttError("timeout", "STT realtime timeout", 504)
+    req = urllib.request.Request(f"{cfg.endpoint}/openai/v1/realtime/calls", method="POST", data=offer.encode(),
+                                 headers={"Authorization": f"Bearer {token}", "Content-Type": "application/sdp"})
+    try:
+        answer = _http(req, remaining()).decode("utf-8")
+    except UnicodeDecodeError as ex:
+        raise SttError("provider_error", "Risposta SDP non valida", 502) from ex
+    try:
+        validate_sdp(answer)
+    except SttError as ex:
+        raise SttError("provider_error", "Risposta SDP non valida", 502) from ex
+    expires = grant.get("expires_at")
+    return {"sdp": answer, "model": cfg.model, "deployment": cfg.model,
+            "expiresAt": int(expires) if isinstance(expires, (int, float)) and not isinstance(expires, bool) else None,
+            "transport": "webrtc"}
diff --git a/clinicos-ai-runtime/clinicos_ai/voice/realtime.py b/clinicos-ai-runtime/clinicos_ai/voice/realtime.py
new file mode 100644
index 00000000..774b2430
--- /dev/null
+++ b/clinicos-ai-runtime/clinicos_ai/voice/realtime.py
@@ -0,0 +1,75 @@
+"""Optional realtime transport; provider knowledge stays in the central registry/adapter.
+
+Configuration availability is not remote provider readiness. No model/provider fallback, no
+session is created by status and no provider token may leave the adapter.
+"""
+from __future__ import annotations
+
+import asyncio
+import importlib
+import os
+from typing import Any, Mapping
+
+from .stt import SttError, stt_model, stt_realtime
+
+MAX_SDP_BYTES = 64_000
+
+
+def realtime_status(env: Mapping[str, str] | None = None) -> dict[str, Any]:
+    from ..models.provider_registry import provider_entry
+
+    e = os.environ if env is None else env
+    config = stt_realtime(e)
+    configured = stt_model(e)
+    entry = provider_entry(configured[0]) if configured else None
+    available = ((e.get("AI_ENABLED") or "true").strip().lower() != "false"
+                 and config["enabled"] and bool(config["model"])
+                 and entry is not None and bool(entry.realtime_module))
+    if available:
+        try:
+            adapter = importlib.import_module(entry.realtime_module)
+            available = (adapter.realtime_config(e, model=config["model"]) is not None
+                         and getattr(adapter, "SERVER_SESSION_DURATION_ENFORCED", False) is True)
+        except SttError:
+            available = False
+    return {**config, "available": bool(available),
+            "provider": configured[0] if configured else None,
+            "transports": ["webrtc"] if available else []}
+
+
+def validate_sdp(value: object) -> str:
+    if (not isinstance(value, str) or not value.startswith("v=0")
+            or len(value.encode("utf-8")) > MAX_SDP_BYTES or "\x00" in value):
+        raise SttError("invalid_sdp", "Offerta SDP non valida", 400)
+    return value
+
+
+async def negotiate(offer: str) -> dict[str, Any]:
+    from ..models.provider_registry import provider_entry
+    from ..models.contract import BUDGET
+    from ..models.errors import RuntimeError_
+    from ..models.cost import COSTS, estimate_usd
+
+    validate_sdp(offer)
+    try:
+        BUDGET.check(os.environ)
+    except RuntimeError_ as ex:
+        raise SttError("budget_exceeded", "Budget AI esaurito", 503) from ex
+    current = realtime_status()
+    if not current["available"]:
+        raise SttError("not_configured", "STT realtime non configurato o disattivato", 503)
+    entry = provider_entry(current["provider"])
+    adapter = importlib.import_module(entry.realtime_module)
+    # Adapter validates endpoint/credentials before opening any network connection.
+    config = adapter.realtime_config(model=current["model"])
+    if config is None:
+        raise SttError("not_configured", "STT realtime non configurato", 503)
+    # The adapter bounds response sizes and checks the remaining negotiation timeout.
+    # Count admitted negotiations conservatively, including failures that might create a session.
+    # This is an estimate at the authoritative adapter's duration ceiling, never measured audio.
+    ceiling = getattr(adapter, "MAX_SESSION_SECONDS", None)
+    if not isinstance(ceiling, int) or isinstance(ceiling, bool) or not 1 <= ceiling <= 60:
+        raise SttError("not_configured", "Limite sessione STT non verificato", 503)
+    estimate = estimate_usd(current["provider"], current["model"], {"audioSeconds": ceiling}, os.environ)
+    COSTS.add(estimate, os.environ)
+    return await asyncio.to_thread(adapter.negotiate_call, config, offer)
