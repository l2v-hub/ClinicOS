+  delete batch.releaseHold;
+  if (batch.release) {
+    batch.release.status = 'merged';
+    batch.release.deploymentSha = deploymentSha;
+    delete batch.release.deployment;
+    delete batch.release.publication;
+  }
+  return archive;
+}
