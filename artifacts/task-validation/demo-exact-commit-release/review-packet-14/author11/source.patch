+    return 'EXACT_MAIN_CHANGED';
+  if (/preflight expired/.test(error?.message ?? '')) return 'EXACT_PREFLIGHT_EXPIRED';
+  if (/workflow failed/.test(error?.message ?? '')) return 'EXACT_RUN_FAILED';
+  return 'EXACT_DISPATCH_BLOCKED';
