+    typeof verify !== 'function' ||
+    typeof guard !== 'function' ||
+    typeof delay !== 'function' ||
+    !Number.isFinite(timeoutMs) ||
+    timeoutMs <= 0 ||
+    timeoutMs > 60 * 60_000 ||
+    !Number.isFinite(pollMs) ||
+    pollMs <= 0 ||
+    pollMs > 60_000
+  )
