+
+export const finalQaIdentity = (
+  subject,
+  fingerprint = subject.externalReview?.feedbackFingerprint ?? subject.feedbackFingerprint,
+) => ({
+  subjectSha: subject.sha,
+  claudeRound: subject.reviews.length,
+  feedbackFingerprint: fingerprint,
