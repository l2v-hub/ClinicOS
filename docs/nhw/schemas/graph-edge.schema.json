{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinicos.local/nhw/graph-edge.schema.json",
  "title": "NHW Graph Edge",
  "type": "object",
  "additionalProperties": false,
  "required": ["from", "type", "to", "evidence", "confidence"],
  "properties": {
    "from": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "type": {
      "enum": [
        "authenticates-with",
        "authorizes-with",
        "belongs-to",
        "calls",
        "configured-by",
        "consumes",
        "contains",
        "depends-on",
        "deployed-by",
        "documents",
        "duplicates",
        "exposes",
        "implements",
        "imports",
        "invokes",
        "persists-as",
        "produces",
        "publishes",
        "reads",
        "subscribes-to",
        "supersedes",
        "tested-by",
        "violates",
        "writes"
      ]
    },
    "to": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "confidence": { "enum": ["observed", "inferred", "declared"] }
  }
}
