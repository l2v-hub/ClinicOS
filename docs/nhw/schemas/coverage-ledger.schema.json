{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinicos.local/nhw/coverage-ledger.schema.json",
  "title": "NHW Coverage Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inventoryHash",
    "documented",
    "metadataOnly",
    "generatedExcluded",
    "unresolved",
    "records"
  ],
  "properties": {
    "inventoryHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "documented": { "type": "integer", "minimum": 0 },
    "metadataOnly": { "type": "integer", "minimum": 0 },
    "generatedExcluded": { "type": "integer", "minimum": 0 },
    "unresolved": { "type": "integer", "minimum": 0 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "classification", "coverageStatus", "reason"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "classification": { "type": "string", "minLength": 1 },
          "coverageStatus": {
            "enum": ["documented", "metadata-only", "generated-excluded", "unresolved"]
          },
          "reason": { "type": "string", "minLength": 1 },
          "knowledgeIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
            }
          }
        }
      }
    }
  }
}
