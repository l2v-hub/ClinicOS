{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinicos.local/nhw/manifest.schema.json",
  "title": "NHW Knowledge Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "systemId", "baseline", "units", "totals"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "systemId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "commit", "inventoryHash"],
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 },
        "inventoryHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "kind": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "status": {
            "enum": ["observed", "inferred", "declared", "drifted", "deprecated"]
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  }
}
